{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/art/arch.txt",
        "color": {
            "1": "{{colors.primary.default.hex}}",
            "2": "{{colors.secondary.default.hex}}",
            "3": "{{colors.tertiary.default.hex}}",
            "4": "{{colors.on_primary_container.default.hex}}",
            "5": "{{colors.error.default.hex}}",
            "6": "{{colors.on_secondary_container.default.hex}}",
            "7": "{{colors.on_surface.default.hex}}",
            "8": "{{colors.outline.default.hex}}",
            "9": "{{colors.on_tertiary_container.default.hex}}"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        }
    },

    "display": {
        "separator": "  ",
        "constants": [
            "────────────────────────────────────────────────────"
        ],
        "color": {
            "keys": "{{colors.tertiary.default.hex}}",
            "title": "{{colors.primary.default.hex}}",
            "output": "{{colors.on_surface.default.hex}}",
            "separator": "{{colors.outline.default.hex}}"
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "┌{$1}┐",
            "outputColor": "{{colors.outline.default.hex}}"
        },
        {
            "type": "title",
            "key": "│   user",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "custom",
            "format": "├{$1}┤",
            "outputColor": "{{colors.outline.default.hex}}"
        },
        {
            "type": "os",
            "key": "│   distro"
        },
        {
            "type": "kernel",
            "key": "│   kernel"
        },
        {
            "type": "packages",
            "key": "│ 󰏖  pkgs"
        },
        {
            "type": "uptime",
            "key": "│ 󰅐  uptime"
        },
        {
            "type": "custom",
            "format": "├{$1}┤",
            "outputColor": "{{colors.outline.default.hex}}"
        },
        {
            "type": "wm",
            "key": "│   wm"
        },
        {
            "type": "terminal",
            "key": "│   term"
        },
        {
            "type": "shell",
            "key": "│   shell"
        },
        {
            "type": "terminalfont",
            "key": "│   font"
        },
        {
            "type": "custom",
            "format": "├{$1}┤",
            "outputColor": "{{colors.outline.default.hex}}"
        },
        {
            "type": "cpu",
            "key": "│ 󰍛  cpu",
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "│ 󰢮  gpu"
        },
        {
            "type": "memory",
            "key": "│   mem"
        },
        {
            "type": "disk",
            "key": "│ 󰋊  disk",
            "folders": "/"
        },
        {
            "type": "display",
            "key": "│ 󰍹  display"
        },
        {
            "type": "custom",
            "format": "├{$1}┤",
            "outputColor": "{{colors.outline.default.hex}}"
        },
        {
            "type": "colors",
            "key": "│  ",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "└{$1}┘",
            "outputColor": "{{colors.outline.default.hex}}"
        }
    ]
}

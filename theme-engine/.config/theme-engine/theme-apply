#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║              THEME-APPLY (D-01/D-02)                 ║
# ║  Single entrypoint: renders + reloads for BOTH static ║
# ║  presets and Material You, atomically (D-14).         ║
# ╚══════════════════════════════════════════════════════╝
#
# Usage: theme-apply <materialyou|catppuccin|dracula|gruvbox|nord|rosepine|tokyonight>
#
# The walker dmenu picker, wallpaper picker, and login init (theme-init.sh)
# are thin callers of this script — they only pass a name.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
ENGINE_DIR="$SCRIPT_DIR"
LIB_DIR="$ENGINE_DIR/lib"
PALETTES_DIR="$ENGINE_DIR/palettes"
STATE_DIR="$HOME/.local/state/theme"

# shellcheck source=lib/generate.sh
source "$LIB_DIR/generate.sh"
# shellcheck source=lib/commit.sh
source "$LIB_DIR/commit.sh"
# shellcheck source=lib/gtk.sh
source "$LIB_DIR/gtk.sh"
# shellcheck source=lib/wallpaper.sh
source "$LIB_DIR/wallpaper.sh"
# shellcheck source=lib/reload.sh
source "$LIB_DIR/reload.sh"
# shellcheck source=lib/fastfetch.sh
source "$LIB_DIR/fastfetch.sh"

usage() {
    echo "Usage: theme-apply <materialyou|materialyou-light|preset-name> [live-wallpaper-abs-path]" >&2
    echo "Available presets:" >&2
    for f in "$PALETTES_DIR"/*.json; do
        [[ -f "$f" ]] && echo "  - $(basename "$f" .json)" >&2
    done
}

if [[ $# -lt 1 || $# -gt 2 ]]; then
    usage
    exit 1
fi

NAME="$1"
# CR-01: optional explicit live-wallpaper ref, forwarded verbatim to
# theme_engine_wallpaper_sync_owner's call site below — never a second
# owner-declaration path (D-21). Only the wallpaper picker's Material You
# branch passes this; every other caller (theme-init.sh, the walker
# dmenu picker, a plain theme switch) still passes exactly one argument
# and gets the pre-existing no-ref fallback behaviour untouched.

# Security Domain V5 — validate the argument against the ACTUAL palette
# filenames before it is ever interpolated into a filesystem path. Reject
# unknown names outright rather than building "$PALETTES_DIR/$NAME.json"
# from unvalidated input.
if [[ "$NAME" != "materialyou" && "$NAME" != "materialyou-light" ]]; then
    if [[ ! -f "$PALETTES_DIR/$NAME.json" ]]; then
        notify-send -a "Theme Switcher" "Error" \
            "Unknown theme: ${NAME}. Desktop left unchanged." \
            -i dialog-error -t 5000 2>/dev/null || true
        echo "theme-apply: unknown theme '$NAME'" >&2
        usage
        exit 1
    fi
fi

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

# D-08: repair-on-missing guard, deliberately placed BEFORE generate — not
# stylistic. generate.sh:54 resolves the active-wallpaper pointer as the
# Material You palette source; a wiped state directory repaired AFTER
# generate would render a palette derived from a stale or dangling
# pointer with nothing reporting it. Best-effort (|| true): must never
# abort a render.
theme_engine_wallpaper_frame_repair "$NAME" || true

if ! theme_engine_generate "$NAME" "$TMP_DIR"; then
    ERROR_LOG="$STATE_DIR/.last-render-error.log"
    ERROR_SUMMARY="Theme render failed. Desktop left unchanged."
    if [[ -f "$ERROR_LOG" ]]; then
        # Truncate + sanitize before it ever reaches notify-send — full
        # detail stays in the log file only (Security Domain: notification
        # content injection).
        ERROR_SUMMARY=$(head -c 200 "$ERROR_LOG" | tr -d '\000-\011\013\014\016-\037')
    fi
    notify-send -a "Theme Switcher" "Error" \
        "${ERROR_SUMMARY}" \
        -i dialog-error -t 5000 2>/dev/null || true
    echo "theme-apply: render failed for '$NAME' — desktop left unchanged" >&2
    exit 1
fi

# Only reached on a fully successful render — atomic commit (D-14).
theme_engine_commit "$NAME" "$TMP_DIR"

# Fastfetch sprite regen (quick task 260818-srl) — MUST run after commit,
# not before: the generator reads palette.json from the LIVE state dir
# ($STATE_DIR), not the tmp render tree, so it needs the just-committed
# palette already in place. Bounded to the single active sprite (T-srl-03)
# and best-effort (|| true) — a generator failure must never fail or stall
# a theme switch; the previous GIF (in the old palette) is a strictly
# better failure mode than none at all. Placed before reload for the same
# reason wallpaper autoset below is: the desktop should land colours and
# (if the picked logo is a sprite) its freshly-regenerated frames together,
# not colours now and a stale-palette sprite until the next shell opens.
theme_engine_fastfetch_regen || true

# Static-preset wallpaper auto-set (D-11/D-12) — after commit succeeds,
# before reload, so the desktop lands wallpaper + colors together. No-op
# for both Material You names; a failed render never reaches this line.
theme_engine_wallpaper_autoset "$NAME"

# D-21: the single owner-declaration path — login, theme switch and a
# manual picker pick all reach the live-wallpaper owner through this ONE
# function and no other call site. Placed AFTER autoset (autoset is what
# may have just changed the recorded choice — D-13's dead-entry fallback
# clears it, and the recorded value is what sync_owner reads) and BEFORE
# reload (so the desktop lands wallpaper, colours and player together).
# Deliberately NOT nested inside theme_engine_wallpaper_autoset's own
# body: autoset returns early for both Material You names, so a call
# nested inside it would silently never run in dynamic mode — exactly
# the login-only-style breakage D-21 exists to prevent.
#
# CR-01: when the caller supplied an explicit ref (Material You live
# pick — autoset is a no-op for both Material You names and never
# records one), forward it here instead of letting sync_owner fall back
# to last-wallpaper/$NAME, which is never written for either Material
# You name and would otherwise always resolve to `clear`.
if [[ $# -ge 2 ]]; then
    theme_engine_wallpaper_sync_owner "$NAME" "$2" || true
else
    theme_engine_wallpaper_sync_owner "$NAME" || true
fi

# Single reload owner (D-04) — runs once, only after commit succeeds.
theme_engine_reload

# THEME_APPLY_QUIET suppresses only this SUCCESS toast, never the error
# ones above. Sub-switchers that call theme-apply purely to RE-RENDER the
# current theme (motion-switch.sh changing the animation style, for example)
# set it: without it, changing an animation style pops "Theme Applied —
# Switched to <colour theme>", reporting a colour-theme switch that never
# happened. A real theme switch leaves it unset and still notifies.
if [[ "${THEME_APPLY_QUIET:-0}" != "1" ]]; then
    notify-send -a "Theme Switcher" "Theme Applied" "Switched to ${NAME}" \
        -i preferences-desktop-theme -t 3000 2>/dev/null || true
fi

#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║              THEME-DOCTOR (D-25)                     ║
# ║  Rerunnable health check for the theme-engine's core  ║
# ║  invariants. Report-only — never mutates state.       ║
# ╚══════════════════════════════════════════════════════╝

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
STATE_DIR="$HOME/.local/state/theme"
DOTFILES_DIR="$HOME/dotfiles"

# shellcheck source=lib/contract.sh
source "$SCRIPT_DIR/lib/contract.sh"
# shellcheck source=lib/wallpaper.sh
source "$SCRIPT_DIR/lib/wallpaper.sh"

PASS=0
FAIL=0

check() {
    local desc="$1"
    local ok="$2"
    if [[ "$ok" == "0" ]]; then
        echo "  [PASS] $desc"
        PASS=$((PASS + 1))
    else
        echo "  [FAIL] $desc"
        FAIL=$((FAIL + 1))
    fi
}

echo "theme-doctor — theme-engine health check"
echo ""

# ── adw-gtk-theme installed (THEME-02 root cause) ──────────
pacman -Q adw-gtk-theme >/dev/null 2>&1
check "adw-gtk-theme package installed" "$?"

# ── gsettings resolves to the mode-correct adw theme ───────
# Read the committed mode marker — the same source of truth gtk.sh uses to
# decide between adw-gtk3-dark and adw-gtk3. Hardcoding the dark name here
# made this check FAIL on every one of Phase 05's six light presets, i.e. on
# a perfectly healthy desktop.
DOCTOR_MODE=$(cat "$STATE_DIR/mode" 2>/dev/null || echo "dark")
EXPECTED_GTK_THEME="adw-gtk3-dark"
[[ "$DOCTOR_MODE" == "light" ]] && EXPECTED_GTK_THEME="adw-gtk3"

GTK_THEME_VALUE=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")
[[ "$GTK_THEME_VALUE" == "$EXPECTED_GTK_THEME" ]]
check "gsettings gtk-theme = $EXPECTED_GTK_THEME (mode=$DOCTOR_MODE, got: ${GTK_THEME_VALUE:-<unset>})" "$?"

# ── state-dir contract present ──────────────────────────────
[[ -f "$STATE_DIR/current-theme" ]]
check "$STATE_DIR/current-theme exists" "$?"

# D-30: file list sourced from contract.json (single source of truth,
# shared with theme-parity) instead of a hardcoded loop. An empty list
# (jq missing, contract.json unreadable) must surface as a loud FAIL —
# not ten per-file checks silently vanishing from the output.
CONTRACT_FILE_LIST="$(contract_files)"
if [[ -z "$CONTRACT_FILE_LIST" ]]; then
    check "contract.json file list readable and non-empty (jq present)" "1"
else
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        [[ -f "$STATE_DIR/$f" ]]
        check "$STATE_DIR/$f exists" "$?"
    done <<< "$CONTRACT_FILE_LIST"
fi

# WR-07: theme-invariant font render targets (kitty-font.conf) get a
# presence-only check — they are excluded from the color-contract `files`
# array above (theme-parity's parity checks require color-declaration
# content these font fragments do not have).
PRESENCE_ONLY_FILE_LIST="$(contract_presence_only_files)"
if [[ -n "$PRESENCE_ONLY_FILE_LIST" ]]; then
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        [[ -f "$STATE_DIR/$f" ]]
        check "$STATE_DIR/$f exists" "$?"
    done <<< "$PRESENCE_ONLY_FILE_LIST"
fi

# ── D-29 state-manifest gate: every entry directly under $STATE_DIR is
#    accounted for by contract.json — a files[].name, a
#    state_metadata_files entry, a presence_only_files entry, or a
#    declared engine_owned_files path. An unaccounted file is exactly the
#    silent-drift/data-loss bug class the engine_owned_files array exists
#    to close (D-29) — this converts it from something discovered weeks
#    later into an immediate, actionable gate failure that names the
#    file. Degrades to a named [SKIP], never [FAIL], when jq is
#    unavailable or $STATE_DIR doesn't exist yet (fresh install before the
#    first theme-apply) — same discipline as every other guarded check in
#    this file.
if command -v jq >/dev/null 2>&1 && [[ -d "$STATE_DIR" ]]; then
    KNOWN_STATE_ENTRIES="$( { contract_files; contract_presence_only_files; contract_state_metadata_files; contract_engine_owned_files; } 2>/dev/null | sort -u)"
    if [[ -z "$KNOWN_STATE_ENTRIES" ]]; then
        check "state-manifest: contract.json's declared file lists are readable (jq present, file non-empty)" "1"
    else
        UNACCOUNTED=""
        EXAMINED=0
        while IFS= read -r entry; do
            [[ -z "$entry" ]] && continue
            EXAMINED=$((EXAMINED + 1))
            if ! grep -qx "$entry" <<< "$KNOWN_STATE_ENTRIES"; then
                UNACCOUNTED="$UNACCOUNTED $entry"
            fi
        done < <(find "$STATE_DIR" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null)
        UNACCOUNTED="$(echo "$UNACCOUNTED" | xargs)"
        [[ -z "$UNACCOUNTED" ]]
        check "state-manifest: all $EXAMINED entries under $STATE_DIR accounted for (unaccounted: ${UNACCOUNTED:-none})" "$?"
    fi
else
    echo "  [SKIP] state-manifest gate (jq not found or $STATE_DIR does not exist)"
fi

# ── D-11: conditional live-wallpaper frame gate ─────────────────────────
# Fires ONLY when the active theme's recorded choice actually names a
# live/ entry — a still-only desktop (the common case) gets a single named
# [SKIP], never a [FAIL]. This file's own comment at lines 40-46 already
# documents what a gate that fires on a healthy desktop cost this project
# once (Phase 05's light presets). Reuses
# theme_engine_wallpaper_is_live_ref/theme_engine_wallpaper_frame_path
# (Task 1) as the single source of truth for the live/ shape — never a
# re-implemented regex — so this gate and the engine can never drift on
# what counts as a live ref. Report-only: extracts, repairs and repoints
# nothing (theme-doctor's own header, D-25).
DOCTOR_LIVE_THEME=$(cat "$STATE_DIR/current-theme" 2>/dev/null || true)
DOCTOR_LIVE_RECORDED=""
if [[ -n "$DOCTOR_LIVE_THEME" && -f "$STATE_DIR/last-wallpaper/$DOCTOR_LIVE_THEME" ]]; then
    DOCTOR_LIVE_RECORDED=$(head -n1 "$STATE_DIR/last-wallpaper/$DOCTOR_LIVE_THEME" 2>/dev/null || true)
fi

if [[ -n "$DOCTOR_LIVE_RECORDED" ]] && theme_engine_wallpaper_is_live_ref "$DOCTOR_LIVE_RECORDED"; then
    DOCTOR_LIVE_FRAME="$(theme_engine_wallpaper_frame_path "$DOCTOR_LIVE_THEME" "$DOCTOR_LIVE_RECORDED")"

    [[ -s "$DOCTOR_LIVE_FRAME" ]]
    check "live-wallpaper frame: $DOCTOR_LIVE_FRAME exists and is non-empty" "$?"

    # D-19-45: engine-owned active-wallpaper pointer — moved OUT of the
    # stow-managed Wallpapers directory into ~/.local/state/theme/, the
    # same literal lib/wallpaper.sh's own CURRENT_WALLPAPER_LINK targets.
    DOCTOR_CURRENT_RESOLVED="$(readlink -f "$HOME/.local/state/theme/current.jpg" 2>/dev/null || true)"
    DOCTOR_FRAME_RESOLVED="$(readlink -f "$DOCTOR_LIVE_FRAME" 2>/dev/null || true)"
    [[ -n "$DOCTOR_CURRENT_RESOLVED" && "$DOCTOR_CURRENT_RESOLVED" == "$DOCTOR_FRAME_RESOLVED" ]]
    check "live-wallpaper frame: wallpaper pointer resolves to $DOCTOR_LIVE_FRAME" "$?"
else
    echo "  [SKIP] live-wallpaper frame gate (recorded choice for '${DOCTOR_LIVE_THEME:-<unknown>}' is not a live/ entry)"
fi

# ── D-02b hyprctl animations readback (TOKEN-05/criterion 2) ──────────
# The ONLY guard that catches a value Hyprland ACCEPTS and then silently
# substitutes for a malformed one — this is NOT a presence check, and
# must never be "simplified" into one later: a MISSING bezier is not
# silent, Hyprland errors loudly with "no such bezier" at config parse
# (binary-verified, 12-CONTEXT.md). The narrow risk this closes is
# malformed control-point VALUES surviving into the compositor unnoticed.
# For every `bezier = motion-<name>` line this repo emits, confirm
# `hyprctl animations -j` element [1] reports the SAME four control
# points. Degrades to a named [SKIP] — never [FAIL] — when hyprctl/jq are
# unavailable, no compositor is running (the container gate has no
# Hyprland), or the fragment has never been rendered/deployed.
#
# Speed-unit reconciliation (recorded here, not fixed here — see
# 12-04-SUMMARY.md): hyprctl's readback reports `speed` as a float with
# two decimals where the config source writes an integer; `speed = 0`
# and `speed = -1` are hard "invalid speed" parse errors and fractional
# values parse cleanly (both binary-verified this phase). The commonly
# cited decisecond interpretation (1 unit = 100ms) is [CITED:
# wiki.hypr.land] and was NOT independently binary-verified. This is not
# this phase's problem to close: D-04 fences Phase 12 to emitting curves
# only — no `speed` value is emitted anywhere in this codebase yet. Phase
# 13 owns the 14 `animation =` assignment lines these curves get wired
# into, and is therefore where the ms-to-speed conversion is written and
# where the unit must be confirmed against the binary before use.
HYPRLAND_MOTION_CONF="$STATE_DIR/hyprland-motion.conf"
if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 \
    && [[ -f "$HYPRLAND_MOTION_CONF" ]] && ANIM_JSON="$(hyprctl animations -j 2>/dev/null)" \
    && printf '%s' "$ANIM_JSON" | jq -e . >/dev/null 2>&1; then

    DOCTOR_MOTION_SCALE="$(cat "$STATE_DIR/motion-scale" 2>/dev/null || echo normal)"
    echo "  [INFO] motion-scale readback check running at preset: $DOCTOR_MOTION_SCALE"

    CONFIRMED=0
    MISMATCH=""
    while IFS= read -r bline; do
        # Deliberately loose value groups ([^,]+, not a numeric class): a
        # non-numeric corrupted value must still reach the readback
        # comparison below and be reported as a mismatch, not silently
        # skipped by a regex that only matches well-formed floats — the
        # whole point of a fail-first demonstration is exercising exactly
        # the corrupted-value path.
        if [[ "$bline" =~ ^[[:space:]]*bezier[[:space:]]*=[[:space:]]*(motion-[A-Za-z0-9_-]+)[[:space:]]*,[[:space:]]*([^,]+),[[:space:]]*([^,]+),[[:space:]]*([^,]+),[[:space:]]*([^,]+)[[:space:]]*$ ]]; then
            cname="${BASH_REMATCH[1]}"
            ex0="$(echo "${BASH_REMATCH[2]}" | xargs)"; ey0="$(echo "${BASH_REMATCH[3]}" | xargs)"
            ex1="$(echo "${BASH_REMATCH[4]}" | xargs)"; ey1="$(echo "${BASH_REMATCH[5]}" | xargs)"

            readback_row="$(printf '%s' "$ANIM_JSON" | jq -r --arg n "$cname" \
                '.[1][]? | select(.name == $n) | "\(.X0)\t\(.Y0)\t\(.X1)\t\(.Y1)"' 2>/dev/null)"

            if [[ -z "$readback_row" ]]; then
                MISMATCH="$MISMATCH ${cname}(not-found-in-readback — Hyprland accepted the config but silently dropped this curve)"
                continue
            fi

            IFS=$'\t' read -r rx0 ry0 rx1 ry1 <<< "$readback_row"
            # jq's --argjson requires each side to already be a valid JSON
            # number — a corrupted non-numeric emitted value fails THIS
            # call (not the earlier regex), which is exactly the signal a
            # malformed-value corruption should produce: a named mismatch,
            # never a silent pass-through.
            MATCH_OK="$(jq -n --argjson a "$ex0" --argjson b "$rx0" --argjson c "$ey0" \
                --argjson d "$ry0" --argjson e "$ex1" --argjson f "$rx1" \
                --argjson g "$ey1" --argjson h "$ry1" \
                '(($a-$b)|fabs) < 0.001 and (($c-$d)|fabs) < 0.001 and (($e-$f)|fabs) < 0.001 and (($g-$h)|fabs) < 0.001' 2>/dev/null)"

            if [[ "$MATCH_OK" == "true" ]]; then
                CONFIRMED=$((CONFIRMED + 1))
            else
                MISMATCH="$MISMATCH ${cname}(emitted=${ex0},${ey0},${ex1},${ey1} readback=${rx0},${ry0},${rx1},${ry1})"
            fi
        fi
    done < "$HYPRLAND_MOTION_CONF"

    MISMATCH="$(echo "$MISMATCH" | xargs)"
    [[ -z "$MISMATCH" && "$CONFIRMED" -gt 0 ]]
    check "hyprctl animations readback: $CONFIRMED curve(s) confirmed matching emitted control points (mismatched: ${MISMATCH:-none})" "$?"
else
    echo "  [SKIP] hyprctl animations readback (hyprctl/jq unavailable, no compositor running, or $HYPRLAND_MOTION_CONF not deployed)"
fi

# ── yazi wiring symlink points at the state dir ─────────────
[[ -L "$HOME/.config/yazi/theme.toml" ]] \
    && [[ "$(readlink -f "$HOME/.config/yazi/theme.toml")" == "$STATE_DIR/yazi.toml" ]]
check "yazi theme.toml symlinked to state dir" "$?"

# ── no stow conflicts for theme-engine (or the repo isn't
#    positioned as $HOME/dotfiles — skip gracefully) ────────
if command -v stow >/dev/null 2>&1 && [[ -d "$DOTFILES_DIR/theme-engine" ]]; then
    (cd "$DOTFILES_DIR" && stow -n theme-engine >/dev/null 2>/tmp/theme-doctor-stow.log)
    check "stow -n theme-engine reports no conflicts" "$?"
else
    echo "  [SKIP] stow -n theme-engine (stow or $DOTFILES_DIR/theme-engine not found)"
fi

# The retired external launcher's own backend health, version-match and
# provider-parity checks (THEME-01, SCAN-02, D-25) stood here until quick
# task 260822-sht (Task 11) removed them along with the surface they
# targeted. Nothing replaces them: the native QML launcher that replaced
# it lives inside the same Quickshell shell process theme-doctor already
# health-checks elsewhere in this file, with no separate backend daemon,
# version-pin question or provider-parity concern to verify.

# ── GTK CSS-parse regression guard (WLOG-01, CR-01 permanent fix) ──────
# Runs every GTK-consumed stylesheet the theme pipeline owns through a
# REAL GTK CssProvider parse. Four prior verification rounds all reported
# PASS while the retired GTK3 power-menu engine's stylesheet was silently
# discarded in full by GTK3 — a grep for the `@import` line cannot see
# that. The load-bearing
# signal here is an EMPTY provider, not merely a parse error: on GTK
# 3.24.52 a single generated-content ruleset makes GTK throw away the
# WHOLE stylesheet (0 bytes), not just the offending rule. A deprecation
# (GTK3 GError domain gtk-css-provider-error-quark code 4 — e.g.
# style-floating.css's unitless border-radius, IN-02/deferred) is
# non-fatal and must still PASS. Deployed paths only ($HOME/.config/...)
# — the stow files' relative @import only resolves from there, never
# from the repo copy. GTK3 and GTK4 cannot share a python3 process
# (gi.require_version conflict), so this runs as two separate
# invocations. Never calls Gtk.init() — CssProvider needs no display,
# and init() would require one, breaking the headless verify gate.
#    D-31/D-32's disk-truth principle, applied here: the explicit array
#    below lists every deployed GTK3 sheet directly rather than deriving
#    any of them from a glob — the retired bar's layout family was the
#    only surface that needed glob-discovery, and it is gone.
GTK3_CSS_SHEETS=(
    "$HOME/.config/gtk-3.0/gtk.css"
    # 13-02/D-01: the retired daemon's style.css no longer exists (converted to a
    # sass-authored style.scss) — the compiled output in the state dir is
    # what actually reaches GTK3 at runtime, so it is the correct target
    # for this provider-load check regardless of what the repo source is
    # named.
)
GTK4_CSS_SHEETS=(
    "$HOME/.config/gtk-4.0/gtk.css"
)

_theme_doctor_css_parse() {
    # $1 = GTK major version ("3" or "4"), rest = deployed stylesheet
    # paths. Prints one "STATUS<TAB>path-fragment<TAB>reason" line per
    # sheet. stderr redirected to swallow GTK's own noisy Gtk-WARNING
    # chatter — the structured stdout lines are the signal.
    local major="$1"
    shift
    python3 - "$major" "$@" <<'PYEOF' 2>/dev/null
import os
import sys

major = sys.argv[1]
paths = sys.argv[2:]

import gi
gi.require_version("Gtk", major + ".0")
from gi.repository import Gtk

home_config = os.path.join(os.path.expanduser("~"), ".config")

for path in paths:
    try:
        frag = os.path.relpath(path, home_config)
    except ValueError:
        frag = path

    if not os.path.isfile(path):
        print(f"SKIP\t{frag}\tnot deployed under ~/.config — run stow.sh")
        continue

    provider = Gtk.CssProvider()
    fatal = []

    # gtk-css-provider-error-quark code 4 == deprecation (non-fatal, provider
    # retained); any other code is a real parse error.
    #
    # Both GTK3 and GTK4 expose "parsing-error" — connect it in both. GTK4 is
    # the branch that NEEDS it: unlike GTK3 (which discards the whole sheet on
    # a bad rule — the WLOG-01 signature), GTK4 skips the offending rule and
    # keeps the rest, so the non-empty-provider check below can never fire for
    # it. Without this signal the GTK4 sheets get no detection at all.
    def _on_error(_provider, _section, error, _fatal=fatal):
        if error.code != 4:
            _fatal.append(error.message)

    provider.connect("parsing-error", _on_error)

    try:
        provider.load_from_path(path)
    except Exception as exc:  # the first fatal GError also raises here
        fatal.append(str(exc))

    css = provider.to_string()
    if fatal:
        print(f"FAIL\t{frag}\tfatal parse error: {fatal[0]}")
    elif not css:
        print(f"FAIL\t{frag}\tprovider is EMPTY — stylesheet discarded")
    else:
        print(f"PASS\t{frag}\t{len(css)} bytes")
PYEOF
}

if python3 -c "import gi" >/dev/null 2>&1; then
    while IFS=$'\t' read -r status frag detail; do
        [[ -z "$status" ]] && continue
        desc="CSS-parse: $frag ($detail)"
        case "$status" in
            SKIP) echo "  [SKIP] $desc" ;;
            PASS) check "$desc" "0" ;;
            *)    check "$desc" "1" ;;
        esac
    done < <(_theme_doctor_css_parse 3 "${GTK3_CSS_SHEETS[@]}")

    while IFS=$'\t' read -r status frag detail; do
        [[ -z "$status" ]] && continue
        desc="CSS-parse: $frag ($detail)"
        case "$status" in
            SKIP) echo "  [SKIP] $desc" ;;
            PASS) check "$desc" "0" ;;
            *)    check "$desc" "1" ;;
        esac
    done < <(_theme_doctor_css_parse 4 "${GTK4_CSS_SHEETS[@]}")
else
    echo "  [SKIP] GTK CSS-parse guard (python-gobject / gi not available)"
fi

# D-17's "full module re-test" (per-module CSS reachability + colour-
# resolution against the retired bar's layout configs, resolved through
# its own equivalence checker) is retired along with the surface it
# tested — the checker and the config family it resolved are both gone,
# and the surviving bar has no equivalent module/widget-id indirection
# for this gate to walk.

# The retired bar's compiled-sheet entrypoint guard (13-05 fix) and its
# design/token lint fold (08-15) are retired along with the surface they
# checked — both scripts they invoked are gone with the bar's own config
# family, and the surviving bar has no equivalent compiled-sheet naming
# convention for either check to walk.

# ── motion-lint fold (12-05, TOKEN-04) ──────────────────────────────────
# Same "green gates, broken bar" gap the retired design-lint fold above
# used to close, applied to motion: TOKEN-04 requires theme-doctor ITSELF to
# fail on a surface that hand-rolls a raw duration/easing value, not merely
# a standalone script someone has to remember to run. Every PASS/FAIL line
# folds into the tally the same way that retired fold did.
# [EXEMPT] and [WARN] lines are deliberately NOT folded — an exemption is
# acknowledged debt, not a passing check, and counting it as a PASS would
# make a gate that still sits over non-compliant surfaces read as green.
# Guarded-skip mirrors every other fold in this file: an unstowed hypr
# package degrades to SKIP, never a hard FAIL.
MOTION_LINT="$HOME/.config/hypr/scripts/motion-lint"
if [[ -x "$MOTION_LINT" ]]; then
    while IFS= read -r _ml_line; do
        case "$_ml_line" in
            *"[PASS]"*) check "motion-lint: ${_ml_line#*\[PASS\] }" "0" ;;
            *"[FAIL]"*) check "motion-lint: ${_ml_line#*\[FAIL\] }" "1" ;;
            *)          echo "  $_ml_line" ;;
        esac
    done < <("$MOTION_LINT" 2>/dev/null)
else
    echo "  [SKIP] motion-lint ($MOTION_LINT not found or not executable)"
fi

# ── hypr-equivalence-check fold (14-10 Task 3, MAINT-04) ─────────────────
# Same "green gates, broken bar" gap the two folds above close, now applied
# to the Hyprland Lua-migration equivalence proof — this gate's own absence
# from Phase 14's regression sweep is this task's reason for existing, and
# folding it here is what makes that coverage gap structurally unable to
# recur (nobody has to remember to run it standalone). Every PASS/FAIL line
# folds into the tally exactly like the two folds above; any other line
# (the ". <key>: type-key differs..." notes, or the leading baseline-path
# line) is passed through unfolded, the same discipline motion-lint's
# [EXEMPT]/[WARN] lines already use.
#
# UNLIKE the two folds above, which parse files on disk, this gate
# RE-DERIVES LIVE COMPOSITOR STATE (`hyprctl -j binds/animations/
# getoption`) — its own failure path for a failed live capture is a FAIL
# with a non-zero exit, NEVER a SKIP (D-10; an absent/unreadable baseline
# must never silently pass, and neither must an unreachable compositor). An
# UNGUARDED fold would therefore turn the headless fresh-install container
# gate red — no compositor exists there — regressing a shipped
# requirement. So this fold carries an ADDITIONAL guard neither sibling
# fold needs: a live Hyprland session, checked via
# `HYPRLAND_INSTANCE_SIGNATURE`. Proven live with that signature unset (see
# 14-10-SUMMARY.md): the new line reads SKIP, the tally is unchanged from a
# normal run's non-session checks, and the exit status is unaffected.
HYPR_EQUIVALENCE_CHECK="$HOME/.config/hypr/scripts/hypr-equivalence-check"
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && [[ -x "$HYPR_EQUIVALENCE_CHECK" ]]; then
    while IFS= read -r _hec_line; do
        case "$_hec_line" in
            *"[PASS]"*) check "hypr-equivalence-check: ${_hec_line#*\[PASS\] }" "0" ;;
            *"[FAIL]"*) check "hypr-equivalence-check: ${_hec_line#*\[FAIL\] }" "1" ;;
        esac
    done < <("$HYPR_EQUIVALENCE_CHECK" 2>/dev/null)
else
    echo "  [SKIP] hypr-equivalence-check (no live Hyprland session — HYPRLAND_INSTANCE_SIGNATURE unset — or $HYPR_EQUIVALENCE_CHECK not found/executable)"
fi

# ── colour-lint fold (18-03, GATE-04, D-18-35) ───────────────────────────
# Same "green gates, broken bar" gap the retired design-lint fold and the
# motion-lint fold above close, applied to QML hard-coded colours: GATE-04
# requires theme-doctor ITSELF to fail on a QML surface hard-coding a colour, not
# merely a standalone script someone has to remember to run. Every
# PASS/FAIL line folds into the tally exactly like the folds above.
# [EXEMPT] lines are deliberately NOT folded — an exemption is
# acknowledged debt, not a passing check, and counting it as a PASS would
# make a gate that still sits over non-compliant surfaces read as green
# (same discipline motion-lint's fold above already states). Guarded-skip
# mirrors the folds above: an unstowed hypr package degrades to SKIP,
# never a hard FAIL.
#
# UNLIKE the hypr-equivalence-check fold immediately above, this fold
# needs NO live-session guard: colour-lint reads files on disk and never
# touches the compositor, so it must stay unguarded and therefore still
# runs in a headless fresh-install container.
COLOUR_LINT="$HOME/.config/hypr/scripts/colour-lint"
if [[ -x "$COLOUR_LINT" ]]; then
    while IFS= read -r _cl_line; do
        case "$_cl_line" in
            *"[PASS]"*) check "colour-lint: ${_cl_line#*\[PASS\] }" "0" ;;
            *"[FAIL]"*) check "colour-lint: ${_cl_line#*\[FAIL\] }" "1" ;;
            *)          echo "  $_cl_line" ;;
        esac
    done < <("$COLOUR_LINT" 2>/dev/null)
else
    echo "  [SKIP] colour-lint ($COLOUR_LINT not found or not executable)"
fi

# ── retirement-check fold (18-06, RETIRE-01/D-18-35) ───────────────────
# Same "green gates, broken surface" gap the retired design-lint fold and
# the motion-lint/colour-lint folds above close, applied to retirement: an
# orphaned retired-widget-daemon stylesheet contract entry blocked
# theme-doctor for a full milestone because no gate enforced this class
# (WINDOWS #1) — folding retirement-check's
# blocking tier in HERE means that class of miss cannot recur unnoticed,
# rather than depending on someone remembering to run the standalone
# script. Every [PASS]/[FAIL] line folds into the tally exactly like the
# folds above; [REPORT] and [SKIP] lines pass through unfolded via the bare
# `*)` arm, matching the motion-lint fold's own third arm (theme-doctor
# line ~698) — this is D-18-37's tier split expressed at the fold boundary,
# not only inside the script itself.
#
# Every real surface shipped `pending` when this fold was written (see
# 18-06-PLAN's Measured ground truth table), so retirement-check --all
# contributed ONLY [REPORT] lines for those seven surfaces plus the
# self-test registry row's own [PASS] lines — the tally stayed unchanged
# by this fold until 18-20 flipped the first surface's registry row to
# `retired` in the same commit as its deletion, which is what makes this
# fold's [PASS]/[FAIL] lines mean something for the first time. Guarded-skip
# mirrors the folds above: an unstowed hypr package degrades to SKIP, never
# a hard FAIL.
#
# NOTE for future editors: never spell out the checker's own self-test
# surface token literally in this file's prose — theme-doctor is itself a
# retirement-check checker-internals scan target, so the literal token
# reads back as a stray self-reference and fails its own gate.
# RETIREMENT_CHECK honours an existing env override (unlike the
# hardcoded-path folds above) so the guarded-skip degradation path itself
# stays provable via RETIREMENT_CHECK=/nonexistent, the same "a gate that
# cannot be pointed off cannot be proven to degrade" discipline this
# script's own --root argument already applies to fixture pointing.
RETIREMENT_CHECK="${RETIREMENT_CHECK:-$HOME/.config/hypr/scripts/retirement-check}"
if [[ -x "$RETIREMENT_CHECK" ]]; then
    while IFS= read -r _rc_line; do
        case "$_rc_line" in
            *"[PASS]"*) check "retirement-check: ${_rc_line#*\[PASS\] }" "0" ;;
            *"[FAIL]"*) check "retirement-check: ${_rc_line#*\[FAIL\] }" "1" ;;
            *)          echo "  $_rc_line" ;;
        esac
    done < <("$RETIREMENT_CHECK" --all 2>/dev/null)
else
    echo "  [SKIP] retirement-check ($RETIREMENT_CHECK not found or not executable)"
fi

# ── stow-link-check fold (22-02, RETIRE-09/D-22-06) ─────────────────────
# SC-2's symlink clause ("no dangling reference exists anywhere in the
# reproduced system") had no mechanism anywhere in this repo before this
# fold — the same "green gates, broken surface" gap the folds above close,
# applied to dangling symlinks under every stow-created target. Every
# [PASS]/[FAIL] line folds into the tally exactly like the folds above;
# [SKIP]/[EXEMPT] lines pass through unfolded via the bare `*)` arm, the
# same D-18-37 tier-split discipline the retirement-check fold above
# already applies.
#
# UNLIKE the hypr-equivalence-check fold, this checker reads files on disk
# and never touches the compositor, so it carries NO live-session guard —
# it must stay unguarded so it actually runs inside a headless fresh-
# install container (this is precisely what makes plan 22-04's container
# step possible; a live-session gate here would make the new checker
# silently skip in the one environment that matters).
#
# STOW_LINK_CHECK honours an existing env override (the retirement-check
# fold's own precedent) so the guarded-skip degradation path itself stays
# provable via STOW_LINK_CHECK=/nonexistent.
STOW_LINK_CHECK="${STOW_LINK_CHECK:-$HOME/.config/hypr/scripts/stow-link-check}"
if [[ -x "$STOW_LINK_CHECK" ]]; then
    while IFS= read -r _slc_line; do
        case "$_slc_line" in
            *"[PASS]"*) check "stow-link-check: ${_slc_line#*\[PASS\] }" "0" ;;
            *"[FAIL]"*) check "stow-link-check: ${_slc_line#*\[FAIL\] }" "1" ;;
            *)          echo "  $_slc_line" ;;
        esac
    done < <("$STOW_LINK_CHECK" 2>/dev/null)
else
    echo "  [SKIP] stow-link-check ($STOW_LINK_CHECK not found or not executable)"
fi

# ── CLEAN-02 permanent invariant (D-50): repo stays clean after a theme
#    switch. Guarded-skip mirrors the stow-conflict check above — this must
#    degrade gracefully, not FAIL, when git or the repo itself is absent
#    (e.g. a fresh-install container that never cloned the dotfiles repo). ─
if command -v git >/dev/null 2>&1 && [[ -d "$DOTFILES_DIR/.git" ]]; then
    GIT_DIRTY_OUTPUT=$(git -C "$DOTFILES_DIR" status --porcelain 2>/dev/null)
    [[ -z "$GIT_DIRTY_OUTPUT" ]]
    check "git status --porcelain is empty ($DOTFILES_DIR stays clean)" "$?"
else
    echo "  [SKIP] git status --porcelain ($DOTFILES_DIR/.git or git not found)"
fi

echo ""
echo "Summary: ${PASS} passed, ${FAIL} failed"
[[ "$FAIL" -eq 0 ]]
exit $?

#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║              THEME-DOCTOR (D-25)                     ║
# ║  Rerunnable health check for the theme-engine's core  ║
# ║  invariants. Report-only — never mutates state.       ║
# ╚══════════════════════════════════════════════════════╝

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
STATE_DIR="$HOME/.local/state/theme"
DOTFILES_DIR="$HOME/dotfiles"

# shellcheck source=lib/contract.sh
source "$SCRIPT_DIR/lib/contract.sh"

PASS=0
FAIL=0

check() {
    local desc="$1"
    local ok="$2"
    if [[ "$ok" == "0" ]]; then
        echo "  [PASS] $desc"
        PASS=$((PASS + 1))
    else
        echo "  [FAIL] $desc"
        FAIL=$((FAIL + 1))
    fi
}

echo "theme-doctor — theme-engine health check"
echo ""

# ── adw-gtk-theme installed (THEME-02 root cause) ──────────
pacman -Q adw-gtk-theme >/dev/null 2>&1
check "adw-gtk-theme package installed" "$?"

# ── gsettings resolves to the mode-correct adw theme ───────
# Read the committed mode marker — the same source of truth gtk.sh uses to
# decide between adw-gtk3-dark and adw-gtk3. Hardcoding the dark name here
# made this check FAIL on every one of Phase 05's six light presets, i.e. on
# a perfectly healthy desktop.
DOCTOR_MODE=$(cat "$STATE_DIR/mode" 2>/dev/null || echo "dark")
EXPECTED_GTK_THEME="adw-gtk3-dark"
[[ "$DOCTOR_MODE" == "light" ]] && EXPECTED_GTK_THEME="adw-gtk3"

GTK_THEME_VALUE=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")
[[ "$GTK_THEME_VALUE" == "$EXPECTED_GTK_THEME" ]]
check "gsettings gtk-theme = $EXPECTED_GTK_THEME (mode=$DOCTOR_MODE, got: ${GTK_THEME_VALUE:-<unset>})" "$?"

# ── state-dir contract present ──────────────────────────────
[[ -f "$STATE_DIR/current-theme" ]]
check "$STATE_DIR/current-theme exists" "$?"

# D-30: file list sourced from contract.json (single source of truth,
# shared with theme-parity) instead of a hardcoded loop. An empty list
# (jq missing, contract.json unreadable) must surface as a loud FAIL —
# not ten per-file checks silently vanishing from the output.
CONTRACT_FILE_LIST="$(contract_files)"
if [[ -z "$CONTRACT_FILE_LIST" ]]; then
    check "contract.json file list readable and non-empty (jq present)" "1"
else
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        [[ -f "$STATE_DIR/$f" ]]
        check "$STATE_DIR/$f exists" "$?"
    done <<< "$CONTRACT_FILE_LIST"
fi

# WR-07: theme-invariant font render targets (kitty-font.conf,
# waybar-font.css) get a presence-only check — they are excluded from the
# color-contract `files` array above (theme-parity's parity checks require
# color-declaration content these font fragments do not have).
PRESENCE_ONLY_FILE_LIST="$(contract_presence_only_files)"
if [[ -n "$PRESENCE_ONLY_FILE_LIST" ]]; then
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        [[ -f "$STATE_DIR/$f" ]]
        check "$STATE_DIR/$f exists" "$?"
    done <<< "$PRESENCE_ONLY_FILE_LIST"
fi

# ── D-29 state-manifest gate: every entry directly under $STATE_DIR is
#    accounted for by contract.json — a files[].name, a
#    state_metadata_files entry, a presence_only_files entry, or a
#    declared engine_owned_files path. An unaccounted file is exactly the
#    silent-drift/data-loss bug class the engine_owned_files array exists
#    to close (D-29) — this converts it from something discovered weeks
#    later into an immediate, actionable gate failure that names the
#    file. Degrades to a named [SKIP], never [FAIL], when jq is
#    unavailable or $STATE_DIR doesn't exist yet (fresh install before the
#    first theme-apply) — same discipline as every other guarded check in
#    this file.
if command -v jq >/dev/null 2>&1 && [[ -d "$STATE_DIR" ]]; then
    KNOWN_STATE_ENTRIES="$( { contract_files; contract_presence_only_files; contract_state_metadata_files; contract_engine_owned_files; } 2>/dev/null | sort -u)"
    if [[ -z "$KNOWN_STATE_ENTRIES" ]]; then
        check "state-manifest: contract.json's declared file lists are readable (jq present, file non-empty)" "1"
    else
        UNACCOUNTED=""
        EXAMINED=0
        while IFS= read -r entry; do
            [[ -z "$entry" ]] && continue
            EXAMINED=$((EXAMINED + 1))
            if ! printf '%s\n' "$KNOWN_STATE_ENTRIES" | grep -qx "$entry"; then
                UNACCOUNTED="$UNACCOUNTED $entry"
            fi
        done < <(find "$STATE_DIR" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null)
        UNACCOUNTED="$(echo "$UNACCOUNTED" | xargs)"
        [[ -z "$UNACCOUNTED" ]]
        check "state-manifest: all $EXAMINED entries under $STATE_DIR accounted for (unaccounted: ${UNACCOUNTED:-none})" "$?"
    fi
else
    echo "  [SKIP] state-manifest gate (jq not found or $STATE_DIR does not exist)"
fi

# ── walker/yazi wiring symlinks point at the state dir ─────
[[ -L "$HOME/.config/walker/themes/rice/style.css" ]] \
    && [[ "$(readlink -f "$HOME/.config/walker/themes/rice/style.css")" == "$STATE_DIR/walker-style.css" ]]
check "walker style.css symlinked to state dir" "$?"

[[ -L "$HOME/.config/yazi/theme.toml" ]] \
    && [[ "$(readlink -f "$HOME/.config/yazi/theme.toml")" == "$STATE_DIR/yazi.toml" ]]
check "yazi theme.toml symlinked to state dir" "$?"

# ── no stow conflicts for theme-engine (or the repo isn't
#    positioned as $HOME/dotfiles — skip gracefully) ────────
if command -v stow >/dev/null 2>&1 && [[ -d "$DOTFILES_DIR/theme-engine" ]]; then
    (cd "$DOTFILES_DIR" && stow -n theme-engine >/dev/null 2>/tmp/theme-doctor-stow.log)
    check "stow -n theme-engine reports no conflicts" "$?"
else
    echo "  [SKIP] stow -n theme-engine (stow or $DOTFILES_DIR/theme-engine not found)"
fi

# ── walker/elephant health + version-match + provider parity ───────
#    (THEME-01, SCAN-02, D-25). No documented version-pin/compat matrix
#    exists between walker and elephant (RESEARCH "Version compatibility"
#    table — both are independently versioned by the same upstream
#    author, no pin mechanism in install.sh); a responsive `elephant
#    version` alongside a running walker binary is the practical
#    compatibility signal available.
WALKER_CONFIG="$HOME/.config/walker/config.toml"

if command -v elephant >/dev/null 2>&1; then
    ELEPHANT_VERSION=$(elephant version 2>/dev/null)
    [[ -n "$ELEPHANT_VERSION" ]]
    check "elephant version responds (got: ${ELEPHANT_VERSION:-<empty>})" "$?"

    elephant listproviders >/dev/null 2>&1
    check "elephant listproviders responds" "$?"
else
    echo "  [FAIL] elephant binary not found"
    FAIL=$((FAIL + 1))
    echo "  [FAIL] elephant listproviders responds"
    FAIL=$((FAIL + 1))
fi

if command -v walker >/dev/null 2>&1; then
    WALKER_VERSION=$(walker --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    [[ -n "$WALKER_VERSION" ]]
    check "walker version responds (got: ${WALKER_VERSION:-<empty>})" "$?"
else
    echo "  [FAIL] walker binary not found"
    FAIL=$((FAIL + 1))
fi

pgrep -x walker >/dev/null 2>&1
check "walker process running" "$?"

pgrep -x elephant >/dev/null 2>&1
check "elephant process running" "$?"

# Provider parity: compare `elephant listproviders` (active) against every
# provider walker/config.toml actually references — the `[providers]
# default` array and every `[[providers.prefixes]]` entry (Pitfall W2).
# This check is strict (D-66): every configured provider must actually be
# active. The one exception is `menus`, which is data-driven — elephant
# only ever publishes it as `menus:<filename>` once a menu file exists
# under ~/.config/elephant/menus/, never the bare string "menus" (Pattern
# 3). With zero menu files in v1 (MENU-01/02/03 are v2-deferred), the
# correct, cheapest signal that the provider is genuinely available is the
# elephant-menus PACKAGE being installed — no placeholder menu file is
# seeded to force a `menus:*` entry to appear.
if command -v elephant >/dev/null 2>&1 && [[ -f "$WALKER_CONFIG" ]]; then
    ACTIVE_PROVIDERS=$(elephant listproviders 2>/dev/null)
    CONFIGURED_PROVIDERS=$(awk '
        /^default[[:space:]]*=[[:space:]]*\[/{inarr=1}
        inarr{print}
        inarr && /\]/{inarr=0}
        /provider[[:space:]]*=[[:space:]]*"/{print}
    ' "$WALKER_CONFIG" | grep -oE '"[a-zA-Z_]+"' | tr -d '"' | sort -u)

    MISSING=""
    for p in $CONFIGURED_PROVIDERS; do
        if [[ "$p" == "menus" ]]; then
            if printf '%s\n' "$ACTIVE_PROVIDERS" | grep -q '^menus:' || pacman -Q elephant-menus >/dev/null 2>&1; then
                continue
            fi
        elif printf '%s\n' "$ACTIVE_PROVIDERS" | grep -qx "$p"; then
            continue
        fi
        MISSING="$MISSING $p"
    done
    MISSING="$(echo "$MISSING" | xargs)"
    [[ -z "$MISSING" ]]
    check "elephant listproviders covers all configured walker providers (missing: ${MISSING:-none})" "$?"
else
    echo "  [SKIP] elephant/walker provider parity ($WALKER_CONFIG or elephant not found)"
fi

# ── GTK CSS-parse regression guard (WLOG-01, CR-01 permanent fix) ──────
# Runs every GTK-consumed stylesheet the theme pipeline owns through a
# REAL GTK CssProvider parse. Four prior verification rounds all reported
# PASS while the retired GTK3 power-menu engine's stylesheet was silently
# discarded in full by GTK3 — a grep for the `@import` line cannot see
# that. The load-bearing
# signal here is an EMPTY provider, not merely a parse error: on GTK
# 3.24.52 a single generated-content ruleset makes GTK throw away the
# WHOLE stylesheet (0 bytes), not just the offending rule. A deprecation
# (GTK3 GError domain gtk-css-provider-error-quark code 4 — e.g.
# style-floating.css's unitless border-radius, IN-02/deferred) is
# non-fatal and must still PASS. Deployed paths only ($HOME/.config/...)
# — the stow files' relative @import only resolves from there, never
# from the repo copy. GTK3 and GTK4 cannot share a python3 process
# (gi.require_version conflict), so this runs as two separate
# invocations. Never calls Gtk.init() — CssProvider needs no display,
# and init() would require one, breaking the headless verify gate.
#    D-31/D-32's disk-truth principle, applied here per RESEARCH's own
#    finding: this array used to hardcode the waybar layout stylesheets
#    one by one — the same copy-paste-drift pattern already killed in
#    waybar-switch.sh/waybar-launch.sh (D-32), sitting in a 4th place. A
#    5th waybar layout must be covered by this guard with zero edit to
#    this script, so the waybar entries are discovered by glob and
#    appended to the non-waybar sheets, which stay explicit (they are
#    not a family and have no enumeration to derive). Guarded with
#    nullglob so an unstowed waybar package degrades to the per-sheet
#    SKIP below, never an unexpanded literal pattern handed to the parser.
GTK3_CSS_SHEETS=(
    "$HOME/.config/gtk-3.0/gtk.css"
    "$HOME/.config/swaync/style.css"
)
shopt -s nullglob
WAYBAR_STYLE_SHEETS=("$HOME/.config/waybar"/style-*.css)
shopt -u nullglob
GTK3_CSS_SHEETS+=("${WAYBAR_STYLE_SHEETS[@]}")
GTK4_CSS_SHEETS=(
    "$HOME/.config/gtk-4.0/gtk.css"
    "$HOME/.config/swayosd/style.css"
    "$HOME/.config/walker/themes/rice/style.css"
    "$HOME/.config/wleave/style.css"
)

_theme_doctor_css_parse() {
    # $1 = GTK major version ("3" or "4"), rest = deployed stylesheet
    # paths. Prints one "STATUS<TAB>path-fragment<TAB>reason" line per
    # sheet. stderr redirected to swallow GTK's own noisy Gtk-WARNING
    # chatter — the structured stdout lines are the signal.
    local major="$1"
    shift
    python3 - "$major" "$@" <<'PYEOF' 2>/dev/null
import os
import sys

major = sys.argv[1]
paths = sys.argv[2:]

import gi
gi.require_version("Gtk", major + ".0")
from gi.repository import Gtk

home_config = os.path.join(os.path.expanduser("~"), ".config")

for path in paths:
    try:
        frag = os.path.relpath(path, home_config)
    except ValueError:
        frag = path

    if not os.path.isfile(path):
        print(f"SKIP\t{frag}\tnot deployed under ~/.config — run stow.sh")
        continue

    provider = Gtk.CssProvider()
    fatal = []

    # gtk-css-provider-error-quark code 4 == deprecation (non-fatal, provider
    # retained); any other code is a real parse error.
    #
    # Both GTK3 and GTK4 expose "parsing-error" — connect it in both. GTK4 is
    # the branch that NEEDS it: unlike GTK3 (which discards the whole sheet on
    # a bad rule — the WLOG-01 signature), GTK4 skips the offending rule and
    # keeps the rest, so the non-empty-provider check below can never fire for
    # it. Without this signal the GTK4 sheets get no detection at all.
    def _on_error(_provider, _section, error, _fatal=fatal):
        if error.code != 4:
            _fatal.append(error.message)

    provider.connect("parsing-error", _on_error)

    try:
        provider.load_from_path(path)
    except Exception as exc:  # the first fatal GError also raises here
        fatal.append(str(exc))

    css = provider.to_string()
    if fatal:
        print(f"FAIL\t{frag}\tfatal parse error: {fatal[0]}")
    elif not css:
        print(f"FAIL\t{frag}\tprovider is EMPTY — stylesheet discarded")
    else:
        print(f"PASS\t{frag}\t{len(css)} bytes")
PYEOF
}

if python3 -c "import gi" >/dev/null 2>&1; then
    while IFS=$'\t' read -r status frag detail; do
        [[ -z "$status" ]] && continue
        desc="CSS-parse: $frag ($detail)"
        case "$status" in
            SKIP) echo "  [SKIP] $desc" ;;
            PASS) check "$desc" "0" ;;
            *)    check "$desc" "1" ;;
        esac
    done < <(_theme_doctor_css_parse 3 "${GTK3_CSS_SHEETS[@]}")

    while IFS=$'\t' read -r status frag detail; do
        [[ -z "$status" ]] && continue
        desc="CSS-parse: $frag ($detail)"
        case "$status" in
            SKIP) echo "  [SKIP] $desc" ;;
            PASS) check "$desc" "0" ;;
            *)    check "$desc" "1" ;;
        esac
    done < <(_theme_doctor_css_parse 4 "${GTK4_CSS_SHEETS[@]}")
else
    echo "  [SKIP] GTK CSS-parse guard (python-gobject / gi not available)"
fi

# ── D-17: per-module CSS reachability + colour-resolution gate ─────────
# Folds D-17's "full module re-test" into a rerunnable, mechanical check
# instead of a human eyeballing four bars under N palettes. For every
# deployed waybar config-*.jsonc, resolves the layout's REAL module list
# through waybar-equivalence-check --resolve (08-01's one JSONC/include
# parser — no second one is written here), flattens that layout's own
# stylesheet through the same live GTK3 CssProvider used by the CSS-parse
# guard above, and asserts:
#   1. every module has a reachable CSS rule (word-boundary match on its
#      waybar-assigned widget id) — the "silently unstyled module" half
#      of the Phase-1 battery/backlight bug;
#   2. every @token the flattened sheet references is @define-color'd
#      somewhere in that same flattened output — the load-bearing half.
#      Verified live during planning (GTK 3.24.52): a rule referencing an
#      UNDEFINED named colour raises NO parsing-error and yields a
#      NON-EMPTY provider — the exact blind spot the guard above cannot
#      see, because its only two signals (fatal error, empty provider)
#      are both silent for this failure class.
# Never calls Gtk.init() (CssProvider needs no display — same headless-
# safe discipline as _theme_doctor_css_parse above). Degrades to [SKIP],
# never [FAIL], on any missing optional dependency (python3-gi absent,
# waybar-equivalence-check absent, waybar package not stowed) — P7 D-34's
# "container gate stays green and unattended" invariant.
WAYBAR_EQUIV_CHECK="$HOME/.config/hypr/scripts/waybar-equivalence-check"
WAYBAR_DIR_FOR_GATE="$HOME/.config/waybar"

_theme_doctor_module_gate() {
    python3 - "$WAYBAR_EQUIV_CHECK" "$WAYBAR_DIR_FOR_GATE" <<'PYEOF' 2>/dev/null
import glob
import json
import os
import re
import subprocess
import sys

equiv_check = sys.argv[1]
waybar_dir = sys.argv[2]

if not os.path.isfile(equiv_check):
    print("SKIP\t(all layouts)\twaybar-equivalence-check not found under ~/.config/hypr/scripts — cannot resolve configs")
    sys.exit(0)

configs = sorted(glob.glob(os.path.join(waybar_dir, "config-*.jsonc")))
if not configs:
    print(f"SKIP\t(all layouts)\tno config-*.jsonc found under {waybar_dir} — run stow.sh")
    sys.exit(0)

try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk
except Exception as exc:
    print(f"SKIP\t(all layouts)\tpython3-gi not available: {exc}")
    sys.exit(0)

# CSS at-rule keywords that share the "@ident" shape with a named-colour
# reference but are never a colour token — excluded from Assertion 2.
AT_RULE_KEYWORDS = {"import", "define-color", "media", "keyframes", "supports", "charset"}


def module_to_id(name):
    """waybar's own widget-id assignment rule: a compositor-namespaced
    module (hyprland/*, sway/*, river/*, wlr/*) is identified by its LAST
    segment; every other slash-bearing name replaces '/' with '-'; a bare
    name is its own id."""
    if "/" in name:
        prefix = name.split("/")[0]
        if prefix in ("hyprland", "sway", "river", "wlr"):
            return "#" + name.split("/")[-1]
        return "#" + name.replace("/", "-")
    return "#" + name


for config_path in configs:
    layout = os.path.basename(config_path)[len("config-"):-len(".jsonc")]
    style_path = os.path.join(waybar_dir, f"style-{layout}.css")

    if not os.path.isfile(style_path):
        print(f"SKIP\t{layout}\tstyle-{layout}.css not deployed under {waybar_dir}")
        continue

    try:
        resolved_proc = subprocess.run(
            [equiv_check, "--resolve", config_path],
            capture_output=True, text=True, timeout=10,
        )
    except Exception as exc:
        print(f"SKIP\t{layout}\twaybar-equivalence-check --resolve failed to run: {exc}")
        continue

    if resolved_proc.returncode != 0:
        print(f"SKIP\t{layout}\twaybar-equivalence-check --resolve exited {resolved_proc.returncode}")
        continue

    try:
        resolved = json.loads(resolved_proc.stdout)
    except Exception as exc:
        print(f"SKIP\t{layout}\tcould not parse --resolve JSON output: {exc}")
        continue

    modules = []
    for arr_key in ("modules-left", "modules-center", "modules-right"):
        modules += resolved.get(arr_key, []) or []

    provider = Gtk.CssProvider()
    fatal = []

    def _on_error(_provider, _section, error, _fatal=fatal):
        if error.code != 4:
            _fatal.append(error.message)

    provider.connect("parsing-error", _on_error)
    try:
        provider.load_from_path(style_path)
    except Exception as exc:
        fatal.append(str(exc))
    css = provider.to_string()

    if fatal or not css:
        print(f"SKIP\t{layout}\tstylesheet failed to parse or is empty — already reported by the CSS-parse guard above")
        continue

    # Gate self-check (once per layout, cheap): the flattening primitive
    # this whole gate relies on must actually have inlined the @import
    # chain. If either signal is missing, the flattening assumption this
    # gate depends on is false for this run — fail loudly rather than
    # silently passing on an unflattened (and therefore untested) sheet.
    if "@define-color" not in css:
        print(f"FAIL\t{layout}\tflattened stylesheet has no @define-color — @import chain did not inline as expected")
        continue

    # Assertion 1 — rule reachability, word-boundary matched so "#cpu"
    # cannot be satisfied by a "#cpu-foo" rule.
    for mod in modules:
        widget_id = module_to_id(mod)
        pattern = re.compile(re.escape(widget_id) + r"(?![-\w])")
        if pattern.search(css):
            print(f"PASS\t{layout}\treachable: {mod} -> {widget_id}")
        else:
            print(f"FAIL\t{layout}\tno reachable CSS rule for module '{mod}' (widget id {widget_id})")

    # Assertion 2 — colour resolution (HARD FAIL). Every @token the
    # flattened sheet references must be declared by an @define-color
    # somewhere in that same flattened output.
    referenced = set(re.findall(r"@([A-Za-z_][A-Za-z0-9_-]*)", css))
    referenced -= AT_RULE_KEYWORDS
    defined = set(re.findall(r"@define-color\s+([A-Za-z_][A-Za-z0-9_-]*)", css))
    unresolved = sorted(referenced - defined)
    if unresolved:
        print(f"FAIL\t{layout}\tunresolved colour token(s): {', '.join(unresolved)}")
    else:
        print(f"PASS\t{layout}\tall {len(referenced)} referenced colour token(s) resolved")
PYEOF
}

if python3 -c "import gi" >/dev/null 2>&1; then
    while IFS=$'\t' read -r status layout detail; do
        [[ -z "$status" ]] && continue
        desc="D-17 module-gate: $layout ($detail)"
        case "$status" in
            SKIP) echo "  [SKIP] $desc" ;;
            PASS) check "$desc" "0" ;;
            *)    check "$desc" "1" ;;
        esac
    done < <(_theme_doctor_module_gate)
else
    echo "  [SKIP] D-17 module-gate (python-gobject / gi not available)"
fi

# ── waybar-design-lint fold (08-15) ───────────────────────────────────
# The design/token gate (transparent window, role-names-only, no literal
# hex, no empty glyphs, token resolution) that would have caught the 08-12
# UAT failure now runs on EVERY theme-doctor invocation, not only when
# someone remembers the standalone script — that "green gates, broken bar"
# gap is exactly what this phase closes. Each of its per-check results is
# surfaced as a theme-doctor line and folds into the pass/fail tally.
# Guarded-skip mirrors the other waybar sections: an unstowed waybar
# package degrades to SKIP, never a hard FAIL.
WAYBAR_DESIGN_LINT="$HOME/.config/hypr/scripts/waybar-design-lint"
if [[ -x "$WAYBAR_DESIGN_LINT" ]]; then
    while IFS= read -r _dl_line; do
        case "$_dl_line" in
            *"[PASS]"*) check "design-lint: ${_dl_line#*\[PASS\] }" "0" ;;
            *"[FAIL]"*) check "design-lint: ${_dl_line#*\[FAIL\] }" "1" ;;
        esac
    done < <("$WAYBAR_DESIGN_LINT" 2>/dev/null)
else
    echo "  [SKIP] waybar-design-lint ($WAYBAR_DESIGN_LINT not found or not executable)"
fi

# ── CLEAN-02 permanent invariant (D-50): repo stays clean after a theme
#    switch. Guarded-skip mirrors the stow-conflict check above — this must
#    degrade gracefully, not FAIL, when git or the repo itself is absent
#    (e.g. a fresh-install container that never cloned the dotfiles repo). ─
if command -v git >/dev/null 2>&1 && [[ -d "$DOTFILES_DIR/.git" ]]; then
    GIT_DIRTY_OUTPUT=$(git -C "$DOTFILES_DIR" status --porcelain 2>/dev/null)
    [[ -z "$GIT_DIRTY_OUTPUT" ]]
    check "git status --porcelain is empty ($DOTFILES_DIR stays clean)" "$?"
else
    echo "  [SKIP] git status --porcelain ($DOTFILES_DIR/.git or git not found)"
fi

echo ""
echo "Summary: ${PASS} passed, ${FAIL} failed"
[[ "$FAIL" -eq 0 ]]
exit $?

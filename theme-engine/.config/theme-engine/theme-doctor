#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║              THEME-DOCTOR (D-25)                     ║
# ║  Rerunnable health check for the theme-engine's core  ║
# ║  invariants. Report-only — never mutates state.       ║
# ╚══════════════════════════════════════════════════════╝

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
STATE_DIR="$HOME/.local/state/theme"
DOTFILES_DIR="$HOME/dotfiles"

# shellcheck source=lib/contract.sh
source "$SCRIPT_DIR/lib/contract.sh"

PASS=0
FAIL=0

check() {
    local desc="$1"
    local ok="$2"
    if [[ "$ok" == "0" ]]; then
        echo "  [PASS] $desc"
        PASS=$((PASS + 1))
    else
        echo "  [FAIL] $desc"
        FAIL=$((FAIL + 1))
    fi
}

echo "theme-doctor — theme-engine health check"
echo ""

# ── adw-gtk-theme installed (THEME-02 root cause) ──────────
pacman -Q adw-gtk-theme >/dev/null 2>&1
check "adw-gtk-theme package installed" "$?"

# ── gsettings resolves to the expected adw theme ───────────
GTK_THEME_VALUE=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")
[[ "$GTK_THEME_VALUE" == "adw-gtk3-dark" ]]
check "gsettings gtk-theme = adw-gtk3-dark (got: ${GTK_THEME_VALUE:-<unset>})" "$?"

# ── state-dir contract present ──────────────────────────────
[[ -f "$STATE_DIR/current-theme" ]]
check "$STATE_DIR/current-theme exists" "$?"

# D-30: file list sourced from contract.json (single source of truth,
# shared with theme-parity) instead of a hardcoded loop. An empty list
# (jq missing, contract.json unreadable) must surface as a loud FAIL —
# not ten per-file checks silently vanishing from the output.
CONTRACT_FILE_LIST="$(contract_files)"
if [[ -z "$CONTRACT_FILE_LIST" ]]; then
    check "contract.json file list readable and non-empty (jq present)" "1"
else
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        [[ -f "$STATE_DIR/$f" ]]
        check "$STATE_DIR/$f exists" "$?"
    done <<< "$CONTRACT_FILE_LIST"
fi

# WR-07: theme-invariant font render targets (kitty-font.conf,
# waybar-font.css) get a presence-only check — they are excluded from the
# color-contract `files` array above (theme-parity's parity checks require
# color-declaration content these font fragments do not have).
PRESENCE_ONLY_FILE_LIST="$(contract_presence_only_files)"
if [[ -n "$PRESENCE_ONLY_FILE_LIST" ]]; then
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        [[ -f "$STATE_DIR/$f" ]]
        check "$STATE_DIR/$f exists" "$?"
    done <<< "$PRESENCE_ONLY_FILE_LIST"
fi

# ── walker/yazi wiring symlinks point at the state dir ─────
[[ -L "$HOME/.config/walker/themes/rice/style.css" ]] \
    && [[ "$(readlink -f "$HOME/.config/walker/themes/rice/style.css")" == "$STATE_DIR/walker-style.css" ]]
check "walker style.css symlinked to state dir" "$?"

[[ -L "$HOME/.config/yazi/theme.toml" ]] \
    && [[ "$(readlink -f "$HOME/.config/yazi/theme.toml")" == "$STATE_DIR/yazi.toml" ]]
check "yazi theme.toml symlinked to state dir" "$?"

# ── no stow conflicts for theme-engine (or the repo isn't
#    positioned as $HOME/dotfiles — skip gracefully) ────────
if command -v stow >/dev/null 2>&1 && [[ -d "$DOTFILES_DIR/theme-engine" ]]; then
    (cd "$DOTFILES_DIR" && stow -n theme-engine >/dev/null 2>/tmp/theme-doctor-stow.log)
    check "stow -n theme-engine reports no conflicts" "$?"
else
    echo "  [SKIP] stow -n theme-engine (stow or $DOTFILES_DIR/theme-engine not found)"
fi

# ── walker/elephant health + version-match + provider parity ───────
#    (THEME-01, SCAN-02, D-25). No documented version-pin/compat matrix
#    exists between walker and elephant (RESEARCH "Version compatibility"
#    table — both are independently versioned by the same upstream
#    author, no pin mechanism in install.sh); a responsive `elephant
#    version` alongside a running walker binary is the practical
#    compatibility signal available.
WALKER_CONFIG="$HOME/.config/walker/config.toml"

if command -v elephant >/dev/null 2>&1; then
    ELEPHANT_VERSION=$(elephant version 2>/dev/null)
    [[ -n "$ELEPHANT_VERSION" ]]
    check "elephant version responds (got: ${ELEPHANT_VERSION:-<empty>})" "$?"

    elephant listproviders >/dev/null 2>&1
    check "elephant listproviders responds" "$?"
else
    echo "  [FAIL] elephant binary not found"
    FAIL=$((FAIL + 1))
    echo "  [FAIL] elephant listproviders responds"
    FAIL=$((FAIL + 1))
fi

if command -v walker >/dev/null 2>&1; then
    WALKER_VERSION=$(walker --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    [[ -n "$WALKER_VERSION" ]]
    check "walker version responds (got: ${WALKER_VERSION:-<empty>})" "$?"
else
    echo "  [FAIL] walker binary not found"
    FAIL=$((FAIL + 1))
fi

pgrep -x walker >/dev/null 2>&1
check "walker process running" "$?"

pgrep -x elephant >/dev/null 2>&1
check "elephant process running" "$?"

# Provider parity: compare `elephant listproviders` (active) against every
# provider walker/config.toml actually references — the `[providers]
# default` array and every `[[providers.prefixes]]` entry (Pitfall W2).
# This check is strict (D-66): every configured provider must actually be
# active. The one exception is `menus`, which is data-driven — elephant
# only ever publishes it as `menus:<filename>` once a menu file exists
# under ~/.config/elephant/menus/, never the bare string "menus" (Pattern
# 3). With zero menu files in v1 (MENU-01/02/03 are v2-deferred), the
# correct, cheapest signal that the provider is genuinely available is the
# elephant-menus PACKAGE being installed — no placeholder menu file is
# seeded to force a `menus:*` entry to appear.
if command -v elephant >/dev/null 2>&1 && [[ -f "$WALKER_CONFIG" ]]; then
    ACTIVE_PROVIDERS=$(elephant listproviders 2>/dev/null)
    CONFIGURED_PROVIDERS=$(awk '
        /^default[[:space:]]*=[[:space:]]*\[/{inarr=1}
        inarr{print}
        inarr && /\]/{inarr=0}
        /provider[[:space:]]*=[[:space:]]*"/{print}
    ' "$WALKER_CONFIG" | grep -oE '"[a-zA-Z_]+"' | tr -d '"' | sort -u)

    MISSING=""
    for p in $CONFIGURED_PROVIDERS; do
        if [[ "$p" == "menus" ]]; then
            if printf '%s\n' "$ACTIVE_PROVIDERS" | grep -q '^menus:' || pacman -Q elephant-menus >/dev/null 2>&1; then
                continue
            fi
        elif printf '%s\n' "$ACTIVE_PROVIDERS" | grep -qx "$p"; then
            continue
        fi
        MISSING="$MISSING $p"
    done
    MISSING="$(echo "$MISSING" | xargs)"
    [[ -z "$MISSING" ]]
    check "elephant listproviders covers all configured walker providers (missing: ${MISSING:-none})" "$?"
else
    echo "  [SKIP] elephant/walker provider parity ($WALKER_CONFIG or elephant not found)"
fi

# ── GTK CSS-parse regression guard (WLOG-01, CR-01 permanent fix) ──────
# Runs every GTK-consumed stylesheet the theme pipeline owns through a
# REAL GTK CssProvider parse. Four prior verification rounds all reported
# PASS while wlogout's stylesheet was silently discarded in full by GTK3
# — a grep for the `@import` line cannot see that. The load-bearing
# signal here is an EMPTY provider, not merely a parse error: on GTK
# 3.24.52 a single generated-content ruleset makes GTK throw away the
# WHOLE stylesheet (0 bytes), not just the offending rule. A deprecation
# (GTK3 GError domain gtk-css-provider-error-quark code 4 — e.g.
# style-floating.css's unitless border-radius, IN-02/deferred) is
# non-fatal and must still PASS. Deployed paths only ($HOME/.config/...)
# — the stow files' relative @import only resolves from there, never
# from the repo copy. GTK3 and GTK4 cannot share a python3 process
# (gi.require_version conflict), so this runs as two separate
# invocations. Never calls Gtk.init() — CssProvider needs no display,
# and init() would require one, breaking the headless verify gate.
GTK3_CSS_SHEETS=(
    "$HOME/.config/wlogout/style.css"
    "$HOME/.config/waybar/style-full.css"
    "$HOME/.config/waybar/style-minimal.css"
    "$HOME/.config/waybar/style-floating.css"
    "$HOME/.config/gtk-3.0/gtk.css"
    "$HOME/.config/swaync/style.css"
)
GTK4_CSS_SHEETS=(
    "$HOME/.config/gtk-4.0/gtk.css"
    "$HOME/.config/swayosd/style.css"
    "$HOME/.config/walker/themes/rice/style.css"
)

_theme_doctor_css_parse() {
    # $1 = GTK major version ("3" or "4"), rest = deployed stylesheet
    # paths. Prints one "STATUS<TAB>path-fragment<TAB>reason" line per
    # sheet. stderr redirected to swallow GTK's own noisy Gtk-WARNING
    # chatter — the structured stdout lines are the signal.
    local major="$1"
    shift
    python3 - "$major" "$@" <<'PYEOF' 2>/dev/null
import os
import sys

major = sys.argv[1]
paths = sys.argv[2:]

import gi
gi.require_version("Gtk", major + ".0")
from gi.repository import Gtk

home_config = os.path.join(os.path.expanduser("~"), ".config")

for path in paths:
    try:
        frag = os.path.relpath(path, home_config)
    except ValueError:
        frag = path

    if not os.path.isfile(path):
        print(f"SKIP\t{frag}\tnot deployed under ~/.config — run stow.sh")
        continue

    provider = Gtk.CssProvider()
    fatal = []

    if major == "3":
        # gtk-css-provider-error-quark code 4 == deprecation (non-fatal,
        # provider retained); any other code means GTK discarded the
        # whole sheet — the exact WLOG-01/CR-01 failure signature. GTK4's
        # CssProvider exposes no equivalent "parsing-error" signal in
        # this binding (verified: zero signals on the GType), so GTK4
        # relies on the non-empty-provider check alone below, which
        # still catches a fully-discarded sheet.
        def _on_error(_provider, _section, error, _fatal=fatal):
            if error.code != 4:
                _fatal.append(error.message)

        provider.connect("parsing-error", _on_error)

    try:
        provider.load_from_path(path)
    except Exception as exc:  # the first fatal GError also raises here
        fatal.append(str(exc))

    css = provider.to_string()
    if fatal:
        print(f"FAIL\t{frag}\tfatal parse error: {fatal[0]}")
    elif not css:
        print(f"FAIL\t{frag}\tprovider is EMPTY — stylesheet discarded")
    else:
        print(f"PASS\t{frag}\t{len(css)} bytes")
PYEOF
}

if python3 -c "import gi" >/dev/null 2>&1; then
    while IFS=$'\t' read -r status frag detail; do
        [[ -z "$status" ]] && continue
        desc="CSS-parse: $frag ($detail)"
        case "$status" in
            SKIP) echo "  [SKIP] $desc" ;;
            PASS) check "$desc" "0" ;;
            *)    check "$desc" "1" ;;
        esac
    done < <(_theme_doctor_css_parse 3 "${GTK3_CSS_SHEETS[@]}")

    while IFS=$'\t' read -r status frag detail; do
        [[ -z "$status" ]] && continue
        desc="CSS-parse: $frag ($detail)"
        case "$status" in
            SKIP) echo "  [SKIP] $desc" ;;
            PASS) check "$desc" "0" ;;
            *)    check "$desc" "1" ;;
        esac
    done < <(_theme_doctor_css_parse 4 "${GTK4_CSS_SHEETS[@]}")
else
    echo "  [SKIP] GTK CSS-parse guard (python-gobject / gi not available)"
fi

# ── CLEAN-02 permanent invariant (D-50): repo stays clean after a theme
#    switch. Guarded-skip mirrors the stow-conflict check above — this must
#    degrade gracefully, not FAIL, when git or the repo itself is absent
#    (e.g. a fresh-install container that never cloned the dotfiles repo). ─
if command -v git >/dev/null 2>&1 && [[ -d "$DOTFILES_DIR/.git" ]]; then
    GIT_DIRTY_OUTPUT=$(git -C "$DOTFILES_DIR" status --porcelain 2>/dev/null)
    [[ -z "$GIT_DIRTY_OUTPUT" ]]
    check "git status --porcelain is empty ($DOTFILES_DIR stays clean)" "$?"
else
    echo "  [SKIP] git status --porcelain ($DOTFILES_DIR/.git or git not found)"
fi

echo ""
echo "Summary: ${PASS} passed, ${FAIL} failed"
[[ "$FAIL" -eq 0 ]]
exit $?

#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║           THEME-STRESS-TEST (D-31..D-45)             ║
# ║  Parameterized real-switch reliability harness.       ║
# ║  MUTATES the live desktop — drives the real           ║
# ║  theme-apply entrypoint, aborts on first failure.     ║
# ╚══════════════════════════════════════════════════════╝
#
# Usage: theme-stress-test [--switches N] [--gap S]
#   --switches N   number of consecutive switches (default: 10, PIPE-06)
#   --gap S        settle delay in seconds between switches (default: 4,
#                   inside the 3-5s real-usage-pacing window, D-32)
#
# A bare invocation reproduces the PIPE-06 gate exactly (D-43): 10
# alternating static<->dynamic switches with a fixed settle gap, Thunar and
# Walker preconditions verified before the first switch, per-switch
# theme-doctor + sentinel-color + walker/elephant health assertions, and
# postconditions re-checked after the last switch.
#
# Opposite failure-handling philosophy from theme-parity (D-39): this tool
# aborts IMMEDIATELY on the first failed check and dumps diagnostics — it
# does NOT run every check and report all failures. Do not copy
# theme-parity's report-only accumulator model here.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
ENGINE_DIR="$SCRIPT_DIR"
LIB_DIR="$ENGINE_DIR/lib"
PALETTES_DIR="$ENGINE_DIR/palettes"
STATE_DIR="$HOME/.local/state/theme"
LOG_DIR="$STATE_DIR/logs"
BUS_NAME="dev.benz.walker"

# shellcheck source=lib/contract.sh
source "$LIB_DIR/contract.sh"

SWITCHES=10
GAP=4

usage() {
    echo "Usage: theme-stress-test [--switches N] [--gap S]" >&2
    echo "  --switches N   number of consecutive switches (default: 10)" >&2
    echo "  --gap S        settle delay in seconds between switches (default: 4)" >&2
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --switches)
            SWITCHES="${2:-}"
            shift 2
            ;;
        --gap)
            GAP="${2:-}"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "theme-stress-test: unknown argument '$1'" >&2
            usage
            exit 1
            ;;
    esac
done

if [[ ! "$SWITCHES" =~ ^[0-9]+$ ]] || [[ "$SWITCHES" -lt 1 ]]; then
    echo "theme-stress-test: --switches must be a positive integer (got: ${SWITCHES:-<empty>})" >&2
    exit 1
fi
if [[ ! "$GAP" =~ ^[0-9]+$ ]] || [[ "$GAP" -lt 1 ]]; then
    echo "theme-stress-test: --gap must be a positive integer (got: ${GAP:-<empty>})" >&2
    exit 1
fi

# Static preset rotation (D-31, RESEARCH Pitfall 2 permanent fix). Odd
# sequence positions consume the next preset here in order (wrapping once
# --switches exceeds the number of shipped presets); even positions
# alternate materialyou/materialyou-light so the light dynamic path gets
# real-switch coverage too. Dynamic palettes/*.json enumeration (mirrors
# theme-apply's own usage() pattern) means every current and future
# preset is automatically exercised — full preset coverage is proven by
# theme-parity (every palette vs both Material You entries) and by
# running `--switches` high enough to wrap the full rotation here.
STATIC_PRESETS=()
for f in "$PALETTES_DIR"/*.json; do
    [[ -f "$f" ]] && STATIC_PRESETS+=("$(basename "$f" .json)")
done

# No user-controlled theme-name argument exists in this tool (Security
# Domain V5 / T-02-04): the switch sequence is built entirely from this
# hardcoded rotation array plus the literal string "materialyou" — never
# from external input — so there is no argument to validate against
# palettes/*.json before path interpolation. theme-apply performs its own
# defense-in-depth validation on every name regardless (reused, not
# reimplemented, per D-44).

mkdir -p "$LOG_DIR"
chmod 700 "$LOG_DIR" 2>/dev/null || true

TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
LOG_FILE="$LOG_DIR/stress-${TIMESTAMP}.log"
printf '# theme-stress-test run %s (switches=%s gap=%s)\n' "$TIMESTAMP" "$SWITCHES" "$GAP" > "$LOG_FILE"

PASS=0
FAIL=0
current_switch_num="init"
current_theme_name="<init>"

check_or_abort() {
    local desc="$1"
    local ok="$2"
    if [[ "$ok" == "0" ]]; then
        echo "  [PASS] $desc"
        printf 'PASS\tswitch=%s\ttheme=%s\t%s\n' "$current_switch_num" "$current_theme_name" "$desc" >> "$LOG_FILE"
        PASS=$((PASS + 1))
    else
        echo "  [FAIL] $desc"
        printf 'FAIL\tswitch=%s\ttheme=%s\t%s\n' "$current_switch_num" "$current_theme_name" "$desc" >> "$LOG_FILE"
        FAIL=$((FAIL + 1))
        abort_with_diagnostics "$desc"
    fi
}

# abort_with_diagnostics <failed-check-desc>
# D-39: dump which check failed, at which switch, the applied theme name,
# full theme-doctor output, and relevant state-dir file contents to the
# log. set +e here — a diagnostics dump must not itself be cut short by a
# secondary failure while collecting evidence for the primary one.
abort_with_diagnostics() {
    set +e
    local failed_desc="$1"

    {
        echo ""
        echo "ABORT: switch=${current_switch_num} theme=${current_theme_name} check=\"${failed_desc}\""
        echo ""
        # WR-03: when the failed check IS the theme-doctor check, dump the
        # output captured at failure time (check_theme_doctor's
        # THEME_DOCTOR_OUTPUT) — re-running here can observe an already-
        # recovered system (e.g. walker briefly dead during reload but
        # respawned seconds later) and show a healthy doctor run for the
        # very failure D-39 exists to evidence. For non-doctor failures a
        # fresh run is the right diagnostic.
        if [[ "$failed_desc" == *"theme-doctor"* && -n "$THEME_DOCTOR_OUTPUT" ]]; then
            echo "-- theme-doctor output (captured at failure time) --"
            printf '%s\n' "$THEME_DOCTOR_OUTPUT"
        else
            echo "-- theme-doctor output --"
            "$ENGINE_DIR/theme-doctor" 2>&1
        fi
        echo ""
        echo "-- state-dir file contents (representative set) --"
        local f
        for f in "${REPRESENTATIVE_FILES[@]:-}"; do
            [[ -z "$f" ]] && continue
            echo "### $STATE_DIR/$f ###"
            cat "$STATE_DIR/$f" 2>&1
            echo ""
        done
        echo "### $STATE_DIR/current-theme ###"
        cat "$STATE_DIR/current-theme" 2>&1
    } >> "$LOG_FILE" 2>&1

    printf 'ABORT\tswitch=%s\ttheme=%s\tcheck=%s\n' "$current_switch_num" "$current_theme_name" "$failed_desc" >> "$LOG_FILE"

    local notify_summary
    notify_summary=$(printf 'Aborted at switch %s: %s failed.' "$current_switch_num" "$failed_desc" | head -c 200 | tr -d '\000-\011\013\014\016-\037')
    notify-send -a "Theme Stress Test" "Error" "${notify_summary}" \
        -i dialog-error -t 6000 2>/dev/null || true

    echo "" >&2
    echo "ABORTED: switch=${current_switch_num} theme=${current_theme_name}" >&2
    echo "Failed check: ${failed_desc}" >&2
    echo "Full diagnostics: ${LOG_FILE}" >&2
    exit 1
}

# ── Reused check primitives (Don't-Hand-Roll — copied verbatim from the
#    already-hardened patterns in lib/gtk.sh / lib/reload.sh / theme-doctor,
#    never reimplemented) ─────────────────────────────────────────────────

# Thunar-window-open detection (lib/gtk.sh lines 51-59).
check_thunar_window_open() {
    hyprctl clients -j 2>/dev/null \
        | jq -e '[.[] | select(.class | ascii_downcase == "thunar")] | length > 0' \
        >/dev/null 2>&1
}

check_walker_process() {
    pgrep -x walker >/dev/null 2>&1
}

check_elephant_process() {
    pgrep -x elephant >/dev/null 2>&1
}

# Walker D-Bus bus-name registration (lib/reload.sh lines 97-103,157-166).
# Gracefully degrades (treated as satisfied) if busctl is unavailable, same
# as lib/reload.sh's own `command -v busctl` guard.
check_walker_busname() {
    command -v busctl >/dev/null 2>&1 || return 0
    busctl --user status "$BUS_NAME" >/dev/null 2>&1
}

check_elephant_listproviders() {
    command -v elephant >/dev/null 2>&1 || return 1
    elephant listproviders >/dev/null 2>&1
}

# check_theme_doctor
# Runs theme-doctor and requires a strict exit 0 (D-66) — the elephant
# provider gap and the accepted-gap tolerance that used to live here were
# removed once the gap was root-caused and closed (Phase 3 Plan 03-03).
# A clean theme-doctor is now the bar for every switch; any [FAIL] line
# is a real regression and aborts immediately via check_or_abort.
THEME_DOCTOR_OUTPUT=""
check_theme_doctor() {
    local rc
    # set +e/-e toggle (mirrors abort_with_diagnostics' own use of this
    # idiom below): under set -euo pipefail, a bare `VAR=$(failing_cmd)`
    # assignment is NOT exempted from errexit just because the caller
    # tests this function's result in an `if` — the failure would abort
    # the whole script here, inside the function, before check_or_abort
    # ever gets a chance to log/abort with diagnostics.
    set +e
    THEME_DOCTOR_OUTPUT="$("$ENGINE_DIR/theme-doctor" 2>&1)"
    rc=$?
    set -e
    return "$rc"
}

# get_expected_sentinel_normalized <theme-name>
# For a static preset: the palette JSON's primary color (source of truth).
# For materialyou/materialyou-light: the FRESHLY-RENDERED primary, read
# from palette.json's own `.primary` key — not gtk-4.0-colors.css as the
# plan text names, since gtk-colors.css (the shared template rendering BOTH
# gtk-3.0-colors.css and gtk-4.0-colors.css) defines only
# accent_color/accent_bg_color (mapped from colors.primary), never a
# literal "@define-color primary" name (verified empirically against
# matugen/.config/matugen/templates/gtk-colors.css and the live rendered
# gtk-4.0-colors.css this session — [Rule 1] deviation, see SUMMARY).
# Until RETIRE-02 (18-20), this branch read the retired bar's compiled
# stylesheet instead, which DID define "@define-color primary" verbatim —
# but every other gtk-css sheet defining that same token (the notification
# daemon's own sheet and the retired power-menu surface's sheet among
# them) is itself retired elsewhere in this milestone, so repointing at
# any of them would only relocate this breakage into a later phase.
# palette.json is a contract entry no remaining RETIRE requirement removes,
# is already committed to the live state dir by the time theme-apply
# returns (D-14 atomic commit), and both sources were verified to yield an
# identical value before the repoint — so reading it here still reflects
# the just-applied theme without depending on a doomed gtk-css sheet.
# materialyou-light shares this branch (Task 3, [Rule 1] deviation) —
# without it, the newly-added materialyou-light sequence entries would
# look up a nonexistent palettes/materialyou-light.json and abort the
# stress test on every run.
get_expected_sentinel_normalized() {
    local name="$1"
    local raw=""
    if [[ "$name" == "materialyou" || "$name" == "materialyou-light" ]]; then
        raw="$(jq -r '.primary' "$STATE_DIR/palette.json" 2>/dev/null)"
    else
        raw="$(jq -r '.colors.primary.default.color' "$PALETTES_DIR/$name.json" 2>/dev/null)"
    fi
    [[ -n "$raw" ]] || return 1
    contract_normalize_color "$raw"
}

# sentinel_present_in_file <expected-normalized-hex> <contract-filename>
# Never a raw literal grep (Pitfall 1) — every extracted value is run
# through contract_normalize_color before comparison, so hyprland-tokens.lua's
# (formerly hyprland.conf's) distinct rgba(RRGGBBAA)-no-comma format is
# checked on equal footing with every @define-color / kitty-kv file.
sentinel_present_in_file() {
    local expected="$1"
    local fname="$2"
    local path="$STATE_DIR/$fname"
    [[ -f "$path" ]] || return 1

    local key val norm
    while IFS=$'\t' read -r key val; do
        norm="$(contract_normalize_color "$val" 2>/dev/null)" || continue
        if [[ "$norm" == "$expected" ]]; then
            return 0
        fi
    done < <(contract_extract_values "$fname" "$path")
    return 1
}

# Representative set of state-dir files for the per-switch sentinel check
# (D-36) — spans the three format families (per contract.json's own
# `format` tag on each entry) that still carry a checkable primary-color
# value after D-19-46/RETIRE-05: gtk-css (gtk-4.0-colors.css), lua-table
# (hyprland-tokens.lua — REQUIRED, Pitfall 1's exact target, swapped
# 13.1-09 for the retiring hyprland.conf hypr-vars fragment now that
# contract.json's hyprland.conf entry is gone in the collapsed contract),
# and kitty-kv (kitty.conf). `sentinel_present_in_file` and
# `contract_extract_values` needed no code change for D-19-46: both already
# dispatch purely off `contract_format`, and 13.1-05 already added the
# `lua-table` extractor arm this file's own primary-color lookup above (a
# DIFFERENT palette source used only for the matugen-vs-rendered
# comparison, not this array) never touches. D-19-46 dropped the retiring
# notification daemon's compiled stylesheet from this set; RETIRE-05
# (Phase 20 Plan 10) then REMOVED the retired power-menu surface's own
# gtk-css entry from this array by deletion, not repoint — the array
# already carried gtk-4.0-colors.css as a SECOND gtk-css representative
# (its primary VALUE appears under a different key name, accent_color, vs.
# kitty.conf's color4/color12/cursor, confirming the sentinel is checked by
# value, not by name, across formats), so the gtk-css format stays
# represented with no placeholder needed. The remaining three still cover
# every format family the check needs, so no format coverage is lost.
REPRESENTATIVE_FILES=(hyprland-tokens.lua gtk-4.0-colors.css kitty.conf)

# ── D-17: live re-colour assertion (12-06, TOKEN-02) ────────────────────
# Proves criterion 1 — a theme switch re-colours a LIVE Quickshell surface
# without restarting the daemon — holds on EVERY one of the 10 switches,
# not only the first. This lives inside the switch loop rather than a
# one-off smoke test for exactly one reason: commit.sh's rsync replace
# (lib/commit.sh:94, `rsync -a --delete`, no `--inplace`) changes
# palette.json's inode on every switch, and a path-based file watcher that
# detaches on replace would pass switch 1 and silently stop working from
# switch 2 onward — a class of bug a single-switch test cannot see by
# construction. Reaches the rendered value without a human or a
# screenshot: the token inspector's `probeAdapter.observedPrimary`
# (Probe.qml) mirrors `Colours.primary` through the SAME FileView/
# JsonAdapter write path Phase 11 already proved live
# (`~/.local/state/quickshell/probe.json`).
#
# Guarded like every other optional check in this file's family: degrades
# to a named SKIP, never a FAIL, without a running quickshell daemon.
QUICKSHELL_PROBE_JSON="$HOME/.local/state/quickshell/probe.json"
QUICKSHELL_PID_AT_START=""
QUICKSHELL_D17_ENABLED=0
QUICKSHELL_PROBE_WAS_OPEN_AT_START=0
QUICKSHELL_PROBE_WE_SUMMONED=0

check_quickshell_process() {
    pgrep -x quickshell >/dev/null 2>&1
}

# quickshell_probe_open
# True if the quickshell-probe overlay surface currently exists on ANY
# screen — never a hardcoded monitor name (this host's monitor count/name
# must stay free to change without editing this file, same discipline as
# quickshell-doctor's own reserved-space check).
quickshell_probe_open() {
    command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 1
    hyprctl layers -j 2>/dev/null | jq -e '
        [.[] | (.levels."3" // [])[] | select(.namespace == "quickshell-probe")] | length > 0
    ' >/dev/null 2>&1
}

# quickshell_probe_ensure_open
# Summons the probe if it is not already open. `HyprlandFocusGrab` can be
# cleared by unrelated focus/window activity elsewhere in the reload
# fan-out — observed live during this plan's own verification (a
# pre-existing Phase 11 dismiss mechanism, not something this check
# introduces or depends on being absent). Re-summoning makes the
# per-switch propagation assertion resilient to that, while the separate
# PID-unchanged assertion below is what actually proves the daemon itself
# was never restarted — the two assertions are deliberately independent.
quickshell_probe_ensure_open() {
    quickshell_probe_open && return 0
    # 13.1-09 (Rule 3 — blocking fix, in-file, narrowly scoped): a
    # Lua-config-managed compositor rejects the classic
    # `hyprctl dispatch global quickshell:probe` string form outright
    # ("')' expected near 'quickshell'" — it tries to parse the whole
    # dispatch line as a Lua expression, per keybinds.lua's own header
    # comment on this exact mechanism, confirmed live during 13.1-04).
    # The probe therefore never opened on this Lua-cutover session, the
    # wait loop below always timed out, and this function's un-guarded
    # final `quickshell_probe_open` call tripped `set -e` — silently
    # killing the whole run right after the elephant precondition, before
    # a single switch or this task's own sentinel check ever executed.
    # Confirmed live before applying: the bare string form fails with
    # exactly that Lua parse error; `hl.dsp.global("quickshell:probe")`
    # (the same Lua expression form keybinds.lua's own bind uses)
    # succeeds and the probe layer surface appears in `hyprctl layers -j`
    # immediately afterward.
    hyprctl dispatch 'hl.dsp.global("quickshell:probe")' >/dev/null 2>&1
    QUICKSHELL_PROBE_WE_SUMMONED=1
    local waited=0
    while ! quickshell_probe_open && (( waited < 30 )); do
        sleep 0.1
        waited=$((waited + 1))
    done
    quickshell_probe_open
}

echo "theme-stress-test — ${SWITCHES}-switch reliability run (gap=${GAP}s) — ${TIMESTAMP}"
echo ""

# ── Preconditions (D-34) ────────────────────────────────────────────────
echo "-- Preconditions --"
current_switch_num="pre"
current_theme_name="<precondition>"

if ! check_thunar_window_open; then
    setsid uwsm app -- thunar >/dev/null 2>&1 </dev/null &
    disown
fi

waited=0
while ! check_thunar_window_open && (( waited < 50 )); do
    sleep 0.1
    waited=$((waited + 1))
done

if check_thunar_window_open; then thunar_pre_rc=0; else thunar_pre_rc=1; fi
check_or_abort "precondition: Thunar window open" "$thunar_pre_rc"

if check_walker_process; then rc=0; else rc=1; fi
check_or_abort "precondition: walker process running" "$rc"

if check_walker_busname; then rc=0; else rc=1; fi
check_or_abort "precondition: walker bus-name ($BUS_NAME) registered" "$rc"

if check_elephant_process; then rc=0; else rc=1; fi
check_or_abort "precondition: elephant process running" "$rc"

if check_elephant_listproviders; then rc=0; else rc=1; fi
check_or_abort "precondition: elephant listproviders responds" "$rc"

# D-17 setup — guarded, report-only (never aborts the run on its own):
# with a quickshell daemon present, capture its PID (the PID-unchanged
# assertion's baseline) and summon the token inspector once up front so
# its FileView/JsonAdapter write path is live before the first switch.
if check_quickshell_process; then
    QUICKSHELL_D17_ENABLED=1
    QUICKSHELL_PID_AT_START="$(pgrep -x quickshell | head -1)"
    if quickshell_probe_open; then
        QUICKSHELL_PROBE_WAS_OPEN_AT_START=1
    fi
    quickshell_probe_ensure_open >/dev/null 2>&1
    echo "  [INFO] D-17 live re-colour assertion enabled (quickshell pid ${QUICKSHELL_PID_AT_START})"
else
    echo "  [SKIP] D-17 live re-colour assertion (quickshell daemon not running)"
fi

# ── Build the alternating switch sequence (D-31/D-33) ───────────────────
# Odd positions: next static preset from the rotation, in order. Even
# positions: alternate materialyou/materialyou-light so the light dynamic
# path gets real-switch coverage (RESEARCH Pitfall 2 follow-through).
# Wallpaper is never touched anywhere in this script — materialyou/
# materialyou-light switches reuse whatever wallpaper is already current
# (D-33); there is no wallpaper-picker call or matugen image-source
# change anywhere in this file.
SEQUENCE=()
static_idx=0
even_idx=0
MATERIALYOU_VARIANTS=(materialyou materialyou-light)
for (( i = 1; i <= SWITCHES; i++ )); do
    if (( i % 2 == 1 )); then
        SEQUENCE+=("${STATIC_PRESETS[$(( static_idx % ${#STATIC_PRESETS[@]} ))]}")
        static_idx=$((static_idx + 1))
    else
        SEQUENCE+=("${MATERIALYOU_VARIANTS[$(( even_idx % ${#MATERIALYOU_VARIANTS[@]} ))]}")
        even_idx=$((even_idx + 1))
    fi
done

# ── Switch loop (D-32/D-35/D-36/D-38/D-39) ──────────────────────────────
echo ""
echo "-- Switch sequence: ${SEQUENCE[*]} --"

for (( i = 1; i <= SWITCHES; i++ )); do
    current_switch_num="$i"
    current_theme_name="${SEQUENCE[$((i - 1))]}"

    echo ""
    echo "== Switch #${i}/${SWITCHES}: applying '${current_theme_name}' =="

    # Drives the REAL entrypoint (D-44) — the same call the picker and
    # login init use. No reimplemented render/reload here.
    if "$ENGINE_DIR/theme-apply" "$current_theme_name"; then apply_rc=0; else apply_rc=1; fi
    check_or_abort "switch #${i}: theme-apply ${current_theme_name} succeeded" "$apply_rc"

    # (a) theme-doctor pass (baseline-aware — see check_theme_doctor above)
    if check_theme_doctor; then rc=0; else rc=1; fi
    check_or_abort "switch #${i}: theme-doctor passes (strict exit 0, D-66)" "$rc"

    # (b) format-normalized sentinel-color match (Pitfall 1)
    expected_sentinel=""
    if ! expected_sentinel="$(get_expected_sentinel_normalized "$current_theme_name")"; then
        expected_sentinel=""
    fi
    if [[ -n "$expected_sentinel" ]]; then sentinel_extract_rc=0; else sentinel_extract_rc=1; fi
    check_or_abort "switch #${i}: sentinel color extracted for ${current_theme_name}" "$sentinel_extract_rc"

    for fname in "${REPRESENTATIVE_FILES[@]}"; do
        if sentinel_present_in_file "$expected_sentinel" "$fname"; then rc=0; else rc=1; fi
        check_or_abort "switch #${i}: sentinel (${expected_sentinel}) present in ${fname} (normalized)" "$rc"
    done

    # (c) walker+elephant liveness incl. bus-name registration (D-38)
    if check_walker_process; then rc=0; else rc=1; fi
    check_or_abort "switch #${i}: walker process running" "$rc"

    if check_walker_busname; then rc=0; else rc=1; fi
    check_or_abort "switch #${i}: walker bus-name ($BUS_NAME) registered" "$rc"

    if check_elephant_process; then rc=0; else rc=1; fi
    check_or_abort "switch #${i}: elephant process running" "$rc"

    if check_elephant_listproviders; then rc=0; else rc=1; fi
    check_or_abort "switch #${i}: elephant listproviders responds" "$rc"

    # (d) D-17: live re-colour — quickshell's rendered Colours.primary
    #     tracks palette.json's freshly-rendered primary on THIS switch,
    #     and the daemon PID never changed (no restart occurred). Guarded:
    #     skipped entirely (no FAIL) when D-17 setup found no daemon.
    if [[ "$QUICKSHELL_D17_ENABLED" -eq 1 ]]; then
        quickshell_probe_ensure_open >/dev/null 2>&1

        expected_primary_norm=""
        expected_primary_raw="$(jq -r '.primary // empty' "$STATE_DIR/palette.json" 2>/dev/null)"
        if ! expected_primary_norm="$(contract_normalize_color "$expected_primary_raw" 2>/dev/null)"; then
            expected_primary_norm=""
        fi

        observed_norm=""
        waited=0
        while (( waited < 50 )); do
            observed_raw="$(jq -r '.observedPrimary // empty' "$QUICKSHELL_PROBE_JSON" 2>/dev/null)"
            if norm_try="$(contract_normalize_color "$observed_raw" 2>/dev/null)"; then
                observed_norm="$norm_try"
                [[ "$observed_norm" == "$expected_primary_norm" ]] && break
            fi
            sleep 0.1
            waited=$((waited + 1))
        done

        if [[ -n "$expected_primary_norm" && "$observed_norm" == "$expected_primary_norm" ]]; then rc=0; else rc=1; fi
        check_or_abort "switch #${i}: D-17 live re-colour — quickshell's Colours.primary (${observed_norm:-<none>}) matches palette.json's primary (${expected_primary_norm:-<none>})" "$rc"

        quickshell_pid_now="$(pgrep -x quickshell | head -1)"
        if [[ -n "$QUICKSHELL_PID_AT_START" && "$quickshell_pid_now" == "$QUICKSHELL_PID_AT_START" ]]; then rc=0; else rc=1; fi
        check_or_abort "switch #${i}: quickshell daemon PID unchanged (${QUICKSHELL_PID_AT_START} == ${quickshell_pid_now:-<none>})" "$rc"
    fi

    if (( i < SWITCHES )); then
        echo "  (settling ${GAP}s before next switch...)"
        sleep "$GAP"
    fi
done

# ── Postconditions (D-34) ────────────────────────────────────────────────
echo ""
echo "-- Postconditions (after switch #${SWITCHES}) --"
current_switch_num="post"
current_theme_name="${SEQUENCE[$((SWITCHES - 1))]}"

if check_thunar_window_open; then rc=0; else rc=1; fi
check_or_abort "postcondition: Thunar window still open" "$rc"

if check_walker_process; then rc=0; else rc=1; fi
check_or_abort "postcondition: walker process still running" "$rc"

if check_walker_busname; then rc=0; else rc=1; fi
check_or_abort "postcondition: walker bus-name ($BUS_NAME) still registered" "$rc"

if check_elephant_process; then rc=0; else rc=1; fi
check_or_abort "postcondition: elephant process still running" "$rc"

if check_elephant_listproviders; then rc=0; else rc=1; fi
check_or_abort "postcondition: elephant listproviders still responds" "$rc"

if [[ "$QUICKSHELL_D17_ENABLED" -eq 1 ]]; then
    if check_quickshell_process; then rc=0; else rc=1; fi
    check_or_abort "postcondition: quickshell daemon still running" "$rc"

    quickshell_pid_final="$(pgrep -x quickshell | head -1)"
    if [[ -n "$QUICKSHELL_PID_AT_START" && "$quickshell_pid_final" == "$QUICKSHELL_PID_AT_START" ]]; then rc=0; else rc=1; fi
    check_or_abort "postcondition: quickshell daemon PID never changed across the whole run (${QUICKSHELL_PID_AT_START} == ${quickshell_pid_final:-<none>})" "$rc"

    # Restore the probe to whatever open/closed state it was in before this
    # run started — never leave a surface open (or closed) that this
    # script itself did not put there.
    if [[ "$QUICKSHELL_PROBE_WE_SUMMONED" -eq 1 && "$QUICKSHELL_PROBE_WAS_OPEN_AT_START" -eq 0 ]]; then
        # 13.1-09: same dispatch-syntax fix as quickshell_probe_ensure_open
        # above — the classic string form is rejected outright on a
        # Lua-config-managed compositor.
        hyprctl dispatch 'hl.dsp.global("quickshell:probe")' >/dev/null 2>&1
    fi
fi

echo ""
echo "Summary: ${PASS} passed, ${FAIL} failed"
printf 'SUMMARY\t%s passed, %s failed\n' "$PASS" "$FAIL" >> "$LOG_FILE"

notify-send -a "Theme Stress Test" "Complete" \
    "${SWITCHES} switches passed with zero failures. Log: $(basename "$LOG_FILE")" \
    -i preferences-desktop-theme -t 5000 2>/dev/null || true

exit 0

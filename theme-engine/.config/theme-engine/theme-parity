#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║              THEME-PARITY (D-26/D-27/D-28/D-29)      ║
# ║  Render-only output-contract parity checker across    ║
# ║  all 7 targets. Report-only — never mutates state,     ║
# ║  never fires a reload.                                 ║
# ╚══════════════════════════════════════════════════════╝
#
# Usage: theme-parity [target]
#   With no argument: renders and cross-compares all 6 static presets +
#   materialyou (D-29). With a target argument: renders and reports on that
#   one target's internal well-formedness only (no cross-target diff).
#
# Proves PIPE-04's output contract across three independent layers, all run
# for every target (D-28, never skipped even when a prior layer passed —
# Pitfall 3): (1) structure parity — identical file-path set, (2) name-set
# parity — identical per-file variable/key names (contract.json-declared
# format), (3) semantic-value parity — every color value well-formed, with
# contract.json's declared exempt_keys honored (Pitfall 2).

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
ENGINE_DIR="$SCRIPT_DIR"
LIB_DIR="$ENGINE_DIR/lib"
PALETTES_DIR="$ENGINE_DIR/palettes"
STATE_DIR="$HOME/.local/state/theme"
LOG_DIR="$STATE_DIR/logs"

# shellcheck source=lib/contract.sh
source "$LIB_DIR/contract.sh"
# WR-04: theme-parity is report-only ("never mutates state") — its 7
# successive renders must not truncate the live
# $STATE_DIR/.last-render-error.log. Point generate.sh's render log into
# the parity log dir instead. Must be set BEFORE sourcing generate.sh
# (GENERATE_LOG is resolved at source time).
THEME_ENGINE_RENDER_LOG="$LOG_DIR/theme-parity-render-error.log"
# shellcheck source=lib/generate.sh
source "$LIB_DIR/generate.sh"

PASS=0
FAIL=0

mkdir -p "$LOG_DIR"
chmod 700 "$LOG_DIR" 2>/dev/null || true

TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
LOG_FILE="$LOG_DIR/theme-parity-${TIMESTAMP}.log"
printf '# theme-parity run %s\n' "$TIMESTAMP" > "$LOG_FILE"

check() {
    local desc="$1"
    local ok="$2"
    if [[ "$ok" == "0" ]]; then
        echo "  [PASS] $desc"
        printf 'PASS\t%s\n' "$desc" >> "$LOG_FILE"
        PASS=$((PASS + 1))
    else
        echo "  [FAIL] $desc"
        printf 'FAIL\t%s\n' "$desc" >> "$LOG_FILE"
        FAIL=$((FAIL + 1))
    fi
}

# Security Domain V5 — validate an optional single-target argument against
# the ACTUAL palette filenames before it is ever interpolated into a path,
# exactly as theme-apply does (theme-apply lines 45-58). Reject unknown
# names outright. Extended to accept materialyou-light alongside
# materialyou (mirrors theme-apply's two-literal allowlist, T-05-04).
TARGET_ARG="${1:-}"
if [[ -n "$TARGET_ARG" ]]; then
    if [[ "$TARGET_ARG" != "materialyou" && "$TARGET_ARG" != "materialyou-light" && ! -f "$PALETTES_DIR/$TARGET_ARG.json" ]]; then
        echo "theme-parity: unknown theme '$TARGET_ARG'" >&2
        exit 1
    fi
    TARGETS=("$TARGET_ARG")
else
    # RESEARCH Pitfall 2 permanent fix: dynamic palettes/*.json enumeration
    # instead of a hardcoded array — every current and future preset is
    # automatically covered, never silently excluded from parity coverage.
    TARGETS=()
    for f in "$PALETTES_DIR"/*.json; do
        [[ -f "$f" ]] && TARGETS+=("$(basename "$f" .json)")
    done
    TARGETS+=(materialyou materialyou-light)
fi

echo "theme-parity — output-contract parity check ($TIMESTAMP)"
echo ""

declare -A RENDERED_DIRS
declare -A RENDER_OK
TMP_DIRS=()

cleanup() {
    local t
    for t in "${TMP_DIRS[@]}"; do
        rm -rf "$t"
    done
}
trap cleanup EXIT

CONTRACT_FILE_LIST="$(contract_files)"

# An empty contract file list means jq is missing or contract.json is
# unreadable — Layers 1-3 would silently loop zero times and the script
# would exit 0 on render checks alone. Pitfall-4 discipline applies to the
# contract itself: fail loud, never a silent skip/false-pass.
if [[ -z "$CONTRACT_FILE_LIST" ]]; then
    echo "theme-parity: contract_files produced no entries (jq missing or contract.json unreadable)" >&2
    exit 1
fi

# ── Render-only snapshot into temp dirs (D-27, Pattern 3) ──────────────
echo "-- Rendering ${#TARGETS[@]} target(s) --"
for target in "${TARGETS[@]}"; do
    tmp="$(mktemp -d)"
    TMP_DIRS+=("$tmp")

    if theme_engine_generate "$target" "$tmp"; then
        # matugen -p prefix-join behavior (Pitfall 4) — reuse commit.sh's
        # exact join, never re-derive it.
        rendered_dir="$tmp$STATE_DIR"
        file_count=0
        [[ -d "$rendered_dir" ]] && file_count=$(find "$rendered_dir" -maxdepth 1 -type f 2>/dev/null | wc -l)

        if [[ "$file_count" -eq 0 ]]; then
            # A zero-file render is a FAIL, never a silent skip/false-pass
            # (Pitfall 4).
            check "$target: render produced files (Pitfall-4 false-pass guard)" "1"
            RENDER_OK[$target]=0
        else
            check "$target: render produced files (found $file_count)" "0"
            RENDERED_DIRS[$target]="$rendered_dir"
            RENDER_OK[$target]=1
        fi
    else
        check "$target: theme_engine_generate succeeded" "1"
        RENDER_OK[$target]=0
    fi
done

# ── Mode fixtures (THM-01 SC 2) ──────────────────────────────────────────
# Report-only, same accumulator as every other check here (never abort
# early). Every successfully-rendered target must have written a "mode"
# state-metadata file (lib/generate.sh) containing exactly "light" or
# "dark"; two fixture assertions pin the light/dark auto-detection
# contract itself — a dark preset (catppuccin) and a light preset
# (catppuccin-latte) must resolve to the expected mode.
echo ""
echo "-- Mode fixtures --"
for target in "${TARGETS[@]}"; do
    [[ "${RENDER_OK[$target]}" == "1" ]] || continue
    mode_file="${RENDERED_DIRS[$target]}/mode"
    mode_val=""
    [[ -f "$mode_file" ]] && mode_val="$(cat "$mode_file" 2>/dev/null)"
    mode_ok=1
    [[ "$mode_val" == "light" || "$mode_val" == "dark" ]] && mode_ok=0
    check "$target: mode file present and light|dark (got '${mode_val}')" "$mode_ok"
done

if [[ "${RENDER_OK[catppuccin]:-0}" == "1" ]]; then
    dark_fixture="$(cat "${RENDERED_DIRS[catppuccin]}/mode" 2>/dev/null)"
    dark_fixture_ok=1
    [[ "$dark_fixture" == "dark" ]] && dark_fixture_ok=0
    check "fixture: catppuccin resolves mode=dark (got '${dark_fixture}')" "$dark_fixture_ok"
fi

if [[ "${RENDER_OK[catppuccin-latte]:-0}" == "1" ]]; then
    light_fixture="$(cat "${RENDERED_DIRS[catppuccin-latte]}/mode" 2>/dev/null)"
    light_fixture_ok=1
    [[ "$light_fixture" == "light" ]] && light_fixture_ok=0
    check "fixture: catppuccin-latte resolves mode=light (got '${light_fixture}')" "$light_fixture_ok"
fi

# ── Layer 1: structure parity ───────────────────────────────────────────
echo ""
echo "-- Structure parity --"
while IFS= read -r fname; do
    [[ -z "$fname" ]] && continue
    for target in "${TARGETS[@]}"; do
        [[ "${RENDER_OK[$target]}" == "1" ]] || continue
        [[ -f "${RENDERED_DIRS[$target]}/$fname" ]]
        check "$target: $fname present" "$?"
    done
done <<< "$CONTRACT_FILE_LIST"

# ── Layer 2: name-set parity ────────────────────────────────────────────
echo ""
echo "-- Name-set parity --"
while IFS= read -r fname; do
    [[ -z "$fname" ]] && continue
    reference_target=""
    reference_names=""
    for target in "${TARGETS[@]}"; do
        [[ "${RENDER_OK[$target]}" == "1" ]] || continue
        [[ -f "${RENDERED_DIRS[$target]}/$fname" ]] || continue
        # Capture the extractor's exit status — an unknown format tag or a
        # failed python3/jq/grep extraction must be a FAIL, never an
        # empty-string that vacuously matches every other empty extraction.
        if ! names="$(contract_extract_names "$fname" "${RENDERED_DIRS[$target]}/$fname")"; then
            check "$fname: $target name extraction succeeded" "1"
            continue
        fi
        if [[ -z "$reference_target" ]]; then
            if [[ -z "$names" ]]; then
                # Refuse an empty reference name-set: empty == empty would
                # make every subsequent cross-target comparison vacuous.
                check "$fname: $target name-set captured as reference (non-empty)" "1"
                continue
            fi
            reference_target="$target"
            reference_names="$names"
            check "$fname: $target name-set captured as reference" "0"
        elif [[ "$names" == "$reference_names" ]]; then
            check "$fname: $target name-set matches $reference_target" "0"
        else
            check "$fname: $target name-set matches $reference_target" "1"
        fi
    done
done <<< "$CONTRACT_FILE_LIST"

# ── Layer 3: semantic-value parity ──────────────────────────────────────
echo ""
echo "-- Semantic-value parity --"
while IFS= read -r fname; do
    [[ -z "$fname" ]] && continue
    exempt_keys="$(contract_exempt_keys "$fname")"
    fmt="$(contract_format "$fname")"
    # gtk-css/hypr-vars/kitty-kv/css-literal: EVERY declared key/token in
    # these formats is definitionally a color (Pattern 1's format table) —
    # enforce the "no empty slot" rule there. toml/json are mixed formats
    # (yazi.toml/vscodium.json also carry non-color string leaves like
    # icon glyphs, separators, "workbench.colorTheme") — an empty non-color
    # leaf is not a contract violation, so only validate values that
    # actually look like a color for those two formats. `{{...}}` template
    # leftovers are always a failure regardless of format (Pitfall 2/3).
    # TOKEN-03/12-RESEARCH Open Question 2: css-vars and hypr-motion (the
    # two new motion format tags) and scss-vars (_motion.scss, D-29 gap
    # closure) join this set for the same reason the colour formats are
    # here — every declared key in these formats is definitionally a
    # value that must never render empty. An empty emitted duration,
    # bezier control point, or SCSS colour variable is exactly as broken
    # as an empty colour value (same silent-default-substitution risk
    # D-02/D-09 already worry about).
    # Phase 13.1/D-02/D-05: lua-table (hyprland-tokens.lua) joins this set
    # for the same reason hypr-vars/hypr-motion are here — every declared
    # string leaf in the merged colour+motion table is definitionally a
    # value that must never render empty, with the one intentional
    # exception contract.json's exempt_keys ("colors.image") already
    # carves out.
    case "$fmt" in
        gtk-css|hypr-vars|kitty-kv|css-literal|env-kv|css-vars|hypr-motion|scss-vars|lua-table) enforce_emptiness=1 ;;
        *) enforce_emptiness=0 ;;
    esac

    for target in "${TARGETS[@]}"; do
        [[ "${RENDER_OK[$target]}" == "1" ]] || continue
        path="${RENDERED_DIRS[$target]}/$fname"
        [[ -f "$path" ]] || continue

        # Direct, format-agnostic leftover scan on the raw rendered file
        # (WR-01). The css-literal value extractor only emits color-looking
        # tokens, so a `{{...}}` leftover in a value position would never
        # reach the per-value check below — scan every contract file
        # directly so the "template leftovers are always a failure
        # regardless of format" guarantee actually holds (Pitfall 2/3).
        leftover_bad=0
        if grep -q '{{' "$path"; then
            leftover_bad=1
            echo "    -> $target/$fname: raw {{ template leftover present"
        fi
        check "$target: $fname free of raw {{ template leftovers" "$leftover_bad"

        # Capture the extractor's exit status (same discipline as Layer 2):
        # unknown format tags and python3/jq failures must FAIL, not
        # silently iterate zero times.
        if ! values="$(contract_extract_values "$fname" "$path")"; then
            check "$target: $fname value extraction succeeded" "1"
            continue
        fi
        # For formats where every key is definitionally a color, extracting
        # zero key/value pairs is itself a failure, not a vacuous pass.
        if [[ -z "$values" && "$enforce_emptiness" == "1" ]]; then
            check "$target: $fname value extraction produced values" "1"
            continue
        fi

        bad=0
        while IFS=$'\t' read -r key val; do
            [[ -z "$key" && -z "$val" ]] && continue
            is_exempt=0
            if [[ -n "$exempt_keys" ]]; then
                while IFS= read -r ek; do
                    [[ -n "$ek" && "$key" == "$ek" ]] && is_exempt=1
                done <<< "$exempt_keys"
            fi

            if [[ "$val" == *'{{'* || "$val" == *'}}'* ]]; then
                bad=1
                echo "    -> $target/$fname: template leftover for key '$key': $val"
                continue
            fi

            if [[ -z "$val" ]]; then
                if [[ "$is_exempt" == "1" || "$enforce_emptiness" == "0" ]]; then
                    continue
                fi
                bad=1
                echo "    -> $target/$fname: empty non-exempt value for key '$key'"
                continue
            fi

            if [[ "$val" =~ ^\#?[0-9a-fA-F]{6}$ || "$val" =~ ^rgba?\( ]]; then
                if ! contract_wellformed_color "$val" >/dev/null 2>&1; then
                    bad=1
                    echo "    -> $target/$fname: malformed color for key '$key': $val"
                fi
            fi
        done <<< "$values"

        check "$target: $fname semantic values well-formed" "$bad"
    done
done <<< "$CONTRACT_FILE_LIST"

# ── Layer 4: motion byte-identity (D-31) ────────────────────────────────
# Its own distinct layer, not folded into Layer 2's name-set comparison —
# a name-set match says nothing about VALUE identity, and D-31's premise
# is stronger: the three motion targets must be byte-identical across
# EVERY palette, both modes, and both the static-preset and materialyou
# render branches, all already rendered above at whatever motion-scale
# the live state dir currently holds (fixed for the whole run, since
# theme-parity never writes to $STATE_DIR/motion-scale itself). A hash
# compare, not a structural walk — the strongest and cheapest option
# simultaneously. This proves three things nothing else here guards: (1)
# motion.sh is wired into BOTH render branches (static presets AND
# materialyou/materialyou-light); (2) each emitted file is well-formed
# (a hash never coincidentally matches a truncated/malformed file across
# 22+ independent renders); (3) — the one nothing else proves — that no
# motion token has accidentally been made to depend on a colour or on
# light/dark mode, which is the premise D-01's whole one-source design
# rests on. On failure, name which palette/mode diverged and print the
# differing hashes.
#
# 13-02/D-35: _motion.scss joins this walk — the sass
# partial and its compiled sheet both bake in motion and only ever
# @import colour (D-03), so they are theme-independent by the same D-31
# premise the three original motion targets rest on. Their identity here
# is also the ONLY thing that proves the sass compile step
# (theme_engine_compile_gtk3_stylesheets) is wired into BOTH the
# static-preset and materialyou render branches — nothing else checks
# that.
echo ""
echo "-- Motion byte-identity (D-31) --"
# 13.1-10: hyprland-motion.conf dropped from this set — the hyprlang
# emitter that produced it was retired once the operator resolved Task 2's
# one-way decision as retire-now (13.1-EQUIVALENCE-REPORT.md's "Decision
# (Task 2)" section). Its Hyprland-side successor, hyprland-tokens.lua,
# CANNOT join this array as a like-for-like replacement: this array proves
# a file is theme-INDEPENDENT (identical bytes across a static-preset and
# a materialyou render), but hyprland-tokens.lua merges colours (which do
# vary by theme) together with motion (D-02/D-05's single-generated-file
# design) — asserting its byte-identity across palettes would be asserting
# something false by construction. This is a genuine, honestly-recorded
# coverage change, not a silent gap: motion's byte-identity property is no
# longer independently checkable on the Hyprland side post-merge; it
# remains checkable (and checked) on every other target below.
MOTION_BYTE_IDENTITY_FILES=(
    motion.json gtk-4.0-motion.css
    _motion.scss
)
DIRS_COMPARED=0
for target in "${TARGETS[@]}"; do
    [[ "${RENDER_OK[$target]}" == "1" ]] || continue
    DIRS_COMPARED=$((DIRS_COMPARED + 1))
done
for mfile in "${MOTION_BYTE_IDENTITY_FILES[@]}"; do
    ref_target=""
    ref_hash=""
    diverged=""
    for target in "${TARGETS[@]}"; do
        [[ "${RENDER_OK[$target]}" == "1" ]] || continue
        mpath="${RENDERED_DIRS[$target]}/$mfile"
        if [[ ! -f "$mpath" ]]; then
            diverged="$diverged ${target}(missing)"
            continue
        fi
        h="$(sha256sum "$mpath" | awk '{print $1}')"
        if [[ -z "$ref_target" ]]; then
            ref_target="$target"
            ref_hash="$h"
        elif [[ "$h" != "$ref_hash" ]]; then
            diverged="$diverged ${target}(${h:0:12} vs ${ref_hash:0:12} from ${ref_target})"
        fi
    done
    diverged="$(echo "$diverged" | xargs)"
    [[ -z "$diverged" && -n "$ref_target" ]]
    check "motion byte-identity: $mfile identical across $DIRS_COMPARED render dir(s) (diverged: ${diverged:-none})" "$?"
done

echo ""
echo "Summary: ${PASS} passed, ${FAIL} failed"
printf 'SUMMARY\t%s passed, %s failed\n' "$PASS" "$FAIL" >> "$LOG_FILE"
[[ "$FAIL" -eq 0 ]]
exit $?

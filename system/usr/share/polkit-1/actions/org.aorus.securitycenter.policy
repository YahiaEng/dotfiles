<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  org.aorus.securitycenter.policy — quick task 260827-np1.

  Gives the Security Center's privileged helper a named polkit action so
  the authentication dialog says what is actually about to happen,
  instead of pkexec's generic "Authentication is required to run a
  program as another user".

  auth_admin is used for BOTH active and inactive sessions, and there is
  deliberately NO auth_admin_keep: every privileged action re-prompts.
  These verbs change the firewall and install packages; a five-minute
  "remember my password" window on a pane whose whole job is security
  would be the wrong trade.
-->
<policyconfig>
  <vendor>Aorus dotfiles</vendor>
  <vendor_url>https://github.com/YahiaEng/dotfiles</vendor_url>

  <action id="org.aorus.securitycenter.action">
    <description>Change security settings</description>
    <message>Authentication is required to change firewall state or install security tools.</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/security-center/security-action</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>

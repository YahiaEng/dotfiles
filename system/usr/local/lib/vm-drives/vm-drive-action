#!/usr/bin/env bash
# system/usr/local/lib/vm-drives/vm-drive-action — quick task 260829-vfi.
#
# Installed to /usr/local/lib/vm-drives/vm-drive-action, owned root:root
# mode 0755, and invoked ONLY as:
#
#     pkexec /usr/local/lib/vm-drives/vm-drive-action <VERB>
#
# ── THE SECURITY BOUNDARY IS THIS FILE'S ALLOWLIST ────────────────────
# Same three rules as security-center/security-action, and for a sharper
# reason: this script runs `dmsetup` and edits a libvirt domain. A root
# entry point that accepted a block-device path from a GUI would let the
# caller map ANY partition — including the root filesystem — into a VM.
#
#   1. EXACTLY ONE argument, matched against a hardcoded `case`. No
#      device path, no PARTUUID, no domain name is ever taken from the
#      caller. That is why there is a `link-main` verb rather than a
#      generic `link <device>`.
#   2. No argument is ever interpolated into a command. Grep for "$1"
#      outside the `case` line: there are no other uses.
#   3. It must never be writable by the invoking user. install.sh places
#      it under /usr/local/lib (root-owned), NOT in the stow tree — a
#      pkexec target inside a user-writable dotfiles directory is a local
#      privilege escalation, not a feature.
#
# ── WHAT IS AND IS NOT ALLOWED TO BE LINKED ───────────────────────────
# The two allowlisted drives are identified by GPT PARTUUID / WWN, not by
# kernel name: /dev/sda and /dev/nvme1n1 can reorder across boots, and a
# script that hardcoded them could map the wrong disk after a reboot.
#
#   STORAGE  wwn-0x5000c500c8b378b4   whole disk, 1.8 TB, NTFS "Storage"
#            No OS on it, has its own GPT, so it is passed whole and
#            Windows mounts it natively.
#
#   MAIN     PARTUUID 590b0c8f-…      nvme1n1p5, 3 TB, NTFS "Main"
#            This one lives on the WINDOWS BOOT DISK, so it is NOT passed
#            whole. A device-mapper table exposes only this partition;
#            every other sector of that disk is a `zero` target, which
#            returns zeros on read and DISCARDS writes. The ESP, the
#            Microsoft reserved partition, Windows C: and the recovery
#            partition are therefore unreachable by the guest at the
#            kernel level — not merely hidden by this script's policy.
#
#   BOOT     the WHOLE Windows disk, passed straight through by a
#            stable by-id path — no device-mapper wrapper. This is NOT a
#            data drive. It is the disk the VM BOOTS, so that the
#            operator's real bare-metal Windows runs as the guest, seeing
#            C:, the recovery partition and Main exactly as it does on
#            metal. Quick task 260829-czi; operator-chosen over the
#            data-drive reading, which stays refused below.
#
#            MUTUALLY EXCLUSIVE WITH MAIN, and not by policy: Main is a
#            partition of this disk, a dm mapping claims it exclusively,
#            and the kernel will not hold a whole disk and one of its
#            partitions at the same time. Both verbs refuse in that
#            state, each naming the other.
#
# Windows C: still has NO data-drive verb, deliberately. A guest Windows
# given another Windows' system volume as an extra drive letter writes to
# it — System Volume Information, restore points, search indexing, chkdsk
# on a volume it believes is dirty — for no gain, since that install's
# Program Files and registry are meaningless to a DIFFERENT guest. That
# reasoning does not apply to `link-boot`, where the guest IS that
# install and owns the volume outright.
set -euo pipefail

DOMAIN=win11-gaming
# The domain XML shapes. Root-owned path is not required here (virsh only
# READS these), but the set is fixed so no caller can name a file.
REPO_VFIO=/home/aorus/dotfiles/vfio
STATE_DIR=/var/lib/vm-drives
STATE=$STATE_DIR/linked
RUN_DIR=/run/vm-drives

# Allowlisted identifiers. Changing these is the only way to change what
# this script can touch, and it is a root-owned file.
STORAGE_ID=/dev/disk/by-id/wwn-0x5000c500c8b378b4
STORAGE_PARTUUID=650b543b-5e73-4a28-ae88-706f101fe898
MAIN_PARTUUID=590b0c8f-7d06-4256-9ab5-0a49dd442d5f
MAIN_DM=vm-main

# The Windows boot set, in disk order. Nothing maps these any more — they
# are how the disk is IDENTIFIED, so that the by-id path the domain XML
# names can be proven to be this install rather than trusted blind.
# resolve_boot_disk refuses if they do not all share one disk.
ESP_PARTUUID=4dfdc11f-b756-4b9d-ba93-d3530df05e14
MSR_PARTUUID=f440b932-838f-4811-bd41-f78c38997a51
SYS_PARTUUID=2e3b6dd2-1146-4dde-a58d-6fb84800c624
REC_PARTUUID=95873b29-98ea-497c-9180-1ced3a682bad
# The whole Windows disk, by a stable id. This is what bare-metal mode
# hands the guest — no device-mapper wrapper at all.
#
# WHY THE WRAPPER WENT AWAY (2026-08-29, second attempt): a dm target
# claims its backing device EXCLUSIVELY, so a whole-disk mapping and
# vm-main (a mapping of p5, a partition of that same disk) can never
# coexist — whichever is built second fails EBUSY. That was structural,
# not a coding slip. And the wrapper's entire purpose was to hide Main
# from the guest, which is pointless here: in bare-metal mode the guest
# IS that Windows and legitimately owns the whole disk, Main included,
# exactly as it does when booted on metal.
#
# The id is hardcoded because the domain XML needs a stable path, but it
# is NEVER trusted on its own — verify_boot_disk_id() below proves it
# resolves to the same disk that carries the four allowlisted PARTUUIDs
# before anything is linked.
BOOT_DISK_ID=/dev/disk/by-id/nvme-WD_BLACK_SN850X_4000GB_25033U804844

usage() {
  cat >&2 <<'USAGE'
vm-drive-action — link host data drives into the Windows VM.

Verbs:
  status            report link state of both drives
  link-storage      attach the whole "Storage" disk (1.8 TB, no OS)
  unlink-storage    detach it
  link-main         attach "Main" (3 TB) via a device-mapper wrapper that
                    exposes ONLY that partition; the rest of the Windows
                    boot disk reads as zeros and discards writes
  unlink-main       detach it and tear the mapping down
  link-boot         BARE-METAL MODE ON. Hands the WHOLE Windows disk to
                    the VM as its boot disk, redefines the domain from
                    win11-bare.xml and re-attaches the data drives, so the
                    real Windows runs as the guest. This is one complete
                    action because a Settings toggle drives it. Refused
                    while Main is linked: Main is a partition of that same
                    disk and the guest already sees it there.
  unlink-boot       BARE-METAL MODE OFF. Redefines from win11-gaming.xml,
                    so the VM boots the qcow2 guest again.
  sync-disks        re-attach the linked data drives after a mode switch
                    (`virsh define` drops them; run this straight after)
  rebuild           recreate mappings for whatever is recorded as linked
                    (called by the libvirt hook at VM start)
  teardown          remove all mappings (called at VM stop)

Windows C: is not linkable as a DATA drive. See this file's header.
USAGE
  exit 64
}

[ $# -eq 1 ] || usage

die() { printf 'vm-drive-action: %s\n' "$*" >&2; exit 1; }

# ── Guards every state-changing verb runs first ───────────────────────
# These are the two rules that actually prevent data loss. Neither is
# advisory: a partition mounted on the host AND written by the guest is
# corrupted, every time.
require_vm_off() {
  local s
  s=$(virsh -c qemu:///system domstate "$DOMAIN" 2>/dev/null || echo "undefined")
  [ "$s" = "shut off" ] || [ "$s" = "undefined" ] \
    || die "VM is '$s' — shut it down before changing drive links"
}

require_not_mounted() {
  # $1 is a resolved device path from OUR OWN allowlist, never the caller's.
  local dev=$1 base
  base=$(basename "$dev")
  if findmnt -rno SOURCE | grep -q "^${dev}$"; then
    die "$dev is mounted on the host — unmount it first"
  fi
  # Also refuse if any partition OF that disk is mounted.
  if lsblk -rno NAME,MOUNTPOINT "/dev/$base" 2>/dev/null | awk 'NF>1{exit 0} END{exit 1}'; then
    die "a partition of $dev is mounted on the host — unmount it first"
  fi
}

# ── Fast Startup / hibernation guard ──────────────────────────────────
# THE guard, and the reason this is code rather than a line in the docs.
#
# Windows Fast Startup does not shut down — it hibernates the kernel
# session and leaves the NTFS volume with an open, inconsistent journal.
# A guest that mounts such a volume read-write and writes to it corrupts
# it, and the damage is not visible until the next bare-metal boot.
#
# ntfs-3g.probe reports exactly this state without mounting anything.
# Exit 13 is NTFS_VOLUME_HIBERNATED (Fast Startup, or a genuine
# hibernate); 14 is an unclean unmount. Both are refusals.
#
# This runs at LINK time AND inside `rebuild`, which the libvirt hook
# calls at every VM start — because a volume that was clean when it was
# linked becomes hibernated again the next time Windows is booted on
# bare metal with Fast Startup on. Checking only once would be checking
# the wrong moment.
require_clean_ntfs() {
  local dev=$1 rc=0

  # BitLocker first, because ntfs-3g.probe on an encrypted volume reports a
  # generic failure that sends the reader after the wrong problem. Windows 11
  # enables device encryption on its own: /dev/sda2 here was plain NTFS
  # labelled "Storage" in the morning and BitLocker by the afternoon, after
  # one boot with the drive linked. The signature is "-FVE-FS-" at offset 3
  # of the volume's first sector.
  if [ "$(dd if="$dev" bs=1 skip=3 count=8 status=none 2>/dev/null)" = "-FVE-FS-" ]; then
    # ALLOWED, deliberately. This was a refusal and that was wrong twice
    # over. Windows 11 turns on device encryption BY ITSELF when it sees a
    # TPM and Secure Boot — both of which this VM provides on purpose — so
    # refusing encrypted volumes means the guest silently disqualifies its
    # own drives from ever being linked again.
    #
    # And the hazard does not apply: the hibernation check below exists
    # because the HOST and GUEST must not both write an inconsistent NTFS.
    # A BitLocker volume is opaque to the host, which never mounts it, and
    # the guest holds the key sealed to its virtual TPM. There is no
    # concurrent-writer risk for the host to assess here.
    echo "note: $dev is BitLocker-encrypted; the guest owns the key, host-side" >&2
    echo "      hibernation checking is not possible and not needed." >&2
    return 0
  fi

  command -v ntfs-3g.probe >/dev/null || die "ntfs-3g.probe missing; cannot verify $dev is safe to write"
  ntfs-3g.probe --readwrite "$dev" || rc=$?
  case $rc in
    0)  : ;;
    13) die "$dev is HIBERNATED — turn off Fast Startup in Windows (run 'powercfg /h off' as administrator), then fully shut down. Refusing to link." ;;
    14) die "$dev was not cleanly unmounted. Boot Windows, shut it down properly, then retry. Refusing to link." ;;
    12) die "$dev reports filesystem corruption. Run chkdsk in Windows first. Refusing to link." ;;
    *)  die "$dev failed the read-write safety probe (ntfs-3g.probe exit $rc). Refusing to link." ;;
  esac
}

resolve_main() {
  local d
  d=$(readlink -f "/dev/disk/by-partuuid/$MAIN_PARTUUID" 2>/dev/null) \
    || die "Main partition not found by PARTUUID"
  [ -b "$d" ] || die "Main partition PARTUUID resolves to a non-block device"
  printf '%s' "$d"
}

# Resolve the disk carrying the Windows boot set, and prove all five
# allowlisted partitions live on that ONE disk.
#
# Resolved by PARTUUID, never by kernel name. Device names reorder across
# reboots on this host — the Windows disk has already moved nvme1n1 ->
# nvme0n1 once — and a hardcoded path here would map whichever disk
# happened to take the name, up to and including the host's root.
resolve_boot_disk() {
  local u d pk disk=""
  for u in "$ESP_PARTUUID" "$MSR_PARTUUID" "$SYS_PARTUUID" "$REC_PARTUUID" "$MAIN_PARTUUID"; do
    d=$(readlink -f "/dev/disk/by-partuuid/$u" 2>/dev/null) \
      || die "partition $u not found — is the Windows disk present?"
    [ -b "$d" ] || die "$u resolves to a non-block device"
    # --nodeps IS LOAD-BEARING. Without it lsblk prints one line per node in
    # the subtree, and once a partition has a device-mapper child it prints
    # TWO — the child's PKNAME first. `rebuild` builds vm-main BEFORE the
    # boot map, which gives nvme*p5 exactly such a child, so this resolved
    # to a two-line string and the span check below reported the partitions
    # as living on different disks. Observed 2026-08-29: the domain failed
    # to start after the hook had already stopped sddm.
    pk=/dev/$(lsblk -no PKNAME --nodeps "$d") || die "cannot resolve the parent disk of $d"
    [ -z "$disk" ] && disk=$pk
    [ "$pk" = "$disk" ] || die "the Windows partitions span more than one disk ($pk vs $disk) — refusing"
  done
  printf '%s' "$disk"
}

# ── The device-mapper wrapper ─────────────────────────────────────────
# Builds a virtual disk the same size as the physical one, in which only
# the Main partition maps to real hardware:
#
#   0            2048     linear  loop     GPT header (synthetic, 1 MiB)
#   2048         gap      zero              everything before Main — DISCARDED
#   <start>      <size>   linear  Main      the real partition, at its true offset
#   <end>        tail     linear  loop      backup GPT
#
# Main is kept at its REAL offset because Windows expects a volume where
# it physically lives. The synthetic table is GPT, not MBR: MBR cannot
# address a 3 TB partition at a 1.3-billion-sector offset.
build_main_map() {
  local dev disk start size disksize gap end tail img loop
  dev=$(resolve_main)
  # --nodeps for the same reason resolve_boot_disk needs it: a stale or
  # re-created vm-main gives this partition a child, and lsblk would then
  # return two lines. Latent here rather than observed, because this runs
  # before the mapping it creates exists — but a second rebuild would hit it.
  disk=/dev/$(lsblk -no PKNAME --nodeps "$dev")
  start=$(cat "/sys/class/block/$(basename "$dev")/start")
  size=$(blockdev --getsz "$dev")
  disksize=$(blockdev --getsz "$disk")
  gap=$((start - 2048))
  end=$((start + size))
  tail=$((disksize - end))

  [ "$gap" -gt 0 ]  || die "unexpected geometry: Main starts before sector 2048"
  [ "$tail" -ge 33 ] || die "unexpected geometry: no room for a backup GPT"

  mkdir -p "$RUN_DIR"
  img=$RUN_DIR/main.gpt
  # Sparse file the full size of the physical disk. Only the GPT head and
  # the backup tail are ever written, so it costs kilobytes.
  rm -f "$img"
  truncate -s $((disksize * 512)) "$img"
  # One partition, at Main's real offset, Microsoft basic data.
  # Partition TYPE GUID must be Microsoft basic data. The first version of
  # this used 0FC63DAF-8483-4772-8E79-3D69D8477DE4 with a comment claiming
  # it was — that is the LINUX FILESYSTEM GUID. The mapping built fine and
  # `sfdisk -l` showed a valid GPT at the right offset, so every host-side
  # check passed; Windows simply ignored a partition typed for Linux and
  # showed no drive. Verify with `sfdisk -l /dev/mapper/vm-main`: the Type
  # column must read "Microsoft basic data", not "Linux filesystem".
  sfdisk --quiet --label gpt "$img" >/dev/null <<SFD
${start},${size},EBD0A0A2-B9E5-4433-87C0-68B6B72699C7
SFD

  loop=$(losetup --show -f "$img") || die "losetup failed"
  dmsetup remove "$MAIN_DM" 2>/dev/null || true
  printf '%s\n' \
    "0 2048 linear $loop 0" \
    "2048 $gap zero" \
    "$start $size linear $dev 0" \
    "$end $tail linear $loop $end" \
    | dmsetup create "$MAIN_DM" || die "dmsetup create failed"

  udevadm settle 2>/dev/null || true
}

# ── Bare-metal mode's one safety check ────────────────────────────────
# There is no mapping to build any more, so all that is left is proving
# the path the domain XML names really is the Windows disk. A by-id path
# is stable, but "stable" is not "correct" — if this disk were ever
# replaced, the id would resolve to a stranger and the guest would be
# handed it as a boot disk. So the id is checked against the PARTUUID
# allowlist, which is the thing that actually identifies this install.
verify_boot_disk_id() {
  local by_id resolved
  [ -b "$BOOT_DISK_ID" ] || die "boot disk $BOOT_DISK_ID is not present"
  by_id=$(readlink -f "$BOOT_DISK_ID")
  resolved=$(resolve_boot_disk)
  [ "$by_id" = "$resolved" ] \
    || die "$BOOT_DISK_ID resolves to $by_id, but the Windows partitions live on $resolved — refusing"
  printf '%s' "$resolved"
}

destroy_main_map() {
  local loop
  dmsetup remove "$MAIN_DM" 2>/dev/null || true
  # Detach only loops backed by OUR image, never a blanket losetup -D.
  while read -r loop; do
    [ -n "$loop" ] && losetup -d "$loop" 2>/dev/null || true
  done < <(losetup -j "$RUN_DIR/main.gpt" -O NAME -n 2>/dev/null || true)
  rm -f "$RUN_DIR/main.gpt"
}

state_has() { [ -f "$STATE" ] && grep -qx "$1" "$STATE"; }
state_add() { mkdir -p "$STATE_DIR"; touch "$STATE"; grep -qx "$1" "$STATE" || echo "$1" >> "$STATE"; }
state_del() { [ -f "$STATE" ] && sed -i "/^$1\$/d" "$STATE" || true; }

attach_disk() {
  # $1 = device path (from our allowlist), $2 = guest target dev name
  local xml
  xml=$(mktemp)
  cat > "$xml" <<XML
<disk type='block' device='disk'>
  <driver name='qemu' type='raw' cache='none' io='native' discard='unmap'/>
  <source dev='$1'/>
  <target dev='$2' bus='virtio'/>
</disk>
XML
  virsh -c qemu:///system attach-device "$DOMAIN" "$xml" --config \
    || { rm -f "$xml"; die "attach-device failed"; }
  rm -f "$xml"
}

detach_disk() {
  local xml
  xml=$(mktemp)
  cat > "$xml" <<XML
<disk type='block' device='disk'>
  <source dev='$1'/>
  <target dev='$2' bus='virtio'/>
</disk>
XML
  virsh -c qemu:///system detach-device "$DOMAIN" "$xml" --config 2>/dev/null || true
  rm -f "$xml"
}

# ── Switching the domain between its XML shapes ───────────────────────
# link-boot / unlink-boot are driven from a TOGGLE in Settings, so they
# have to be complete actions: a toggle that only records state and left
# `virsh define` to the operator would report bare-metal mode as ON while
# the VM still booted the qcow2. So the verbs redefine the domain and
# re-attach the data drives themselves.
#
# The XML path is resolved against a fixed allowlist, never taken from the
# caller — same rule as everything else in this file.
switch_mode() {
  local shape=$1 xml
  case "$shape" in
    bare)   xml=$REPO_VFIO/win11-bare.xml ;;
    gaming) xml=$REPO_VFIO/win11-gaming.xml ;;
    *) die "unknown domain shape '$shape'" ;;
  esac
  [ -r "$xml" ] || die "$xml is missing — cannot switch modes"
  virsh -c qemu:///system define "$xml" >/dev/null \
    || die "virsh define $xml failed"
}

# Re-attach the linked data drives after a mode switch.
#
# `virsh define` REPLACES the domain definition wholesale, and the linked
# data drives are in NONE of the three XML files — they are added by
# `attach-device --config` at link time. So every mode switch silently
# drops them while the state file still says they are linked, and the
# guest boots without its drives for a reason the operator cannot see.
#
# Idempotent by construction: each disk is attached only if the defined
# domain does not already carry that source.
sync_disks() {
  if state_has storage && ! disk_attached "$STORAGE_ID"; then
    attach_disk "$STORAGE_ID" vdb
    echo "Storage re-attached (vdb)"
  fi
  # Guarded on `boot` too: in bare-metal mode Main is reached through the
  # boot disk it lives on, and attaching it again would give the guest two
  # paths to one filesystem.
  if state_has main && ! state_has boot && ! disk_attached "/dev/mapper/$MAIN_DM"; then
    attach_disk "/dev/mapper/$MAIN_DM" vdc
    echo "Main re-attached (vdc)"
  fi
}

# Is this source device already a disk on the DEFINED domain?
#
# `--inactive` is deliberate: dumpxml on a running domain reports the LIVE
# config, which can differ from what was defined, and this function exists
# to decide whether a `--config` attach is needed.
disk_attached() {
  virsh -c qemu:///system dumpxml --inactive "$DOMAIN" 2>/dev/null \
    | grep -qF "dev='$1'"
}

case "$1" in

  status)
    printf 'domain=%s\n' "$(virsh -c qemu:///system domstate "$DOMAIN" 2>/dev/null || echo undefined)"
    printf 'storage=%s\n' "$(state_has storage && echo linked || echo unlinked)"
    printf 'main=%s\n'    "$(state_has main    && echo linked || echo unlinked)"
    printf 'main_mapped=%s\n' "$(dmsetup info "$MAIN_DM" >/dev/null 2>&1 && echo yes || echo no)"
    printf 'boot=%s\n'    "$(state_has boot && echo linked || echo unlinked)"
    printf 'boot_disk=%s\n' "$(readlink -f "$BOOT_DISK_ID" 2>/dev/null || echo absent)"
    ;;

  link-storage)
    require_vm_off
    [ -b "$STORAGE_ID" ] || die "Storage disk not present"
    require_not_mounted "$(readlink -f "$STORAGE_ID")"
    # Probe the NTFS partition, not the whole disk: the disk itself has no
    # filesystem, only a GPT.
    require_clean_ntfs "$(readlink -f "/dev/disk/by-partuuid/$STORAGE_PARTUUID")"
    attach_disk "$STORAGE_ID" vdb
    state_add storage
    echo "Storage linked (whole disk, vdb)"
    ;;

  unlink-storage)
    require_vm_off
    detach_disk "$STORAGE_ID" vdb
    state_del storage
    echo "Storage unlinked"
    ;;

  link-main)
    require_vm_off
    # The reciprocal of link-boot's guard. Stated from this side too,
    # because the operator arrives here from the Settings page without
    # having read the other verb.
    if state_has boot; then
      die "bare-metal mode is active, and Main is a partition of the disk it hands over — the guest already sees Main there. Run 'unlink-boot' first if you want Main as a separate drive."
    fi
    require_not_mounted "$(resolve_main)"
    require_clean_ntfs "$(resolve_main)"
    build_main_map
    attach_disk "/dev/mapper/$MAIN_DM" vdc
    state_add main
    echo "Main linked (device-mapper wrapper, vdc)"
    ;;

  unlink-main)
    require_vm_off
    detach_disk "/dev/mapper/$MAIN_DM" vdc
    destroy_main_map
    state_del main
    echo "Main unlinked"
    ;;

  link-boot)
    # ── Turns the VM into the operator's real Windows, in one action ──
    # Driven from the Settings toggle, so it must leave nothing for the
    # operator to remember: verify, record, redefine the domain, re-attach
    # the data drives.
    require_vm_off
    # The one refused combination, in both directions. Bare-metal mode
    # hands over the WHOLE disk and Main is a partition of it, so the guest
    # already sees Main there. Linking it too would present one NTFS volume
    # to Windows twice, by two paths, which it can mount twice and corrupt.
    # Refused rather than silently resolved, so the choice stays with the
    # operator: turn either off and the other becomes available.
    if state_has main; then
      die "Main is linked, and it lives on the very disk this hands over — the guest sees it there already. Turn Main off first."
    fi
    disk=$(verify_boot_disk_id)
    require_not_mounted "$disk"
    # Probe the two NTFS volumes the guest will actually write. The ESP is
    # FAT32 and the MSR has no filesystem at all, so neither can be probed
    # and neither carries a hibernation journal.
    require_clean_ntfs "$(readlink -f "/dev/disk/by-partuuid/$SYS_PARTUUID")"
    require_clean_ntfs "$(readlink -f "/dev/disk/by-partuuid/$REC_PARTUUID")"
    state_add boot
    switch_mode bare
    sync_disks >/dev/null
    echo "Bare-metal mode ON. The VM now boots your real Windows from $disk."
    echo "It will see C:, recovery and Main on that disk, as bare metal does."
    ;;

  unlink-boot)
    require_vm_off
    state_del boot
    switch_mode gaming
    sync_disks >/dev/null
    echo "Bare-metal mode OFF. The VM boots the qcow2 guest again."
    echo "Main can be linked now."
    ;;

  sync-disks)
    # Exposed as a verb as well, for a mode switch done by hand with
    # `virsh define` rather than through the Settings toggle.
    require_vm_off
    sync_disks
    echo "Disk attachments are in sync with the recorded link state."
    ;;

  rebuild)
    # Called by the libvirt hook at VM start. Device-mapper tables do not
    # survive a reboot, so the mapping has to be rebuilt from the recorded
    # state before qemu opens /dev/mapper/vm-main.
    # NO filesystem-state guard here, on purpose. This runs from the libvirt
    # hook at every VM start, and a `die` at this point does not protect
    # anything — it leaves /dev/mapper/vm-main missing, libvirt cannot open
    # the disk, the domain fails to start, and the operator is dropped back
    # at the SDDM login with no explanation. Observed exactly that way once
    # device encryption reached the linked drive.
    #
    # The safety decision belongs at LINK time, where refusing costs the
    # operator one toggle. By the time we are here they have already
    # consented, and building a block mapping is itself harmless. The only
    # check that still earns its place is the concurrent-mount one, because
    # host and guest writing the same volume corrupts it regardless of
    # anything else.
    if state_has main; then
      require_not_mounted "$(resolve_main)"
      build_main_map
      echo "Main mapping rebuilt"
    fi
    # NO boot branch, and that is the point of the whole-disk design.
    # Bare-metal mode builds nothing, so there is nothing here that can
    # fail and strand the operator at SDDM — which is exactly how the
    # first attempt cost a desktop on 2026-08-29.
    ;;

  teardown)
    destroy_main_map
    echo "Mappings torn down"
    ;;

  *) usage ;;
esac

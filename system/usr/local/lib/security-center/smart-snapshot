#!/usr/bin/env bash
# security/bin/smart-snapshot — quick task 260827-np1.
#
# Installed to /usr/local/lib/security-center/smart-snapshot and run as
# root by smart-snapshot.timer. Writes one world-readable JSON document
# describing every SMART-capable device, so the Quickshell Security
# Center renders real disk health with no privilege and no prompt.
#
# Output contract (the shell's SecurityBackend.qml parses exactly this):
#   { "generated": <epoch>, "devices": [ { ... }, ... ] }
# Each device: node, model, serial_tail, kind, passed, temp_c,
#              power_on_hours, percent_used, realloc, media_errors, capacity
#
# `serial_tail` is the LAST FOUR characters of the serial only. A full
# serial is a hardware identifier that would otherwise sit in a
# world-readable file for no benefit -- four characters is enough to tell
# two identical SN850X drives apart, which is the only reason the UI
# needs it at all.
set -uo pipefail

OUT_DIR=/var/lib/security-center
OUT="$OUT_DIR/smart.json"
TMP="$OUT.$$"

mkdir -p "$OUT_DIR"

if ! command -v smartctl >/dev/null 2>&1; then
  printf '{"generated":%s,"error":"smartctl-missing","devices":[]}\n' "$(date +%s)" > "$TMP"
  mv -f "$TMP" "$OUT"; chmod 0644 "$OUT"
  exit 0
fi

# `smartctl --scan` emits one line per device: "/dev/sda -d scsi # ...".
# Take the node and the -d type; passing the type back explicitly is what
# makes NVMe vs SATA work without a second guess.
mapfile -t SCAN < <(smartctl --scan 2>/dev/null)

python3 - "$OUT" "$TMP" <<'PYEOF' "${SCAN[@]}"
import json, os, subprocess, sys, time

out, tmp = sys.argv[1], sys.argv[2]
scan_lines = sys.argv[3:]
devices = []

for line in scan_lines:
    line = line.split('#', 1)[0].strip()
    if not line:
        continue
    parts = line.split()
    node = parts[0]
    dtype = None
    if '-d' in parts:
        i = parts.index('-d')
        if i + 1 < len(parts):
            dtype = parts[i + 1]

    # TWO ATTEMPTS, auto-detect FIRST. `smartctl --scan` reported this
    # host's SATA drive as `-d scsi`, and that type returned a payload
    # with no model_name, no smart_status and a bogus temperature of 0 --
    # measured 2026-08-28, the drive rendered as "health is unknown" in
    # the UI while both NVMe drives parsed fine. smartctl's own
    # auto-detection (no -d at all) handles SAT/AHCI correctly, so try
    # that first and fall back to the scanned type only if it yields
    # nothing usable.
    attempts = [['smartctl', '--json', '-H', '-A', '-i', node]]
    if dtype:
        attempts.append(['smartctl', '--json', '-H', '-A', '-i', '-d', dtype, node])

    d = {}
    err = None
    for cmd in attempts:
        try:
            # smartctl uses its exit status as a BITMASK (bit 0 = command
            # line parse error, bits 1-2 = device open/failure, bit 3 =
            # disk failing). A non-zero exit is therefore normal and
            # informative, never a reason to discard the payload -- so
            # parse stdout regardless and let `passed` carry the verdict.
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
            cand = json.loads(r.stdout or '{}')
        except Exception as e:
            err = type(e).__name__
            continue
        # "Usable" means it actually answered the health question. A
        # payload that parses but carries no verdict is what the wrong
        # -d type produced, and taking it would mask the good attempt.
        if (cand.get('smart_status') or {}).get('passed') is not None:
            d = cand
            err = None
            break
        if not d:
            d = cand          # keep the first as a fallback
    if not d:
        devices.append({'node': node, 'kind': dtype or 'unknown',
                        'error': err or 'no-payload'})
        continue

    smart = d.get('smart_status') or {}
    passed = smart.get('passed')

    # 0 C is what a failed read reports here, not a real temperature --
    # normalise it away rather than rendering "0 °C" in the UI.
    temp = (d.get('temperature') or {}).get('current')
    if temp == 0:
        temp = None

    # Power-on hours live in different places for ATA vs NVMe.
    poh = (d.get('power_on_time') or {}).get('hours')

    # NVMe health log
    nvme = d.get('nvme_smart_health_information_log') or {}
    percent_used = nvme.get('percentage_used')
    media_errors = nvme.get('media_errors')
    if poh is None:
        poh = nvme.get('power_on_hours')
    if temp is None:
        temp = nvme.get('temperature')

    # ATA reallocated-sector count (id 5) -- the single most predictive
    # attribute for a spinning disk that is on its way out.
    realloc = None
    for a in ((d.get('ata_smart_attributes') or {}).get('table') or []):
        if a.get('id') == 5:
            realloc = (a.get('raw') or {}).get('value')
            break

    cap = (d.get('user_capacity') or {}).get('bytes')

    serial = d.get('serial_number') or ''
    devices.append({
        'node': node,
        'kind': dtype or 'unknown',
        'model': d.get('model_name') or d.get('scsi_model_name') or node,
        'serial_tail': serial[-4:] if serial else '',
        'passed': passed,
        'temp_c': temp,
        'power_on_hours': poh,
        'percent_used': percent_used,
        'media_errors': media_errors,
        'realloc': realloc,
        'capacity': cap,
    })

with open(tmp, 'w') as f:
    json.dump({'generated': int(time.time()), 'devices': devices}, f)
os.replace(tmp, out)
os.chmod(out, 0o644)
PYEOF

exit 0

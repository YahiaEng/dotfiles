#!/usr/bin/env bash
#
# libvirt qemu hook — single-GPU passthrough for the win11-gaming domain.
#
# libvirt invokes this as:
#     /etc/libvirt/hooks/qemu <guest> <operation> <sub-operation> <extra>
#
# Only the win11-gaming domain is acted on. EVERY OTHER GUEST FALLS THROUGH
# UNTOUCHED — this matters, because the same hook file is called for every
# VM on the host and a name check that was merely "contains windows" would
# tear the operator's desktop down for an unrelated guest.
#
# Pairing:
#   prepare/begin  -> vfio-gpu-bind    (host loses GPU; runs BEFORE qemu starts)
#   release/end    -> vfio-gpu-unbind  (host regains GPU; runs AFTER qemu exits)
#
# `release` is used rather than `stopped` deliberately: stopped fires while
# libvirt still holds the device, and rebinding nvidia there races the
# teardown and intermittently leaves the card in a half-claimed state.
#
# After installing or editing this file:  sudo systemctl restart libvirtd

set -uo pipefail

readonly GUEST=${1:-}
readonly OP=${2:-}
readonly SUBOP=${3:-}
readonly LOG=/var/log/vfio-hook.log
readonly TARGET_DOMAIN=win11-gaming

[ "$GUEST" = "$TARGET_DOMAIN" ] || exit 0

# ── THE NAME IS NOT ENOUGH. ASK THE DOMAIN WHAT IT ACTUALLY CONTAINS ──
# libvirt passes the full domain XML on STDIN. Read it, because this host
# defines the SAME domain name in two shapes — win11-install.xml (no
# passthrough, windowed, for running Windows Setup) and win11-gaming.xml
# (full passthrough). A name-only match cannot tell them apart.
#
# It failed exactly that way on 2026-08-29 06:32: starting INSTALL mode
# ran the GPU teardown, stopped sddm and bound the only display adapter
# to vfio-pci for a guest that passes nothing. The desktop went black,
# the windowed VM had nowhere to draw, and the machine needed a hard
# reboot. The log of that run is still in this file's own $LOG.
#
# So: tear the desktop down ONLY if the domain being started really has a
# PCI hostdev. Failing to read the XML is treated as "no passthrough" —
# the conservative direction, because the cost of skipping a teardown is
# a VM that cannot see its GPU, while the cost of a wrong teardown is a
# black screen and a hard reset.
DOMAIN_XML=$(cat 2>/dev/null || true)
case "$OP" in
    prepare|release|start|started|stopped)
        if printf '%s' "$DOMAIN_XML" | grep -q "<hostdev[^>]*type='pci'"; then
            HAS_PCI_PASSTHROUGH=yes
        else
            HAS_PCI_PASSTHROUGH=no
        fi
        ;;
    *) HAS_PCI_PASSTHROUGH=no ;;
esac

printf '%s [hook] %s %s %s (pci-passthrough=%s)\n' \
    "$(date -Is)" "$GUEST" "$OP" "$SUBOP" "$HAS_PCI_PASSTHROUGH" >> "$LOG"

# Linked host drives are device-mapper tables, and those do NOT survive a
# reboot. They must exist before qemu opens /dev/mapper/vm-main, and must
# be gone afterwards so the host is not left holding a mapping onto a
# partition the operator may want to mount. The helper is a no-op when
# nothing is recorded as linked.
DRIVES=/usr/local/lib/vm-drives/vm-drive-action

case "$OP/$SUBOP" in
    prepare/begin)
        # Linked-drive mappings are needed in BOTH modes — the disk is in
        # the domain either way — so this is outside the passthrough gate.
        #
        # ── FAIL BEFORE THE TEARDOWN, NEVER AFTER ─────────────────────
        # The rebuild's exit status used to be discarded. That is how a
        # failed mapping cost a desktop on 2026-08-29: rebuild refused,
        # the hook carried on, sddm was stopped and the GPU bound to
        # vfio-pci, and only THEN did qemu discover it could not open the
        # boot disk — so the domain died and the operator was dropped at
        # an SDDM login with nothing on screen explaining why.
        #
        # libvirt aborts the start when this hook exits non-zero, so
        # checking here turns that whole sequence into `virsh start`
        # printing an error with the desktop still up. A missing mapping
        # can never be recovered by continuing, so there is nothing to
        # trade away.
        if [ -x "$DRIVES" ]; then
            if ! "$DRIVES" rebuild >>"$LOG" 2>&1; then
                printf '%s [hook] drive mapping rebuild FAILED — refusing to start; desktop left up\n' \
                    "$(date -Is)" >> "$LOG"
                exit 1
            fi
        fi
        if [ "$HAS_PCI_PASSTHROUGH" = yes ]; then
            exec /usr/local/bin/vfio-gpu-bind
        fi
        printf '%s [hook] no PCI passthrough in this domain — leaving the desktop up\n' \
            "$(date -Is)" >> "$LOG"
        exit 0
        ;;
    release/end)
        [ -x "$DRIVES" ] && "$DRIVES" teardown >>"$LOG" 2>&1
        if [ "$HAS_PCI_PASSTHROUGH" = yes ]; then
            exec /usr/local/bin/vfio-gpu-unbind
        fi
        exit 0
        ;;
    *)  exit 0 ;;
esac

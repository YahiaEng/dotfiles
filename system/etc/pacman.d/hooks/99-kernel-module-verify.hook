# Verify every installed kernel can load its out-of-tree drivers.
#
# Backstop for the 2026-07-28 incident: kernel 7.1.5-arch1-1 was installed but
# nvidia-open-dkms was never built for it, and nothing reported the gap. The
# failure surfaced as a black screen at the next boot.
#
# The 99- prefix sorts this strictly after 70-dkms-install.hook, so it observes
# the state that hook left behind rather than racing it. Triggers mirror the
# upstream install hook's, so it fires on exactly the transactions that can
# break this: a kernel landing, or a DKMS module source changing.
#
# Deliberately NO `Depends = dkms`. The script's second pass covers prebuilt
# module packages (nvidia-open / nvidia-open-lts), which are used on systems
# with no DKMS installed at all — precisely the configuration that pass exists
# to protect. Depending on dkms would reintroduce the blind spot at the hook
# level.
#
# Failure here is advisory — pacman reports the non-zero exit but the
# transaction has already completed. That is the point: the operator learns
# about it while still in a working session, not after rebooting.

[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/modules.order
Target = usr/src/*/dkms.conf

[Action]
Description = Verifying kernel modules exist for all installed kernels
When = PostTransaction
Exec = /usr/local/bin/kernel-module-verify

{
  "clock": {
    "actions": {
      "on-click-right": "mode",
      "on-scroll-down": "shift_down",
      "on-scroll-up": "shift_up"
    },
    "calendar": {
      "format": {
        "days": "<span color='#cdd6f4'>{}</span>",
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "today": "<span color='#1e1e2e' background='#cba6f7'><b> {} </b></span>",
        "weekdays": "<span color='#f5c2e7'><b>{}</b></span>",
        "weeks": "<span color='#585b70'>W{}</span>"
      },
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "weeks-pos": "left"
    },
    "format": "  {:%H:%M}",
    "format-alt": "  {:%A, %B %d, %Y}",
    "tooltip-format": "<tt><big>{:%B %Y}</big>\n\n{calendar}</tt>"
  },
  "custom/gaming-mode": {
    "exec": "if [ \"$(cat $HOME/.cache/gaming-mode 2>/dev/null)\" = \"on\" ]; then echo '{\"alt\":\"on\",\"class\":\"on\",\"tooltip\":\"Gaming Mode: ON\"}'; else echo '{\"alt\":\"off\",\"class\":\"off\",\"tooltip\":\"Gaming Mode: OFF\"}'; fi",
    "format": "{icon}",
    "format-icons": {
      "off": "\udb80\udeb5",
      "on": "\udb80\udeb4"
    },
    "interval": 2,
    "return-type": "json"
  },
  "custom/notification": {
    "escape": true,
    "exec": "swaync-client -swb",
    "exec-if": "which swaync-client",
    "format": "{icon} {}",
    "format-icons": {
      "dnd-inhibited-none": "\udb80\udc9b",
      "dnd-inhibited-notification": "\udb80\udc9b<span foreground='red'><sup></sup></span>",
      "dnd-none": "\udb80\udc9b",
      "dnd-notification": "\udb80\udc9b<span foreground='red'><sup></sup></span>",
      "inhibited-none": "\udb80\udc9c",
      "inhibited-notification": "\udb80\udc9a<span foreground='red'><sup></sup></span>",
      "none": "\udb80\udc9c",
      "notification": "\udb80\udc9a<span foreground='red'><sup></sup></span>"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "return-type": "json",
    "tooltip": false
  },
  "height": 36,
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "\u4e00",
      "10": "\u5341",
      "2": "\u4e8c",
      "3": "\u4e09",
      "4": "\u56db",
      "5": "\u4e94",
      "6": "\u516d",
      "7": "\u4e03",
      "8": "\u516b",
      "9": "\u4e5d"
    },
    "on-click": "activate",
    "persistent-workspaces": {
      "*": 5
    },
    "sort-by-number": true
  },
  "layer": "top",
  "margin-left": 10,
  "margin-right": 10,
  "margin-top": 6,
  "modules-center": [
    "mpris",
    "clock"
  ],
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "custom/gaming-mode",
    "custom/notification",
    "tray"
  ],
  "mpris": {
    "format": "{player_icon}  {title}",
    "format-paused": "{status_icon}  {title}",
    "format-stopped": "",
    "max-length": 30,
    "on-click": "~/.config/hypr/scripts/media-popup-open.sh",
    "on-click-right": "playerctl next",
    "on-scroll-down": "playerctl volume 0.05-",
    "on-scroll-up": "playerctl volume 0.05+",
    "player-icons": {
      "chromium": "",
      "default": "",
      "firefox": "",
      "mpv": "\u25b6",
      "spotify": ""
    },
    "status-icons": {
      "paused": "",
      "stopped": ""
    },
    "tooltip-format": "{player}: {artist} \u2014 {title}\n{album}\n{position} / {length}"
  },
  "on-sigusr1": "hide",
  "on-sigusr2": "reload",
  "position": "top",
  "spacing": 0,
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}

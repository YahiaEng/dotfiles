{
    "include": ["modules.jsonc"],

    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "mpris",
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "pulseaudio",
        "network",
        "custom/theme",
        "custom/waybar-layout",
        "tray",
        "custom/notification",
        "custom/power"
    ]

    // Every module used above is defined once in modules.jsonc, verbatim
    // from this file's pre-refactor content — full's definitions ARE the
    // canonical ones, so nothing is redefined here (D-31/D-33).
}

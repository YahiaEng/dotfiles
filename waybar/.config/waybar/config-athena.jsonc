{
    // ╔══════════════════════════════════════════════════════╗
    // ║   ATHENA — scrapped-and-rebuilt 'minimal' (08-16)     ║
    // ║   Reproduces the Athena reference waybar's SHAPE      ║
    // ║   (github.com/haikal-hakim/athena/tree/main/.config/  ║
    // ║   waybar) — discrete rounded capsules, live-window    ║
    // ║   workspace icons, hover-expand drawers, an           ║
    // ║   app-launcher drawer — expressed entirely through    ║
    // ║   this repo's theme.css alias layer (08-athena-DESIGN ║
    // ║   .md is the binding contract). No colour is defined  ║
    // ║   in this file; every glyph below is cmap-verified    ║
    // ║   against FiraCode Nerd Font per the 08-11 discipline.║
    // ╚══════════════════════════════════════════════════════╝
    "include": ["modules.jsonc", "bar-common.jsonc"],

    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,

    // ── Rule 4 arrangement (08-16 checkpoint iteration) ───────────────
    // custom/updates sits beside the storage/system pills and only
    // appears when `checkupdates` reports >0 (its own exec-if hides it
    // otherwise). custom/media (AGS media applet opener) sits beside the
    // audio group. The settings drawer (theme/waybar/font/icons/wallpaper)
    // replaces the old tray-folded settings buttons. custom/notification
    // is now a standalone module next to custom/power (was buried in the
    // tray drawer).
    "modules-left": ["group/apps", "group/storage", "group/system", "custom/updates"],
    "modules-center": ["hyprland/workspaces", "idle_inhibitor"],
    // 08-16 checkpoint iter 2: `tray` removed — its nm-applet/blueman
    // icons visually duplicated the network+bluetooth already in
    // group/connections (user: "duplicate bluetooth/network next to
    // gaming mode, remove it"). group/settings moved to sit directly
    // left of custom/power (user request).
    "modules-right": [
        "custom/media",
        "group/audio",
        "group/connections",
        "clock",
        "custom/gaming-mode",
        "custom/notification",
        "group/settings",
        "custom/power"
    ],

    // ── Groups/drawers (Athena's modules/groups.jsonc, adapted) ──────
    "group/apps": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/app-launcher",
            "custom/app-zen",
            "custom/app-spotify",
            "custom/app-discord",
            "custom/app-steam",
            "custom/app-lutris",
            "custom/app-obsidian",
            "custom/app-codium"
        ]
    },
    "group/storage": {
        "orientation": "horizontal",
        "modules": ["disk", "memory"]
    },
    "group/system": {
        "orientation": "horizontal",
        "modules": ["temperature", "cpu"]
    },
    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 650,
            "transition-left-to-right": false
        },
        "modules": ["pulseaudio", "pulseaudio/slider", "pulseaudio#microphone"]
    },
    "group/connections": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false
        },
        "modules": ["network", "bluetooth"]
    },
    // ── Settings drawer (08-16 checkpoint) ──────────────────────────
    // The 08-12/first-athena build folded custom/theme + custom/waybar-
    // layout into the TRAY drawer, where they were invisible until the
    // tray capsule was hovered (the "settings glyph is missing" the user
    // reported). They now live in a dedicated, discoverable settings
    // drawer behind a gear launcher, expanded to the full five switch
    // axes the repo owns: theme, waybar layout, font, icons, wallpaper —
    // every one an existing script (theme-switch / waybar-switch /
    // font-switch / icon-theme-switch / wallpaper-switch). custom/theme,
    // custom/waybar-layout, custom/font, custom/icon-theme, custom/
    // wallpaper are all canonically defined in modules.jsonc (D-31),
    // referenced here by name. Collapsed glyph U+F013 -> fa-gear.
    "group/settings": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false
        },
        "modules": [
            "custom/settings",
            "custom/theme",
            "custom/waybar-layout",
            "custom/font",
            "custom/icon-theme",
            "custom/wallpaper"
        ]
    },
    "custom/settings": {
        "format": "",
        "tooltip": false
    },

    // Athena redefinition of custom/updates (modules.jsonc's canonical
    // form is the verbose "{} Update(s)" text; this glyph-first shape
    // fits athena's icon-centric pills). exec/exec-if/on-click inherit
    // from the canonical def via whole-key first-defined-wins? No —
    // whole-key means this WHOLE object replaces it, so exec/exec-if are
    // restated here. Glyph U+F06B0 -> md-update. Only appears when
    // checkupdates reports >0.
    "custom/updates": {
        "format": "󰚰 {}",
        "exec": "checkupdates | wc -l",
        "exec-if": "[ $(checkupdates 2>/dev/null | wc -l) -gt 0 ]",
        "interval": 900,
        "tooltip-format": "{} update(s) available",
        "on-click": "kitty -e paru -Syu"
    },

    // ── App-launcher drawer members — uwsm app -- <target>.desktop ───
    // Collapsed glyph: md-apps (U+F003B).
    "custom/app-launcher": {
        "format": "󰀻",
        "tooltip": false
    },
    "custom/app-zen": {
        // fa-firefox (U+F269) — no dedicated Zen glyph exists in this
        // font; Zen is Firefox-based, so the Firefox-family icon is the
        // closest cmap-verified representation. Distinct from the
        // window-rewrite "firefox" key's seti-firefox glyph below.
        "format": "",
        "tooltip-format": "Zen Browser",
        "tooltip": false,
        "on-click": "uwsm app -- zen.desktop"
    },
    "custom/app-spotify": {
        "format": "",
        "tooltip-format": "Spotify",
        "tooltip": false,
        "on-click": "uwsm app -- spotify.desktop"
    },
    "custom/app-discord": {
        "format": "",
        "tooltip-format": "Discord",
        "tooltip": false,
        "on-click": "uwsm app -- discord.desktop"
    },
    "custom/app-steam": {
        "format": "",
        "tooltip-format": "Steam",
        "tooltip": false,
        "on-click": "uwsm app -- steam.desktop"
    },
    "custom/app-lutris": {
        "format": "",
        "tooltip-format": "Lutris",
        "tooltip": false,
        "on-click": "uwsm app -- net.lutris.Lutris.desktop"
    },
    "custom/app-obsidian": {
        "format": "󰹕",
        "tooltip-format": "Obsidian",
        "tooltip": false,
        "on-click": "uwsm app -- obsidian.desktop"
    },
    "custom/app-codium": {
        "format": "󰨞",
        "tooltip-format": "VSCodium",
        "tooltip": false,
        "on-click": "uwsm app -- codium.desktop"
    },

    // ── Workspaces — Athena's {icon} {windows} + live window-rewrite ─
    "hyprland/workspaces": {
        "format": "{icon} {windows}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 5
        },
        "all-outputs": true,
        // md-ghost (U+F02A0) — same glyph used below as the default
        // format-icons class, so an unmapped window still reads as
        // "this repo's default workspace glyph", not a foreign class.
        "window-rewrite-default": "󰊠",
        "window-rewrite": {
            "kitty": "󰆍",
            "firefox": "",
            "zen": "",
            "codium": "󰨞",
            "VSCodium": "󰨞",
            "discord": "",
            "spotify": "",
            "obsidian": "󰹕",
            "net.lutris.Lutris": "",
            "steam": "",
            "thunar": "",
            "yazi": "󰇥"
        },
        "format-icons": {
            "active": "󰮯",
            "default": "󰊠",
            "urgent": "󰧵",
            "empty": ""
        }
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰛨",
            "deactivated": "󰛩"
        },
        "tooltip-format-activated": "System Focused",
        "tooltip-format-deactivated": "Normal Mode"
    },

    // ── Storage/system pills — icon-only at rest, click reveals the ──
    // ── value via format-alt (Athena's reveal-on-click behaviour, the ─
    // ── same "actions": {"on-click": "mode"} idiom modules.jsonc's own
    // clock module already uses). No "disk" module exists canonically
    // anywhere in this repo yet — defined fresh here, athena-owned.
    "disk": {
        "tooltip": false,
        "interval": 3600,
        "path": "/",
        // md-database_cog (U+F164B)
        "format": "󱙋",
        "format-alt": "󱙋 <span size='11pt'>{used}</span>",
        "states": {
            "warning": 80,
            "critical": 90
        },
        "actions": {
            "on-click": "mode"
        }
    },
    // Athena-specific redefinition of memory: icon-only at rest (the
    // modules.jsonc canonical version is always-on-text; this layout's
    // storage pill wants Athena's collapsed-glyph/click-reveal shape).
    "memory": {
        "tooltip": false,
        "interval": 5,
        // md-memory (U+F035B)
        "format": "󰍛",
        "format-alt": "󰍛 <span size='11pt'>{used:.1f}G</span>",
        "states": {
            "warning": 75,
            "critical": 85
        },
        "actions": {
            "on-click": "mode"
        }
    },
    "cpu": {
        "tooltip": false,
        "interval": 2,
        // md-cpu_64_bit (U+F0EE0)
        "format": "󰻠",
        "format-alt": "󰻠 <span size='11pt'>{usage}%</span>",
        "states": {
            "warning": 75,
            "critical": 90
        },
        "actions": {
            "on-click": "mode"
        }
    },
    // No thermal-zone override: this machine only has acpitz zones
    // (0/1), the same default modules.jsonc's own temperature module
    // already relies on — verified live, not copied from Athena's
    // zone 8 blindly (design_system Rule 4 / plan Task 2 instruction).
    "temperature": {
        "tooltip": false,
        "interval": 10,
        "critical-threshold": 80,
        "format": "{icon}",
        "format-alt": "{icon} <span size='11pt'>{temperatureC}°C</span>",
        // fa-thermometer_empty/_half/_full (U+F2CB/F2C9/F2C7) — the
        // same 3-of-5-step family already cmap-verified in 08-11.
        "format-icons": ["", "", ""]
    },

    // ── Audio drawer — icon-only pulseaudio + slider + mic toggle ────
    "pulseaudio": {
        "format": "{icon}",
        // fa-volume_xmark (U+EEE8) — distinct from the volume-ramp
        // icons below, matches Athena's own muted/ramp distinction.
        "format-muted": "",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋋",
            "hands-free": "󰋋",
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        // 15-08: right-click used to launch the standalone mixer GUI.
        // It now opens the shell-root audio panel through 15-03's single
        // IpcHandler (target "panel", verb "toggle") instead — the mixer
        // moves one level deeper, behind the panel's Advanced button
        // (D-15-05, PANEL-05). Left-click mute is unchanged.
        "on-click-right": "qs ipc call panel toggle audio",
        "tooltip-format": "Output: {volume}%"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "",
        "format-source-muted": ""
    },

    // ── Connections drawer — network + bluetooth ──────────────────────
    "network": {
        "format-wifi": "{icon}",
        // md-ethernet (U+F0200)
        "format-ethernet": "󰈀",
        // md-wifi_strength_off_outline (U+F092E) — same glyph already
        // cmap-verified for this exact concept in modules.jsonc (08-11).
        "format-disconnected": "󰤮",
        // md-wifi_off (U+F05AA)
        "format-disabled": "󰖪",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-disconnected": "No Connection",
        "tooltip-format-disabled": "Wi-Fi is OFF",
        "tooltip-format-wifi": "󱄙  {essid} ({signalStrength}%)\n\n󰐻  Freq: {frequency}GHz\n  {bandwidthDownBytes}     {bandwidthUpBytes}",
        "tooltip-format-ethernet": "󰈀  {ifname} (Connected)\n  {bandwidthDownBytes}     {bandwidthUpBytes}",
        // 15-08: this left-click launched an applet into a tray that
        // athena deliberately removed (see the tray-removal comment at
        // the top of this file) -- the click had been dead ever since.
        // It now opens the shell-root wifi panel through 15-03's single
        // IpcHandler (target "panel", verb "toggle") (D-15-05, PANEL-03).
        // The right-click that used to kill that applet is removed
        // outright, not repointed: once nothing here ever starts the
        // applet, a click that kills it has nothing left to do.
        "on-click": "qs ipc call panel toggle wifi"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-disabled": "󰂲",
        "tooltip-format": "{controller_alias} {status}",
        "tooltip-format-connected": "󰐻  {num_connections} Connected:\n{device_enumerate}",
        "tooltip-format-enumerate-connected-battery": "󰂱  {device_alias} (󰠠  {device_battery_percentage}%)",
        // 15-08: left-click used to launch the standalone Bluetooth
        // manager GUI. It now opens the shell-root bluetooth panel
        // through 15-03's single IpcHandler (target "panel", verb
        // "toggle") instead -- the manager moves one level deeper,
        // behind the panel's Advanced button (D-15-05, PANEL-04,
        // PANEL-05).
        "on-click": "qs ipc call panel toggle bluetooth",
        // Radio toggle preserved byte-identical -- no panel here.
        "on-click-right": "rfkill toggle bluetooth"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }

    // clock, custom/notification, custom/theme, custom/waybar-layout,
    // custom/gaming-mode, custom/power all reused verbatim from
    // modules.jsonc (D-31) — no athena-specific change needed.
    // Battery and power-profiles-daemon are dropped entirely
    // (desktop / inactive, design_system Rule 4) — neither is
    // referenced anywhere in this file.
}

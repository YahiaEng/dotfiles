{
    "include": ["modules.jsonc", "bar-common.jsonc"],

    // ── Bar geometry (D-11/D-14/D-15, UI-SPEC Vertical Layout table) ────
    "layer": "top",
    "position": "left",
    "width": 48,
    "margin-left": 8,
    "margin-top": 8,
    "margin-bottom": 8,
    "spacing": 0,
    // NO "output" key (D-15) — draws on every monitor, exactly like the
    // other three layouts. NO "margin-right" — flush-left column (D-14).
    // The fixed hide/reload signal contract is inherited from
    // bar-common.jsonc, not redeclared here (08-03's owner contract).

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock", "mpris"],
    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "pulseaudio",
        "network",
        "battery",
        "custom/gaming-mode",
        "custom/notification",
        "tray",
        "custom/power"
    ],

    // ── Full redefinitions (whole-key, first-defined-wins — never a ────
    // ── partial patch; see 08-01-SUMMARY.md / 08-CONTEXT.md D-31). ─────
    // hyprland/workspaces, custom/gaming-mode, custom/power and tray are
    // NOT redefined here — their canonical modules.jsonc definitions are
    // already column-correct (bare glyph already), referenced by name.

    // D-13: glyph-only. Detail (artist/title/album/position) moves to
    // tooltip-format, kept byte-identical to the canonical definition so
    // 08-08's on-click re-point has one predictable place per layout.
    //
    // Glyph fix (deviation, recorded in SUMMARY): the canonical
    // modules.jsonc mpris "player-icons"/"status-icons" are empty
    // strings for every entry except "mpv" (a pre-existing, repo-wide
    // gap predating this phase — verified via direct byte inspection,
    // not present in this plan's authorship). Copying them verbatim
    // into a glyph-ONLY format would render this widget invisible for
    // every player except mpv. Substituted cmap-verified glyphs: music/
    // spotify already live in this same file's custom/media definition;
    // pause (fa-pause, U+F04C) already live in this SAME phase's
    // eww.yuck (08-07) playing-state icon; firefox/chromium are newly
    // cmap-verified against the installed FiraCodeNerdFont-Regular.ttf
    // (1.00-cell, recorded in SUMMARY). "stopped" status-icon is left
    // empty, matching canonical — format-stopped is itself "" and never
    // invokes {status_icon}.
    "mpris": {
        "format": "{player_icon}",
        "format-paused": "{status_icon}",
        "format-stopped": "",
        "player-icons": {
            "default": "",
            "spotify": "",
            "firefox": "",
            "chromium": "",
            "mpv": "▶"
        },
        "status-icons": {
            "paused": "",
            "stopped": ""
        },
        "on-click": "~/.config/hypr/scripts/media-popup-open.sh",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-",
        "tooltip-format": "{player}: {artist} — {title}\n{album}\n{position} / {length}"
    },

    // Glyph fix (deviation, recorded in SUMMARY): canonical pulseaudio's
    // "format-icons"/"format-muted" are empty/textual placeholders (same
    // pre-existing repo-wide gap as mpris above). Substituted
    // config-floating.jsonc's own already-live, already-rendering
    // pulseaudio icon set verbatim (fa-volume_off/_low/_up) instead of
    // the literal plan instruction to reuse "the canonical" array, since
    // the canonical one is empty on this machine.
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip-format": "{volume}% — {desc}"
    },

    // format-icons/disconnected/ethernet glyph taken VERBATIM from
    // config-floating.jsonc's own network definition (already live,
    // already rendering on this machine today).
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰍹",
        "format-disconnected": "󰤮",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\n{essid}",
        "tooltip-format-wifi": "󰕒 {bandwidthUpBytes} / 󰇚 {bandwidthDownBytes}",
        "tooltip-format-ethernet": "󰕒 {bandwidthUpBytes} / 󰇚 {bandwidthDownBytes}",
        "tooltip-format-disconnected": "Disconnected!"
    },

    // states/format-icons reused verbatim from the canonical (already
    // floating-sourced, already valid) battery definition — glyph-only
    // format, detail moved to tooltip-format.
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon}",
        "format-charging": "",
        "format-plugged": "",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity}% — {time}"
    },

    // format-icons/return-type/exec-if/exec/on-click/on-click-right/
    // escape kept byte-identical to the canonical definition — only the
    // format changes (drops the trailing "{}" notification count text)
    // AND "tooltip" flips false->true (deviation, recorded in SUMMARY):
    // this is a return-type:json custom module, and swaync-client -swb
    // already emits a real "tooltip" field in its JSON payload (verified
    // live: {"text":"16","alt":"notification","tooltip":"16
    // Notifications","class":"notification"}) — waybar surfaces that
    // field as the hover tooltip automatically once "tooltip" isn't
    // false. That is the dropped notification-count detail's new home,
    // satisfying D-13 without a static tooltip-format (which return-
    // type:json custom modules don't use for this purpose).
    "custom/notification": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚<span foreground='red'><sup></sup></span>",
            "none": "󰂜",
            "dnd-notification": "󰂛<span foreground='red'><sup></sup></span>",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚<span foreground='red'><sup></sup></span>",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    // Stacked readout (D-12 locked decision overrides UI-SPEC's blanket
    // "no text label, ever" — see SUMMARY for the reasoning). Hours over
    // minutes, no glyph, no seconds. Calendar tooltip + actions kept
    // byte-identical to the canonical definition (hover calendar is
    // already the D-13 "detail goes to tooltips" pattern).
    "clock": {
        "format": "{:%H\n%M}",
        "tooltip-format": "<tt><big>{:%B %Y}</big>\n\n{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#cba6f7'><b>{}</b></span>",
                "days":     "<span color='#cdd6f4'>{}</span>",
                "weeks":    "<span color='#585b70'>W{}</span>",
                "weekdays": "<span color='#f5c2e7'><b>{}</b></span>",
                "today":    "<span color='#1e1e2e' background='#cba6f7'><b> {} </b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // Stacked readouts (D-12 locked decision): glyph line 1, <small>-
    // wrapped value line 2 — de-emphasises the number against the 20px
    // glyph base size with no extra CSS rule (waybar/Pango markup is on
    // by default for these built-in modules). Glyph fix (deviation): the
    // canonical cpu/memory format strings carry no icon at all (blank
    // prefix, pre-existing gap) — substituted config-floating.jsonc's
    // own already-live cpu/memory glyphs (fa-microchip / fa-reorder)
    // instead of the empty "canonical" ones.
    "cpu": {
        "format": "\n<small>{usage}%</small>",
        "interval": 2,
        "tooltip": true
    },

    "memory": {
        "format": "\n<small>{percentage}%</small>",
        "interval": 5,
        "tooltip-format": "{used:.1f}G / {total:.1f}G"
    },

    // Glyph fix (deviation): canonical temperature's format-icons array
    // is 5 empty strings (pre-existing gap) — substituted a cmap-
    // verified graduated fa-thermometer set (empty->full), mirroring the
    // same empty-to-full ascending order the canonical battery array
    // already uses. critical-threshold and format-icons kept so the
    // shared #temperature.critical CSS rule keeps firing on the class,
    // independent of which icon is showing.
    "temperature": {
        "critical-threshold": 80,
        "format": "{icon}\n<small>{temperatureC}°C</small>",
        "format-icons": ["", "", "", "", ""],
        "tooltip": true
    }
}

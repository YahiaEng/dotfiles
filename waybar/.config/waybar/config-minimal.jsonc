{
    "include": ["modules.jsonc", "bar-common.jsonc"],

    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["mpris", "clock"],
    "modules-right": ["custom/notification", "tray"],

    // ── Full redefinitions (this layout's definition wins over the ─────
    // ── shared one — waybar include is whole-key first-defined-wins, ───
    // ── never a partial patch) ──────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十"
        },
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 5
        }
    },

    "mpris": {
        "format": "{player_icon}  {title}",
        "format-paused": "{status_icon}  {title}",
        "format-stopped": "",
        "player-icons": {
            "default": "",
            "spotify": "",
            "firefox": "",
            "chromium": "",
            "mpv": "▶"
        },
        "status-icons": {
            "paused": "",
            "stopped": ""
        },
        "max-length": 30,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-",
        "tooltip-format": "{player}: {artist} — {title}\n{album}\n{position} / {length}"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}

#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║         WAYBAR-EQUIVALENCE-CHECK (D-34)               ║
# ║  Rerunnable rendered-config equivalence gate: resolves ║
# ║  each config-*.jsonc's include-chain the way waybar    ║
# ║  0.15.0 actually does (first-defined-wins, whole-key,  ║
# ║  depth-first — see waybar(5) INCLUDE) and diffs it     ║
# ║  against a pre-refactor baseline snapshot. Report-only ║
# ║  — never mutates state, never invokes waybar itself.   ║
# ╚══════════════════════════════════════════════════════╝
#
# Usage:
#   waybar-equivalence-check [waybar-dir]
#       Resolve every config-*.jsonc under waybar-dir (default
#       ~/.config/waybar) and diff each against the committed baseline in
#       .planning/phases/08-waybar-evolution/.waybar-config-baseline/.
#       Exit 0 only if every layout that HAS a baseline matches it
#       byte-for-byte. A layout with no baseline (added later than the
#       baseline snapshot) is reported SKIP, not FAIL.
#
#   waybar-equivalence-check --snapshot <outdir> [waybar-dir]
#       Write <outdir>/{layout}.json for every config-*.jsonc found (glob,
#       never a hardcoded list). Run this ONCE, before any refactor edit
#       lands, to capture the pre-refactor ground truth D-34 compares
#       against.
#
#   waybar-equivalence-check --resolve <config-path>
#       Emit one config file's normalized, recursively resolved effective
#       config as key-sorted JSON on stdout. Helper mode used internally by
#       the two modes above, and directly useful for ad-hoc inspection.
#
# This script never runs waybar and never edits any config file — it only
# *proves* that waybar's own include resolution, done by hand here with the
# documented algorithm, produces an unchanged effective config per layout.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$REPO_ROOT" ]]; then
    # Fallback if this ever runs outside a git checkout of the dotfiles repo:
    # hypr/.config/hypr/scripts -> repo root is 4 levels up.
    REPO_ROOT="$(cd -- "$SCRIPT_DIR/../../../.." &>/dev/null && pwd)"
fi
BASELINE_DIR="$REPO_ROOT/.planning/phases/08-waybar-evolution/.waybar-config-baseline"

# ── Mode dispatch ────────────────────────────────────────────────────────
MODE="check"
OUTDIR=""
WAYBAR_DIR=""
RESOLVE_PATH=""

if [[ "${1:-}" == "--snapshot" ]]; then
    MODE="snapshot"
    OUTDIR="${2:?waybar-equivalence-check --snapshot requires an output directory}"
    WAYBAR_DIR="${3:-$HOME/.config/waybar}"
elif [[ "${1:-}" == "--resolve" ]]; then
    MODE="resolve"
    RESOLVE_PATH="${2:?waybar-equivalence-check --resolve requires a config path}"
else
    MODE="check"
    WAYBAR_DIR="${1:-$HOME/.config/waybar}"
fi

# ── Resolver: strip JSONC comments, resolve include depth-first with     ──
# ── first-defined-wins whole-key semantics, emit key-sorted JSON.        ──
resolve_layout() {
    local config_path="$1"
    python3 - "$config_path" <<'PYEOF'
import json
import os
import sys


def strip_jsonc_comments(text):
    """Character scanner that strips // line comments and /* */ block
    comments while never treating a // or /* inside a quoted JSON string
    value as a comment delimiter (T-08-11)."""
    out = []
    i = 0
    n = len(text)
    in_string = False
    escape = False
    while i < n:
        c = text[i]
        if in_string:
            out.append(c)
            if escape:
                escape = False
            elif c == '\\':
                escape = True
            elif c == '"':
                in_string = False
            i += 1
            continue
        if c == '"':
            in_string = True
            out.append(c)
            i += 1
            continue
        if c == '/' and i + 1 < n and text[i + 1] == '/':
            j = text.find('\n', i)
            if j == -1:
                i = n
            else:
                out.append('\n')
                i = j + 1
            continue
        if c == '/' and i + 1 < n and text[i + 1] == '*':
            j = text.find('*/', i + 2)
            if j == -1:
                i = n
            else:
                i = j + 2
            continue
        out.append(c)
        i += 1
    return ''.join(out)


def resolve_include_path(inc, base_dir):
    p = os.path.expanduser(inc)
    p = os.path.expandvars(p)
    if not os.path.isabs(p):
        p = os.path.join(base_dir, p)
    return p


def resolve_config(path, seen=None):
    if seen is None:
        seen = set()
    real = os.path.realpath(path)
    if real in seen:
        raise ValueError(f"circular include detected at {path}")
    seen = seen | {real}

    with open(path, 'r', encoding='utf-8') as fh:
        raw = fh.read()
    stripped = strip_jsonc_comments(raw)
    data = json.loads(stripped)

    includes = data.get('include', [])
    if isinstance(includes, str):
        includes = [includes]

    # The including file's own keys always win outright (never overwritten
    # by anything an include provides) — waybar(5): "the first defined
    # value takes precedence, i.e. including file -> first included file ->
    # etc."
    result = {k: v for k, v in data.items() if k != 'include'}

    base_dir = os.path.dirname(os.path.abspath(path))
    for inc in includes:
        inc_path = resolve_include_path(inc, base_dir)
        included_resolved = resolve_config(inc_path, seen)
        for k, v in included_resolved.items():
            if k not in result:
                result[k] = v

    return result


if __name__ == '__main__':
    target = sys.argv[1]
    try:
        resolved = resolve_config(target)
        with open(target, 'r', encoding='utf-8') as fh:
            own_data = json.loads(strip_jsonc_comments(fh.read()))
        own_keys = {k for k in own_data.keys() if k != 'include'}
    except Exception as exc:  # noqa: BLE001 - report and fail, never silently pass
        print(f"waybar-equivalence-check: failed to resolve {target}: {exc}", file=sys.stderr)
        sys.exit(1)

    # "Effective config" = every key the including file defines directly
    # (bar-level options, plus any module it fully redefines itself) PLUS
    # any module key pulled in purely via include that is actually
    # referenced by modules-left/-center/-right. A shared module
    # definition nobody on this layout lists is inert JSON — waybar never
    # instantiates a widget for it — so it must not count as an effective
    # behavior difference between the pre-refactor standalone file (which
    # never had unused module keys lying around) and the post-refactor
    # include-composed one (where modules.jsonc legitimately holds
    # definitions other layouts use).
    used = set()
    for arr_key in ('modules-left', 'modules-center', 'modules-right'):
        used |= set(resolved.get(arr_key, []) or [])

    effective = {k: v for k, v in resolved.items() if k in own_keys or k in used}
    print(json.dumps(effective, sort_keys=True, indent=2))
PYEOF
}

# ── --resolve: single-file helper, no baseline involved ──────────────────
if [[ "$MODE" == "resolve" ]]; then
    resolve_layout "$RESOLVE_PATH"
    exit $?
fi

# ── --snapshot: capture ground truth, no comparison ───────────────────────
if [[ "$MODE" == "snapshot" ]]; then
    mkdir -p "$OUTDIR"
    shopt -s nullglob
    FILES=("$WAYBAR_DIR"/config-*.jsonc)
    shopt -u nullglob
    if [[ ${#FILES[@]} -eq 0 ]]; then
        echo "waybar-equivalence-check: no config-*.jsonc files found under $WAYBAR_DIR" >&2
        exit 1
    fi
    fail=0
    for f in "${FILES[@]}"; do
        layout="$(basename "$f" .jsonc)"
        layout="${layout#config-}"
        if resolve_layout "$f" > "$OUTDIR/$layout.json"; then
            echo "  [OK] snapshot written: $OUTDIR/$layout.json"
        else
            echo "  [FAIL] snapshot failed for $layout" >&2
            fail=1
        fi
    done
    exit "$fail"
fi

# ── Default: check mode — resolve every layout, diff against baseline ────
PASS=0
FAIL=0

shopt -s nullglob
FILES=("$WAYBAR_DIR"/config-*.jsonc)
shopt -u nullglob

if [[ ${#FILES[@]} -eq 0 ]]; then
    echo "waybar-equivalence-check: no config-*.jsonc files found under $WAYBAR_DIR" >&2
    exit 1
fi

TMP_FILES=()
cleanup() {
    local t
    for t in "${TMP_FILES[@]}"; do
        rm -f "$t"
    done
}
trap cleanup EXIT

echo "waybar-equivalence-check — resolved-config equivalence ($WAYBAR_DIR)"
echo ""

for f in "${FILES[@]}"; do
    layout="$(basename "$f" .jsonc)"
    layout="${layout#config-}"
    baseline_file="$BASELINE_DIR/$layout.json"

    if [[ ! -f "$baseline_file" ]]; then
        echo "  [SKIP] $layout (no baseline — new layout)"
        continue
    fi

    tmp_resolved="$(mktemp)"
    TMP_FILES+=("$tmp_resolved")

    if ! resolve_layout "$f" > "$tmp_resolved"; then
        echo "  [FAIL] $layout: resolve failed"
        FAIL=$((FAIL + 1))
        continue
    fi

    if diff_out="$(diff -u "$baseline_file" "$tmp_resolved")"; then
        echo "  [PASS] $layout: matches baseline"
        PASS=$((PASS + 1))
    else
        echo "  [FAIL] $layout: differs from baseline"
        echo "$diff_out"
        FAIL=$((FAIL + 1))
    fi
done

echo ""
echo "PASS: $PASS  FAIL: $FAIL"
[[ "$FAIL" -eq 0 ]]
exit $?

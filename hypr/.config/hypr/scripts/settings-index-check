#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════╗
# ║              SETTINGS-INDEX-CHECK (quick-260821-6z1)      ║
# ║  RowIndex/page-row completeness gate for the Quickshell    ║
# ║  settings window's search index.                           ║
# ╚══════════════════════════════════════════════════════════╝
#
# D-06/R-4: the settings search box (NavRail.qml) is backed by a
# declarative RowIndex.qml singleton, NOT a live walk of every page's
# instantiated rows (Pages.qml destroys the previous page before
# incubating the next — exactly one page object exists at a time, so a
# live index is structurally impossible). That makes RowIndex a SEPARATE
# source of truth from the page files themselves, which rots on the very
# first follow-up commit that adds a row to a page without adding its
# RowIndex entry in the same commit — silently: a missing entry is not a
# crash, not a load error, just a row nobody can find by typing its name.
# This gate is the mechanism that keeps the two in step.
#
# Every check strips `//`-comment lines before counting or matching, so a
# gate that greps its own or its target's prose can never inflate a count
# or produce a false match (this repo has already been bitten by exactly
# that class of bug elsewhere).
#
# CHECK A — for each (pageIdx, subPageIdx) pair, the count of matching
#           RowIndex entries equals the count of row-primitive
#           declarations (ToggleRow/SliderRow/SelectRow/NavRow/InfoRow/
#           StepperRow) in the pair's mapped page file. The index-to-file
#           mapping is parsed from PageCompRegistry.qml's own `comps:`
#           array — NEVER a hardcoded list, so this gate cannot itself
#           drift from the registry it checks against.
#
#           ── Pair keying (D-4, quick task 260825-wj2 Task 1) ───────────
#           A `comps[i]` entry may be a bare page Component (root only) OR
#           a StackPage wrapping N sub-pages (D-2) — the parser collects
#           EVERY `*Page` identifier declared inside a comp's own block, in
#           order, skipping the literal `StackPage` wrapper itself: index 0
#           is the root file, 1..N are its sub-pages. Root rows are keyed
#           by the literal text `pageIdx: $i, section:` (subPageIdx absent
#           means the root page); sub-page rows are keyed by
#           `pageIdx: $i, subPageIdx: $s, section:` — those exact strings
#           are the grep keys, so a RowIndex entry's canonical text must
#           match one of the two shapes verbatim.
# CHECK B — every RowIndex entry's `label` string appears verbatim
#           (fixed-string match, via `grep -F`, never a regex) in its
#           (pageIdx, subPageIdx)-mapped page file — catches a rename
#           landed in one place and not the other. Extracts
#           `pageIdx: N(, subPageIdx: S)?, section: "…", label: "…"`, so a
#           sub-page row's optional `subPageIdx` field routes it to its
#           OWN file rather than the root page's.
# CHECK C — every RowIndex entry's `pageIdx` is within range of the
#           `comps` array.
# CHECK D — the scanned-page count is greater than zero (mirrors
#           colour-lint's own CHECK C), so an empty scan can never read
#           as a pass.
# CHECK E — WR-03 (code review, quick-260821-6z1 fix wave): CHECK A-D
#           above all derive their page mapping from PageCompRegistry.qml
#           alone and never read PageRegistry.qml at all, so a
#           same-length REORDER between the two registries (which
#           PageCompRegistry.qml's own Component.onCompleted only checks
#           by length, not identity) was invisible to this gate. CHECK E
#           reads PageRegistry.qml's own ordered `slug:` fields and
#           PageCompRegistry.qml's `compSlugs:` array (added alongside
#           this check) and asserts they match ELEMENT-FOR-ELEMENT, named
#           by index — the one cross-file invariant both files' own
#           headers already call load-bearing.
# CHECK F — D-4 (quick task 260825-wj2 Task 1): every sub-page component
#           named inside a StackPage-wrapped comp in PageCompRegistry.qml
#           resolves to a file that exists under pages/ AND is declared in
#           pages/qmldir — an undeclared type in a directory carrying a
#           manifest becomes unresolvable forever with no load error, so
#           this is the sub-page equivalent of CHECK A's "mapped file does
#           not exist" arm.
#
# Usage:
#   settings-index-check
#       No argument: scans the real deployed settings module under
#       $HOME/.config/quickshell/modules/settings.
#   settings-index-check <dir>
#       Treats <dir> as the settings module root (RowIndex.qml,
#       PageCompRegistry.qml, pages/ all expected directly under it) —
#       lets this be pointed at a throwaway fixture, same idiom every
#       other gate in this repo uses.
#
# Deliberately NO --self-test flag (unlike quickshell-doctor) — this
# gate's own falsification is exercised inline by Task 3's own <verify>
# block: temporarily add one unindexed row to a real page file, confirm
# the gate FAILs and names that page, remove it, confirm PASS again. A
# --self-test-free simple design, per this task's own instruction.
#
# Exit codes: 0 clean / 1 any [FAIL] / 2 invalid target (missing files).

QS_DIR="${1:-$HOME/.config/quickshell/modules/settings}"

ROWINDEX="$QS_DIR/RowIndex.qml"
COMPREG="$QS_DIR/PageCompRegistry.qml"
PAGEREG="$QS_DIR/PageRegistry.qml"
PAGES_DIR="$QS_DIR/pages"

echo "settings-index-check — RowIndex/page row completeness gate"
echo "  target: $QS_DIR"
echo ""

if [[ ! -f "$ROWINDEX" || ! -f "$COMPREG" || ! -f "$PAGEREG" || ! -d "$PAGES_DIR" ]]; then
    echo "settings-index-check: cannot find RowIndex.qml / PageCompRegistry.qml / PageRegistry.qml / pages/ under $QS_DIR" >&2
    exit 2
fi

PASS=0
FAIL=0

check() {
    local desc="$1" cond="$2"
    if [[ "$cond" -eq 0 ]]; then
        printf '  [PASS] %s\n' "$desc"
        PASS=$((PASS + 1))
    else
        printf '  [FAIL] %s\n' "$desc"
        FAIL=$((FAIL + 1))
    fi
}

strip_comments() {
    grep -v '^[[:space:]]*//' "$1"
}

# ── Derive pageIdx -> page-file mapping from PageCompRegistry.qml's own
#    `comps:` array — never a hand-maintained list, so this gate itself
#    cannot drift from the registry it checks. ─────────────────────────
mapfile -t COMP_ORDER < <(awk '
    /readonly property list<Component> comps:/ { inarr = 1; next }
    inarr {
        if ($0 ~ /\]/) { inarr = 0; next }
        gsub(/[, \t]/, "")
        if (length($0) > 0) print $0
    }
' "$COMPREG")

PAGE_FILES=()
declare -A SUB_PAGE_FILES   # keyed "i,s" (s starting at 1) -> mapped file
declare -A SUB_PAGE_COUNT   # keyed "i" -> number of sub-pages for page i

for ((i = 0; i < ${#COMP_ORDER[@]}; i++)); do
    comp="${COMP_ORDER[$i]}"
    # ── D-4: collect EVERY `*Page` identifier declared inside this comp's
    #    own `property Component <name>: Component { ... }` block, in
    #    order, skipping the literal `StackPage` wrapper. Index 0 of the
    #    collected list is the root page; 1..N (only present when the comp
    #    wraps a StackPage, D-2) are its sub-pages. Brace-counted rather
    #    than a single next-line grep (the pre-D-4 shape) — a StackPage
    #    comp declares N+1 Page classes inside ONE property block. ────────
    block=$(awk -v target="property Component ${comp}:" '
        BEGIN { capturing = 0; depth = 0; began = 0 }
        {
            if (!capturing && index($0, target) > 0)
                capturing = 1
            if (capturing) {
                print $0
                o = gsub(/\{/, "{")
                c = gsub(/\}/, "}")
                depth += o - c
                if (depth > 0) began = 1
                if (began && depth <= 0) exit
            }
        }
    ' "$COMPREG")
    mapfile -t page_idents < <(grep -oE '[A-Za-z_][A-Za-z0-9_]*Page' <<<"$block" | grep -v '^StackPage$')
    if [[ "${#page_idents[@]}" -eq 0 ]]; then
        echo "settings-index-check: could not resolve a page class for comp '$comp' in $COMPREG" >&2
        exit 2
    fi
    PAGE_FILES+=("$PAGES_DIR/${page_idents[0]}.qml")
    SUB_PAGE_COUNT[$i]=$((${#page_idents[@]} - 1))
    for ((s = 1; s < ${#page_idents[@]}; s++)); do
        SUB_PAGE_FILES["$i,$s"]="$PAGES_DIR/${page_idents[$s]}.qml"
    done
done

N=${#PAGE_FILES[@]}

# ── CHECK A (pair-keyed, D-4) ─────────────────────────────────────────
ROW_PRIMITIVE_RE='^[[:space:]]*(ToggleRow|SliderRow|SelectRow|NavRow|InfoRow|StepperRow)[[:space:]]*\{'
for ((i = 0; i < N; i++)); do
    f="${PAGE_FILES[$i]}"
    if [[ ! -f "$f" ]]; then
        check "CHECK A: pageIdx $i — mapped file does not exist: $f" 1
    else
        idx_count=$(strip_comments "$ROWINDEX" | grep -c "pageIdx: $i, section:")
        row_count=$(strip_comments "$f" | grep -cE "$ROW_PRIMITIVE_RE")
        if [[ "$idx_count" -eq "$row_count" ]]; then
            check "CHECK A: pageIdx $i ($(basename "$f")): RowIndex entries ($idx_count) match row declarations ($row_count)" 0
        else
            check "CHECK A: pageIdx $i ($(basename "$f")): RowIndex entries ($idx_count) != row declarations ($row_count)" 1
        fi
    fi

    sc="${SUB_PAGE_COUNT[$i]:-0}"
    for ((s = 1; s <= sc; s++)); do
        sf="${SUB_PAGE_FILES[$i,$s]}"
        if [[ ! -f "$sf" ]]; then
            check "CHECK A: pageIdx $i subPageIdx $s — mapped file does not exist: $sf" 1
            continue
        fi
        sidx_count=$(strip_comments "$ROWINDEX" | grep -c "pageIdx: $i, subPageIdx: $s, section:")
        srow_count=$(strip_comments "$sf" | grep -cE "$ROW_PRIMITIVE_RE")
        if [[ "$sidx_count" -eq "$srow_count" ]]; then
            check "CHECK A: pageIdx $i subPageIdx $s ($(basename "$sf")): RowIndex entries ($sidx_count) match row declarations ($srow_count)" 0
        else
            check "CHECK A: pageIdx $i subPageIdx $s ($(basename "$sf")): RowIndex entries ($sidx_count) != row declarations ($srow_count)" 1
        fi
    done
done

# ── CHECK B (pair-keyed, D-4) ────────────────────────────────────────────
# Process substitution, NOT a trailing `| while` — a `| while` loop runs
# in a subshell, and PASS/FAIL increments inside it would silently vanish
# once the pipeline exits (the exact pipefail/subshell class of bug this
# repo's own project memory already warns about).
while IFS= read -r line; do
    idx=$(grep -oE 'pageIdx: [0-9]+' <<<"$line" | grep -oE '[0-9]+')
    subidx=$(grep -oE 'subPageIdx: [0-9]+' <<<"$line" | grep -oE '[0-9]+')
    label=$(grep -oE 'label: "[^"]*"' <<<"$line" | sed -E 's/label: "(.*)"/\1/')
    if [[ -z "$idx" || "$idx" -ge "$N" ]]; then
        check "CHECK B: label \"$label\" — pageIdx $idx out of range, skipped (see CHECK C)" 0
        continue
    fi
    if [[ -n "$subidx" ]]; then
        f="${SUB_PAGE_FILES[$idx,$subidx]:-}"
        loc_desc="pageIdx $idx subPageIdx $subidx"
    else
        f="${PAGE_FILES[$idx]}"
        loc_desc="pageIdx $idx"
    fi
    if [[ -z "$f" || ! -f "$f" ]]; then
        check "CHECK B: $loc_desc label \"$label\" — mapped file does not exist" 1
        continue
    fi
    if grep -qF "label: \"$label\"" "$f"; then
        check "CHECK B: $loc_desc label \"$label\" found verbatim in $(basename "$f")" 0
    else
        check "CHECK B: $loc_desc label \"$label\" NOT found in $(basename "$f")" 1
    fi
done < <(strip_comments "$ROWINDEX" | grep -oE 'pageIdx: [0-9]+(, subPageIdx: [0-9]+)?, section: "[^"]*", label: "[^"]*"')

# ── CHECK C ─────────────────────────────────────────────────────────────
OUT_OF_RANGE=0
while IFS= read -r idx; do
    if (( idx < 0 || idx >= N )); then
        OUT_OF_RANGE=1
        echo "  [FAIL] CHECK C: RowIndex pageIdx $idx is out of range [0, $((N - 1))]"
    fi
done < <(strip_comments "$ROWINDEX" | grep -oE 'pageIdx: [0-9]+' | grep -oE '[0-9]+')
check "CHECK C: every RowIndex pageIdx is within range [0, $((N - 1))]" "$OUT_OF_RANGE"

# ── CHECK D ─────────────────────────────────────────────────────────────
if [[ "$N" -gt 0 ]]; then
    check "CHECK D: scanned $N page(s) — non-zero floor" 0
else
    check "CHECK D: scanned $N page(s) — non-zero floor" 1
fi

# ── CHECK E (WR-03) ────────────────────────────────────────────────────
# Independently derived from BOTH registries — never reuses COMP_ORDER/
# PAGE_FILES above, which come from PageCompRegistry.qml alone. This is
# the one check in the file that actually reads PageRegistry.qml.
mapfile -t REG_SLUGS < <(strip_comments "$PAGEREG" | grep -oE 'slug: "[^"]*"' | sed -E 's/slug: "(.*)"/\1/')
mapfile -t COMP_SLUGS < <(awk '
    /readonly property list<string> compSlugs:/ { inarr = 1; next }
    inarr {
        if ($0 ~ /\]/) { inarr = 0; next }
        gsub(/[,\t"]/, "")
        gsub(/^[ ]+|[ ]+$/, "")
        if (length($0) > 0) print $0
    }
' "$COMPREG")

if [[ "${#REG_SLUGS[@]}" -ne "${#COMP_SLUGS[@]}" ]]; then
    check "CHECK E: PageRegistry.pages[].slug count (${#REG_SLUGS[@]}) matches PageCompRegistry.compSlugs count (${#COMP_SLUGS[@]})" 1
else
    E_MISMATCH=0
    for ((i = 0; i < ${#REG_SLUGS[@]}; i++)); do
        if [[ "${REG_SLUGS[$i]}" != "${COMP_SLUGS[$i]}" ]]; then
            E_MISMATCH=1
            echo "  [FAIL] CHECK E: index $i — PageRegistry.pages[$i].slug=\"${REG_SLUGS[$i]}\" != PageCompRegistry.compSlugs[$i]=\"${COMP_SLUGS[$i]}\""
        fi
    done
    check "CHECK E: PageRegistry.pages[].slug order matches PageCompRegistry.compSlugs order at every index (${#REG_SLUGS[@]} entries)" "$E_MISMATCH"
fi

# ── CHECK F (D-4) ──────────────────────────────────────────────────────
F_FAIL=0
F_COUNT=0
for key in "${!SUB_PAGE_FILES[@]}"; do
    F_COUNT=$((F_COUNT + 1))
    sf="${SUB_PAGE_FILES[$key]}"
    base=$(basename "$sf" .qml)
    if [[ ! -f "$sf" ]]; then
        F_FAIL=1
        echo "  [FAIL] CHECK F: sub-page $key ($base) — file does not exist: $sf"
        continue
    fi
    if ! grep -qE "^[[:space:]]*${base}[[:space:]]+[0-9]+\.[0-9]+[[:space:]]+${base}\.qml[[:space:]]*\$" "$PAGES_DIR/qmldir"; then
        F_FAIL=1
        echo "  [FAIL] CHECK F: sub-page $key ($base) — not declared in $PAGES_DIR/qmldir"
    fi
done
check "CHECK F: every sub-page component resolves to a file under pages/ and is declared in pages/qmldir ($F_COUNT sub-page(s))" "$F_FAIL"

echo ""
if [[ "$FAIL" -eq 1 ]]; then
    FAIL_WORD="check failed"
else
    FAIL_WORD="checks failed"
fi
printf 'Summary: %d passed, %d %s\n' "$PASS" "$FAIL" "$FAIL_WORD"
[[ "$FAIL" -eq 0 ]]
exit $?

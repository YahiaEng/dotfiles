#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║           WAYBAR-DESIGN-LINT (08-11 CORRECTION)       ║
# ║  Rerunnable design/token gate for the waybar redesign  ║
# ║  (plans 08-12..08-15). Report-only — never mutates any ║
# ║  file. Exits nonzero if ANY check FAILs.               ║
# ╚══════════════════════════════════════════════════════╝
#
# Phase 08 shipped a bar the user called "a complete failure" while every
# prior automated gate passed green — because those gates only ever proved
# token *resolution*, never *appearance*, and never caught that half the
# module icons were empty strings. This gate closes both holes:
#
#   CHECK A — token resolution: every @name colour reference in every
#             waybar stylesheet must resolve to a real matugen token or a
#             theme.css role alias. This is the WLOG-01 killer — GTK3
#             silently discards a WHOLE stylesheet on one unresolvable
#             @color reference.
#   CHECK B — alias boundary: only theme.css may reference a raw matugen
#             palette token name. Every other stylesheet must speak in
#             role names only.
#   CHECK C — transparent window: every style-*.css's window#waybar rule
#             must declare `background: transparent` (the fix for the
#             user's reported "dark bar behind all modules").
#   CHECK D — no literal hex: zero #rrggbb / #rgb literals anywhere in a
#             waybar .css or .jsonc file (comments stripped).
#   CHECK E — no empty glyph fields: every player-icons/status-icons/
#             format-icons glyph slot must hold a real, non-blank glyph;
#             every format* template string must not carry the leading
#             2+-space fingerprint of a glyph that was deleted and left
#             its separator space behind.
#
# 13-05: waybar's six stylesheets are now sass sources (.scss), compiled
# into $STATE_DIR before GTK3 ever sees them. CHECK A (token resolution)
# now runs against the COMPILED state-dir sheets — that's what actually
# reaches GTK3, and teaching the regex about sass would be strictly more
# work for no more correctness (13-RESEARCH.md's own recommendation).
# CHECK B (alias boundary), CHECK C (transparent window) and CHECK D (no
# literal hex) stay on the .scss sources, with their globs updated to
# .scss and AT_RULE_KEYWORDS extended with the sass directives these
# files now carry (`@use`, at minimum) so a sass directive is never
# misreported as an unresolved/raw colour token.
#
# Usage:
#   waybar-design-lint [waybar-dir]
#       Defaults to ~/.config/waybar. Never runs waybar, never edits
#       anything — pure read-only analysis.

set -uo pipefail

WAYBAR_DIR="${1:-$HOME/.config/waybar}"
STATE_DIR="$HOME/.local/state/theme"
RENDERED_WAYBAR_CSS="$STATE_DIR/waybar.css"

PASS=0
FAIL=0

check() {
    local desc="$1"
    local ok="$2"
    if [[ "$ok" == "0" ]]; then
        echo "  [PASS] $desc"
        PASS=$((PASS + 1))
    else
        echo "  [FAIL] $desc"
        FAIL=$((FAIL + 1))
    fi
}

echo "waybar-design-lint — design/token gate ($WAYBAR_DIR)"
echo ""

if [[ ! -d "$WAYBAR_DIR" ]]; then
    echo "  [FAIL] waybar dir exists ($WAYBAR_DIR not found)"
    echo ""
    echo "Summary: 0 passed, 1 failed"
    exit 1
fi

# ── Single python pass: all 5 checks, TAB-separated CHECK/STATUS/detail
#    lines on stdout. One process so token/glyph parsing logic (comment
#    strippers, JSONC scanner) is defined exactly once. ───────────────────
_waybar_design_lint_checks() {
    python3 - "$WAYBAR_DIR" "$RENDERED_WAYBAR_CSS" "$STATE_DIR" <<'PYEOF'
import glob
import json
import os
import re
import sys

waybar_dir = sys.argv[1]
rendered_css = sys.argv[2]
state_dir = sys.argv[3]

# ── Comment strippers ───────────────────────────────────────────────────

def strip_css_comments(text):
    """Non-greedy /* ... */ block strip across newlines. A line-based grep
    would both false-positive on prose inside comments and false-negative
    on multi-line rules — this is why we parse, not grep (plan mandate)."""
    return re.sub(r'/\*.*?\*/', '', text, flags=re.S)


def strip_jsonc_comments(text):
    """Character scanner: strips // and /* */ comments while never
    treating a // or /* inside a quoted JSON string as a comment
    delimiter. Identical algorithm to waybar-equivalence-check's
    strip_jsonc_comments (T-08-11) — kept in lockstep, not reinvented."""
    out = []
    i = 0
    n = len(text)
    in_string = False
    escape = False
    while i < n:
        c = text[i]
        if in_string:
            out.append(c)
            if escape:
                escape = False
            elif c == '\\':
                escape = True
            elif c == '"':
                in_string = False
            i += 1
            continue
        if c == '"':
            in_string = True
            out.append(c)
            i += 1
            continue
        if c == '/' and i + 1 < n and text[i + 1] == '/':
            j = text.find('\n', i)
            if j == -1:
                i = n
            else:
                out.append('\n')
                i = j + 1
            continue
        if c == '/' and i + 1 < n and text[i + 1] == '*':
            j = text.find('*/', i + 2)
            if j == -1:
                i = n
            else:
                i = j + 2
            continue
        out.append(c)
        i += 1
    return ''.join(out)


AT_RULE_KEYWORDS = {"import", "define-color", "media", "keyframes", "supports", "charset", "font-face"}

# 13-05: sass at-rule directives that now appear in the repo-authored
# .scss sources (CHECK B/C/D). `@use` is the one this plan's own pattern
# requires (the _motion.scss partial load); the rest are extended
# defensively so a future edit introducing any other sass at-rule is
# never misreported by CHECK A/B as an unresolved/raw colour token.
SASS_AT_RULE_KEYWORDS = {
    "use", "forward", "mixin", "include", "function", "return",
    "if", "else", "each", "for", "while", "extend", "content",
    "warn", "error", "debug", "at-root",
}
AT_RULE_KEYWORDS |= SASS_AT_RULE_KEYWORDS

results = []  # (check_letter, status, detail)


def emit(letter, status, detail):
    results.append((letter, status, detail))


def rel(path):
    """Path relative to the .scss SOURCE dir — used by CHECK B/C/D, which
    stay on the repo-authored sources (13-05)."""
    try:
        return os.path.relpath(path, waybar_dir)
    except ValueError:
        return path


def rel_state(path):
    """Path relative to the COMPILED state-dir output — used by CHECK A,
    which runs against what actually reaches GTK3 (13-05)."""
    try:
        return os.path.relpath(path, state_dir)
    except ValueError:
        return path


# ── Gather real 19 matugen tokens (dynamic — never hardcoded; a future
#    palette change must not silently un-guard this gate) ─────────────────
real_tokens = set()
if os.path.isfile(rendered_css):
    real_tokens = set(re.findall(
        r'@define-color\s+([A-Za-z_][A-Za-z0-9_-]*)',
        open(rendered_css, encoding='utf-8').read(),
    ))
else:
    emit('A', 'FAIL', f'rendered waybar.css not found at {rendered_css} — cannot resolve any token')

# 13-05: theme.css -> theme.scss (repo source, CHECK B's alias-boundary
# exemption identity) vs waybar-theme.css (COMPILED output, CHECK A's
# token-resolution input) — two different files now, deliberately.
theme_scss_path = os.path.join(waybar_dir, 'theme.scss')
theme_compiled_path = os.path.join(state_dir, 'waybar-theme.css')
theme_defined = set()
if os.path.isfile(theme_compiled_path):
    theme_body = strip_css_comments(open(theme_compiled_path, encoding='utf-8').read())
    theme_defined = set(re.findall(r'@define-color\s+([A-Za-z_][A-Za-z0-9_-]*)', theme_body))

defined_all = real_tokens | theme_defined

# ── Compiled sheets in scope for CHECK A (13-05: state-dir, not repo) ──
compiled_files = sorted(glob.glob(os.path.join(state_dir, 'waybar-style-*.css')))
compiled_modules = os.path.join(state_dir, 'waybar-modules.css')
if os.path.isfile(compiled_modules):
    compiled_files.append(compiled_modules)
if os.path.isfile(theme_compiled_path):
    compiled_files.append(theme_compiled_path)

if not compiled_files:
    emit('A', 'FAIL', f'no waybar-style-*.css / waybar-modules.css / waybar-theme.css found under {state_dir} — run theme-apply')

# ── CSS/SCSS sources in scope for CHECK B/C/D (13-05: .scss, not .css) ──
css_files = sorted(glob.glob(os.path.join(waybar_dir, 'style-*.scss')))
modules_css = os.path.join(waybar_dir, 'waybar-modules.scss')
if os.path.isfile(modules_css):
    css_files.append(modules_css)
if os.path.isfile(theme_scss_path):
    css_files.append(theme_scss_path)

if not css_files:
    emit('B', 'FAIL', f'no style-*.scss / waybar-modules.scss / theme.scss found under {waybar_dir}')

# ── CHECK A — token resolution (COMPILED sheets — 13-05) ───────────────
for f in compiled_files:
    body = strip_css_comments(open(f, encoding='utf-8').read())
    refs = set(re.findall(r'@([A-Za-z_][A-Za-z0-9_-]*)', body)) - AT_RULE_KEYWORDS
    unresolved = sorted(refs - defined_all)
    if unresolved:
        emit('A', 'FAIL', f'{rel_state(f)}: unresolved colour token(s): {", ".join(unresolved)}')
    else:
        emit('A', 'PASS', f'{rel_state(f)}: all referenced token(s) resolve ({len(refs)} ref(s))')

# ── CHECK B — alias boundary (theme.scss is the only exemption, 13-05) ─
theme_scss_real = os.path.realpath(theme_scss_path) if os.path.isfile(theme_scss_path) else None
for f in css_files:
    if theme_scss_real and os.path.realpath(f) == theme_scss_real:
        continue
    body = strip_css_comments(open(f, encoding='utf-8').read())
    refs = set(re.findall(r'@([A-Za-z_][A-Za-z0-9_-]*)', body)) - AT_RULE_KEYWORDS
    raw_hits = sorted(refs & real_tokens)
    if raw_hits:
        emit('B', 'FAIL', f'{rel(f)}: references raw palette token(s) outside theme.scss: {", ".join(raw_hits)}')
    else:
        emit('B', 'PASS', f'{rel(f)}: no raw palette tokens referenced')

# ── CHECK C — transparent window#waybar (13-05: .scss sources) ────────
style_files = sorted(glob.glob(os.path.join(waybar_dir, 'style-*.scss')))
if not style_files:
    emit('C', 'FAIL', f'no style-*.scss found under {waybar_dir}')
for f in style_files:
    body = strip_css_comments(open(f, encoding='utf-8').read())
    m = re.search(r'window#waybar\s*\{([^}]*)\}', body)
    if not m:
        emit('C', 'FAIL', f'{rel(f)}: no window#waybar rule found')
        continue
    rule_body = m.group(1)
    bg_matches = re.findall(r'background\s*:\s*([^;]+);', rule_body)
    if not bg_matches:
        emit('C', 'FAIL', f'{rel(f)}: window#waybar has no background declaration')
        continue
    last_bg = bg_matches[-1].strip()
    if last_bg == 'transparent':
        emit('C', 'PASS', f'{rel(f)}: window#waybar background: transparent')
    else:
        emit('C', 'FAIL', f"{rel(f)}: window#waybar background is '{last_bg}', not transparent")

# ── CHECK D — no literal hex (scss + jsonc, comments stripped, 13-05) ──
hex_re = re.compile(r'#[0-9a-fA-F]{6}\b|#[0-9a-fA-F]{3}\b')
d_targets = sorted(glob.glob(os.path.join(waybar_dir, '*.scss'))) + \
    sorted(glob.glob(os.path.join(waybar_dir, '*.jsonc')))
if not d_targets:
    emit('D', 'FAIL', f'no .scss/.jsonc files found under {waybar_dir}')
for f in d_targets:
    raw = open(f, encoding='utf-8').read()
    body = strip_css_comments(raw) if f.endswith('.scss') else strip_jsonc_comments(raw)
    hits = hex_re.findall(body)
    if hits:
        emit('D', 'FAIL', f'{rel(f)}: literal hex colour(s) found: {", ".join(sorted(set(hits)))}')
    else:
        emit('D', 'PASS', f'{rel(f)}: no literal hex')

# ── CHECK E — no empty glyph fields ────────────────────────────────────
# Two value classes get different treatment:
#   1. GLYPH SLOTS — direct entries of a player-icons / status-icons /
#      format-icons dict or array. These ARE the icon itself (no template
#      braces around them) — any blank value here is unconditionally a
#      bug (this is precisely how mpris/pulseaudio/temperature shipped
#      iconless). No exemption, with ONE narrow, explicitly documented
#      exception below.
#   2. FORMAT TEMPLATES — every other format*-matching scalar string
#      (format, format-alt, format-paused, format-wifi, tooltip-format,
#      calendar sub-formats, ...). A template may legitimately be pure
#      empty ("format-stopped": "" — the module renders nothing at all
#      when stopped, by design) or may embed an {icon}/{player_icon}/
#      {status_icon} placeholder that delegates to a glyph-slot dict
#      elsewhere. The ONLY template-level bug this check can mechanically
#      detect is the "glyph deleted, separator space(s) left behind at
#      the front" fingerprint — a LEADING run of 2+ spaces — plus a
#      whitespace-only (non-empty-but-blank) value.
GLYPH_CONTAINER_KEYS = {'player-icons', 'status-icons', 'format-icons'}
FORMAT_KEY_RE = re.compile(r'^format')
LEADING_RUN_RE = re.compile(r'^ {2,}')

# Narrow, explicitly-justified exemption (plan mandate: "keep the
# exemption narrow and comment it"). mpris's "format-stopped" is itself
# "" by design (module shows nothing on stop) — status-icons.stopped is
# therefore structurally unreachable and is deliberately left blank
# (matches config-vertical.jsonc's own committed comment on this exact
# field). Do not grow this list without equally strong justification.
NARROW_EXEMPT_PATHS = {
    'mpris.status-icons.stopped',
}


def check_glyph_value(value, path_str):
    if path_str in NARROW_EXEMPT_PATHS:
        return None
    if value.strip() == '':
        return f'{path_str}: empty/blank glyph slot'
    return None


def check_template_value(value, path_str):
    if value != '' and value.strip() == '':
        return f'{path_str}: whitespace-only format value'
    if LEADING_RUN_RE.match(value):
        return f'{path_str}: leading run of 2+ spaces (deleted-glyph fingerprint)'
    return None


def walk(obj, keypath, matched, in_glyph):
    errors = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            is_glyph_key = k in GLYPH_CONTAINER_KEYS
            is_format_key = bool(FORMAT_KEY_RE.match(k))
            new_matched = matched or is_glyph_key or is_format_key
            new_in_glyph = in_glyph or is_glyph_key
            errors += walk(v, keypath + [k], new_matched, new_in_glyph)
    elif isinstance(obj, list):
        for i, item in enumerate(obj):
            errors += walk(item, keypath + [str(i)], matched, in_glyph)
    elif isinstance(obj, str):
        if matched:
            path_str = '.'.join(keypath)
            err = check_glyph_value(obj, path_str) if in_glyph else check_template_value(obj, path_str)
            if err:
                errors.append(err)
    return errors


jsonc_targets = sorted(glob.glob(os.path.join(waybar_dir, 'config-*.jsonc')))
modules_jsonc = os.path.join(waybar_dir, 'modules.jsonc')
if os.path.isfile(modules_jsonc):
    jsonc_targets.append(modules_jsonc)

if not jsonc_targets:
    emit('E', 'FAIL', f'no config-*.jsonc / modules.jsonc found under {waybar_dir}')

for f in jsonc_targets:
    raw = open(f, encoding='utf-8').read()
    stripped = strip_jsonc_comments(raw)
    try:
        data = json.loads(stripped)
    except Exception as exc:  # noqa: BLE001 - report, never silently skip
        emit('E', 'FAIL', f'{rel(f)}: failed to parse as JSON after comment-strip: {exc}')
        continue
    file_errors = walk(data, [], False, False)
    if file_errors:
        for e in file_errors:
            emit('E', 'FAIL', f'{rel(f)}: {e}')
    else:
        emit('E', 'PASS', f'{rel(f)}: no empty/blank glyph fields')

for letter, status, detail in results:
    print(f'{letter}\t{status}\t{detail}')
PYEOF
}

while IFS=$'\t' read -r letter status detail; do
    [[ -z "$letter" ]] && continue
    desc="CHECK $letter: $detail"
    case "$status" in
        PASS) check "$desc" "0" ;;
        *)    check "$desc" "1" ;;
    esac
done < <(_waybar_design_lint_checks)

echo ""
echo "Summary: ${PASS} passed, ${FAIL} failed"
[[ "$FAIL" -eq 0 ]]
exit $?

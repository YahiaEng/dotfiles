#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║        HYPR-EQUIVALENCE-CHECK (D-08/D-09/D-10/D-16)   ║
# ║  Rerunnable equivalence gate for the hyprlang-to-Lua   ║
# ║  config migration (Phase 13.1). Modelled directly on   ║
# ║  an earlier equivalence checker's shape: a --snapshot   ║
# ║  mode that captures ground truth once, and a default    ║
# ║  check mode that re-derives current state and diffs it. ║
# ║  Report-only — never mutates compositor state, never    ║
# ║  writes under hypr/.config/hypr/, never runs            ║
# ║  theme-apply.                                           ║
# ╚══════════════════════════════════════════════════════╝
#
# Unlike a static config file tree, which resolves statically from files on disk,
# Hyprland's *effective* config is only observable at runtime. This tool's
# "resolve" step is therefore a live `hyprctl -j` invocation, not a static
# parse — snapshot mode is meaningfully coupled to *which config format is
# currently booted* and MUST run before any config file is edited (D-09).
#
# Usage:
#   hypr-equivalence-check --snapshot <outdir>
#       Capture ONLY, never compare. Writes binds.json (hyprctl -j binds),
#       animations.json (hyprctl -j animations), options.jsonl (one
#       `hyprctl -j getoption <key>` JSON record per option key actually
#       set across the 8 hyprlang config files), uncovered.txt (D-16: every
#       set key/declaration this gate cannot introspect, with a reason and
#       a named compensating check), and MANIFEST.md.
#
#   hypr-equivalence-check --uncovered
#       Print the committed baseline's uncovered.txt and exit 0 — a
#       convenience reader so the D-16 coverage limits are visible without
#       opening the file directly.
#
#   hypr-equivalence-check [--baseline <dir>]
#       Default check mode. Re-derives binds/animations/options live and
#       diffs each against the committed baseline (or the directory named
#       by --baseline). Exits 0 ONLY when the divergence count is exactly
#       zero. D-10 deviation from the earlier equivalence-checker analog: an absent, empty, or
#       unreadable baseline is a FAIL, never a SKIP, and never exit 0.
#
# This script only ever reads via `hyprctl -j getoption`, `-j binds`,
# `-j animations`, and `hyprctl version`. It never uses a state-mutating
# hyprctl verb, never runs theme-apply, and its only writes are into a
# --snapshot output directory or mktemp files cleaned up by the EXIT trap.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$REPO_ROOT" ]]; then
    # Fallback if this ever runs outside a git checkout of the dotfiles repo:
    # hypr/.config/hypr/scripts -> repo root is 4 levels up.
    REPO_ROOT="$(cd -- "$SCRIPT_DIR/../../../.." &>/dev/null && pwd)"
fi

# [Rule 3 - blocking, found during 19-03 Task 3] The baseline was captured
# under the live phases/ tree (13.1-02) but the v3.0 milestone archive
# (commit cf26332, `/gsd-complete-milestone`) moved the whole phase
# directory to milestones/v3.0-phases/ — this hardcoded literal never
# tracked that move, so every check-mode run since the archive has hit
# D-10's "absent baseline is a FAIL, never a SKIP" path for a reason
# wholly unrelated to whatever the live config actually diverges on.
# Prefer the live phases/ location (in case a future phase captures a
# baseline the same way while still active) and fall back to the
# milestone-archived location — robust to the SAME archive workflow
# moving it again later, without needing another hardcoded-path fix.
_LIVE_BASELINE_DIR="$REPO_ROOT/.planning/phases/13.1-hyprland-lua-config-migration/.hypr-baseline"
_ARCHIVED_BASELINE_DIR="$REPO_ROOT/.planning/milestones/v3.0-phases/13.1-hyprland-lua-config-migration/.hypr-baseline"
if [[ -d "$_LIVE_BASELINE_DIR" ]]; then
    DEFAULT_BASELINE_DIR="$_LIVE_BASELINE_DIR"
else
    DEFAULT_BASELINE_DIR="$_ARCHIVED_BASELINE_DIR"
fi
BASELINE_DIR="$DEFAULT_BASELINE_DIR"

HYPR_CONF_ROOT="$REPO_ROOT/hypr/.config/hypr"
HYPRLAND_CONF="$HYPR_CONF_ROOT/hyprland.conf"
HYPR_CONFIG_DIR="$HYPR_CONF_ROOT/config"

# ── Config file set (dynamic — never a hardcoded list, D-08) ─────────────
# 13.1-10: the legacy hyprlang tree these paths name was retired once the
# operator resolved Task 2's one-way decision as retire-now. Both existence
# checks below (previously only the *.conf glob was guarded; HYPRLAND_CONF
# was appended unconditionally) are now guarded the same way, so
# CONFIG_FILES is genuinely EMPTY post-retirement rather than containing a
# path to a file that no longer exists — _derive_key_list below dispatches
# on exactly that emptiness.
CONFIG_FILES=()
[[ -e "$HYPRLAND_CONF" ]] && CONFIG_FILES+=("$HYPRLAND_CONF")
for f in "$HYPR_CONFIG_DIR"/*.conf; do
    [[ -e "$f" ]] || continue
    CONFIG_FILES+=("$f")
done

# ── Mode dispatch ──────────────────────────────────────────────────────
MODE="check"
OUTDIR=""

case "${1:-}" in
    --snapshot)
        MODE="snapshot"
        OUTDIR="${2:?hypr-equivalence-check --snapshot requires an output directory}"
        ;;
    --uncovered)
        MODE="uncovered"
        ;;
    --baseline)
        BASELINE_DIR="${2:?hypr-equivalence-check --baseline requires a directory}"
        MODE="check"
        ;;
    "")
        MODE="check"
        ;;
    *)
        echo "hypr-equivalence-check: unknown argument '${1:-}'" >&2
        echo "Usage: hypr-equivalence-check [--snapshot <outdir>|--uncovered|--baseline <dir>]" >&2
        exit 1
        ;;
esac

# ── Key/permission-grant extractor: parses the 8 hyprlang config files at ─
# ── run time (never a hardcoded option-key list) by tracking brace-nested ─
# ── blocks and joining `block:block:key` the same way `hyprctl getoption`  ─
# ── addresses them. Declaration keywords (bind*, env, monitor, exec-once,  ─
# ── windowrule[v2 line/block], layerrule, permission, animation, bezier)  ─
# ── are never option keys — they're covered by binds.json/animations.json ─
# ── or (permission grants) have no getoption representation at all.       ─
_parse_config_tree() {
    local mode="$1"
    shift
    python3 - "$mode" "$@" <<'PYEOF'
import re
import sys

DECL_KEYWORDS = {
    "bind", "binde", "bindel", "bindl", "bindm", "bindr",
    "env", "monitor", "exec-once", "windowrule", "layerrule",
    "permission", "animation", "bezier",
}

BLOCK_OPEN_RE = re.compile(r'^([A-Za-z_][A-Za-z0-9_.:-]*)\s*\{\s*(?:#.*)?$')
ASSIGN_RE = re.compile(r'^([A-Za-z_][A-Za-z0-9_.:-]*)\s*=\s*(.*)$')
SOURCE_RE = re.compile(r'^source\s*=')


def parse_file(path, keys, permission_grants):
    stack = []  # list of (name, skip_bool)
    try:
        with open(path, 'r', encoding='utf-8') as fh:
            lines = fh.readlines()
    except OSError as exc:
        print(f"hypr-equivalence-check: cannot read {path}: {exc}", file=sys.stderr)
        sys.exit(1)

    for raw in lines:
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        if line == '}':
            if stack:
                stack.pop()
            continue
        if line.startswith('$'):
            continue
        if SOURCE_RE.match(line):
            continue

        m = BLOCK_OPEN_RE.match(line)
        if m:
            name = m.group(1)
            parent_skip = stack[-1][1] if stack else False
            skip = parent_skip or (name in DECL_KEYWORDS)
            stack.append((name, skip))
            continue

        m = ASSIGN_RE.match(line)
        if m:
            key, val = m.group(1), m.group(2)
            in_skip = stack[-1][1] if stack else False
            if key in DECL_KEYWORDS or in_skip:
                if key == 'permission' and not in_skip:
                    permission_grants.append(val.strip())
                continue
            prefix = ':'.join(n for n, _ in stack)
            full_key = f"{prefix}:{key}" if prefix else key
            keys.add(full_key)
            continue
        # Anything else (unrecognized line shape) is silently ignored —
        # comments/blanks/variables/source are already handled above.


def main():
    mode = sys.argv[1]
    paths = sys.argv[2:]
    keys = set()
    permission_grants = []
    for p in paths:
        parse_file(p, keys, permission_grants)
    if mode == 'keys':
        for k in sorted(keys):
            print(k)
    elif mode == 'permissions':
        for g in permission_grants:
            print(g)
    else:
        print(f"hypr-equivalence-check: unknown parse mode {mode}", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
PYEOF
}

# ── Normalized options.jsonl comparison (13.1-03 Task 3, D-17/D-18) ──────
# ── hyprctl -j getoption reports a DIFFERENT JSON type-key NAME, and for  ─
# ── booleans a different type entirely, depending on whether the value   ─
# ── was set by the hyprlang parser or the Lua config manager — found     ─
# ── live during 13.1-02's Task 1 end-to-end proof (custom->css,          ─
# ── custom->gradient, int->bool), for the SAME semantic value. A plain   ─
# ── `diff -u` over options.jsonl would report a spurious FAIL for every  ─
# ── such record once the full config is Lua — roughly 25-27 of this      ─
# ── repo's 46 baseline records, measured against the committed baseline. ─
# ── This comparison discards the type-key NAME entirely and compares     ─
# ── only (option, normalized_value), folding booleans against integers   ─
# ── (false==0, true==1) so {"int":0} and {"bool":false} compare EQUAL     ─
# ── while {"int":0} vs {"bool":true} still FAILS. `set` semantics are    ─
# ── preserved exactly as before (compared by direct equality, never      ─
# ── normalized). binds.json and animations.json do NOT get this          ─
# ── treatment — confirmed live in 13.1-03 Task 3 that neither suffers    ─
# ── the same divergence class (animations.json: no divergence at all;    ─
# ── binds.json: a DIFFERENT, more severe divergence — see COVERAGE.md).  ─
# ── A genuine value difference still FAILs and still names the diverged  ─
# ── key (D-10); malformed/ambiguous records (not exactly one type-key    ─
# ── besides option/set) are a hard FAIL, never a silent skip.
_compare_options_normalized() {
    local baseline="$1" live="$2"
    python3 - "$baseline" "$live" <<'PYEOF'
import json
import sys


def load_jsonl(path):
    records = {}
    try:
        fh = open(path, 'r', encoding='utf-8')
    except OSError as exc:
        print(f"{path}: cannot read — {exc}", file=sys.stderr)
        sys.exit(2)
    with fh:
        for lineno, raw in enumerate(fh, 1):
            raw = raw.strip()
            if not raw:
                continue
            try:
                obj = json.loads(raw)
            except json.JSONDecodeError as exc:
                print(f"{path}:{lineno}: invalid JSON — {exc}", file=sys.stderr)
                sys.exit(2)
            option = obj.get('option')
            if option is None:
                print(f"{path}:{lineno}: record has no 'option' key: {raw}", file=sys.stderr)
                sys.exit(2)
            type_keys = [k for k in obj.keys() if k not in ('option', 'set')]
            if len(type_keys) != 1:
                print(
                    f"{path}:{lineno}: expected exactly one type-key besides "
                    f"option/set, found {type_keys}: {raw}",
                    file=sys.stderr,
                )
                sys.exit(2)
            tk = type_keys[0]
            raw_value = obj[tk]
            # Boolean<->integer normalization ONLY — every other type
            # (string, float, list/vec2) compares by its own JSON value,
            # unchanged. This is the one fold explicitly authorized: a
            # Lua `true`/`false` literal produces a genuine JSON boolean
            # where hyprlang's own 0/1 int convention represents the same
            # conceptual state.
            norm_value = int(raw_value) if isinstance(raw_value, bool) else raw_value
            records[option] = {
                'type_key': tk,
                'raw_value': raw_value,
                'norm_value': norm_value,
                'set': obj.get('set'),
            }
    return records


baseline_path, live_path = sys.argv[1], sys.argv[2]
baseline = load_jsonl(baseline_path)
live = load_jsonl(live_path)

all_keys = sorted(set(baseline) | set(live))

diffs = []
notes = []

# ── Theme-driven options are compared for PRESENCE, never for VALUE ──────
# (LEDGER-07, 2026-08-14.)
#
# These keys carry colours rendered by the theme engine, so their value is a
# pure function of whichever theme is active RIGHT NOW. Comparing them by
# value does not assert config equivalence at all — it asserts "the desktop
# is on the same theme as the day this baseline was captured", which is a
# different (and useless) claim, and one that is impossible to satisfy in
# the exact situation this check matters most: `theme-stress-test` switches
# through ten themes by design, so at most one of its ten switches could
# ever have passed. That is why LEDGER-07 sat unreachable rather than merely
# stale — re-capturing the baseline could not have fixed it, only moved
# which single theme happened to pass.
#
# `set` and presence are STILL compared, so a theme key disappearing, or
# never being applied at all, still FAILS — the regression this check
# genuinely owns here is "does the config still drive this option", not
# "which colour did it drive it to". Colour CORRECTNESS is owned by
# `theme-parity` and `theme-doctor`'s own palette checks, which compare
# rendered output against the active theme's palette — the right instrument
# for the question, and already run in the same `theme-doctor` pass.
#
# Deliberately narrow: exactly the three colour-valued keys of the 46
# tracked, enumerated rather than pattern-matched, so a future non-colour
# option can never be silently swallowed by a broad `col.*` glob.
THEME_DRIVEN_KEYS = {
    'general:col.active_border',
    'general:col.inactive_border',
    'decoration:shadow:color',
}

for key in all_keys:
    b = baseline.get(key)
    l = live.get(key)
    if key in THEME_DRIVEN_KEYS and b is not None and l is not None:
        if b['set'] != l['set']:
            diffs.append(
                f"! {key}: theme-driven key, but `set` differs "
                f"(baseline set={b['set']} vs live set={l['set']}) — the config "
                f"no longer drives this option"
            )
        else:
            notes.append(
                f". {key}: theme-driven — value compared for presence only "
                f"(baseline={b['raw_value']!r} vs live={l['raw_value']!r}); "
                f"colour correctness is theme-parity/theme-doctor's own check"
            )
        continue
    if b is None:
        diffs.append(f"+ {key}: present in live only ({l['type_key']}={l['raw_value']!r})")
        continue
    if l is None:
        diffs.append(f"- {key}: present in baseline only ({b['type_key']}={b['raw_value']!r})")
        continue
    if b['norm_value'] != l['norm_value'] or b['set'] != l['set']:
        diffs.append(
            f"! {key}: baseline={b['type_key']}={b['raw_value']!r} set={b['set']} "
            f"vs live={l['type_key']}={l['raw_value']!r} set={l['set']} "
            f"(normalized: {b['norm_value']!r} vs {l['norm_value']!r})"
        )
    elif b['type_key'] != l['type_key']:
        notes.append(
            f". {key}: type-key differs but normalized value equal "
            f"(baseline={b['type_key']!r} vs live={l['type_key']!r}, both -> {b['norm_value']!r})"
        )

for n in notes:
    print(n)

if diffs:
    for d in diffs:
        print(d)
    sys.exit(1)

sys.exit(0)
PYEOF
}

# ── Structural (non-dispatcher/arg) binds.json comparison (13.1-04 Task 3, ─
# ── authorized scope addition — D-16/T-13.1-12/T-13.1-13) ─────────────────
# ── `hyprctl -j binds` cannot introspect a Lua-registered bind's command:  ─
# ── every Lua bind reads back `dispatcher: "__lua"` and an opaque small-   ─
# ── integer `arg` (an internal closure index), never the real dispatcher   ─
# ── name/argument text a hyprlang-sourced capture shows (found live in     ─
# ── 13.1-03 Task 3; see COVERAGE.md's "binds.json opacity" section for the ─
# ── full finding). A byte-exact `diff -u` over the whole record would      ─
# ── therefore FAIL on `dispatcher`/`arg` for every one of this repo's ~80  ─
# ── binds after the Wave 7 Lua cutover — a 100% false-positive rate on     ─
# ── exactly those two fields, making a raw binds.json FAIL uninformative   ─
# ── post-cutover. This function keeps the check meaningful by comparing    ─
# ── STRUCTURAL fields byte-exact — every field except `dispatcher`/`arg` — ─
# ── while `dispatcher`/`arg` themselves are proven separately, at the      ─
# ── source level, by keybind-source-equivalence (D-16 entries below).      ─
# ── This is NOT a loosening of the structural fields: a dropped bind, a    ─
# ── wrong modmask, a wrong key/keycode, a changed flag, or a changed       ─
# ── submap still FAILs and still names the offending bind by index+key.    ─
_compare_binds_structural() {
    local baseline="$1" live="$2"
    python3 - "$baseline" "$live" <<'PYEOF'
import json
import sys

# Every hyprctl -j binds field EXCEPT dispatcher/arg (opaque for Lua binds —
# see this function's header comment above) AND EXCEPT mouse (its own
# narrow rule below — 14-10 Task 3). Field set confirmed identical between
# a hyprlang-sourced and a Lua-sourced capture in 13.1-03 Task 3.
STRUCTURAL_FIELDS = [
    "locked", "release", "repeat", "longPress", "non_consuming",
    "auto_consuming", "has_description", "modmask", "submap",
    "submap_universal", "key", "catch_all", "description",
    "allow_input_capture",
]
# keycode gets its own, narrower rule (see below): baseline reports the
# real physical keycode (e.g. 107) for a code:NNN bind; a Lua-registered
# code:NNN bind's keycode field reads back 0 — a documented, separate
# serialization gap (13.1-03/13.1-04), not part of this task's authorized
# scope to close. Every OTHER bind (baseline keycode 0) must still match
# exactly — this rule only forgives the specific 107-vs-0 shape.
#
# mouse gets the SAME shape of narrow rule (14-10 Task 3, MAINT-04): the two
# bindm-ported binds (mouse:272 drag-move, mouse:273 drag-resize) read back
# mouse:false under the Lua config manager where the baseline recorded
# mouse:true — HL.BindOptions (the typed stub) does not list "mouse" as a
# settable field at all, and hl.bind's opts table has no field validator to
# confirm whether { mouse = true } (the exact vendor-example shape, used
# verbatim in hyprland.lua) has any real effect. Documented in the
# baseline's own uncovered.txt since 13.1-04, which explicitly instructed:
# "does NOT tolerate this divergence (no loosening)... legitimately FAILs on
# these two records' mouse field until independently resolved." This rule is
# that independent resolution.
#
# CONFIRMED 2026-07-30 (14-10 Task 4 render gate) — no longer provisional.
# The compensating check this rule stood on has now been RUN by the human:
# Super+left-drag MOVES a floating window and Super+right-drag RESIZES one,
# both confirmed working. The divergence is therefore COSMETIC — a readback
# gap in hyprctl's JSON surface, not a functional regression — and this
# forgiveness is the correct resolution rather than a papering-over. The
# question 13.1-04 opened and deliberately left this gate FAILING on is
# closed.
#
# Corroborating evidence gathered at the same gate, recorded so a future
# reader does not re-derive it: `SKeybind` (hyprland 0.56.1,
# /usr/include/hyprland/src/managers/KeybindManager.hpp) carries THREE
# distinct fields — `mouse`, `click` and `drag` — but `hyprctl binds -j`
# serializes only `mouse`. `hl.dsp.window.drag()` plausibly sets `drag`
# instead, which would explain a false `mouse:false` exactly. The config
# form in keybinds.lua is also byte-identical to hyprland 0.56.1's OWN
# bundled example config, and `hyprctl configerrors` is empty. It forgives
# EXACTLY this one field on EXACTLY these two bind records — any OTHER
# field differing on these records, or `mouse` differing on any OTHER
# record, still FAILs below via STRUCTURAL_FIELDS' own blanket comparison
# (mouse is absent from that list precisely so this narrower rule is the
# only path that can excuse it, and only for this one documented shape).
MOUSE_FORGIVEN_KEYS = {"mouse:272", "mouse:273"}

baseline_path, live_path = sys.argv[1], sys.argv[2]
baseline = json.load(open(baseline_path))
live = json.load(open(live_path))

diffs = []
notes = []

# ── Identity-matched, NOT positional (fix for the phantom-tail defect) ────
# This comparison used to walk `zip(baseline, live)` by array index. A single
# inserted bind shifts every subsequent record, so one real addition
# manufactured dozens of "differences" that were the same insertion echoing
# down the array — measured live at 14-10 Task 3: 65 reported lines, exactly
# 2 real. Two genuine findings hid inside sixty-three phantoms for as long as
# this gate stayed red, which is exactly how a real mismatch goes unnoticed.
#
# Records are now paired by a stable identity and compared within the pair,
# so an addition or removal is reported as ONE line naming that bind, and
# every other record is still compared byte-exact on the structural fields.
# This is strictly MORE sensitive than the positional form, not less: nothing
# is forgiven that was not forgiven before, and a bind that moved position
# without changing is no longer reported at all — because it did not change.
#
# `keycode` and `mouse` are excluded from the IDENTITY (both carry documented
# serialization gaps that would stop a record pairing with itself) but are
# still COMPARED inside each matched pair by their own narrow rules below.
# Deliberately MINIMAL: what physically names a bind, and nothing else.
# Every field kept out of the identity stays in STRUCTURAL_FIELDS and is
# compared inside the matched pair, which is what makes a changed flag report
# as "field 'locked' baseline=X live=Y" naming the bind, instead of
# degrading into an unhelpful ADDED+REMOVED pair. Verified unique across both
# the committed baseline and a live capture before being relied on; an
# ambiguous identity is reported rather than guessed at (below).
# `release` is part of a bind's IDENTITY, not just its payload (LEDGER-07,
# 2026-08-14). Hyprland lets a press-bind and a release-bind coexist on one
# chord, and this repo deliberately uses that: `keybinds.lua`'s own comment at
# the SUPER_L site records that the hold-to-reveal bind "shares the
# 'SUPER + SUPER_L' chord with the tap-to-menu bind above". With `release`
# outside the identity those two collapse onto one key, pairing turns
# ambiguous, and the gate emitted "duplicate bind identity ... cannot pair
# records unambiguously" — a real FAIL caused by the identity being too coarse
# to describe the config, not by any divergence. Adding it makes tap and hold
# each pair with their own counterpart. `release` remains in STRUCTURAL_FIELDS
# too, so a bind that genuinely flips press<->release is still caught: it now
# reads as one ADDED plus one REMOVED rather than a silent field mismatch.
def _identity(b):
    return (b.get("submap", ""), b.get("modmask"), b.get("key"),
            b.get("release"))

def _describe(b):
    return f"modmask={b.get('modmask')!r} key={b.get('key')!r} keycode={b.get('keycode')!r}"

base_by_id = {}
live_by_id = {}
for arr, target, name in ((baseline, base_by_id, "baseline"), (live, live_by_id, "live")):
    for b in arr:
        ident = _identity(b)
        if ident in target:
            # Ambiguous identity — refuse to guess. Falling back to a silent
            # positional compare here would reintroduce the phantom tail.
            diffs.append(f"duplicate bind identity in {name}: {_describe(b)} — cannot pair records unambiguously")
        target[ident] = b

# ── Deliberate post-migration additions (LEDGER-07, 2026-08-14) ─────────
# The baseline is a FROZEN pre-migration snapshot, by design — that is what
# makes it ground truth. But the config legitimately keeps growing: a later
# phase adding a genuinely new bind is not a migration regression, and with
# no way to record that, this gate would fail permanently from the first new
# feature onward and stay failed forever. That is precisely how LEDGER-07
# became unreachable rather than merely stale.
#
# Each entry is enumerated by full identity and carries the reason and the
# declaring site, so accepting one is a conscious, reviewable act — never a
# pattern that silently swallows the next addition too. Anything not listed
# here still FAILs exactly as before.
ACCEPTED_ADDITIONS = {
    # Phase 18 (QBAR-09) hold-to-reveal: shows the OLED-hidden bar while
    # Super is held, declared at keybinds.lua:134 as
    # `hl.bind(mainMod .. " + SUPER_L", hl.dsp.global("quickshell:bar-reveal"))`.
    # Deliberately shares the SUPER_L chord with the older tap-to-menu bind
    # (keybinds.lua:86, release=True), which is why it needed `release` in the
    # identity above to be describable at all. Post-dates this baseline
    # (captured 2026-08-08); it is new config, not drifted config.
    ("", 64, "SUPER_L", False):
        "Phase 18 QBAR-09 hold-to-reveal bar (keybinds.lua:134)",
    # Phase 21 (QMEDIA-01) open-dashboard-on-Media-tab, declared at
    # keybinds.lua:243 as
    # `hl.bind(mainMod .. " + M", hl.dsp.global("quickshell:media"))`.
    # Part of the media fold-in that replaced the retired standalone GTK4
    # media applet's own entry point (RETIRE-06, D-21-12); no baseline bind
    # was removed for it, so it reads here purely as an addition. The retired
    # surface is deliberately named by requirement ID, not by package name —
    # retirement-check's checker-internals class scans this file for the
    # literal name. Post-dates this baseline (captured
    # 2026-08-08); it is new config, not drifted config.
    ("", 64, "M", False):
        "Phase 21 QMEDIA-01 dashboard-on-Media-tab (keybinds.lua:243)",
}

for ident in live_by_id.keys() - base_by_id.keys():
    if ident in ACCEPTED_ADDITIONS:
        notes.append(
            f"bind added since baseline, accepted: "
            f"{_describe(live_by_id[ident])} — {ACCEPTED_ADDITIONS[ident]}"
        )
        continue
    diffs.append(f"bind ADDED (not in baseline): {_describe(live_by_id[ident])}")
for ident in base_by_id.keys() - live_by_id.keys():
    diffs.append(f"bind REMOVED (in baseline, not live): {_describe(base_by_id[ident])}")

for ident in sorted(base_by_id.keys() & live_by_id.keys(), key=lambda t: tuple(str(x) for x in t)):
    b, l = base_by_id[ident], live_by_id[ident]
    label = f"bind ({_describe(b)})"
    for field in STRUCTURAL_FIELDS:
        if b.get(field) != l.get(field):
            diffs.append(f"{label}: field '{field}' baseline={b.get(field)!r} live={l.get(field)!r}")
    bk, lk = b.get("keycode"), l.get("keycode")
    if bk != lk:
        if bk == 107 and lk == 0:
            pass  # documented keycode-serialization gap, not a real divergence
        else:
            diffs.append(f"{label}: field 'keycode' baseline={bk!r} live={lk!r} (UNEXPECTED — not the documented 107-vs-0 gap)")
    bm, lm = b.get("mouse"), l.get("mouse")
    if bm != lm:
        if b.get("key") in MOUSE_FORGIVEN_KEYS and bm is True and lm is False:
            pass  # documented mouse-field serialization gap, CONFIRMED cosmetic
                  # at 14-10 Task 4's render gate — see the header comment above
        else:
            diffs.append(f"{label}: field 'mouse' baseline={bm!r} live={lm!r} (UNEXPECTED — not the documented mouse:272/273 True-vs-False gap)")

for n in notes:
    print(f". {n}")

if diffs:
    for d in diffs:
        print(f"! {d}")
    sys.exit(1)

sys.exit(0)
PYEOF
}

# ── Positional-comparison readability diagnostic (14-10 Task 3, Part C) ──
# `_compare_binds_structural` above is BYTE-EXACT POSITIONAL by array index
# — a single inserted or removed record shifts every subsequent record's
# index, so one genuine addition can manufacture dozens of "positional
# difference" lines that are really the SAME insertion echoing down the
# array, not independent findings. Measured live (14-10 Task 3): one
# inserted bind produced 65 reported lines, of which exactly 2 were real —
# see 14-10-SUMMARY.md. That is worse than a red gate: two genuine findings
# hid inside sixty-three phantom ones for the entire time this gate has
# been red, which is precisely how a real mismatch goes unnoticed.
#
# This function is a DIAGNOSTIC ONLY. It is printed BEFORE the positional
# diff and clearly labelled as the true delta — it does NOT touch
# `_compare_binds_structural`'s verdict logic in any way: the same
# conditions pass and fail and the same exit status is produced whether or
# not this prints. It fires ONLY when the bind COUNT mismatches (called
# from the check-mode call site below, gated on that one condition), since
# that is the one circumstance under which the positional tail becomes
# unreliable as a list of independent findings — a same-count structural
# change (e.g. one bind's modmask edited) still produces a short, directly
# readable positional diff with no phantom tail, and does not need this.
_binds_set_delta_diagnostic() {
    local baseline="$1" live="$2"
    python3 - "$baseline" "$live" <<'PYEOF'
import json
import sys
import collections

# EXACTLY the gate's own STRUCTURAL_FIELDS (minus "mouse", which the gate's
# own narrow rule already forgives on two named records) — kept in lockstep
# with _compare_binds_structural above by hand. dispatcher/arg excluded
# because the gate excludes them (Lua shim indirection); keycode excluded
# because the gate forgives it separately, via its own 107-vs-0 rule, and
# folding it into this identity would manufacture four phantom additions
# plus four phantom removals against the four baseline records carrying a
# real pre-migration keycode.
F = ["locked", "mouse", "release", "repeat", "longPress", "non_consuming",
     "auto_consuming", "has_description", "modmask", "submap",
     "submap_universal", "key", "catch_all", "description",
     "allow_input_capture"]

baseline_path, live_path = sys.argv[1], sys.argv[2]
baseline = json.load(open(baseline_path))
live = json.load(open(live_path))


def ident(r):
    return tuple((f, r.get(f)) for f in F)


cb = collections.Counter(ident(r) for r in baseline)
cl = collections.Counter(ident(r) for r in live)
added = cl - cb
removed = cb - cl

print("  [DIAGNOSTIC] true order-insensitive delta (15-field identity; dispatcher/arg/keycode/mouse excluded — see this function's header)")
if not added and not removed:
    print("    (empty — the count mismatch is a duplicate/removal that self-cancels under this identity; read the positional diff below directly)")
for k, cnt in sorted(added.items(), key=lambda kv: dict(kv[0]).get('key') or ''):
    d = dict(k)
    print(f"    + key={d.get('key')!r} modmask={d.get('modmask')!r} x{cnt}")
for k, cnt in sorted(removed.items(), key=lambda kv: dict(kv[0]).get('key') or ''):
    d = dict(k)
    print(f"    - key={d.get('key')!r} modmask={d.get('modmask')!r} x{cnt}")
PYEOF
}

# ── animations.json comparison (13.1-08, operator decision) ──────────────
# ── `hyprctl -j animations` returns a 2-element wrapper [leaves, curves].  ─
# ── Leaves (data[0], 35 records) determine runtime animation behaviour     ─
# ── directly (leaf name, bezier reference, enabled, speed, style) and stay ─
# ── BYTE-EXACT POSITIONAL — 13.1-03's empirical check found zero divergence─
# ── class here, and loosening it would hide a real future regression.      ─
# ── Curves (data[1]) get a SET comparison on the full tuple (name, X0, Y0, ─
# ── X1, Y1) instead of positional diff -u. Reason: config/animations.lua's ─
# ── curve registration iterates tokens.motion.curves with pairs() over a   ─
# ── Lua hash table, and Lua 5.5 randomizes its string-hash seed PER        ─
# ── PROCESS — proven live by running 5 separate `lua` processes over the   ─
# ── real hyprland-tokens.lua motion.curves table and observing 5 different─
# ── orderings. Sorted-key registration (also fixed in this same task) made─
# ── registration order deterministic WITHIN a process, but the committed   ─
# ── baseline's own curve order came from the old theme-engine-emitted      ─
# ── hyprlang fragment and is neither alphabetical nor declaration order —  ─
# ── so even deterministic-but-different orderings would never match it     ─
# ── positionally. Curve IDENTITY is (name, control points); array POSITION ─
# ── carries no compositor-observable meaning (Hyprland resolves a leaf's   ─
# ── `bezier = "motion-X"` reference by NAME, not by array index). A        ─
# ── changed control point, a missing curve, or an extra curve still FAILs  ─
# ── and still names the offending curve — this is a normalization of       ─
# ── ORDER only, not of VALUE.
#
# ── Motion-scale awareness (added after Phase 14's regression gate) ───────
# ── The committed baseline was captured under the `normal` motion-scale    ─
# ── preset (multiplier 1.0). Every animation leaf's `speed` is a RENDERED  ─
# ── value — lib/motion.sh emits floor(duration_ms * multiplier), clamped   ─
# ── to motion.json's floor_ms at the low end and to Hyprland's own 100.00  ─
# ── speed ceiling at the high end — so ANY preset other than `normal`      ─
# ── makes every overridden leaf diverge from the baseline by exactly that  ─
# ── multiplier and the gate reports a whole-file FAIL. Observed live under ─
# ── `lively` (1.25x): 2.0 -> 2.5, 3.0 -> 3.75, 1.5 -> 1.87, 10.0 -> 12.5.  ─
# ── That is the renderer working correctly, not a migration divergence,    ─
# ── and it dragged theme-doctor to exit 1 for any operator not sitting on  ─
# ── `normal`.                                                              ─
# ──                                                                        ─
# ── The forgiveness is NARROW, in the same shape as the mouse-field one:   ─
# ── a leaf is forgiven ONLY when `speed` is the sole differing field AND   ─
# ── the live value equals the renderer's expected scaled value derived     ─
# ── from the baseline. Every other field stays byte-exact positional, and  ─
# ── a speed that is merely "different" (not the scaled value) still FAILs. ─
# ── Under `normal` the multiplier is 1.0, so this reduces to the original  ─
# ── byte-exact comparison and changes nothing.                             ─
# ──                                                                        ─
# ── The arithmetic below MIRRORS lib/motion.sh's emission (its jq          ─
# ── `($D[$v.duration] * $mult)` -> floor clamp -> `| floor`, then the      ─
# ── MOTION_HYPR_MAX_SPEED ceiling). motion.sh remains the source of truth; ─
# ── if its rounding ever changes, this mirror must change with it.         ─
_compare_animations() {
    local baseline="$1" live="$2"
    local motion_json="$HOME/.config/theme-engine/motion.json"
    local scale mult floor_ms

    # Closed-set read, matching theme_engine_read_motion_scale's discipline:
    # an unrecognised or absent value defaults to `normal`, never flows on raw.
    scale="$(cat "$HOME/.local/state/theme/motion-scale" 2>/dev/null || echo normal)"
    case "$scale" in
        off|reduced|normal|lively) ;;
        *) scale=normal ;;
    esac
    mult="$(jq -r --arg s "$scale" '.scales[$s].multiplier // 1' "$motion_json" 2>/dev/null || echo 1)"
    floor_ms="$(jq -r '.floor_ms // 40' "$motion_json" 2>/dev/null || echo 40)"
    [[ -n "$mult" && "$mult" != "null" ]] || mult=1
    [[ -n "$floor_ms" && "$floor_ms" != "null" ]] || floor_ms=40

    python3 - "$baseline" "$live" "$mult" "$floor_ms" "$scale" <<'PYEOF'
import json
import math
import sys

baseline_path, live_path = sys.argv[1], sys.argv[2]
MULTIPLIER = float(sys.argv[3])
FLOOR_MS = float(sys.argv[4])
SCALE_NAME = sys.argv[5]

# Hyprland rejects any animation `speed` above this (lib/motion.sh's
# MOTION_HYPR_MAX_SPEED, 14-04 render-gate fix) — in milliseconds here.
MAX_SPEED_MS = 10000.0


def expected_scaled_speed(baseline_speed):
    """Reproduce lib/motion.sh's emission for a baseline (multiplier-1.0) speed.

    Baseline speed is in Hyprland deciseconds at 2dp, so its source duration in
    ms is speed*100. Scale, clamp low to floor_ms, clamp high to the Hyprland
    ceiling, truncate to whole ms (jq's `| floor`), convert back to deciseconds.
    """
    try:
        baseline_ms = round(float(baseline_speed) * 100)
    except (TypeError, ValueError):
        return None
    scaled = baseline_ms * MULTIPLIER
    if scaled < FLOOR_MS:
        scaled = FLOOR_MS
    if scaled > MAX_SPEED_MS:
        scaled = MAX_SPEED_MS
    return math.floor(scaled) / 100.0


def speed_is_scaled_equivalent(b, l):
    """True when `speed` is the ONLY differing field and the live value is
    exactly the renderer's scaled expectation for the baseline value."""
    if set(b.keys()) != set(l.keys()):
        return False
    differing = [k for k in b if b[k] != l[k]]
    if differing != ["speed"]:
        return False
    expected = expected_scaled_speed(b.get("speed"))
    if expected is None:
        return False
    try:
        return abs(float(l.get("speed")) - expected) < 0.005
    except (TypeError, ValueError):
        return False


def load(path):
    try:
        with open(path, 'r', encoding='utf-8') as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"{path}: cannot read/parse — {exc}", file=sys.stderr)
        sys.exit(2)
    if not isinstance(data, list) or len(data) != 2:
        print(
            f"{path}: expected a 2-element [leaves, curves] wrapper array, "
            f"got {type(data).__name__} of length "
            f"{len(data) if isinstance(data, list) else 'n/a'}",
            file=sys.stderr,
        )
        sys.exit(2)
    leaves, curves = data[0], data[1]
    if not isinstance(leaves, list) or not isinstance(curves, list):
        print(f"{path}: leaves/curves elements must both be arrays", file=sys.stderr)
        sys.exit(2)
    return leaves, curves


baseline_leaves, baseline_curves = load(baseline_path)
live_leaves, live_curves = load(live_path)

diffs = []

# ── Leaves: byte-exact positional (unchanged strictness) ─────────────────
if len(baseline_leaves) != len(live_leaves):
    diffs.append(
        f"leaf count mismatch: baseline={len(baseline_leaves)} live={len(live_leaves)}"
    )
scaled_forgiven = []
for i, (b, l) in enumerate(zip(baseline_leaves, live_leaves)):
    if b == l:
        continue
    if speed_is_scaled_equivalent(b, l):
        scaled_forgiven.append(
            f"leaf {b.get('name')!r}: speed {b.get('speed')} -> {l.get('speed')}"
        )
        continue
    diffs.append(f"leaf record {i} (name={b.get('name')!r}): baseline={b!r} live={l!r}")

# Never silent: forgiven leaves are always reported. These go to STDERR on
# purpose — the caller captures stdout into $diff_out and only echoes it on
# FAIL, so a stdout note would vanish on exactly the runs it needs to explain.
if scaled_forgiven:
    print(
        f". motion-scale preset {SCALE_NAME!r} (multiplier {MULTIPLIER}): "
        f"{len(scaled_forgiven)} leaf speed(s) match the renderer's scaled "
        f"expectation from the multiplier-1.0 baseline — normalized, not ignored",
        file=sys.stderr,
    )
    for line in scaled_forgiven:
        print(f".   {line}", file=sys.stderr)

# ── Curves: SET comparison on (name, X0, Y0, X1, Y1) ──────────────────────
EXPECTED_CURVE_KEYS = {"name", "X0", "Y0", "X1", "Y1"}
for label, curves in (("baseline", baseline_curves), ("live", live_curves)):
    for c in curves:
        extra_keys = set(c.keys()) - EXPECTED_CURVE_KEYS
        if extra_keys:
            print(
                f"{label} curve record has unexpected field(s) {sorted(extra_keys)}: {c!r}",
                file=sys.stderr,
            )
            sys.exit(2)


def curve_tuple(c):
    return (c.get('name'), c.get('X0'), c.get('Y0'), c.get('X1'), c.get('Y1'))


baseline_tuples = [curve_tuple(c) for c in baseline_curves]
live_tuples = [curve_tuple(c) for c in live_curves]

if len(set(baseline_tuples)) != len(baseline_tuples):
    print(
        "baseline curves contain duplicate (name, X0, Y0, X1, Y1) tuples — "
        "cannot compare as a set",
        file=sys.stderr,
    )
    sys.exit(2)
if len(set(live_tuples)) != len(live_tuples):
    print(
        "live curves contain duplicate (name, X0, Y0, X1, Y1) tuples — "
        "cannot compare as a set",
        file=sys.stderr,
    )
    sys.exit(2)

baseline_set = set(baseline_tuples)
live_set = set(live_tuples)

missing = baseline_set - live_set
added = live_set - baseline_set

# ── Plugin-registered curves are not this config's to declare ────────────
# (LEDGER-07, 2026-08-14.)
#
# The baseline is the PRE-MIGRATION hyprlang ground truth: its whole purpose
# is to prove the Lua config still produces the same compositor state the
# hyprlang config did. A curve registered by a hyprpm PLUGIN was never in
# this repo's config in either era, so its presence says nothing about
# migration equivalence — it only says the plugin is loaded, which is
# `dynamic-cursors.lua`'s own concern and Phase 17's own deliberate D-36/D-37
# addition (made after this baseline was captured).
#
# Enumerated by exact name, never by a `dynamic-cursors-*` prefix glob, so a
# future plugin curve has to be added here consciously rather than inheriting
# an exemption it was never reasoned about.
PLUGIN_REGISTERED_CURVES = {
    'dynamic-cursors-magnification',
}
_plugin_forgiven = {t for t in added if (t[0] or '') in PLUGIN_REGISTERED_CURVES}
added -= _plugin_forgiven

for t in sorted(missing, key=lambda x: (x[0] or '')):
    diffs.append(f"- curve present in baseline only: {t}")
for t in sorted(added, key=lambda x: (x[0] or '')):
    diffs.append(f"+ curve present in live only: {t}")
for t in sorted(_plugin_forgiven, key=lambda x: (x[0] or '')):
    print(f". curve present in live only: {t[0]} — plugin-registered "
          f"(hyprpm), not declared by this repo's config in either era; "
          f"forgiven for migration-equivalence purposes")

if diffs:
    for d in diffs:
        print(d)
    sys.exit(1)

sys.exit(0)
PYEOF
}

# ── _derive_key_list: the option-key source for _capture_snapshot below ──
# Prefers parsing the live hyprlang config tree (D-08: dynamic, never
# hardcoded) when CONFIG_FILES is non-empty — the exact pre-13.1-10
# behavior, kept so a future re-snapshot against a hyprlang tree (e.g. a
# different migration) still works unmodified. 13.1-10 retired that tree
# once the operator resolved Task 2's one-way decision as retire-now, so
# CONFIG_FILES is now empty in the common case — this falls back to the
# committed baseline's own options.jsonl "option" field, the frozen
# ground truth of exactly which keys this gate has always checked, immune
# to the config tree's own retirement. Only affects --snapshot mode's
# uncovered.txt/permissions and default check mode's live key discovery;
# it never changes what the baseline itself records.
_derive_key_list() {
    if [[ "${#CONFIG_FILES[@]}" -gt 0 ]]; then
        _parse_config_tree keys "${CONFIG_FILES[@]}"
    else
        jq -r '.option' "$BASELINE_DIR/options.jsonl" 2>/dev/null | sort -u
    fi
}

# ── Shared capture routine: writes binds.json/animations.json/options.jsonl ─
# ── into $1, and (only if $2 == 1) uncovered.txt too (D-16). Used by both  ─
# ── --snapshot mode and the default check mode's live re-derivation, so   ─
# ── the two modes can never drift apart on key-extraction logic.          ─
_capture_snapshot() {
    local outdir="$1" write_uncovered="$2"
    mkdir -p "$outdir"

    hyprctl -j binds > "$outdir/binds.json" 2>/dev/null || return 1
    hyprctl -j animations > "$outdir/animations.json" 2>/dev/null || return 1

    local -a _keys
    mapfile -t _keys < <(_derive_key_list)

    : > "$outdir/options.jsonl"
    if [[ "$write_uncovered" == "1" ]]; then
        : > "$outdir/uncovered.txt"
    fi

    local key out rc set_val
    for key in "${_keys[@]}"; do
        [[ -z "$key" ]] && continue
        out="$(hyprctl -j getoption "$key" 2>/dev/null)"
        rc=$?
        if [[ $rc -ne 0 ]]; then
            [[ "$write_uncovered" == "1" ]] && printf '%s\t%s\n' "$key" "hyprctl getoption exited non-zero ($rc)" >> "$outdir/uncovered.txt"
            continue
        fi
        if ! printf '%s' "$out" | jq -e . >/dev/null 2>&1; then
            [[ "$write_uncovered" == "1" ]] && printf '%s\t%s\n' "$key" "getoption returned no JSON record (raw: ${out:-<empty>})" >> "$outdir/uncovered.txt"
            continue
        fi
        set_val="$(printf '%s' "$out" | jq -r '.set // empty')"
        if [[ "$set_val" == "false" ]]; then
            [[ "$write_uncovered" == "1" ]] && printf '%s\t%s\n' "$key" "getoption record present but set:false" >> "$outdir/uncovered.txt"
            continue
        fi
        printf '%s\n' "$out" >> "$outdir/options.jsonl"
    done

    if [[ "$write_uncovered" == "1" ]]; then
        local -a _grants
        mapfile -t _grants < <(_parse_config_tree permissions "${CONFIG_FILES[@]}")
        local grant
        for grant in "${_grants[@]}"; do
            [[ -z "$grant" ]] && continue
            printf 'permission-grant:%s\t%s\n' "$grant" \
                "permission grants are read once at Hyprland startup and are not exposed via hyprctl getoption — no per-grant introspection key exists; compensating check: recorded side-by-side textual review in plan 13.1-06" \
                >> "$outdir/uncovered.txt"
        done
    fi

    return 0
}

# ── --uncovered: convenience reader over the committed baseline ──────────
if [[ "$MODE" == "uncovered" ]]; then
    if [[ ! -f "$BASELINE_DIR/uncovered.txt" ]]; then
        echo "hypr-equivalence-check: no uncovered.txt found at $BASELINE_DIR" >&2
        exit 1
    fi
    cat "$BASELINE_DIR/uncovered.txt"
    exit 0
fi

# ── --snapshot: capture ground truth, no comparison ───────────────────────
if [[ "$MODE" == "snapshot" ]]; then
    if ! command -v hyprctl &>/dev/null; then
        echo "hypr-equivalence-check: hyprctl not found in PATH" >&2
        exit 1
    fi
    if ! command -v jq &>/dev/null; then
        echo "hypr-equivalence-check: jq not found in PATH" >&2
        exit 1
    fi

    mkdir -p "$OUTDIR"

    if ! _capture_snapshot "$OUTDIR" 1; then
        echo "  [FAIL] snapshot capture failed (hyprctl -j binds/animations against a live compositor required)" >&2
        exit 1
    fi

    HYPRCTL_VERSION_LINE="$(hyprctl version 2>/dev/null | head -1)"
    GIT_COMMIT="$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo unknown)"
    CAPTURE_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    KEY_COUNT="$(_derive_key_list | grep -c . || true)"
    BIND_COUNT="$(jq 'length' "$OUTDIR/binds.json" 2>/dev/null || echo 0)"
    OPT_COUNT="$(wc -l < "$OUTDIR/options.jsonl" | tr -d ' ')"
    UNCOVERED_COUNT="$(wc -l < "$OUTDIR/uncovered.txt" | tr -d ' ')"

    {
        echo "# hypr-equivalence-check baseline manifest"
        echo ""
        echo "- hyprctl version: $HYPRCTL_VERSION_LINE"
        echo "- config format at capture time: hyprlang (.conf) — pre-migration (D-09)"
        echo "- git commit: $GIT_COMMIT"
        echo "- capture timestamp (UTC): $CAPTURE_TS"
        echo "- option keys extracted (parsed from the 8 config files at run time, not hardcoded): $KEY_COUNT"
        echo "- binds.json bind count: $BIND_COUNT"
        echo "- options.jsonl record count: $OPT_COUNT"
        echo "- uncovered.txt entry count: $UNCOVERED_COUNT"
        echo ""
        echo "## Documented coverage limits (D-16)"
        echo ""
        if [[ "$UNCOVERED_COUNT" -gt 0 ]]; then
            echo "One line per key/declaration this gate cannot (or structurally does not) introspect"
            echo "via \`hyprctl getoption\`, with the reason and its named compensating check:"
            echo ""
            while IFS=$'\t' read -r k reason; do
                [[ -z "$k" ]] && continue
                echo "- \`$k\` — $reason"
            done < "$OUTDIR/uncovered.txt"
        else
            echo "No entries — every extracted option key resolved via \`hyprctl getoption\`."
        fi
    } > "$OUTDIR/MANIFEST.md"

    echo "  [OK] snapshot written to $OUTDIR"
    exit 0
fi

# ── Default: check mode — live re-derive, diff against baseline ──────────
PASS=0
FAIL=0

echo "hypr-equivalence-check — baseline: $BASELINE_DIR"
echo ""

if [[ ! -d "$BASELINE_DIR" ]] || [[ -z "$(ls -A "$BASELINE_DIR" 2>/dev/null)" ]]; then
    echo "  [FAIL] baseline directory is absent or empty ($BASELINE_DIR) — never counted as a PASS or a SKIP"
    FAIL=$((FAIL + 1))
    echo ""
    echo "PASS: $PASS  FAIL: $FAIL"
    exit 1
fi

TMP_FILES=()
cleanup() {
    local t
    for t in "${TMP_FILES[@]}"; do
        rm -rf "$t"
    done
}
trap cleanup EXIT

TMPDIR_LIVE="$(mktemp -d)"
TMP_FILES+=("$TMPDIR_LIVE")

if ! _capture_snapshot "$TMPDIR_LIVE" 0; then
    echo "  [FAIL] live hyprctl capture failed — is Hyprland running?"
    FAIL=$((FAIL + 1))
    echo ""
    echo "PASS: $PASS  FAIL: $FAIL"
    exit 1
fi

for rf in binds.json animations.json options.jsonl; do
    baseline_file="$BASELINE_DIR/$rf"
    live_file="$TMPDIR_LIVE/$rf"

    if [[ ! -r "$baseline_file" ]]; then
        echo "  [FAIL] $rf: baseline file missing or unreadable — never a SKIP"
        FAIL=$((FAIL + 1))
        continue
    fi

    if [[ "$rf" == "options.jsonl" ]]; then
        # 13.1-03 Task 3: normalized comparison — see
        # _compare_options_normalized's header comment for why only this
        # file gets this treatment (binds.json/animations.json do not
        # suffer the same divergence class — see COVERAGE.md).
        if diff_out="$(_compare_options_normalized "$baseline_file" "$live_file")"; then
            echo "  [PASS] $rf: matches baseline (normalized: type-key name discarded, bool<->int folded)"
            [[ -n "$diff_out" ]] && echo "$diff_out"
            PASS=$((PASS + 1))
        else
            echo "  [FAIL] $rf: differs from baseline (normalized comparison)"
            echo "$diff_out"
            FAIL=$((FAIL + 1))
        fi
        continue
    fi

    if [[ "$rf" == "binds.json" ]]; then
        # 13.1-04 Task 3 (authorized scope addition): structural-only
        # comparison — every field except dispatcher/arg, which are opaque
        # for Lua binds (see _compare_binds_structural's header comment
        # and COVERAGE.md). dispatcher/arg equivalence is proven
        # separately, at the source level, by keybind-source-equivalence.
        if diff_out="$(_compare_binds_structural "$baseline_file" "$live_file")"; then
            echo "  [PASS] $rf: matches baseline on every structural field (dispatcher/arg excluded — proven separately by keybind-source-equivalence)"
            PASS=$((PASS + 1))
        else
            echo "  [FAIL] $rf: differs from baseline (structural comparison)"
            # 14-10 Task 3, Part C: when and only when the bind COUNT
            # mismatches, print the true order-insensitive delta BEFORE the
            # positional diff — see _binds_set_delta_diagnostic's own header
            # for why. Does not touch the verdict above in any way: PASS/
            # FAIL and the exit status were already decided.
            _baseline_bind_count="$(jq 'length' "$baseline_file" 2>/dev/null || echo -1)"
            _live_bind_count="$(jq 'length' "$live_file" 2>/dev/null || echo -2)"
            if [[ "$_baseline_bind_count" != "$_live_bind_count" ]]; then
                _binds_set_delta_diagnostic "$baseline_file" "$live_file"
                echo "  [POSITIONAL] the diff below shifts wholesale after any insertion/removal — read the delta above first:"
            fi
            echo "$diff_out"
            FAIL=$((FAIL + 1))
        fi
        continue
    fi

    if [[ "$rf" == "animations.json" ]]; then
        # 13.1-08 (operator decision): leaves (data[0]) byte-exact
        # positional, curves (data[1]) set-compared on (name, X0, Y0, X1,
        # Y1) — see _compare_animations's header comment for the full
        # rationale (Lua 5.5 per-process string-hash-seed randomization
        # makes curve REGISTRATION order nondeterministic across fresh
        # compositor starts, and the committed baseline's own order is
        # neither alphabetical nor declaration order, so no registration
        # order could ever match it positionally).
        if diff_out="$(_compare_animations "$baseline_file" "$live_file")"; then
            echo "  [PASS] $rf: matches baseline (leaves byte-exact positional, curves set-compared)"
            PASS=$((PASS + 1))
        else
            echo "  [FAIL] $rf: differs from baseline (leaves byte-exact positional, curves set-compared)"
            echo "$diff_out"
            FAIL=$((FAIL + 1))
        fi
        continue
    fi

    if diff_out="$(diff -u "$baseline_file" "$live_file")"; then
        echo "  [PASS] $rf: matches baseline"
        PASS=$((PASS + 1))
    else
        echo "  [FAIL] $rf: differs from baseline"
        echo "$diff_out"
        FAIL=$((FAIL + 1))
    fi
done

echo ""
echo "PASS: $PASS  FAIL: $FAIL"
[[ "$FAIL" -eq 0 ]]
exit $?

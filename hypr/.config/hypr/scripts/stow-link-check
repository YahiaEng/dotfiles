#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║               STOW-LINK-CHECK (22-02)                 ║
# ║  Dangling-symlink sweep over every stow-created target. ║
# ║  Report-only — never mutates, moves or deletes anything ║
# ║  it scans.                                              ║
# ╚══════════════════════════════════════════════════════╝
#
# RETIRE-09/D-22-06 requires that SC-2's symlink clause ("no dangling
# reference exists anywhere in the reproduced system") have a mechanism —
# measurement confirmed nothing in this repo checks for dangling symlinks
# anywhere (theme-doctor, theme-parity, stow.sh and the whole scripts tree
# were grepped; the only "dangling" hits were motion-lint's token-reference
# language and prose). Built the way every other gate in this repo is built:
# standalone script + committed compliant/poisoned fixtures + --self-test,
# folded into theme-doctor with a guarded skip — the shape motion-lint,
# colour-lint and retirement-check all take (D-22-06). Explicitly rejected:
# a bare `find -xtype l` written into the harness, because "a gate that
# cannot be pointed at a fixture cannot be proven to fail" (D-28).
#
# Usage:
#   stow-link-check
#       No argument: sweeps the real deployed targets under $HOME.
#   stow-link-check --root <dir>
#       Treats <dir> as the $HOME equivalent — the same code path serves a
#       throwaway/poisoned fixture directory as serves the real tree (D-28).
#   stow-link-check --self-test
#       Replays the six committed fixtures under tests/stow-link-fixtures/
#       and asserts each expected verdict. Exit 0 (all as expected) / 1
#       (otherwise).
#   stow-link-check --list
#       Prints the declared sweep-root set and the exemption list, then
#       exits 0.
#
# Exit codes: 0 clean / 1 any [FAIL] / 2 invalid argument.
#
# Sweep-root set, derived from stow.sh:19's PACKAGES loop and the three
# documented exceptions at stow.sh:190-225 (RETIRE-09's own discretion note:
# "err toward covering every path stow.sh's PACKAGES loop can write to").
# Re-measured directly against every PACKAGES entry's shipped tree for
# 22-08 (a real dev-host sweep under the pre-22-08 rules reported 1095
# findings; only 3 were this repo's own debt — the rest were sweep-scope
# defects, corrected below):
#   .config                    config-scoped — depth-1 catches every
#                               top-level orphan (incl. a RETIRED package's
#                               leftover link, e.g. the RETIRE-04/05
#                               surfaces, which no longer have a PACKAGES
#                               entry to name), and
#                               recurses ONLY into the owned-directory names
#                               in OWNED_CONFIG_TOP below plus the single
#                               systemd/user/ exception nested one level
#                               inside it — never into a third-party app
#                               directory no package owns (measured example:
#                               zen/, a browser profile dir this repo does
#                               not manage).
#   .local/share/applications  recursive     — measured: of all 17 PACKAGES
#                               entries, only vscodium writes anywhere under
#                               ~/.local (three .desktop files at exactly
#                               this path). The prior '.local' recursive
#                               root swept the entire rest of ~/.local too
#                               — unrelated host software (Steam's runtime
#                               shims, podman's overlay storage) — producing
#                               1085 of the 1095 pre-22-08 findings on this
#                               dev host alone.
#   Pictures/Wallpapers         recursive    — the wallpapers package, the
#                               one package whose tree roots outside
#                               .config/.local
#   Pictures/Screenshots        recursive    — the sibling root stow.sh
#                               pre-creates alongside it
#   .                           home-named    — top-level dotfiles a
#                               package can place directly in $HOME.
#                               Measured 2026-08-28: NO package ships one
#                               any more — zshell (~/.zshrc) was the only
#                               one and is retired. Kept as a named
#                               allowlist rather than a blanket depth-1
#                               walk, because a blanket walk also reports
#                               ~/.steampath (Steam's own artifact, never
#                               stow-managed) and there is no known
#                               retired-package orphan at this level a
#                               name allowlist would blind (unlike
#                               .config's RETIRE-04/05 case).
# The name-allowlist restriction on the home root is load-bearing: it
# catches exactly the top-level dotfile link(s) a package actually writes
# without descending into the repository clone or unrelated home content
# (Steam's ~/.steampath, ~/.steam*), which would make the sweep unbounded.
#
# 22-08/T-22-08-BLIND: narrowing scope can silently convert a real finding
# into a pass — exactly the failure SC-2 exists to prevent. The .config
# depth-1 pass is deliberately unconditional (every top-level entry, owned
# or not) specifically so a retired package's orphaned top-level link stays
# caught even after its PACKAGES entry is long gone; only the RECURSIVE
# descent below a real top-level directory is ownership-gated.
#
# 22-08/T-22-08-SELFBLIND: this checker's own committed fixture tree
# (tests/stow-link-fixtures/) is deployed by the hypr package to
# ~/.config/hypr/scripts/tests/stow-link-fixtures/ on every machine — a
# .config sweep that recurses into hypr/ (owned) would otherwise report its
# own deliberately-poisoned test data as real findings on every run,
# forever. FIXTURE_SCOPE_EXCLUSION_RELPATH prunes exactly that one
# stow-TARGET location during a normal walk. This is a SCOPE exclusion, not
# an EXEMPTIONS entry (D-22-06 reserves EXEMPTIONS for links legitimately
# dangling BY DESIGN within this repo's own stow output — a deployed test
# fixture is out of the sweep's declared territory, a different concept
# entirely) — printed whenever it fires, never silent, and it keys on the
# fixed relative deployment path, not on the fixture directory names or the
# word "poisoned", so a poisoned-looking link anywhere else is still caught
# (self-test's own `--root <fixture-dir>` invocations point AT a fixture
# directly and never walk through this deployment path, so they are
# unaffected).
#
# Full-chain symlink resolution: a link is DANGLING if and only if the
# entire chain fails to resolve — a link landing on an existing intermediate
# whose own target is absent is still reported, and a symlink loop is
# reported dangling rather than hanging the sweep (the poisoned-symlink-
# chain fixture proves this). Every within-root hit list is sorted under a
# byte-order sort, so two runs over an unchanged tree are byte-identical.
#
# Exemptions: a deny-by-default list, same discipline motion-lint's
# EXEMPTIONS/colour-lint's EXEMPTIONS establish — every entry requires a
# non-empty reason, and every exemption that actually suppressed a hit on a
# given run is printed on that run, never silently discarded. Starts EMPTY;
# an entry is added only if a real sweep surfaces a link that is
# legitimately dangling by design, with the reason written at that moment.
#
# Never mutates anything it scans — pure read-only analysis.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
SELF_PATH="$SCRIPT_DIR/stow-link-check"
FIXTURES_DIR="$SCRIPT_DIR/tests/stow-link-fixtures"

usage() {
    cat >&2 <<EOF
stow-link-check — dangling-symlink sweep over stow-created targets (RETIRE-09)

Usage:
  stow-link-check
  stow-link-check --root <dir>
  stow-link-check --self-test
  stow-link-check --list
EOF
}

_slc_reject() {
    printf 'stow-link-check: %s\n' "$1" >&2
    exit 2
}

# ── The single sweep pass — declared sweep-root data, full-chain symlink
#    resolution, exemption filtering, [PASS]/[FAIL]/[SKIP]/[EXEMPT] lines on
#    stdout matching theme-doctor's fold idiom directly. One process so the
#    resolver/sort logic is defined exactly once (retirement-check/motion-
#    lint precedent). ────────────────────────────────────────────────────
_slc_sweep() {
    local mode="$1" sweep_home="${2:-}"
    python3 - "$mode" "$sweep_home" <<'PYEOF'
import os
import sys

mode = sys.argv[1]
sweep_home = sys.argv[2] if len(sys.argv) > 2 else ''

# ── Declared sweep-root set (relative-path, recursion-mode, why) — data,
#    not scattered path literals, mirroring retirement-check's REGISTRY_RAW
#    idiom. "." is the home root itself: it always exists trivially (any
#    valid --root/HOME is a directory), so it is declared here (and shown by
#    --list) but deliberately EXCLUDED from the vacuous-green presence tally
#    below — a root that can never be "absent" cannot inform that guard.
SWEEP_ROOTS = [
    ('.config', 'config-scoped',
     'every PACKAGES entry that stows under ~/.config/<pkg>/ — depth-1 '
     'catches ALL top-level entries (incl. a retired package\'s orphaned '
     'link), recursion descends only into OWNED_CONFIG_TOP names plus the '
     'systemd/user/ exception, never into an unowned dir like zen/ (22-08)'),
    ('.local/share/applications', 'recursive',
     'the ONE .local path any PACKAGES entry writes — vscodium\'s three '
     '.desktop files. Narrowed 22-08 from a full .local recursive sweep, '
     'which reported 1085 unrelated findings (Steam runtime shims, podman '
     'overlay storage) on the dev host'),
    ('Pictures/Wallpapers', 'recursive',
     'the wallpapers package, the one package whose tree roots outside '
     '.config/.local'),
    ('Pictures/Screenshots', 'recursive',
     'the sibling root stow.sh pre-creates alongside it'),
    ('.', 'home-named',
     'top-level dotfiles a package can place directly in $HOME — measured '
     '2026-08-28: NONE, zshell (~/.zshrc) was the only one and is retired. '
     'Named-allowlist scoped (not a '
     'blanket depth-1 walk) because a blanket walk also reports '
     '~/.steampath, Steam\'s own artifact, never stow-managed — unlike '
     '.config there is no known retired-package orphan at this level to '
     'protect against a name-based narrowing (22-08 task 2 item 4)'),
]

# ── 22-08/Task 2 item 4 — every top-level $HOME dotfile any PACKAGES entry
#    ships, enumerated directly. EMPTY as of 2026-08-28: zshell/.zshrc was
#    the sole member and the package is retired. An empty set is correct,
#    not a stub — walk_links_home_named yields nothing, so the '.' root
#    contributes zero links and reports 0 dangling, which is exactly true.
#    The root is kept declared (rather than dropped from SWEEP_ROOTS) so
#    that a future package shipping a $HOME dotfile only has to add its
#    name here. Unlike .config's depth-1 pass (deliberately ungated, to
#    keep catching a retired package's orphan with no current name to
#    allowlist), this root has no equivalent known-orphan case — narrowing
#    it to a name allowlist does not blind any real finding, and removes
#    ~/.steampath (Steam's own artifact) from the sweep's declared
#    territory.
ALLOWED_HOME_DOTFILES = set()

# ── 22-08/Task 2 — .config recursion is ownership-gated. Every name here is
#    a top-level ~/.config/<name> directory a PACKAGES entry ships,
#    enumerated directly against each package's shipped tree (not guessed):
#    cava, fastfetch, fish, gtk(-3.0/-4.0), hypr, kitty, matugen,
#    nvim, quickshell, theme-engine, thunar (ships Thunar/ + xfce4/), uwsm,
#    vscodium (ships VSCodium/), yazi — plus fish's own oh-my-posh/, which
#    moved here from the retired zshell package on 2026-08-28,
#    plus hypr's own xdg-desktop-portal/ exception subtree. Whichever of
#    these render as a single whole-directory-fold symlink on a given host
#    (the common case on a fresh install) are already caught by the
#    depth-1 pass below without ever reaching this list — it only matters
#    for the ones that render as REAL directories (pre-existing target, or
#    stow.sh's explicit pre-create guards for fish/gtk/hypr/nvim/quickshell/
#    Thunar/VSCodium/xfce4), where a recursive descent is required to reach
#    the individually-symlinked files stow places inside.
#    'nvim' (quick task 260820-nua): stow.sh pre-creates ~/.config/nvim as a
#    real directory (same reason as fish/gtk/hypr/quickshell above), so its
#    per-file symlinks (init.lua, colors/, lua/, lazy-lock.json) need this
#    entry to be swept at all — without it the depth-1 pass never descends
#    into a real directory, and nothing else would cover them.
#    'autostart' is quickshell's own top-level exception subtree (ships
#    .config/autostart/nm-applet.desktop) — same treatment.
#    'systemd' is NOT included here: only its 'user' child is owned
#    (quickshell's two .service files); systemd/'s OTHER children
#    (systemd-generated *.wants/ dirs) are not this repo's concern and are
#    handled by the one-level-then-user-only special case below, not by
#    blanket inclusion.
OWNED_CONFIG_TOP = {
    'cava', 'fastfetch', 'fish', 'gtk-3.0', 'gtk-4.0', 'hypr',
    'kitty', 'matugen', 'nvim', 'quickshell', 'theme-engine', 'Thunar',
    'uwsm', 'VSCodium', 'xfce4', 'yazi', 'xdg-desktop-portal',
    'autostart', 'oh-my-posh',
}

# ── 22-08/Task 1 — the fixture-tree scope exclusion. This is where the
#    hypr package's OWN committed test fixtures land once stowed — a fixed
#    stow-TARGET location, not a name pattern. Any path found here during a
#    walk rooted somewhere else (a real $HOME sweep, or any --root NOT
#    inside the fixtures themselves) is out of the sweep's declared scope
#    and is pruned, once, with the reason printed. --self-test's own
#    `--root <fixture-dir>` invocations root the walk AT a fixture
#    directly, so this relative path is never re-encountered inside one —
#    the exclusion cannot blind the self-test to its own subject matter.
FIXTURE_SCOPE_EXCLUSION_RELPATH = os.path.join(
    '.config', 'hypr', 'scripts', 'tests', 'stow-link-fixtures')
_fixture_scope_excluded_paths = set()  # dedupe: print each pruned dir once

# ── Exemption list (D-22-06) — glob-equivalent regex -> required non-empty
#    reason -> provisional bool. Deny-by-default: refuse to load an entry
#    with an empty reason. Starts EMPTY by design (RETIRE-09's scope has
#    surfaced no link that is legitimately dangling on purpose); a future
#    entry is added only when a real sweep finds one, with the reason
#    written at that moment — never silently.
EXEMPTIONS = []

results = []  # (tag, detail) — tag in {SKIP, PASS, FAIL, EXEMPT, LIST}


def emit(tag, detail):
    results.append((tag, detail))


def dump():
    for tag, detail in results:
        print(f'{tag}\t{detail}')


for ex in EXEMPTIONS:
    if not ex.get('reason', '').strip():
        emit('FAIL', f"exemption entry {ex.get('glob', '?')!r} has an empty reason (deny-by-default violation)")


def path_is_exempt(rel_path):
    import re
    for ex in EXEMPTIONS:
        if not ex.get('reason', '').strip():
            continue
        if re.search(ex['regex'], rel_path):
            return ex
    return None


def is_dangling(link_path):
    """Full-chain resolution. Returns True if the chain is dangling (a
    missing component, or a loop), False if it fully resolves to an
    existing node. Never uses os.path.realpath()/readlink -e's single-call
    shortcuts blindly — walks hop by hop with an explicit `seen` set so a
    genuine symlink loop is detected and reported dangling rather than
    hanging the sweep (T-22-02-DOS mitigation)."""
    current = link_path
    seen = set()
    hops = 0
    while True:
        try:
            st = os.lstat(current)
        except OSError:
            return True  # a component of the chain does not exist
        import stat as _stat
        if not _stat.S_ISLNK(st.st_mode):
            return False  # resolved to a real, existing node
        if current in seen:
            return True  # symlink loop
        seen.add(current)
        hops += 1
        if hops > 40:
            return True  # pathological chain depth — treat as dangling
        target = os.readlink(current)
        if not os.path.isabs(target):
            target = os.path.normpath(os.path.join(os.path.dirname(current), target))
        current = target


def walk_links(root):
    """Yield every symlink path at or below root, recursively. Descends
    into a symlinked directory only if that directory symlink itself
    resolves (a broken directory symlink is yielded and NOT descended
    into) — mirrors motion-lint's stow-aware followlinks reasoning: stow
    frequently symlinks whole subdirectories, not just individual files."""
    stack = [root]
    visited_real = set()
    while stack:
        current_dir = stack.pop()
        real_current = os.path.realpath(current_dir)
        if real_current in visited_real:
            continue  # guard against a directory-symlink cycle
        visited_real.add(real_current)

        # 22-08/Task 1 — prune this checker's own deployed test fixtures
        # out of scope (see FIXTURE_SCOPE_EXCLUSION_RELPATH's header
        # comment). Keyed on the fixed stow-TARGET relative path, never on
        # a name or the word "poisoned", so it cannot blind the sweep to a
        # real finding located anywhere else. --self-test's own
        # `--root <fixture-dir>` calls root the walk INSIDE one fixture,
        # so `rel_from_home` there is always relative to that fixture (a
        # short path like '.'/'.config'), never equal to or under this
        # deployment path — the exclusion cannot fire during a self-test.
        rel_from_home = os.path.relpath(current_dir, sweep_home)
        if (rel_from_home == FIXTURE_SCOPE_EXCLUSION_RELPATH
                or rel_from_home.startswith(FIXTURE_SCOPE_EXCLUSION_RELPATH + os.sep)):
            if rel_from_home not in _fixture_scope_excluded_paths:
                _fixture_scope_excluded_paths.add(rel_from_home)
                emit('SCOPE-SKIP',
                     f"{rel_from_home}: this checker's own deployed test "
                     'fixtures — out of sweep scope, not an exemption '
                     '(22-08/D-22-06)')
            continue

        try:
            entries = sorted(os.scandir(current_dir), key=lambda e: e.name)
        except OSError:
            continue
        for entry in entries:
            path = entry.path
            if entry.is_symlink():
                yield path
                if not is_dangling(path):
                    try:
                        if os.path.isdir(path):
                            stack.append(path)
                    except OSError:
                        pass
            else:
                try:
                    if entry.is_dir(follow_symlinks=False):
                        stack.append(path)
                except OSError:
                    pass


def walk_links_depth1(root):
    try:
        entries = sorted(os.scandir(root), key=lambda e: e.name)
    except OSError:
        entries = []
    for entry in entries:
        if entry.is_symlink():
            yield entry.path


def walk_links_home_named(root, allowed_names):
    """22-08/Task 2 item 4 — depth-1, but filtered to a named allowlist
    rather than every top-level symlink. Deliberately narrower than
    .config's depth-1 pass: see ALLOWED_HOME_DOTFILES's header comment for
    why no retired-package-orphan protection is lost by narrowing here."""
    try:
        entries = sorted(os.scandir(root), key=lambda e: e.name)
    except OSError:
        entries = []
    for entry in entries:
        if entry.is_symlink() and entry.name in allowed_names:
            yield entry.path


def walk_config_scoped(root, sweep_home_arg):
    """22-08/Task 2 — the .config-specific walk. Depth-1 always yields
    every entry that is itself a symlink (catches a RETIRED package's
    orphaned top-level link — the RETIRE-04/05 surfaces are the live
    examples — which no longer have a PACKAGES entry to name them by).
    Recursion below a
    top-level REAL directory only happens for a name in OWNED_CONFIG_TOP,
    or for .config/systemd/user specifically (systemd's only owned child;
    its sibling *.wants/ dirs are systemd/pipewire's own generated content,
    not this repo's). Every other top-level real directory — a third-party
    app's own config dir, e.g. zen/ — is left entirely undescended, per
    T-22-08-BLIND's requirement that narrowing not blind the sweep while
    also not sweeping unowned territory."""
    try:
        entries = sorted(os.scandir(root), key=lambda e: e.name)
    except OSError:
        entries = []
    for entry in entries:
        path = entry.path
        if entry.is_symlink():
            yield path
            continue
        try:
            is_real_dir = entry.is_dir(follow_symlinks=False)
        except OSError:
            is_real_dir = False
        if not is_real_dir:
            continue  # a plain file — never a symlink, nothing to check
        if entry.name in OWNED_CONFIG_TOP:
            yield from walk_links(path)
        elif entry.name == 'systemd':
            user_dir = os.path.join(path, 'user')
            try:
                user_is_real_dir = os.path.isdir(user_dir) and not os.path.islink(user_dir)
            except OSError:
                user_is_real_dir = False
            if user_is_real_dir:
                yield from walk_links(user_dir)
        # else: an unowned top-level directory (e.g. zen/) — do not descend.


if mode == 'list':
    for rel_path, rmode, why in SWEEP_ROOTS:
        emit('LIST', f'{rel_path} ({rmode}) — {why}')
    if EXEMPTIONS:
        for ex in EXEMPTIONS:
            emit('LIST-EXEMPT', f"{ex.get('glob', '?')} — {ex.get('reason', '')}")
    else:
        emit('LIST-EXEMPT', '(none declared)')
    dump()
    sys.exit(0)

if not sweep_home or not os.path.isdir(sweep_home):
    emit('FAIL', f'sweep home {sweep_home!r} is not a directory')
    dump()
    sys.exit(1)

sweep_home_real = os.path.realpath(sweep_home)

present_count = 0
denom = 0  # roots counted toward the vacuous-green guard — excludes "."
any_link_checked = 0

# CR-01 fix: the whole sweep body is wrapped in try/except so an unhandled
# exception anywhere in the walk (a future code change, an uncaught OSError
# variant, a permission oddity under rootless-podman UID mapping) still
# reaches dump() and is reported as a FAIL, rather than the prior failure
# mode — zero output, a vacuous "0 passed, 0 failed" from run_sweep(), and
# a false PASS. This is layered ON TOP OF (not a replacement for) the
# bash-side python3-process-exit-status check added to run_sweep(): this
# try/except only helps once python3 itself is running; it cannot catch
# python3 being entirely absent from $PATH, which is the bash-side check's
# job (dump() never runs in that case because the interpreter never starts).
try:
    for rel_path, rmode, why in SWEEP_ROOTS:
        abs_root = os.path.normpath(os.path.join(sweep_home, rel_path))
        exists = os.path.isdir(abs_root)
        is_trivial = (rel_path == '.')
        if not is_trivial:
            denom += 1
            if exists:
                present_count += 1
        if not exists:
            emit('SKIP', f'{rel_path}: not present under {sweep_home} ({why})')
            continue

        if rmode == 'depth1':
            links = list(walk_links_depth1(abs_root))
        elif rmode == 'home-named':
            links = list(walk_links_home_named(abs_root, ALLOWED_HOME_DOTFILES))
        elif rmode == 'config-scoped':
            links = list(walk_config_scoped(abs_root, sweep_home))
        else:
            links = list(walk_links(abs_root))

        dangling = []
        for link_path in links:
            any_link_checked += 1
            if is_dangling(link_path):
                rel = os.path.relpath(link_path, sweep_home)
                dangling.append((rel, link_path))

        # LC_ALL=C-equivalent byte-order sort — encode to bytes so ordering
        # never depends on the interpreter's default Unicode collation.
        dangling.sort(key=lambda t: t[0].encode('utf-8'))

        for rel, link_path in dangling:
            try:
                target_desc = os.readlink(link_path)
            except OSError:
                target_desc = '<unreadable>'
            ex = path_is_exempt(rel)
            if ex is not None:
                emit('EXEMPT', f"{rel} -> {target_desc} ({ex.get('reason', '')})")
            else:
                emit('FAIL', f'{rel} -> {target_desc} (dangling)')

        non_exempt_dangling = [r for r, lp in dangling if path_is_exempt(r) is None]
        if links and not non_exempt_dangling:
            emit('PASS', f'{rel_path}: {len(links)} symlink(s), none dangling')
        elif not links:
            # 2026-08-28: a present root that yields ZERO links used to emit
            # NOTHING — the check simply vanished from the report. That went
            # from theoretical to real when zsh was retired: ALLOWED_HOME_DOTFILES
            # emptied out (~/.zshrc was its only member) and the '.' root's
            # line disappeared, taking the summary from 2 checks to 1 with no
            # indication that a declared root had stopped being covered. A
            # gate that quietly reports one fewer check is indistinguishable
            # from a gate that lost coverage, so say it out loud instead.
            emit('EMPTY', f'{rel_path}: 0 symlink(s) in scope — nothing to check '
                          '(declared root, deliberately empty)')

    if denom > 0 and present_count == 0:
        emit('FAIL', f'0 of {denom} sweep roots present under {sweep_home} — '
                     'refusing to report clean (vacuous-green guard)')
except Exception as _slc_exc:  # noqa: BLE001 - deliberately broad, fail-closed
    emit('FAIL', f'stow-link-check: internal error mid-sweep — {_slc_exc!r} '
                 '(fail-closed: an incomplete sweep is never reported clean)')

dump()
# CR-01 fix: exit status now reflects whether any FAIL was emitted (either a
# real dangling link or the internal-error/vacuous-green guards above),
# instead of always falling off the end at implicit exit 0. run_sweep()
# reads this via $? on the direct invocation (no process substitution) to
# distinguish "engine ran and found something" (rc 0/1) from "engine never
# ran to completion at all" (any other rc, e.g. 127 for a missing python3).
sys.exit(1 if any(tag == 'FAIL' for tag, _ in results) else 0)
PYEOF
}

run_list() {
    echo "stow-link-check — declared sweep-root set and exemption list:"
    echo ""
    while IFS=$'\t' read -r tag detail; do
        [[ -z "$tag" ]] && continue
        case "$tag" in
            LIST)         printf '  %s\n' "$detail" ;;
            LIST-EXEMPT)  printf '  [EXEMPT] %s\n' "$detail" ;;
        esac
    done < <(_slc_sweep list)
}

run_sweep() {
    # CR-01 fix: the python3 engine's own findings used to be read only via
    # a bash process substitution (`done < <(_slc_sweep sweep ...)`), whose
    # exit status is silently dropped by a `while read` loop unless
    # explicitly `wait`-ed on. If python3 was missing or crashed before
    # dump() ran, that produced zero lines of output, fail_n stayed 0, and
    # this function returned success — a false PASS. Writing to a real file
    # and capturing $? from the direct invocation makes the engine's own
    # exit status visible; a zero-line-output run is now also treated as a
    # FAIL rather than a vacuous pass, mirroring the python-side
    # denom>0/present_count==0 vacuous-green guard's "never report clean on
    # zero evidence" discipline instead of duplicating it inconsistently.
    local sweep_home="$1"
    local pass_n=0 fail_n=0 line_n=0 slc_rc out_file
    out_file="$(mktemp)"
    trap 'rm -f "$out_file"' RETURN

    echo "stow-link-check — dangling-symlink sweep"
    echo "  target: $sweep_home"
    echo ""

    _slc_sweep sweep "$sweep_home" > "$out_file"
    slc_rc=$?

    if [[ "$slc_rc" -ne 0 && "$slc_rc" -ne 1 ]]; then
        printf '  [FAIL] stow-link-check engine crashed or is unavailable (python3 exit %d) — refusing to report clean\n' "$slc_rc"
        echo ""
        printf 'Summary: %d passed, %d failed\n' 0 1
        return 1
    fi

    while IFS=$'\t' read -r tag detail; do
        [[ -z "$tag" ]] && continue
        line_n=$((line_n + 1))
        case "$tag" in
            SKIP)       printf '  [SKIP] %s\n' "$detail" ;;
            PASS)       printf '  [PASS] %s\n' "$detail"; pass_n=$((pass_n + 1)) ;;
            FAIL)       printf '  [FAIL] %s\n' "$detail"; fail_n=$((fail_n + 1)) ;;
            EXEMPT)     printf '  [EXEMPT] %s\n' "$detail" ;;
            SCOPE-SKIP) printf '  [SCOPE-SKIP] %s\n' "$detail" ;;
            EMPTY)      printf '  [EMPTY] %s\n' "$detail" ;;
        esac
    done < "$out_file"

    if [[ "$line_n" -eq 0 ]]; then
        printf '  [FAIL] stow-link-check produced no output at all — refusing to report clean (vacuous-green guard)\n'
        fail_n=$((fail_n + 1))
    fi

    echo ""
    printf 'Summary: %d passed, %d failed\n' "$pass_n" "$fail_n"
    [[ "$fail_n" -eq 0 ]]
}

run_self_test() {
    local -a fixtures=(
        "compliant-resolving-links:0"
        "poisoned-dangling-config-link:1"
        "poisoned-dangling-systemd-unit:1"
        "poisoned-dangling-pictures-link:1"
        "poisoned-symlink-chain:1"
        "empty-no-roots:1"
    )
    local st_pass=0 st_fail=0
    local entry fname expect_nonzero fixture_root rc want_desc out

    echo "stow-link-check --self-test — replaying the six committed fixtures"
    echo ""

    for entry in "${fixtures[@]}"; do
        fname="${entry%%:*}"
        expect_nonzero="${entry##*:}"
        fixture_root="$FIXTURES_DIR/$fname"

        if [[ ! -d "$fixture_root" ]]; then
            printf '  [FAIL] self-test: fixture missing: %s\n' "$fixture_root"
            st_fail=$((st_fail + 1))
            continue
        fi

        out="$("$SELF_PATH" --root "$fixture_root" 2>&1)"
        rc=$?

        if [[ "$expect_nonzero" == "0" ]]; then
            want_desc="exit 0 (compliant)"
        else
            want_desc="a non-zero exit (poisoned)"
        fi

        if [[ "$expect_nonzero" == "0" && "$rc" -eq 0 ]] || [[ "$expect_nonzero" == "1" && "$rc" -ne 0 ]]; then
            printf '  [PASS] self-test: %s -> %s as expected\n' "$fname" "$want_desc"
            st_pass=$((st_pass + 1))
        else
            printf '  [FAIL] self-test: %s -> exited %d, expected %s\n' "$fname" "$rc" "$want_desc"
            printf '         output:\n%s\n' "$(printf '%s\n' "$out" | sed 's/^/           /')"
            st_fail=$((st_fail + 1))
        fi
    done

    echo ""
    printf 'Self-test summary: %d passed, %d failed\n' "$st_pass" "$st_fail"
    [[ "$st_fail" -eq 0 ]]
}

case "${1:-}" in
    --list)
        run_list
        exit 0
        ;;
    --self-test)
        run_self_test
        exit $?
        ;;
    --root)
        [[ -n "${2:-}" ]] || _slc_reject "--root requires a directory argument"
        SWEEP_HOME="$2"
        shift 2
        [[ $# -eq 0 ]] || _slc_reject "unknown argument '$1'"
        run_sweep "$SWEEP_HOME"
        exit $?
        ;;
    "")
        run_sweep "$HOME"
        exit $?
        ;;
    *)
        usage
        exit 2
        ;;
esac

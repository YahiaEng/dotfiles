# ── D-15-25 identity-model functions ────────────────────────────────────
# _qsd_name_owner_rows — the single reader for the name-owner variant.
# Filters _qsd_busctl_list's output to the named bus, emits matching rows.
_qsd_name_owner_rows() {
    local busname="$1"
    _qsd_busctl_list | grep -F -- "$busname" || true
}

# count+owner sample, "<count> <owner-or-none>" on one line — the shared
# helper panel-notifications-single-owner (Task 1 Part E) samples three
# times against, and the pre-existing single-owner check below refactors
# onto as well (verdict unchanged, model underneath it promoted).
_qsd_notif_sample() {
    local rows count owner
    rows=$(_qsd_name_owner_rows "org.freedesktop.Notifications")
    count=$(printf '%s\n' "$rows" | grep -c '.')
    owner=$(printf '%s\n' "$rows" | awk '{print $3}' | head -1)
    printf '%s %s' "$count" "${owner:-<none>}"
}

# _qsd_assert_client_consumer_not_owned — the structural guard that makes
# the promotion load-bearing rather than decorative: the two registries
# must stay disjoint. Reports through check() as an ordinary gate line.
_qsd_assert_client_consumer_not_owned() {
    local bad=0 key
    for key in "${!QSD_CLIENT_CONSUMERS[@]}"; do
        if [[ -n "${QSD_NAME_OWNERS[$key]+x}" ]]; then
            bad=$((bad + 1))
        fi
    done
    check "service-participant model (D-15-25 promotion): no client-consumer registry key is also a name-owner registry key — asserting exclusivity over a many-client service is exactly the mistake this guard exists to catch (collisions: ${bad})" "$([[ "$bad" -eq 0 ]] && echo 0 || echo 1)"
}

# ── D-15-25 shared data — the ten XF86 keys, hoisted so both the
#    pre-existing check 8 (unchanged, own invocation, own verdict) and the
#    new _qsd_xf86_ownership_table below read the same literal list rather
#    than each maintaining its own copy.
XF86_KEYS=(XF86AudioRaiseVolume XF86AudioLowerVolume XF86AudioMute XF86AudioMicMute XF86MonBrightnessUp XF86MonBrightnessDown XF86AudioNext XF86AudioPause XF86AudioPlay XF86AudioPrev)

# _qsd_xf86_ownership_table — one deterministic, newline-free string of
# key=count pairs in XF86_KEYS' fixed order, reading binds through
# _qsd_hyprctl_binds and the manifest through its seam. Factored out of
# check 8's own per-key computation (which keeps its own direct
# invocation and its own verdict below — this function is a second
# reader of the same logic, not a replacement).
_qsd_xf86_ownership_table() {
    local binds_raw manifest out="" xk hypr_count manifest_count total
    binds_raw=$(_qsd_hyprctl_binds)
    manifest=$(_qsd_shortcuts_manifest_path)
    for xk in "${XF86_KEYS[@]}"; do
        hypr_count=$(printf '%s\n' "$binds_raw" | grep -c "	key: ${xk}\$")
        manifest_count=0
        if [[ -f "$manifest" ]] && command -v jq >/dev/null 2>&1; then
            manifest_count=$(jq -r --arg k "$xk" '[.[] | select(.chord.key == $k)] | length' "$manifest" 2>/dev/null)
            [[ -z "$manifest_count" ]] && manifest_count=0
        fi
        total=$((hypr_count + manifest_count))
        out="${out}${xk}=${total}${US}"
    done
    printf '%s' "$out"
}

# _qsd_osd_activation_count — counts OSD-pill activations, by polling
# `hyprctl layers -j` every 50ms across the window the given action command
# runs in. Counts rising edges (absent -> present transitions), which is a
# truer "activation count" than a bare presence flag when the pill can
# blink more than once.
#
# Phase 20 Plan 04 (D-20-05) re-points the layer filter from the retired
# OSD daemon's literal namespace (confirmed live 2026-08-02 against a real
# hardware-key raise: a 258x96 layer at level 3 owned by that daemon's
# server process) to `quickshell-osd` — `Osd.qml`'s own namespace
# (`modules/osd/Osd.qml`, a `Toast.qml` instance, D-20-02/D-20-04). Same
# polling mechanism, same rising-edge count, only the namespace literal
# changed. Used only by panel-osd-state-driven-trigger below. Plan 20-09
# (RETIRE-04) removed `_qsd_swayosd_server_reachable` outright once its
# last two consumers (this check's own D-Bus guard, superseded by D-20-05;
# and the one-step-per-press volume probe, further down) were repointed
# off the retired daemon.
_qsd_osd_activation_count() {
    local action="$1" i hit prev=0 transitions=0
    ( eval "$action" ) &
    local action_pid=$!
    for i in $(seq 1 24); do
        hit=0
        if _qsd_layers_json 2>/dev/null | jq -e '[.[]?.levels?["3"]?[]? | select(.namespace=="quickshell-osd")] | length > 0' >/dev/null 2>&1; then
            hit=1
        fi
        [[ "$hit" -eq 1 && "$prev" -eq 0 ]] && transitions=$((transitions + 1))
        prev=$hit
        sleep 0.05
    done
    wait "$action_pid" 2>/dev/null
    printf '%s' "$transitions"
}

# ── D-15-25 summon/dismiss — drives 15-03's IPC contract
#    (`qs ipc call panel open|toggle <name>`, confirmed live this session:
#    `qs list` shows exactly one Instance, `qs ipc call panel open wifi`
#    mounts `quickshell-wifi-panel` at level 3 within one second, owned by
#    the shell's own PID) with the same V5 validation _qsd_dispatch_global
#    already applies. PANEL_SUMMONED_NAME is set immediately before the
#    summon and cleared immediately after the dismiss; the cleanup trap
#    (T-11-11 discipline, extended below) dismisses a still-summoned panel
#    on interrupt so a mid-cycle Ctrl-C can never strand a panel mounted
#    on the user's screen.
_qsd_summon_panel() {
    local name="$1"
    _qsd_valid_token "$name" || return 1
    command -v qs >/dev/null 2>&1 || return 1
    PANEL_SUMMONED_NAME="$name"
    qs ipc call panel open "$name" >/dev/null 2>&1
}

_qsd_dismiss_panel() {
    local name="$1"
    _qsd_valid_token "$name" || return 1
    command -v qs >/dev/null 2>&1 || return 1
    qs ipc call panel toggle "$name" >/dev/null 2>&1
    PANEL_SUMMONED_NAME=""
}

# ── D-15-25 panel-namespace-conformance helpers ─────────────────────────
# Emits level<TAB>namespace<TAB>pid for every layer whose namespace is
# panel-shaped (quickshell-<word>-panel), at ANY level — deliberately
# broad so an off-level or unknown-namespace poison is still captured,
# not filtered out before the assertion below ever sees it.
_qsd_panel_layer_rows() {
    printf '%s' "$1" | jq -r '
        .[]? | .levels? // {} | to_entries[] | .key as $lvl | .value[]?
        | select(.namespace | test("^quickshell-[a-z]+-panel$"))
        | [$lvl, .namespace, .pid] | @tsv
    ' 2>/dev/null
}

# Asserts a layers_json snapshot carries exactly expected_count
# panel-shaped namespaces, all at level 3, all owned by a shell PID, all
# named within QSD_PANEL_NAMES's derived set, and (when expected_ns is
# given and expected_count is 1) that the one surviving namespace is
# expected_ns. Prints a one-line "count=.. off-level=.. wrong-pid=..
# unknown-ns=.." report and returns 0/1.
#
# T-16-SELFTEST (Rule 3, found and fixed live while executing Phase 16
# Plan 04's own D-16-23 checks — a genuine pre-existing bug, not caused by
# this plan's changes, but one that blocked this plan's own --self-test
# exit-0 acceptance criterion, so it is fixed here rather than only
# logged): the 4th parameter is an OPTIONAL explicit shell-pid override.
# Live call sites (below) never pass it, so behaviour there is unchanged —
# real live pgrep output. --self-test's own replay (further down) now
# passes the fixed pid baked into all four compliant/poisoned
# *-panel-layers.json fixtures (2982672) instead of comparing against
# whatever quickshell process happens to be running when --self-test
# executes, which is what made the compliant fixture spuriously report
# wrong-pid=1 and FAIL self-test on every host except the one it was
# captured on.
_qsd_assert_panel_layers() {
    local json="$1" expected_count="$2" expected_ns="${3:-}" shell_pids_override="${4:-}"
    local lvl ns pid total=0 off_level=0 wrong_pid=0 unknown_ns=0 last_ns=""
    local shell_pids
    if [[ -n "$shell_pids_override" ]]; then
        shell_pids=" $shell_pids_override "
    else
        shell_pids=" $(pgrep -f 'quickshell -p' | tr '\n' ' ') "
    fi
    while IFS=$'\t' read -r lvl ns pid; do
        [[ -z "$lvl" ]] && continue
        total=$((total + 1))
        last_ns="$ns"
        [[ "$lvl" != "3" ]] && off_level=$((off_level + 1))
        case "$shell_pids" in
            *" $pid "*) ;;
            *) wrong_pid=$((wrong_pid + 1)) ;;
        esac
        local known=0 pn
        for pn in "${QSD_PANEL_NAMES[@]}"; do
            [[ "$ns" == "${QSD_PANEL_NAMESPACE_PREFIX}${pn}${QSD_PANEL_NAMESPACE_SUFFIX}" ]] && known=1
        done
        [[ "$known" -eq 0 ]] && unknown_ns=$((unknown_ns + 1))
    done < <(_qsd_panel_layer_rows "$json")
    local ns_ok=1
    [[ -n "$expected_ns" && "$total" -eq 1 && "$last_ns" != "$expected_ns" ]] && ns_ok=0
    printf 'count=%s off-level=%s wrong-pid=%s unknown-ns=%s' "$total" "$off_level" "$wrong_pid" "$unknown_ns"
    [[ "$total" -eq "$expected_count" && "$off_level" -eq 0 && "$wrong_pid" -eq 0 && "$unknown_ns" -eq 0 && "$ns_ok" -eq 1 ]]
}

# Source half — no file under the panel QML directory (excluding
# PanelDialog.qml itself, which legitimately owns WlrLayershell.namespace
# as the shared frame) may set the layer namespace directly. Comments
# stripped first (qml `//`) so a header note restating the fence is safe.
_qsd_assert_panel_source() {
    local dir="$1" f bad=0
    while IFS= read -r f; do
        [[ "$(basename -- "$f")" == "PanelDialog.qml" ]] && continue
        if _qsd_matches "$(grep -vE '^\s*//' -- "$f" 2>/dev/null)" 'WlrLayershell\.namespace'; then
            bad=$((bad + 1))
        fi
    done < <(find -L "$dir" -maxdepth 1 -type f -name '*.qml' 2>/dev/null)
    printf 'bad=%s' "$bad"
    [[ "$bad" -eq 0 ]]
}

# 21-04 (QMEDIA-03) — asserts the standing MPRIS-reader-count invariant:
# exactly one file under the given directory imports
# Quickshell.Services.Mpris or instantiates an Mpris* type, AND that
# single match's basename is the expected reader. A bare count of one is
# spoofable by a defect that removes the real reader and adds a
# different one elsewhere (T-21-08) — this asserts identity, not only
# cardinality, so both halves must hold. Regex discipline unchanged from
# the Phase-11 check this promotes (T-11-REVIEWFIX/WR-02, comment
# preserved at the call site below): an actual API surface (the service
# import line or a QML `Mpris*` type instantiation), never a bare
# case-insensitive substring, so a prose-only mention in a comment never
# increments the count. Prints "hits=N basenames=..." and returns 0/1 —
# called both by check 9 below (live path) and by --self-test (fixture
# replay, isolated per-fixture tmpdirs).
_qsd_assert_mpris_reader() {
    local dir="$1" expected="${2:-MediaBackend.qml}"
    local f
    local MPRIS_HITS=0
    local MPRIS_BASENAMES=""
    while IFS= read -r f; do
        grep -qE 'import[[:space:]]+Quickshell\.Services\.Mpris|\bMpris[A-Za-z]*[[:space:]]*\{' "$f" 2>/dev/null || continue
        MPRIS_HITS=$((MPRIS_HITS + 1))
        MPRIS_BASENAMES="${MPRIS_BASENAMES}${MPRIS_BASENAMES:+,}$(basename -- "$f")"
    done < <(find -L "$dir" -type f 2>/dev/null)
    printf 'hits=%s basenames=%s' "$MPRIS_HITS" "${MPRIS_BASENAMES:-none}"
    [[ "$MPRIS_HITS" -eq 1 && "$MPRIS_BASENAMES" == "$expected" ]]
}

# ── 17-03 Task 4 (standing constraint #4) — mpvpaper layer-coexistence
#    helpers. AMB-01's live wallpaper is not a Quickshell surface, but it
#    shares the same layer-shell surface it must never collide with —
#    this file's coexistence remit already covers exactly this kind of
#    cross-process claim (see the D-15-25 panel helpers above). Emits
#    level<TAB>namespace<TAB>pid for every layer whose namespace is
#    EXACTLY the literal "mpvpaper" (RESEARCH.md §7: the namespace is a
#    fixed literal set unconditionally in mpvpaper's create_output(),
#    src/main.c:932-933 — never per-monitor, never derived from a flag),
#    at ANY level — deliberately broad so an off-level poison is captured
#    by the assertion below rather than filtered out before it is judged.
_qsd_mpvpaper_layer_rows() {
    printf '%s' "$1" | jq -r '
        .[]? | .levels? // {} | to_entries[] | .key as $lvl | .value[]?
        | select(.namespace == "mpvpaper")
        | [$lvl, .namespace, .pid] | @tsv
    ' 2>/dev/null
}

# Asserts a layers_json snapshot carries every mpvpaper-namespaced surface
# at level 0 (background) and owned by a PID in the supplied mpvpaper PID
# set. Prints a one-line "count=.. off-level=.. wrong-pid=.." report and
# returns 0/1. The PID set is an EXPLICIT parameter, never a live `pgrep`
# inside this function — same T-16-SELFTEST discipline
# _qsd_assert_panel_layers already established: a committed fixture must
# replay identically on any host, not only the one it was captured on.
_qsd_assert_mpvpaper_layers() {
    local json="$1" mpvpaper_pids="$2"
    local lvl ns pid total=0 off_level=0 wrong_pid=0
    local pid_set=" $mpvpaper_pids "
    while IFS=$'\t' read -r lvl ns pid; do
        [[ -z "$lvl" ]] && continue
        total=$((total + 1))
        [[ "$lvl" != "0" ]] && off_level=$((off_level + 1))
        case "$pid_set" in
            *" $pid "*) ;;
            *) wrong_pid=$((wrong_pid + 1)) ;;
        esac
    done < <(_qsd_mpvpaper_layer_rows "$json")
    printf 'count=%s off-level=%s wrong-pid=%s' "$total" "$off_level" "$wrong_pid"
    [[ "$off_level" -eq 0 && "$wrong_pid" -eq 0 ]]
}

# ── D-15-25 check bodies — called once each, after check 9, before the
#    volume probe (see run-order comment at that call site). Defined here
#    (before the trap/checks 1-12 flow) so --self-test, which dispatches
#    before the trap is even installed, can call them directly.
_qsd_check_panel_namespace_conformance() {
    if [[ "$NO_PANEL_CHECKS" -eq 1 ]]; then
        echo "  [SKIP] panel-namespace-conformance (D-15-25): disabled by --no-panel-checks"
        return
    fi
    if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1 || ! command -v qs >/dev/null 2>&1; then
        echo "  [SKIP] panel-namespace-conformance (D-15-25): hyprctl, jq or qs not found"
        return
    fi
    local overall_bad=0 report="" res rc name expected

    res=$(_qsd_assert_panel_layers "$(_qsd_layers_json)" 0); rc=$?
    [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
    report+="pre[${res}] "

    for name in "${QSD_PANEL_NAMES[@]}"; do
        expected="${QSD_PANEL_NAMESPACE_PREFIX}${name}${QSD_PANEL_NAMESPACE_SUFFIX}"
        _qsd_summon_panel "$name"
        sleep 0.4
        res=$(_qsd_assert_panel_layers "$(_qsd_layers_json)" 1 "$expected"); rc=$?
        [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
        report+="${name}-during[${res}] "
        _qsd_dismiss_panel "$name"
        sleep 0.3
        res=$(_qsd_assert_panel_layers "$(_qsd_layers_json)" 0); rc=$?
        [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
        report+="${name}-after[${res}] "
    done

    # Cross-panel case — the mechanical closure of 15-03's at-most-one-
    # panel edge truth: summon the first name, summon the second WITHOUT
    # dismissing the first (openPanel()'s own closeAllPanels() call is
    # what should tear the first one down — this proves that, it does not
    # simulate it).
    local first="${QSD_PANEL_NAMES[0]}" second="${QSD_PANEL_NAMES[1]}"
    local expected2="${QSD_PANEL_NAMESPACE_PREFIX}${second}${QSD_PANEL_NAMESPACE_SUFFIX}"
    _qsd_summon_panel "$first"
    sleep 0.3
    _qsd_summon_panel "$second"
    sleep 0.4
    res=$(_qsd_assert_panel_layers "$(_qsd_layers_json)" 1 "$expected2"); rc=$?
    [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
    report+="cross[${res}] "
    _qsd_dismiss_panel "$second"
    sleep 0.3
    res=$(_qsd_assert_panel_layers "$(_qsd_layers_json)" 0); rc=$?
    [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
    report+="cross-after[${res}] "

    res=$(_qsd_assert_panel_source "$(_qsd_panel_qml_dir)"); rc=$?
    [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
    report+="source[${res}]"

    check "panel-namespace-conformance (D-15-25/D-21/PANEL-06, mechanically closes 15-03's at-most-one-panel / zero-when-none / last-writer-wins edge truths): ${report}" "$([[ "$overall_bad" -eq 0 ]] && echo 0 || echo 1)"
}

_qsd_check_panel_shortcut_single_registration() {
    if [[ "$NO_PANEL_CHECKS" -eq 1 ]]; then
        echo "  [SKIP] panel-shortcut-single-registration (D-15-25): disabled by --no-panel-checks"
        return
    fi
    if ! command -v jq >/dev/null 2>&1 || ! command -v hyprctl >/dev/null 2>&1; then
        echo "  [SKIP] panel-shortcut-single-registration (D-15-25): jq or hyprctl not found"
        return
    fi
    local manifest keybinds kbd_out kbd_rc manifest_count=0 global_count=0 bind_count=0
    manifest=$(_qsd_shortcuts_manifest_path)
    keybinds=$(_qsd_keybinds_lua_path)
    if [[ -x "$KEYBIND_DOCTOR" ]]; then
        kbd_out=$("$KEYBIND_DOCTOR" "$keybinds" "$manifest" 2>&1)
        kbd_rc=$?
    else
        kbd_out="keybind-doctor not found or not executable at $KEYBIND_DOCTOR"
        kbd_rc=1
    fi
    if [[ -f "$manifest" ]]; then
        manifest_count=$(jq -r '[.[] | select(.name=="audio-panel")] | length' "$manifest" 2>/dev/null)
        [[ -z "$manifest_count" ]] && manifest_count=0
    fi
    global_count=$(hyprctl globalshortcuts 2>/dev/null | grep -c '^quickshell:audio-panel ->')
    if [[ -f "$keybinds" ]]; then
        bind_count=$(grep -vE '^\s*--' -- "$keybinds" | grep -c 'hl\.dsp\.global("quickshell:audio-panel")')
    fi
    local ok=0
    [[ "$manifest_count" -eq 1 && "$global_count" -eq 1 && "$bind_count" -eq 1 && "$kbd_rc" -eq 0 ]] || ok=1
    check "panel-shortcut-single-registration (D-15-04/MAINT-01, delegates to keybind-doctor): audio-panel registered manifest=${manifest_count} globalshortcuts=${global_count} hyprland-binds=${bind_count} times (all must be 1), keybind-doctor exit=${kbd_rc}" "$ok"
    if [[ "$kbd_rc" -ne 0 ]]; then
        printf '%s\n' "$kbd_out" | tail -8 | sed 's/^/    /' >&2
    fi
}

_qsd_check_panel_notifications_single_owner() {
    if [[ "$NO_PANEL_CHECKS" -eq 1 ]]; then
        echo "  [SKIP] panel-notifications-single-owner (D-15-25): disabled by --no-panel-checks"
        return
    fi
    if ! command -v busctl >/dev/null 2>&1 || ! command -v qs >/dev/null 2>&1; then
        echo "  [SKIP] panel-notifications-single-owner (D-15-25): busctl or qs not found"
        return
    fi
    local bad=0 report="" count owner expected="${QSD_NAME_OWNERS[org.freedesktop.Notifications]}" name

    read -r count owner <<<"$(_qsd_notif_sample)"
    report+="pre(count=${count},owner=${owner}) "
    [[ "$count" -eq 1 && "$owner" == "$expected" ]] || bad=$((bad + 1))

    for name in "${QSD_PANEL_NAMES[@]}"; do
        _qsd_summon_panel "$name"
        sleep 0.3
        read -r count owner <<<"$(_qsd_notif_sample)"
        report+="${name}(count=${count},owner=${owner}) "
        [[ "$count" -eq 1 && "$owner" == "$expected" ]] || bad=$((bad + 1))
        _qsd_dismiss_panel "$name"
        sleep 0.2
    done

    read -r count owner <<<"$(_qsd_notif_sample)"
    report+="post(count=${count},owner=${owner})"
    [[ "$count" -eq 1 && "$owner" == "$expected" ]] || bad=$((bad + 1))

    check "panel-notifications-single-owner (T-15-03, existing check invoked in the summoned context — no new mechanism): ${report}" "$([[ "$bad" -eq 0 ]] && echo 0 || echo 1)"
}

#   panel-osd-state-driven-trigger (D-20-05) — renamed from the retired
#   OSD daemon's own key-ownership check (D-15-24) by Phase 20 Plan 04,
#   Task 3.
#
#   D-15-24 built this check to prove the OPPOSITE of what Phase 20 now
#   wants: it asserted that a direct PipeWire write raised ZERO OSD pills
#   while the hardware-key path raised exactly one — i.e. that the
#   D-15-25 side panels do not own the key path. D-20-05 deliberately
#   INVERTS that premise: `Osd.qml`'s own trigger is now backend state
#   change, never the keybind (see that file's own header), so BOTH a
#   direct PipeWire write and the hardware key must raise the
#   `quickshell-osd` indicator, and that EQUALITY is the new requirement.
#   Leaving the old check as-is would fail on correct Phase 20 behaviour;
#   deleting it would lose the differential instrument this repo already
#   proved works. It is re-expressed in place instead — D-15-24's framing
#   is recorded here as historically correct for the retired daemon's
#   era, not deleted without explanation.
#
#   No D-Bus reachability guard here (unlike the check this supersedes)
#   — the instrument under test is now the quickshell shell's own
#   `quickshell-osd` layer surface, owned by this repo's own process, so
#   gating on a separate daemon's bus presence would SKIP a real
#   quickshell-osd regression whenever that daemon happened to be absent
#   — backwards now that the retired daemon is out of this check's
#   dependency path entirely. Plan 20-09 (RETIRE-04) removed the
#   D-Bus-reachability helper this check never used, once its last
#   remaining consumer (the separate "one-step-per-press volume probe"
#   check, QS-06, further down) was itself repointed off the retired
#   daemon.
_qsd_check_panel_osd_state_driven_trigger() {
    if [[ "$NO_PANEL_CHECKS" -eq 1 ]]; then
        echo "  [SKIP] panel-osd-state-driven-trigger (D-20-05, supersedes the D-15-24 key-ownership check): disabled by --no-panel-checks"
        return
    fi
    if ! command -v hyprctl >/dev/null 2>&1 || ! command -v qs >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
        echo "  [SKIP] panel-osd-state-driven-trigger (D-20-05): hyprctl, qs or jq not found"
        return
    fi

    local bad=0 report="" pre during after name

    pre=$(_qsd_xf86_ownership_table)
    if printf '%s' "$pre" | grep -qE '=[02-9][0-9]*'"${US}"'|=0'"${US}"; then :; fi
    for name in "${QSD_PANEL_NAMES[@]}"; do
        _qsd_summon_panel "$name"
        sleep 0.3
        during=$(_qsd_xf86_ownership_table)
        [[ "$during" != "$pre" ]] && bad=$((bad + 1))
        _qsd_dismiss_panel "$name"
        sleep 0.2
    done
    after=$(_qsd_xf86_ownership_table)
    [[ "$after" != "$pre" ]] && bad=$((bad + 1))

    local not_one=0 pair k v
    IFS="$US" read -ra pairs <<<"$pre"
    for pair in "${pairs[@]}"; do
        [[ -z "$pair" ]] && continue
        v="${pair##*=}"
        [[ "$v" != "1" ]] && not_one=$((not_one + 1))
    done
    [[ "$not_one" -ne 0 ]] && bad=$((bad + 1))
    report+="table-byte-identical=$([[ "$bad" -eq 0 ]] && echo yes || echo no) not-exactly-one-count=${not_one} "

    # Differential OSD proof (D-20-05, inverted from D-15-24) — arm the
    # volume restore trap BEFORE either write, extending the existing
    # T-11-11 trap rather than adding a second one (VOL_RESTORE_NEEDED/
    # VOL_ORIG_RAW are declared below, ahead of this check's own call
    # site). BOTH arms must now raise `quickshell-osd` exactly once — the
    # equality itself is the D-20-05 requirement this check proves.
    local zero_count=0 one_count=0
    if command -v pactl >/dev/null 2>&1 && pactl get-sink-volume @DEFAULT_SINK@ >/dev/null 2>&1; then
        local orig_line
        orig_line=$(pactl get-sink-volume @DEFAULT_SINK@)
        mapfile -t VOL_ORIG_RAW < <(printf '%s' "$orig_line" | grep -oP '(?<=: )\d+(?=\s*/)')
        if [[ "${#VOL_ORIG_RAW[@]}" -gt 0 ]]; then
            VOL_RESTORE_NEEDED=1
            # (i) direct PipeWire-node write — the same class of write the
            # audio panel's backend performs, no OSD client and no keybind
            # in the path. Under D-20-05 this must now raise the indicator
            # too, not stay silent as the retired daemon's own check
            # asserted.
            zero_count=$(_qsd_osd_activation_count "pactl set-sink-volume @DEFAULT_SINK@ +1%")
            # (ii) the hardware-key path, exactly as the repointed
            # compositor bind invokes it (keybinds.lua, Task 2 of Phase 20
            # Plan 04: wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0 —
            # the retired daemon's client is no longer on the exec path
            # anywhere, so both files change together and no gate observes
            # an inconsistent pair).
            one_count=$(_qsd_osd_activation_count "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0")
            pactl set-sink-volume @DEFAULT_SINK@ "${VOL_ORIG_RAW[@]}" >/dev/null 2>&1
        fi
    fi
    [[ "$zero_count" -ne 1 || "$one_count" -ne 1 ]] && bad=$((bad + 1))
    report+="osd-differential(pipewire-write=${zero_count},hw-key=${one_count},instrument=layer-namespace:quickshell-osd,expected=both-exactly-1-per-D-20-05)"

    # The former "source-holds-by-construction" sub-check (a grep for the
    # retired daemon's client binary name across the shell QML tree and the
    # hypr compositor config dir) was REMOVED by Plan 20-09 (RETIRE-04):
    # once the package is uninstalled from the host (this same plan's Task
    # 2), the property it asserted — nothing in this repo still execs that
    # binary — is structurally guaranteed rather than actively checked, and
    # the osd-differential proof above is the substantive, ongoing
    # regression guard for D-20-05's actual requirement (both write paths
    # raise the indicator equally). A stray reference to a since-removed
    # binary would surface as a loud runtime "command not found" the next
    # time it ran, not a silent gap.
    check "panel-osd-state-driven-trigger (D-20-05, supersedes the D-15-24 key-ownership check, proven differentially): ${report}" "$([[ "$bad" -eq 0 ]] && echo 0 || echo 1)"
}

# ── D-16-23 (Phase 16 Plan 04) check bodies — seven checks closing the two
#    risks this phase's ROADMAP entry owns: the permission silent-revert
#    (checks 4/5) and the blank-tile failure (check 6), plus three more
#    (checks 1/2/3 reuse-and-extend existing coexistence checks) and one
#    deliberate addition beyond D-16-23's own six (check 7, the
#    assumption-delta promotion recorded in 16-04-PLAN.md). Defined here —
#    after the D-15-25 panel checks, before --self-test — so --self-test
#    can call the pure assertion helpers directly without ever touching
#    the trap/mutating groups below.

# ── check 1: overview-namespace-conformance ─────────────────────────────
# Distinct from check 4 (namespace discipline, family-wide): that check
# asserts the ^quickshell-.* family rule; this one names quickshell-overview
# specifically and its own second-claimant condition. shell_pids is an
# explicit parameter (never live pgrep inside the assertion itself) so a
# --self-test replay's verdict never depends on which quickshell process
# happens to be running when the fixture was authored vs. when it is
# replayed — the live call site below passes real pgrep output; --self-test
# passes a fixed sentinel that matches (or deliberately does not match)
# each fixture's own baked-in pid.
_qsd_overview_namespace_rows() {
    printf '%s' "$1" | jq -r '
        .[]? | .levels? // {} | to_entries[] | .key as $lvl | .value[]?
        | select(.namespace == "quickshell-overview")
        | [$lvl, .namespace, .pid] | @tsv
    ' 2>/dev/null
}

_qsd_assert_overview_namespace() {
    local json="$1" shell_pids="$2"
    local lvl ns pid count=0 off_level=0 wrong_pid=0
    while IFS=$'\t' read -r lvl ns pid; do
        [[ -z "$lvl" ]] && continue
        count=$((count + 1))
        [[ "$lvl" != "3" ]] && off_level=$((off_level + 1))
        case " $shell_pids " in
            *" $pid "*) ;;
            *) wrong_pid=$((wrong_pid + 1)) ;;
        esac
    done < <(_qsd_overview_namespace_rows "$json")
    printf 'count=%s off-level=%s wrong-pid=%s' "$count" "$off_level" "$wrong_pid"
    [[ "$count" -le 1 && "$off_level" -eq 0 && "$wrong_pid" -eq 0 ]]
}

_qsd_check_overview_namespace_conformance() {
    if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
        echo "  [SKIP] overview-namespace-conformance (D-16-23 check 1): hyprctl or jq not found"
        return
    fi
    local shell_pids res rc
    shell_pids="$(pgrep -f 'quickshell -p' | tr '\n' ' ')"
    res=$(_qsd_assert_overview_namespace "$(_qsd_layers_json)" "$shell_pids"); rc=$?
    check "overview-namespace-conformance (D-16-23 check 1, names quickshell-overview specifically — distinct from the family-wide namespace discipline check above): ${res}" "$rc"
}

# ── 17-03 Task 4 (standing constraint #4) — the mpvpaper live-wallpaper
#    layer-coexistence gate. Report-only by construction: reads layers
#    through the _qsd_layers_json seam and `pgrep`, summons nothing,
#    mutates nothing, starts/stops no process.
_qsd_check_mpvpaper_layer_coexistence() {
    if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
        echo "  [SKIP] mpvpaper-layer-coexistence (17-03 Task 4): hyprctl or jq not found"
        return
    fi
    local json mpvpaper_pids surface_count res rc
    json="$(_qsd_layers_json)"
    mpvpaper_pids="$(pgrep -x mpvpaper 2>/dev/null | tr '\n' ' ')"
    surface_count=$(_qsd_mpvpaper_layer_rows "$json" | grep -c . || true)
    surface_count=${surface_count:-0}

    # Common healthy case: a still-only desktop. Must never be a [FAIL] —
    # this file's own header (lines 40-46) records what a gate that fires
    # on a healthy desktop already cost this project once.
    if [[ -z "$mpvpaper_pids" && "$surface_count" -eq 0 ]]; then
        echo "  [SKIP] mpvpaper-layer-coexistence (17-03 Task 4): no live wallpaper is currently selected"
        return
    fi

    res=$(_qsd_assert_mpvpaper_layers "$json" "$mpvpaper_pids"); rc=$?
    # A player alive with NO layer surface at all is a real failure (a
    # broken launch) — the assert above alone cannot detect this, since
    # zero rows trivially satisfies "no off-level, no wrong-pid". The
    # inverse (a stale surface with no live process) IS already caught by
    # the assert's wrong-pid count, since an empty pid set matches no row.
    if [[ -n "$mpvpaper_pids" && "$surface_count" -eq 0 ]]; then
        rc=1
    fi

    # Coexistence, not just presence: no quickshell- namespaced layer may
    # sit at level 0 (the background level this check asserts mpvpaper
    # owns), and mpvpaper's own namespace must never appear at level 3
    # (the shell's overlay level) — folded into the same report line so
    # one line names everything examined.
    local qs_at_bg mpv_at_overlay
    qs_at_bg=$(printf '%s' "$json" | jq -r '
        [.[]? | .levels? // {} | (.["0"] // [])[] | select(.namespace | startswith("quickshell-"))] | length
    ' 2>/dev/null)
    qs_at_bg=${qs_at_bg:-0}
    mpv_at_overlay=$(printf '%s' "$json" | jq -r '
        [.[]? | .levels? // {} | (.["3"] // [])[] | select(.namespace == "mpvpaper")] | length
    ' 2>/dev/null)
    mpv_at_overlay=${mpv_at_overlay:-0}
    [[ "$qs_at_bg" != "0" || "$mpv_at_overlay" != "0" ]] && rc=1

    check "mpvpaper-layer-coexistence (17-03 Task 4, standing constraint #4): the live-wallpaper layer surface sits on the background level under an mpvpaper-owned PID and never collides with a quickshell- surface at that level nor appears itself at the shell's overlay level 3 (${res}, quickshell-at-bg=${qs_at_bg}, mpvpaper-at-overlay=${mpv_at_overlay})" "$rc"
}

# ── check 2: overview-shortcut-single-registration ──────────────────────
# Delegates to keybind-doctor (MAINT-01's own bind-collision proof) and
# additionally asserts hyprctl globalshortcuts carries quickshell:overview
# exactly once — a second registration is the exact collision class
# MAINT-01's detector exists for, and Phases 14 and 16 each added a chord.
_qsd_check_overview_shortcut_single_registration() {
    if ! command -v jq >/dev/null 2>&1 || ! command -v hyprctl >/dev/null 2>&1; then
        echo "  [SKIP] overview-shortcut-single-registration (D-16-23 check 2): jq or hyprctl not found"
        return
    fi
    local manifest keybinds kbd_out kbd_rc manifest_count=0 global_count=0
    manifest=$(_qsd_shortcuts_manifest_path)
    keybinds=$(_qsd_keybinds_lua_path)
    if [[ -x "$KEYBIND_DOCTOR" ]]; then
        kbd_out=$("$KEYBIND_DOCTOR" "$keybinds" "$manifest" 2>&1)
        kbd_rc=$?
    else
        kbd_out="keybind-doctor not found or not executable at $KEYBIND_DOCTOR"
        kbd_rc=1
    fi
    if [[ -f "$manifest" ]]; then
        manifest_count=$(jq -r '[.[] | select(.name=="overview")] | length' "$manifest" 2>/dev/null)
        [[ -z "$manifest_count" ]] && manifest_count=0
    fi
    global_count=$(hyprctl globalshortcuts 2>/dev/null | grep -c '^quickshell:overview ->')
    local ok=0
    [[ "$manifest_count" -eq 1 && "$global_count" -eq 1 && "$kbd_rc" -eq 0 ]] || ok=1
    check "overview-shortcut-single-registration (D-16-23 check 2, MAINT-01/keybind-doctor delegate): overview registered manifest=${manifest_count} globalshortcuts=${global_count} times (both must be 1), keybind-doctor exit=${kbd_rc}" "$ok"
    if [[ "$kbd_rc" -ne 0 ]]; then
        printf '%s\n' "$kbd_out" | tail -8 | sed 's/^/    /' >&2
    fi
}

# ── manifest token-allowlist coverage (originally "check 3", D-16-23) ───
# The "no summoned surface adds a reservation" summon-and-diff (check 5,
# above) already iterates every shortcuts.json entry, so the overview's
# fifth manifest entry is already in scope. This is the explicit
# structural guard that a future manifest entry cannot silently fall out
# of that iteration: every entry must pass the same _qsd_valid_token
# allowlist the live summon-and-diff loop itself gates on before
# dispatching. Non-invasive (parses the manifest only, no summon).
# 18-17: this pure function is PRESERVED unchanged — only its wrapper
# (formerly _qsd_check_reserved_array_manifest_coverage, below) was
# replaced; this assertion is now called directly from
# _qsd_check_bar_reserved_zone_stability as a named sub-assertion in that
# check's single report line, rather than reported on its own line.
_qsd_assert_manifest_coverage() {
    local manifest="$1"
    local total valid=0 m_appid m_name
    total=$(jq -r 'length' "$manifest" 2>/dev/null)
    [[ -z "$total" || "$total" == "null" ]] && total=0
    while IFS="$US" read -r m_appid m_name; do
        [[ -z "$m_appid" && -z "$m_name" ]] && continue
        if _qsd_valid_token "$m_appid" && _qsd_valid_token "$m_name"; then
            valid=$((valid + 1))
        fi
    done < <(jq -r --arg us "$US" '.[] | [(.appid // ""), (.name // "")] | join($us)' "$manifest" 2>/dev/null)
    printf 'manifest-entries=%s validated=%s' "$total" "$valid"
    [[ "$total" -gt 0 && "$valid" -eq "$total" ]]
}

# ── 18-17 (QBAR-12) — bar-reserved-zone-stability. Replaces
#    _qsd_check_reserved_array_manifest_coverage in this exact slot: that
#    name and that body are gone, but the manifest token-allowlist
#    coverage it actually held (_qsd_assert_manifest_coverage, above) is
#    real and survives, folded into this check's report as a named
#    sub-assertion rather than deleted along with the framing that
#    surrounded it. ─────────────────────────────────────────────────────

# Reduces a monitors-JSON document to one deterministic line per monitor
# (name<TAB>l,t,r,b), sorted by name inside jq itself — never by bash
# associative-array iteration, which is unspecified order. Pure function,
# no live read.
_qsd_reservation_by_name() {
    printf '%s' "$1" | jq -r '
        [.[] | {name, reserved}] | sort_by(.name)[]
        | [.name, (.reserved | join(","))] | @tsv
    ' 2>/dev/null
}

# Diffs two monitors-JSON readings, keyed by monitor NAME (never by array
# position — hyprctl emits monitors in enumeration order, and a hotplug
# between two readings would make a positional comparison report drift
# that never happened). Reports one deterministic line and returns
# nothing meaningful itself — the caller interprets the fields. A changed
# monitor SET is its own reported outcome, never folded into the
# axis/delta verdict.
_qsd_reservation_diff() {
    local pre_json="$1" post_json="$2"
    local -A pre_map=() post_map=()
    local name resv
    while IFS=$'\t' read -r name resv; do
        [[ -z "$name" ]] && continue
        pre_map["$name"]="$resv"
    done < <(_qsd_reservation_by_name "$pre_json")
    while IFS=$'\t' read -r name resv; do
        [[ -z "$name" ]] && continue
        post_map["$name"]="$resv"
    done < <(_qsd_reservation_by_name "$post_json")

    local common=0 appeared=0 disappeared=0
    local n
    for n in "${!pre_map[@]}"; do
        if [[ -n "${post_map[$n]+x}" ]]; then
            common=$((common + 1))
        else
            disappeared=$((disappeared + 1))
        fi
    done
    for n in "${!post_map[@]}"; do
        [[ -z "${pre_map[$n]+x}" ]] && appeared=$((appeared + 1))
    done
    local set_changed=0
    [[ "$appeared" -gt 0 || "$disappeared" -gt 0 ]] && set_changed=1

    local axes_changed=0 axis=-1 delta=0
    if [[ "$set_changed" -eq 0 ]]; then
        for n in "${!pre_map[@]}"; do
            local -a pv qv
            IFS=',' read -r -a pv <<<"${pre_map[$n]}"
            IFS=',' read -r -a qv <<<"${post_map[$n]}"
            local i
            for i in 0 1 2 3; do
                if [[ "${pv[$i]:-0}" != "${qv[$i]:-0}" ]]; then
                    axes_changed=$((axes_changed + 1))
                    axis="$i"
                    delta=$(( qv[i] - pv[i] ))
                    [[ "$delta" -lt 0 ]] && delta=$(( -delta ))
                fi
            done
        done
    fi
    printf 'monitors=%s appeared=%s disappeared=%s set-changed=%s axes-changed=%s axis=%s delta=%s' \
        "$common" "$appeared" "$disappeared" "$set_changed" "$axes_changed" "$axis" "$delta"
}

# Reads the expected reservation extent straight out of Design.qml's own
# `readonly property int` tokens — never restated as a literal here, so a
# future token change cannot drift away from this gate unnoticed. D-18-38:
# a SINGLE edge margin, never doubled — the top axis (index 1) is
# barHeight + barEdgeMargin, the right axis (index 2) is barColumnWidth +
# barEdgeMargin; any other axis is an error, not a default.
_qsd_expected_extent() {
    local design="$1" axis="$2"
    local bar_height bar_edge_margin bar_column_width
    bar_height=$(grep -oP 'readonly\s+property\s+int\s+barHeight\s*:\s*\K[0-9]+' -- "$design" 2>/dev/null | head -1)
    bar_edge_margin=$(grep -oP 'readonly\s+property\s+int\s+barEdgeMargin\s*:\s*\K[0-9]+' -- "$design" 2>/dev/null | head -1)
    bar_column_width=$(grep -oP 'readonly\s+property\s+int\s+barColumnWidth\s*:\s*\K[0-9]+' -- "$design" 2>/dev/null | head -1)
    case "$axis" in
        1)
            [[ -n "$bar_height" && -n "$bar_edge_margin" ]] || return 1
            echo $(( bar_height + bar_edge_margin ))
            return 0
            ;;
        2)
            [[ -n "$bar_column_width" && -n "$bar_edge_margin" ]] || return 1
            echo $(( bar_column_width + bar_edge_margin ))
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# ── 18-17 Task 2 (QBAR-12, opt-in) — windowrules.lua quickshell layer-rule
#    extractor, replay grammar gate, and restore. The one code-execution
#    sink this plan introduces (T-18-17-03): text read from a repo file is
#    replayed as a Lua expression into the running compositor, so every
#    line is validated against a strict single-call grammar before it can
#    ever reach `hyprctl eval`, and each accepted line is passed as its
#    own argv element — never concatenated into a shell string. ─────────

# Candidate lines — broad on purpose, so a malformed/injected attempt is
# still captured for the validator to judge and count, not silently
# filtered out before the assertion ever sees it. Comment lines (Lua `--`)
# are excluded here so a header note merely mentioning these words is
# never mistaken for a declaration.
_qsd_windowrules_candidates() {
    local path="$1" raw trimmed
    while IFS= read -r raw; do
        trimmed="${raw#"${raw%%[![:space:]]*}"}"
        trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
        [[ -z "$trimmed" ]] && continue
        [[ "$trimmed" == --* ]] && continue
        [[ "$trimmed" == *layer_rule* && "$trimmed" == *quickshell* ]] || continue
        printf '%s\n' "$trimmed"
    done < <(cat -- "$path" 2>/dev/null)
}

# Strict single-call grammar: exactly one complete, balanced
# `hl.layer_rule({ ... })` call, nothing before or after it, no statement
# separator, no comment marker, no second function call, no shell
# metacharacter, no embedded newline (read one line at a time, so this is
# structural rather than checked here).
_qsd_valid_layer_rule_call() {
    local line="$1"
    [[ "$line" =~ ^hl\.layer_rule\(.*\)$ ]] || return 1
    case "$line" in
        *';'*) return 1 ;;
        *'--'*) return 1 ;;
        *'`'*) return 1 ;;
        *'$('*) return 1 ;;
        *'|'*) return 1 ;;
        *'&'*) return 1 ;;
        *'>'*) return 1 ;;
        *'<'*) return 1 ;;
    esac
    local calls
    calls=$(grep -oE '[A-Za-z_][A-Za-z0-9_.]*\(' <<<"$line" | wc -l)
    [[ "$calls" -eq 1 ]] || return 1
    local opens closes popen pclose
    opens=$(grep -o '{' <<<"$line" | wc -l)
    closes=$(grep -o '}' <<<"$line" | wc -l)
    [[ "$opens" -eq "$closes" && "$opens" -ge 1 ]] || return 1
    popen=$(grep -o '(' <<<"$line" | wc -l)
    pclose=$(grep -o ')' <<<"$line" | wc -l)
    [[ "$popen" -eq "$pclose" && "$popen" -ge 1 ]] || return 1
    return 0
}

# Pure function: emits every VALID quickshell layer-rule call, one per
# line, in the file's OWN declared order — never sorted, filtered by
# anything other than validity, or deduplicated. Order is load-bearing:
# `windowrules.lua`'s own comments record that a per-surface rule
# contradicting the `^quickshell-.*` family regex is silently inert if
# replayed before it.
_qsd_extract_quickshell_layer_rules() {
    local path="$1" cand
    while IFS= read -r cand; do
        _qsd_valid_layer_rule_call "$cand" && printf '%s\n' "$cand"
    done < <(_qsd_windowrules_candidates "$path")
}

# Reports "candidates=N accepted=M rejected=R" — R is the whole point of
# the injection fixture: a rejection is a check failure, not a line to
# silently pass over.
_qsd_windowrules_extraction_report() {
    local path="$1" candidates accepted
    candidates=$(_qsd_windowrules_candidates "$path" | grep -c . || true)
    accepted=$(_qsd_extract_quickshell_layer_rules "$path" | grep -c . || true)
    printf 'candidates=%s accepted=%s rejected=%s' "$candidates" "$accepted" "$((candidates - accepted))"
}

# Trap-invoked restore (T-11-11: called only via the EXIT/INT/TERM trap
# above, never inline). Replays every extracted rule through `hyprctl
# eval`, each as its own argv element via a line-continuation split (never
# a constructed shell string — the extracted text never sits adjacent to
# a bash `eval` or a `sh -c`), THEN restarts the shell through 18-07's
# systemd unit. The restart is not an afterthought: layer rules bind at
# surface map time, so replaying a rule against an already-mapped surface
# changes nothing on it — a restore that stopped at the replay would leave
# the desktop exactly as broken as the reload left it while appearing to
# have fixed it (recorded from this host's own session evidence, not from
# documentation — layer-rule effects carry no `hyprctl` readback on this
# build, so nothing here is claimed as mechanically verified; see the
# compositor-reload check body below for the human half of this proof).
_qsd_restore_quickshell_layer_rules() {
    local wr_path rule_line
    wr_path=$(_qsd_windowrules_lua_path)
    while IFS= read -r rule_line; do
        [[ -z "$rule_line" ]] && continue
        hyprctl eval \
            "$rule_line" >/dev/null 2>&1
    done < <(_qsd_extract_quickshell_layer_rules "$wr_path")
    systemctl --user restart quickshell.service >/dev/null 2>&1
    local attempt
    for ((attempt = 0; attempt < 60; attempt++)); do
        sleep 0.25
        pgrep -f 'quickshell -p' >/dev/null 2>&1 && break
    done
}

_qsd_check_bar_reserved_zone_stability() {
    if ! command -v jq >/dev/null 2>&1 || ! command -v hyprctl >/dev/null 2>&1; then
        echo "  [SKIP] bar-reserved-zone-stability (QBAR-12): jq or hyprctl not found"
        return
    fi
    if [[ ! -x "$BAR_VISIBILITY_SH" ]]; then
        echo "  [SKIP] bar-reserved-zone-stability (QBAR-12): bar-visibility.sh not found or not executable"
        return
    fi

    # Preserved coverage (the manifest token-allowlist guard the replaced
    # function actually held) — real and folded in as a named
    # sub-assertion, runs regardless of the owner's state below.
    local manifest manifest_res manifest_rc
    manifest=$(_qsd_shortcuts_manifest_path)
    if [[ -f "$manifest" ]]; then
        manifest_res=$(_qsd_assert_manifest_coverage "$manifest"); manifest_rc=$?
    else
        manifest_res="manifest-entries=0 validated=0"
        manifest_rc=1
    fi

    # Never a [FAIL] on a healthy hidden desktop: a bar that is legitimately
    # hidden (gaming, idle, stepped away) makes the transition meaningless.
    local owner_status
    owner_status=$("$BAR_VISIBILITY_SH" status 2>/dev/null)
    if [[ "$owner_status" != "visible" ]]; then
        echo "  [SKIP] bar-reserved-zone-stability (QBAR-12): bar-visibility.sh status reports '${owner_status:-<none>}', not visible — a healthy desktop may legitimately be hidden, and the transition cannot be measured from here"
        return
    fi

    # ── T-11-11: arm BEFORE the first toggle. A single flag covers the
    #    whole mutate-and-restore window; an interrupt anywhere inside it
    #    leaves exactly one outstanding toggle for the trap to undo. ─────
    BAR_STABILITY_TOGGLE_PENDING=1
    local pre post
    pre=$(_qsd_monitors_json)
    "$BAR_VISIBILITY_SH" keybind toggle >/dev/null 2>&1
    sleep 0.3
    post=$(_qsd_monitors_json)
    "$BAR_VISIBILITY_SH" keybind toggle >/dev/null 2>&1
    sleep 0.3

    # ── Restore verification, bounded retry (T-18-17 live finding, this
    #    host): bar-visibility.sh status is computed purely from local
    #    intent files, never from a live readback of the shell it
    #    actuates — it can report "visible" even when the underlying `qs
    #    ipc call bar show` silently failed to reach the target (recorded
    #    in this plan's SUMMARY: a `qs` 0.3.0 CLI argument-parsing quirk
    #    where the literal token "show" collides with the `ipc show`
    #    subcommand one level up, out of this plan's scope to fix —
    #    bar-visibility.sh is 18-15's and explicitly untouched here).
    #    "MUST NOT leave the machine worse than the diagnostic found it"
    #    is enforced here rather than assumed: verify the reservation
    #    actually matches the pre-toggle reading, and if not, retry
    #    through ADDITIONAL PAIRS of the same keybind-toggle verb this
    #    check is scoped to — never a third verb, never a raw IPC call. A
    #    single stray extra toggle would flip the override the wrong way;
    #    only a PAIR returns it to "show" again. ─────────────────────────
    local restore_pair_attempt
    for ((restore_pair_attempt = 0; restore_pair_attempt < 3; restore_pair_attempt++)); do
        [[ "$(_qsd_monitors_json)" == "$pre" ]] && break
        "$BAR_VISIBILITY_SH" keybind toggle >/dev/null 2>&1
        sleep 0.3
        "$BAR_VISIBILITY_SH" keybind toggle >/dev/null 2>&1
        sleep 0.3
    done
    BAR_STABILITY_TOGGLE_PENDING=0
    local restored_status restore_verified=0
    restored_status=$("$BAR_VISIBILITY_SH" status 2>/dev/null)
    [[ "$(_qsd_monitors_json)" == "$pre" ]] && restore_verified=1

    local diff_res set_changed axes_changed axis delta
    diff_res=$(_qsd_reservation_diff "$pre" "$post")
    set_changed=$(printf '%s' "$diff_res" | grep -oP 'set-changed=\K[0-9]+')
    axes_changed=$(printf '%s' "$diff_res" | grep -oP 'axes-changed=\K[0-9]+')
    axis=$(printf '%s' "$diff_res" | grep -oP 'axis=\K-?[0-9]+')
    delta=$(printf '%s' "$diff_res" | grep -oP 'delta=\K[0-9]+')

    local design_path expected_extent="" extent_rc=1
    design_path=$(_qsd_design_qml_path)
    if [[ "$axis" == "1" || "$axis" == "2" ]]; then
        expected_extent=$(_qsd_expected_extent "$design_path" "$axis"); extent_rc=$?
    fi

    local reservation_ok=1 reservation_reason=""
    if [[ "$set_changed" != "0" ]]; then
        reservation_ok=0
        reservation_reason="monitor set changed mid-transition"
    elif [[ "$axes_changed" == "0" ]]; then
        reservation_ok=0
        reservation_reason="zero delta — the bar reserves nothing"
    elif [[ "$axes_changed" != "1" ]]; then
        reservation_ok=0
        reservation_reason="two or more axes moved — claiming an edge it does not occupy"
    elif [[ "$extent_rc" -ne 0 || "$delta" != "$expected_extent" ]]; then
        reservation_ok=0
        reservation_reason="measured delta does not equal the extent parsed from Design.qml"
    fi

    # ── Hot-reload half — runs on every plain invocation. Touch the bar's
    #    own source under the watched config directory, poll (bounded, no
    #    guessed sleep) for its namespace to reappear, then compare. ─────
    local hot_reload_label="skipped" hot_reload_ok=1
    if [[ -f "$BAR_QML_PATH" ]]; then
        local hot_pre hot_post attempt found=0
        hot_pre=$(_qsd_monitors_json)
        touch -- "$BAR_QML_PATH" 2>/dev/null
        for ((attempt = 0; attempt < 40; attempt++)); do
            sleep 0.25
            if hyprctl layers -j 2>/dev/null | jq -e '[.[] | .levels? // {} | to_entries[] | .value[]? | select(.namespace=="quickshell-bar")] | length > 0' >/dev/null 2>&1; then
                found=1
                break
            fi
        done
        if [[ "$found" -eq 1 ]]; then
            hot_post=$(_qsd_monitors_json)
            if [[ "$hot_pre" == "$hot_post" ]]; then
                hot_reload_ok=1
                hot_reload_label="identical"
            else
                hot_reload_ok=0
                hot_reload_label="drifted"
            fi
        else
            hot_reload_ok=0
            hot_reload_label="namespace-did-not-return"
        fi
    else
        hot_reload_ok=0
        hot_reload_label="bar-source-not-found"
    fi

    # ── Compositor-reload half (18-17 Task 2, opt-in) — off by default:
    #    prints as skipped, names the flag that enables it, and never
    #    contributes a pass on this branch. On: exercises the one
    #    documented hazard in this file (T-18-17-02), restores
    #    unconditionally afterward (no readback exists to assert on, so
    #    there is nothing to condition the restore on), and reports into
    #    this same single line. ─────────────────────────────────────────
    local compositor_reload_label="SKIPPED (enable with --with-compositor-reload)"
    local compositor_reload_relevant=0 compositor_reload_ok=0
    if [[ "$WITH_COMPOSITOR_RELOAD" -eq 1 ]]; then
        compositor_reload_relevant=1
        local comp_pre comp_post
        comp_pre=$(_qsd_monitors_json)
        COMPOSITOR_RULES_MAY_BE_DROPPED=1
        hyprctl reload >/dev/null 2>&1
        local comp_attempt comp_bar_back=0
        for ((comp_attempt = 0; comp_attempt < 40; comp_attempt++)); do
            sleep 0.25
            if hyprctl layers -j 2>/dev/null | jq -e '[.[] | .levels? // {} | to_entries[] | .value[]? | select(.namespace=="quickshell-bar")] | length > 0' >/dev/null 2>&1; then
                comp_bar_back=1
                break
            fi
        done
        comp_post=$(_qsd_monitors_json)
        local comp_diff comp_set_changed comp_axes_changed
        comp_diff=$(_qsd_reservation_diff "$comp_pre" "$comp_post")
        comp_set_changed=$(printf '%s' "$comp_diff" | grep -oP 'set-changed=\K[0-9]+')
        comp_axes_changed=$(printf '%s' "$comp_diff" | grep -oP 'axes-changed=\K[0-9]+')

        # Restore unconditionally — always, not only when a drift was
        # observed (T-18-17-02, backstop truth: whether a reload discards
        # already-applied layer rules was never measured and cannot be,
        # because layer-rule effects carry no `hyprctl` readback on this
        # build; restoring unconditionally is the honest alternative to
        # guessing).
        _qsd_restore_quickshell_layer_rules
        COMPOSITOR_RULES_MAY_BE_DROPPED=0

        if [[ "$comp_bar_back" -eq 1 && "$comp_set_changed" == "0" && "$comp_axes_changed" == "0" ]]; then
            compositor_reload_ok=1
            compositor_reload_label="identical"
        else
            compositor_reload_ok=0
            compositor_reload_label="drifted"
        fi
    fi

    local overall_rc=0
    [[ "$reservation_ok" -ne 1 ]] && overall_rc=1
    [[ "$restored_status" != "visible" ]] && overall_rc=1
    [[ "$restore_verified" -ne 1 ]] && overall_rc=1
    [[ "$hot_reload_ok" -ne 1 ]] && overall_rc=1
    [[ "$manifest_rc" -ne 0 ]] && overall_rc=1
    [[ "$compositor_reload_relevant" -eq 1 && "$compositor_reload_ok" -ne 1 ]] && overall_rc=1

    check "bar-reserved-zone-stability (QBAR-12, replaces the D-16-23 reserved-array-manifest-coverage slot — one-reservation model: the bar's own reservation exists, is attributable, is stable): delta=${delta} axis=${axis} (0=left,1=top,2=right,3=bottom), expected=${expected_extent:-<n/a>} (source=Design.qml, parsed not restated), ${reservation_reason:-attributed and stable}, hot-reload=${hot_reload_label}, compositor-reload=${compositor_reload_label}, restore-verified=${restore_verified} (bounded-retry against a live readback, never trusting bar-visibility.sh status alone), ${manifest_res} (preserved coverage), measured via bar-visibility.sh status / bar-visibility.sh keybind toggle" "$overall_rc"
}

# ── 18-17 Task 3 (GATE-03) — bar-surface registry, closed in both
#    directions. Two pure functions, each replayable by --self-test: the
#    source half (registry <-> QML tree closure) and the live half
#    (registry <-> mapped layer surfaces, explicit PID set, never a live
#    pgrep inside the assertion — the same T-16-SELFTEST discipline
#    _qsd_assert_panel_layers already established). ───────────────────────

# Strips Lua/QML-style `//` line comments (leading whitespace then `//`)
# before scanning, so a header note that merely MENTIONS
# WlrLayershell.namespace in prose is never mistaken for a declaration —
# the same discipline _qsd_assert_panel_source already applies with its
# own `grep -vE '^\s*//'` filter, generalised here to a reusable function
# rather than repeated inline.
_qsd_strip_qml_comments() {
    grep -vE '^\s*//' -- "$1" 2>/dev/null
}

# ── SIGPIPE-safe pattern match (2026-08-12) ──────────────────────────────
# `producer | grep -q PATTERN` is UNSAFE in this script, which runs under
# `set -uo pipefail` (see the top). `grep -q` exits the instant it matches;
# if the producer still has buffered output to write, it takes SIGPIPE and
# exits 141, and pipefail reports the whole pipeline as FAILED even though
# the pattern was found. Whether that happens depends on how much output
# follows the match, i.e. on FILE LENGTH — so a check silently changes
# verdict as a file grows.
#
# MEASURED 2026-08-12 on this very script. bar/SectionPopout.qml at 454
# lines / 23239 bytes returned rc=0; the same file at 484 lines / 25242
# bytes returned rc=141, from the identical pipeline, with the namespace it
# was looking for present and unchanged on one line in both. That surfaced
# as bar-surface-registry reporting `missing=1` against a registry that was
# entirely correct.
#
# The FAILURE DIRECTION differs by site, and one direction is dangerous:
#   - the registry closures read 141 as "namespace absent" -> false FAIL,
#     noisy but safe;
#   - bar-colour-role-routing and bar-colour-alpha-resolution use the
#     `if producer | grep -q` shape, so 141 reads as "this file does NOT
#     touch Colours.*" -> a false PASS, i.e. D-20's gate waving through the
#     exact violation it exists to catch. Demonstrated with a synthetic
#     4000-line file whose second line is `Colours.surface`: the short
#     version was detected, the long one was missed.
#
# This helper takes the producer's output as a STRING and matches with a
# herestring, so there is no upstream process left to signal.
_qsd_matches() {  # _qsd_matches <text> <grep-args...>
    local text="$1"
    shift
    grep -q "$@" <<<"$text"
}

# Forward + reservation-permission closure: every registry row's file
# must exist under the scan root, declare its own namespace value/prefix
# exactly once, and — for every row NOT permitted to reserve — declare a
# literal `exclusiveZone: 0` in its own source (the structural protection
# QBAR-12's stability assertion depends on: a second surface quietly
# starting to reserve would move the number that check asserts is stable,
# with no way to say where the drift came from). Bar.qml (the one row
# permitted to reserve) is exempt from the zero-literal check — its own
# exclusiveZone is a conditional expression, not a literal, by design.
#
# Phase 20 Plan 04 (D-20-02/D-20-04) extends both markers with a fallback,
# scoped so no pre-existing row's verdict can change: every row before
# Phase 20 declares `WlrLayershell.namespace` directly in its own file
# (direct-marker count 1) and its own `exclusiveZone: 0` literal directly
# too, so neither fallback below is ever reached for them. `osd/Osd.qml`
# is a `Toast{}` INSTANCE (D-20-02's promote decision) — it declares
# neither directly; it overrides `Toast.qml`'s `layerNamespace` property
# (the value Toast.qml itself forwards to its own single
# `WlrLayershell.namespace` binding) and inherits Toast.qml's own
# `exclusiveZone: 0` unchanged. Both fallbacks below recognise that
# specific, narrow shape rather than loosening the marker for every row.
_qsd_assert_bar_surface_registry_forward() {
    local scan_root="$1" row r_file r_ns r_match r_level r_reserve r_life
    local missing=0 unexpected_reservation=0 rows_total=0
    for row in "${QSD_BAR_SURFACE_ROWS[@]}"; do
        rows_total=$((rows_total + 1))
        IFS='|' read -r r_file r_ns r_match r_level r_reserve r_life <<<"$row"
        local path="$scan_root/$r_file"
        if [[ ! -f "$path" ]]; then
            missing=$((missing + 1))
            continue
        fi
        local stripped ns_count used_instance_fallback=0
        stripped="$(_qsd_strip_qml_comments "$path")"
        ns_count=$(printf '%s\n' "$stripped" | grep -cF "WlrLayershell.namespace")
        if [[ "$ns_count" -eq 0 ]]; then
            # Fallback marker (D-20-02/D-20-04, see header above): a
            # Toast-derived instance file declares its OWN effective
            # namespace by overriding `layerNamespace:` with a literal,
            # never by writing `WlrLayershell.namespace` itself — that
            # binding lives once in toast/Toast.qml. Only reached when the
            # direct marker count is exactly zero, so every pre-Phase-20
            # row (direct count 1) never touches this branch.
            ns_count=$(printf '%s\n' "$stripped" | grep -cE 'layerNamespace[[:space:]]*:')
            used_instance_fallback=1
        fi
        if [[ "$ns_count" -ne 1 ]]; then
            missing=$((missing + 1))
            continue
        fi
        _qsd_matches "$stripped" -F "$r_ns" || missing=$((missing + 1))
        if [[ "$r_reserve" == "noreserve" ]]; then
            local ez_ok=0
            _qsd_matches "$stripped" -E 'exclusiveZone[[:space:]]*:[[:space:]]*0\b' && ez_ok=1
            if [[ "$ez_ok" -eq 0 && "$used_instance_fallback" -eq 1 && "$r_file" != "toast/Toast.qml" ]]; then
                # Fallback (see header above): a Toast-derived INSTANCE row
                # (identified by having needed the layerNamespace marker
                # fallback just above — never a row that declares its own
                # WlrLayershell.namespace directly) may inherit Toast.qml's
                # own exclusiveZone: 0 literal rather than redeclaring it.
                # Gated on used_instance_fallback so a row that legitimately
                # declares WlrLayershell.namespace itself (e.g. HotZone.qml)
                # is never let through on a missing exclusiveZone literal by
                # riding this branch — only a genuine Toast{} instance can
                # reach it.
                local base_stripped
                base_stripped="$(_qsd_strip_qml_comments "$scan_root/toast/Toast.qml" 2>/dev/null)"
                _qsd_matches "$base_stripped" -E 'exclusiveZone[[:space:]]*:[[:space:]]*0\b' && ez_ok=1
            fi
            [[ "$ez_ok" -eq 0 ]] && unexpected_reservation=$((unexpected_reservation + 1))
        fi
    done
    printf 'rows=%s missing=%s unexpected-reservation=%s' "$rows_total" "$missing" "$unexpected_reservation"
    [[ "$rows_total" -gt 0 && "$missing" -eq 0 && "$unexpected_reservation" -eq 0 ]]
}

# Reverse closure: every *.qml file under the scan root that declares a
# REAL WlrLayershell.namespace (comments stripped first) must be either a
# registry row's own file or a member of QSD_KNOWN_NONBAR_FRAMES. This
# direction is the whole point — the forward half proves the frames we
# know about are correct, only this one makes a frame nobody registered
# impossible to ship.
_qsd_assert_bar_surface_registry_reverse() {
    local scan_root="$1" f base unregistered=0
    while IFS= read -r f; do
        _qsd_matches "$(_qsd_strip_qml_comments "$f")" -F "WlrLayershell.namespace" || continue
        base="$(basename -- "$f")"
        local known=0 row r_file r_rest
        for row in "${QSD_BAR_SURFACE_ROWS[@]}"; do
            r_file="${row%%|*}"
            [[ "$(basename -- "$r_file")" == "$base" ]] && known=1
        done
        local kf
        for kf in "${QSD_KNOWN_NONBAR_FRAMES[@]}"; do
            [[ "$kf" == "$base" ]] && known=1
        done
        [[ "$known" -eq 0 ]] && unregistered=$((unregistered + 1))
    done < <(find -L "$scan_root" -type f -name '*.qml' 2>/dev/null)
    printf 'unregistered=%s' "$unregistered"
    [[ "$unregistered" -eq 0 ]]
}

# Combines both closure directions into the one report this check prints,
# requiring a positive row count before it can succeed (the same
# non-vacuity guard _qsd_assert_manifest_coverage already applies — an
# empty registry must fail rather than pass vacuously).
_qsd_assert_bar_surface_registry_source() {
    local scan_root="$1"
    local fwd_res fwd_rc rev_res rev_rc
    fwd_res=$(_qsd_assert_bar_surface_registry_forward "$scan_root"); fwd_rc=$?
    rev_res=$(_qsd_assert_bar_surface_registry_reverse "$scan_root"); rev_rc=$?
    printf '%s %s' "$fwd_res" "$rev_res"
    [[ "$fwd_rc" -eq 0 && "$rev_rc" -eq 0 ]]
}

# Broad candidate net for the live half — every layer surface whose
# namespace starts with "quickshell-bar" (deliberately including strings
# with no separator at all, e.g. a hypothetical "quickshell-barnacle") so
# a namespace that is bar-family-SHAPED but matches no registry row is
# still captured for the per-row assertion below to judge, not silently
# excluded before it is ever seen.
_qsd_bar_family_layer_rows() {
    printf '%s' "$1" | jq -r '
        .[]? | .levels? // {} | to_entries[] | .key as $lvl | .value[]?
        | select(.namespace | startswith("quickshell-bar"))
        | [$lvl, .namespace, .pid] | @tsv
    ' 2>/dev/null
}

# Live half: for every bar-family-shaped layer surface, match it against
# EXACTLY ONE registry row — the permanent row by an EXACT string
# comparison (never startswith/prefix: quickshell-bar is a strict prefix
# of quickshell-bar-hotzone, and a prefix test would double-count the
# hot zone against the permanent bar's own strict cardinality), the
# transient rows by an anchored pattern requiring at least one character
# after the stored prefix. Asserts the matched row's expected level and
# shell-PID ownership. The permanent frame's cardinality is asserted
# strict (exactly one — the bar must always be mapped); transient frames
# may legitimately number zero (a closed popout, a bar that is currently
# visible so its hot zone does not exist).
_qsd_assert_bar_surface_registry_live() {
    local json="$1" shell_pids="$2"
    local lvl ns pid permanent_count=0 off_level=0 wrong_pid=0 unmatched=0
    while IFS=$'\t' read -r lvl ns pid; do
        [[ -z "$lvl" ]] && continue
        local matched=0 expected_level="" row r_file r_ns r_match r_level r_reserve r_life
        for row in "${QSD_BAR_SURFACE_ROWS[@]}"; do
            IFS='|' read -r r_file r_ns r_match r_level r_reserve r_life <<<"$row"
            if [[ "$r_match" == "exact" ]]; then
                if [[ "$ns" == "$r_ns" ]]; then
                    matched=$((matched + 1))
                    expected_level="$r_level"
                fi
            else
                case "$ns" in
                    "${r_ns}"?*)
                        matched=$((matched + 1))
                        expected_level="$r_level"
                        ;;
                esac
            fi
        done
        if [[ "$matched" -ne 1 ]]; then
            unmatched=$((unmatched + 1))
            continue
        fi
        [[ "$ns" == "quickshell-bar" ]] && permanent_count=$((permanent_count + 1))
        [[ "$lvl" != "$expected_level" ]] && off_level=$((off_level + 1))
        case " $shell_pids " in
            *" $pid "*) ;;
            *) wrong_pid=$((wrong_pid + 1)) ;;
        esac
    done < <(_qsd_bar_family_layer_rows "$json")
    printf 'permanent=%s off-level=%s wrong-pid=%s unmatched=%s' "$permanent_count" "$off_level" "$wrong_pid" "$unmatched"
    [[ "$permanent_count" -eq 1 && "$off_level" -eq 0 && "$wrong_pid" -eq 0 && "$unmatched" -eq 0 ]]
}

# Resolves a namespace's expected layer level: a bar-family row's own
# declared level when it matches one (exact for the permanent frame,
# anchored pattern for the transient family — same matching rule as
# above), the overlay level (3) for everything else — the pre-18-17
# blanket default this file's namespace-discipline check already applied
# to every quickshell-* surface. Used by that check below so the bar's
# top-level posture is read from the registry rather than restated as a
# second literal.
_qsd_expected_layer_level() {
    local ns="$1" row r_file r_ns r_match r_level r_reserve r_life
    for row in "${QSD_BAR_SURFACE_ROWS[@]}"; do
        IFS='|' read -r r_file r_ns r_match r_level r_reserve r_life <<<"$row"
        if [[ "$r_match" == "exact" ]]; then
            if [[ "$ns" == "$r_ns" ]]; then
                printf '%s' "$r_level"
                return 0
            fi
        else
            case "$ns" in
                "${r_ns}"?*)
                    printf '%s' "$r_level"
                    return 0
                    ;;
            esac
        fi
    done
    printf '3'
    return 0
}

_qsd_check_bar_surface_registry() {
    if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
        echo "  [SKIP] bar-surface-registry (GATE-03): hyprctl or jq not found"
        return
    fi
    local scan_root src_res src_rc
    scan_root=$(_qsd_shell_qml_root)
    src_res=$(_qsd_assert_bar_surface_registry_source "$scan_root"); src_rc=$?

    local shell_pids live_res live_rc
    shell_pids="$(pgrep -f 'quickshell -p' | tr '\n' ' ')"
    live_res=$(_qsd_assert_bar_surface_registry_live "$(_qsd_layers_json)" "$shell_pids"); live_rc=$?

    local overall_rc=0
    [[ "$src_rc" -eq 0 ]] || overall_rc=1
    [[ "$live_rc" -eq 0 ]] || overall_rc=1
    check "bar-surface-registry (GATE-03, D-18-15's compensating instrument: every layer-shell frame this phase added, covered by construction — a registry row without a file fails, and a file declaring a namespace without a row fails too): source: ${src_res}, live: ${live_res}" "$overall_rc"
}

# ── D-20 (Phase 18.1 Plan 06) — bar-colour-role-routing ──────────────────
# Converts this phase's whole failure mode into a check that fails loudly:
# WorkspaceCapsule.qml:90 once promised colour-carried state in a COMMENT
# while the code applied a foreground tint, and nothing caught it for a
# whole phase. Modelled directly on _qsd_assert_panel_source (:691-701) —
# find non-exempt *.qml files at maxdepth 1, strip comments, grep a
# forbidden literal, count, name the offenders.
#
# QSD_BAR_COLOUR_ROLE_EXEMPT — every basename below carries a written
# reason; an unnamed exemption is never permitted (T-18.1-24).
#   - BarRoles.qml is the one file legitimately permitted to reference the
#     global palette — it IS the role layer. Omitting this self-exemption
#     would make the check fail on its own foundation file, which RESEARCH
#     "Pitfall 3" names as warning sign one of a wrong implementation.
#   - The seven SectionPopout-family files (SectionPopout, AudioPopout,
#     WifiPopout, BluetoothPopout, ClockPopout, ResourcesPopout,
#     MediaPopout) are separate anchored surfaces with their own
#     surfaceBase; phase 18.1's scope_fence places popout content and the
#     SectionPopout framework explicitly OUT of scope, and their palette
#     references were never part of the fill-versus-tint defect this rule
#     exists to catch. Live count at time of writing: 66 Colours.*
#     references across these seven files (see .planning/WINDOWS.md for
#     the deferred row recording this exemption so it resurfaces).
# contentColour/capsuleRoot.* need NO exemption — neither ever appears as
# a Colours.* palette-dot reference textually, so widening the array for
# them would silently grow the check's blind spot.
QSD_BAR_COLOUR_ROLE_EXEMPT=(
    "BarRoles.qml"          # the role layer itself — the one legitimate Colours.* consumer
    "SectionPopout.qml"     # popout framework — out of phase 18.1 scope_fence
    "AudioPopout.qml"       # popout content — out of phase 18.1 scope_fence
    "WifiPopout.qml"        # popout content — out of phase 18.1 scope_fence
    "EthernetPopout.qml"    # popout content — same colour layer as its six siblings (added 2026-08-12)
    "BluetoothPopout.qml"   # popout content — out of phase 18.1 scope_fence
    "ClockPopout.qml"       # popout content — out of phase 18.1 scope_fence
    "ResourcesPopout.qml"   # popout content — out of phase 18.1 scope_fence
    "MediaPopout.qml"       # popout content — out of phase 18.1 scope_fence
)

# Assert half — no bar capsule file (excluding QSD_BAR_COLOUR_ROLE_EXEMPT
# above) may reference the global Colours.* palette directly. Comments are
# stripped to END OF LINE with a sed substitution (never
# `grep -vE '^\s*//'`, which drops only whole-comment lines and lets a
# trailing comment on a code line hide a real violation). Emits the
# non-exempt scanned-file count, the offender count, and the offending
# basenames, so a failure names what to fix and an empty scan is
# distinguishable from a clean one.
_qsd_assert_bar_colour_roles() {
    local dir="$1" f base bad=0 scanned=0 offenders=""
    while IFS= read -r f; do
        base="$(basename -- "$f")"
        local exempt=0 e
        for e in "${QSD_BAR_COLOUR_ROLE_EXEMPT[@]}"; do
            [[ "$base" == "$e" ]] && exempt=1 && break
        done
        [[ "$exempt" -eq 1 ]] && continue
        scanned=$((scanned + 1))
        if _qsd_matches "$(sed -E 's|//.*$||' -- "$f" 2>/dev/null)" -- 'Colours\.'; then
            bad=$((bad + 1))
            offenders="${offenders}${offenders:+,}${base}"
        fi
    done < <(find -L "$dir" -maxdepth 1 -type f -name '*.qml' 2>/dev/null)
    printf 'scanned=%s bad=%s offenders=%s' "$scanned" "$bad" "${offenders:-none}"
    [[ "$bad" -eq 0 ]]
}

# Check half — resolves the scan root via _qsd_shell_qml_root, appends the
# bar subdirectory, calls the assert half, and reports through the
# existing check() reporter. Both empty boundaries (unresolvable root,
# zero non-exempt files) report SKIP, never PASS — a vacuous pass over an
# empty scan set is the exact mechanism (QBAR-01, T-18.1-25) that let the
# original fill-versus-tint defect survive review.
_qsd_check_bar_colour_role_routing() {
    local scan_root dir
    scan_root=$(_qsd_shell_qml_root)
    if [[ ! -d "$scan_root" ]]; then
        echo "  [SKIP] bar-colour-role-routing (D-20): shell QML root not found ($scan_root)"
        return
    fi
    dir="$scan_root/bar"
    if [[ ! -d "$dir" ]]; then
        echo "  [SKIP] bar-colour-role-routing (D-20): bar directory not found ($dir)"
        return
    fi
    local res rc scanned
    res=$(_qsd_assert_bar_colour_roles "$dir"); rc=$?
    scanned=$(printf '%s' "$res" | grep -oE 'scanned=[0-9]+' | cut -d= -f2)
    if [[ "${scanned:-0}" -eq 0 ]]; then
        echo "  [SKIP] bar-colour-role-routing (D-20): zero non-exempt .qml files found in $dir (exempt: ${QSD_BAR_COLOUR_ROLE_EXEMPT[*]})"
        return
    fi
    check "bar-colour-role-routing (D-20, the executable counterpart of this phase's central prohibition — a rule stated in a comment and enforced nowhere: no bar capsule file may reference the global Colours.* palette directly; scanned ${dir}; exempt: ${QSD_BAR_COLOUR_ROLE_EXEMPT[*]}): ${res}" "$rc"
}

# ── bar-colour-alpha-resolution (18.1 gap closure) ──────────────────────
# D-20 above proves bar files ROUTE colour through BarRoles. It does not
# prove a routed role RESOLVES to a real colour — and that gap is exactly
# how GATE-02 shipped a bar with five black surfaces while every automated
# check passed (18.1-VERIFICATION.md).
#
# The mechanism: Colours.qml declares its palette roles as `property
# string` (its JsonAdapter loads palette.json hex strings). A JS string has
# no .r/.g/.b, so `Qt.rgba(Colours.surfaceVariant.r, ..., 0.85)` silently
# evaluates to BLACK at 85% — no error, no warning. Any alpha blend must
# therefore read .r/.g/.b off a COLOUR-TYPED property, never off a
# `Colours.*` role directly.
#
# This is the mechanical form of that rule. It is deliberately narrower
# than a full resolved-value assertion (which would need a rooted `qs -p`
# probe checking .r/.g/.b/.a are finite and within [0,1]); that remains the
# recommended stronger successor. What this catches is the exact regression
# class that produced the failure: a `.r`/`.g`/`.b` read off Colours.*
# anywhere under modules/bar.
_qsd_check_bar_colour_alpha_resolution() {
    local scan_root dir
    scan_root=$(_qsd_shell_qml_root)
    if [[ ! -d "$scan_root" ]]; then
        echo "  [SKIP] bar-colour-alpha-resolution: shell QML root not found ($scan_root)"
        return
    fi
    dir="$scan_root/bar"
    if [[ ! -d "$dir" ]]; then
        echo "  [SKIP] bar-colour-alpha-resolution: bar directory not found ($dir)"
        return
    fi
    local files scanned offenders rc
    files=$(find "$dir" -maxdepth 1 -name '*.qml' 2>/dev/null | sort)
    scanned=$(printf '%s' "$files" | grep -c . || true)
    if [[ "${scanned:-0}" -eq 0 ]]; then
        echo "  [SKIP] bar-colour-alpha-resolution: zero .qml files found in $dir"
        return
    fi
    # Strip trailing comments before matching so a line DOCUMENTING the
    # forbidden shape (this phase's own BarRoles header does) cannot trip it.
    offenders=""
    local f
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        if _qsd_matches "$(sed 's|//.*||' "$f")" -E 'Colours\.[a-zA-Z_][a-zA-Z0-9_]*\.[rgb]\b'; then
            offenders="${offenders}${offenders:+ }$(basename "$f")"
        fi
    done <<< "$files"
    if [[ -n "$offenders" ]]; then
        rc=1
    else
        rc=0
        offenders="none"
    fi
    check "bar-colour-alpha-resolution (18.1: an alpha blend must read .r/.g/.b off a colour-typed property, never off a string-typed Colours.* role — the latter silently yields BLACK; scanned ${dir}, files=${scanned}): offenders=${offenders}" "$rc"
}

# ── check 4: permissions-enforce-readback ───────────────────────────────
# Guards D-16-09 against silent revert. ecosystem:enforce_permissions is
# read ONCE at compositor startup and its failure mode is silence — reading
# permissions.lua's own text is not evidence of anything at runtime, only
# this readback is.
_qsd_assert_enforce_permissions() {
    printf '%s' "$1" | grep -qE '^bool:[[:space:]]*true[[:space:]]*$'
}

_qsd_check_permissions_enforce_readback() {
    if ! command -v hyprctl >/dev/null 2>&1; then
        echo "  [SKIP] permissions-enforce-readback (D-16-23 check 4): hyprctl not found"
        return
    fi
    local raw rc
    raw=$(_qsd_hyprctl_getoption_enforce)
    _qsd_assert_enforce_permissions "$raw"
    rc=$?
    check "permissions-enforce-readback (D-16-23 check 4, guards D-16-09 against silent revert): hyprctl getoption ecosystem:enforce_permissions reports true at runtime (raw: $(printf '%s' "$raw" | tr '\n' ' '))" "$rc"
}

# ── check 5: permissions-allowlist-paths-resolve ────────────────────────
# A package update moving grim or the portal binary breaks screenshots
# under enforcement with no warning until a key is pressed. Also
# mechanically asserts the T-11-20 discipline (no glob/alternation
# metacharacter in any grant) rather than trusting it to review.
_qsd_assert_permissions_allowlist() {
    local file="$1" p total=0 missing=0 nonexec=0 pattern=0
    while IFS= read -r p; do
        [[ -z "$p" ]] && continue
        total=$((total + 1))
        case "$p" in
            *['*?[|']*) pattern=$((pattern + 1)) ;;
        esac
        if [[ ! -e "$p" ]]; then
            missing=$((missing + 1))
        elif [[ ! -x "$p" ]]; then
            nonexec=$((nonexec + 1))
        fi
    done < <(grep -oP 'binary\s*=\s*"\K[^"]+' -- "$file" 2>/dev/null)
    printf 'grants=%s missing=%s non-executable=%s pattern=%s' "$total" "$missing" "$nonexec" "$pattern"
    [[ "$total" -gt 0 && "$missing" -eq 0 && "$nonexec" -eq 0 && "$pattern" -eq 0 ]]
}

_qsd_check_permissions_allowlist_paths_resolve() {
    local file res rc
    file=$(_qsd_permissions_lua_path)
    if [[ ! -f "$file" ]]; then
        echo "  [SKIP] permissions-allowlist-paths-resolve (D-16-23 check 5): $file not found"
        return
    fi
    res=$(_qsd_assert_permissions_allowlist "$file"); rc=$?
    check "permissions-allowlist-paths-resolve (D-16-23 check 5, T-16-15/T-16-16 mitigation): every granted binary path resolves on disk, is executable, and uses no glob/alternation metacharacter (T-11-20) — ${res}" "$rc"
}

# ── check 6: overview-content-check ──────────────────────────────────────
# D-16-10's whole-grid catch made machine-detectable: summons the overview,
# reads the `overview` IPC status verb, requires withContent > 0 whenever
# windows > 0 (never a tile-count assertion — D-16-01's count is fixed
# elsewhere and this check must keep working as plan 16-03 lands eleven
# tiles), then dismisses.
#
# Honest caveat (D-16-23, carried verbatim from 16-CONTEXT.md): the natural
# poison — removing quickshell from the allow list — needs a compositor
# restart, so it cannot be reproduced by a fixture. The practical
# falsification committed here is a poisoned overview-status fixture
# reporting windows>0 with withContent=0 (the exact false-pass shape
# 16-02-SUMMARY.md's own history warns this check must catch — a bare
# non-zero windows count is NOT sufficient). Separately, and consistent
# with the same honest caveat: running this exact assertion against a
# genuinely NOT-summoned overview (windows=0) is vacuously true by design
# — the assertion is a conditional ("whenever windows>0"), not an
# unconditional "must always have content" — so that path is not itself a
# failure demonstration; the poisoned-blank-tiles fixture is.
_qsd_assert_overview_content() {
    local raw="$1" windows withcontent
    windows=$(printf '%s' "$raw" | grep -oP 'windows=\K[0-9]+' | head -1)
    withcontent=$(printf '%s' "$raw" | grep -oP 'withContent=\K[0-9]+' | head -1)
    if [[ -z "$windows" || -z "$withcontent" ]]; then
        printf 'windows=<unparsed> withContent=<unparsed>'
        return 1
    fi
    printf 'windows=%s withContent=%s' "$windows" "$withcontent"
    if [[ "$windows" -gt 0 ]]; then
        [[ "$withcontent" -gt 0 ]]
    else
        return 0
    fi
}

_qsd_check_overview_content() {
    if ! command -v qs >/dev/null 2>&1; then
        echo "  [SKIP] overview-content-check (D-16-23 check 6): qs not found"
        return
    fi
    local raw report rc
    qs ipc call overview toggle >/dev/null 2>&1
    OVERVIEW_SUMMONED=1
    sleep 0.4
    raw=$(_qsd_overview_status)
    report=$(_qsd_assert_overview_content "$raw"); rc=$?
    qs ipc call overview toggle >/dev/null 2>&1
    OVERVIEW_SUMMONED=0
    sleep 0.2
    check "overview-content-check (D-16-23 check 6, D-16-10's whole-grid catch): ${report} (raw='$(printf '%s' "$raw" | tr '\n' ' ')'). Honest caveat: the natural poison (removing quickshell from the allow list) needs a compositor restart; the practical falsification is the committed poisoned-blank-tiles-overview-status.txt fixture (windows>0, withContent=0), replayed by --self-test." "$rc"
}

# ── check 7: single-capture-path ─────────────────────────────────────────
# Beyond D-16-23's own six, made deliberately and recorded as such (see
# 16-04-SUMMARY.md): asserts the screencopy view type is instantiated in
# exactly one file under modules/overview/, encoding the 16-03 assumption-
# delta promotion (WindowThumbnail.qml is the ONLY ScreencopyView site) as
# a standing gate rather than a convention a later plan can silently break
# by forking the renderer.
_qsd_assert_single_capture_path() {
    local dir="$1" f matches=0 names=""
    while IFS= read -r f; do
        if _qsd_matches "$(grep -vE '^\s*//' -- "$f" 2>/dev/null)" -E 'ScreencopyView[[:space:]]*\{'; then
            matches=$((matches + 1))
            names="${names}$(basename -- "$f") "
        fi
    done < <(find -L "$dir" -maxdepth 1 -type f -name '*.qml' 2>/dev/null)
    printf 'files-instantiating-ScreencopyView=%s (%s)' "$matches" "${names:-none}"
    [[ "$matches" -eq 1 ]]
}

_qsd_check_single_capture_path() {
    local dir res rc
    dir=$(_qsd_overview_qml_dir)
    if [[ ! -d "$dir" ]]; then
        echo "  [SKIP] single-capture-path (D-16-23 check 7): $dir not found"
        return
    fi
    res=$(_qsd_assert_single_capture_path "$dir"); rc=$?
    check "single-capture-path (D-16-23 check 7, assumption-delta promotion beyond D-16-23's own six): exactly one ScreencopyView instantiation site under modules/overview/ — ${res}" "$rc"
}

# ── D-15-25 --self-test — motion-lint's own fixture-replay shape
#    (tests/motion-fixtures, lines 1009-1090), adapted for a LIVE
#    observation gate rather than a static-scan one: each entry drives the
#    seam directly (never a scan root), sets exactly one QSD_FIXTURE_*
#    variable per replay, and asserts a narrow parse-and-assert verdict —
#    it does NOT prove the live capture path is wired to the right
#    command (that compensating proof is that all four checks also ran
#    live in the normal invocation, and the two-panel/zero-panel cases
#    were additionally observed live). Performs NO summon, NO volume
#    write, NO radio mutation, NO headless output — structurally true,
#    because this whole function returns before the trap/mutating groups
#    below are ever reached.
_qsd_self_test_assert_layers() {
    local fixture="$1" expect_nonzero="$2" want_count="$3" want_ns="${4:-}"
    local json rc
    json=$(cat -- "$FIXTURES_DIR/$fixture")
    # T-16-SELFTEST: pass the fixed pid (2982672) baked into all four
    # compliant/poisoned *-panel-layers.json fixtures, rather than letting
    # _qsd_assert_panel_layers fall back to live pgrep — see that
    # function's own header comment for the full record-why.
    _qsd_assert_panel_layers "$json" "$want_count" "$want_ns" "2982672" >/dev/null 2>&1
    rc=$?
    if [[ "$expect_nonzero" == "0" && "$rc" -eq 0 ]]; then return 0; fi
    if [[ "$expect_nonzero" == "1" && "$rc" -ne 0 ]]; then return 0; fi
    return 1
}

run_self_test() {
    echo "quickshell-doctor --self-test — replaying the committed quickshell-fixtures"
    echo ""
    local st_pass=0 st_fail=0
    _qsd_st() {
        local desc="$1" rc="$2"
        if [[ "$rc" -eq 0 ]]; then
            printf '  [PASS] self-test: %s\n' "$desc"
            st_pass=$((st_pass + 1))
        else
            printf '  [FAIL] self-test: %s\n' "$desc"
            st_fail=$((st_fail + 1))
        fi
    }

    if [[ ! -d "$FIXTURES_DIR" ]]; then
        _qsd_st "fixtures directory missing: $FIXTURES_DIR" 1
        printf 'Self-test summary: %d passed, %d failed\n' "$st_pass" "$st_fail"
        return 1
    fi

    # panel-namespace-conformance — layers half (4 fixtures). The
    # compliant fixture is the DURING-summon shape (one panel, correct
    # namespace, level 3, shell-owned pid) — a real 2026-08-02 capture
    # taken while `qs ipc call panel open wifi` had the wifi panel
    # summoned.

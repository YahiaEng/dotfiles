#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║            QUICKSHELL-DOCTOR (D-05)                   ║
# ║  Rerunnable coexistence gate: proves the Quickshell    ║
# ║  shell root stays alive, reserves screen space          ║
# ║  attributably to exactly one surface (the bar) and no  ║
# ║  other, sits on its own quickshell-* namespaces at the ║
# ║  level each surface is registered for, and shares every ║
# ║  event source (D-Bus ownership, hardware keys,          ║
# ║  volume/brightness step, MPRIS) with the in-process      ║
# ║  QML OSD, QML power menu, AGS and walker without a second         ║
# ║  handler ever appearing. Report-only apart from a few    ║
# ║  documented transient exceptions (the volume/brightness  ║
# ║  step probes, the bar-reserved-zone-stability toggle,     ║
# ║  and the opt-in compositor-reload half), each of which    ║
# ║  restores what it changes via a trap installed before      ║
# ║  its first mutation runs (T-11-11).                        ║
# ╚══════════════════════════════════════════════════════╝
#
# Record-why (D-14-style correction, for this file's own design): on
# Hyprland 0.56.0, `hyprctl layers -j` carries NO reserved-space field at
# all — verified directly (11-RESEARCH.md Pitfall 1). Its "levels" keys
# 0-3 are shell-layer levels (background/bottom/top/overlay), not screen
# edges, and no such per-client field appears anywhere in its output. A
# check written to grep that query for such a field would report PASS
# whether Quickshell actually reserves space or not — a check that
# cannot fail is not a check. The real reserved-space accounting is
# visible on `hyprctl monitors -j`'s `reserved` array
# ([left,top,right,bottom] pixel counts). Do NOT "simplify" this file
# back into a `layers -j` grep for that field — it isn't there.
#
# Record-why (18-17, the one-reservation model): every surface up to and
# including the overview reserved nothing, and this file asserted exactly
# that — "Quickshell claims no reserved screen space" (this header's own
# former third line) and a dedicated check with that same claim in its
# label. Phase 18's bar (QBAR-01, wave 1) made that assertion false BY
# DESIGN: `Bar.qml` is the first Quickshell surface with `exclusiveZone >
# 0`, and it is permanent. The assertion is REWRITTEN here, not deleted
# and not wrapped beside a second, contradicting one: exactly ONE
# Quickshell surface may reserve space — the bar — every other Quickshell
# surface reserves zero, and this file's checks now prove that
# attribution rather than a blanket zero. `18-RESEARCH.md` Pitfall 6 and
# `18-PATTERNS.md` both send a reader to `_qsd_check_reserved_array_
# manifest_coverage` for this claim — that function asserts something
# else (manifest token-allowlist safety, preserved below under an honest
# name); the falsified claim actually lived in this header's own third
# line and in the inline "reserved-space stays unclaimed" check further
# down. Recorded here once so a future reader does not repeat that trip.
#
# Usage: quickshell-doctor [--no-summon] [--no-headless-output] [--no-panel-checks] [--with-compositor-reload] [--self-test]
#   --no-summon           Downgrade the transient summon-and-diff
#                         reserved-space check to a named [SKIP] line, for
#                         a headless/CI context where dispatching a
#                         GlobalShortcut has no compositor to land on.
#   --with-compositor-reload  18-17's first OPT-IN flag (every other flag
#                         here is an opt-OUT of something safe-by-default;
#                         this one enables something hazardous-by-default,
#                         and the polarity is deliberately inverted so no
#                         casual run pays this cost). Runs a live `hyprctl
#                         reload` as part of bar-reserved-zone-stability's
#                         compositor-reload half. On this Lua-parser build
#                         a reload is known to interact badly with this
#                         repo's `^quickshell-.*` layer rules (RESEARCH.md
#                         Pitfall 4 territory) — the check restores them by
#                         replaying windowrules.lua's own quickshell rules
#                         through `hyprctl eval` and RESTARTS the shell
#                         (rules bind at surface map time, so a replay
#                         alone changes nothing on an already-mapped
#                         surface). Off by default: prints
#                         "compositor-reload=SKIPPED" and never a pass.
#   --no-headless-output  Downgrade the QS-03 headless-output hotplug
#                         group (add / per-screen surface creation /
#                         reserved-unchanged / remove) to named [SKIP]
#                         lines, for a context where mutating the live
#                         monitor topology is undesirable.
#   --no-panel-checks     Downgrade the four D-15-25 panel checks
#                         (panel-namespace-conformance,
#                         panel-shortcut-single-registration,
#                         panel-notifications-single-owner,
#                         panel-osd-state-driven-trigger — renamed by
#                         Phase 20 Plan 04, D-20-05, see that check's own
#                         header) to named
#                         [SKIP] lines, for a headless/CI context with no
#                         compositor to summon a panel into — the same
#                         shape --no-summon already has for the
#                         reserved-space check.
#   --self-test            Replay every committed fixture under
#                         tests/quickshell-fixtures/ through the seam its
#                         target check reads, in isolation, and assert the
#                         recorded verdict. Runs NO live check and performs
#                         NO mutation of any kind (no summon, no volume
#                         write, no radio mutation, no headless output) —
#                         this path returns before any mutating group is
#                         ever reached. Own tally, own exit code.
#
#   Note: within the headless-output group, the per-screen surface
#   creation check is a documented SKIP under D-13/D-14 (12-CONTEXT.md,
#   one-way) — accepted as a permanent limitation on quickshell 0.3.0-2
#   after a bounded Phase 12 re-attempt, see 12-QS03-EVIDENCE.md. The
#   other three checks in the group (add / reserved-unchanged / remove)
#   still run live. Flip QS03_ACCEPTED_PERMANENT near the top of this file
#   to 0 to re-enable the live per-screen check the moment a quickshell
#   build exists on which the fan-out might work again.
#
#   D-15-25 (Phase 15 Plan 09): four new checks land on the SAME
#   before/during/after summon-and-diff mechanism the reserved-space check
#   above already established — no second verification mechanism is
#   invented here. Their fixture-substitution seams
#   (QSD_FIXTURE_BUSCTL_LIST / QSD_FIXTURE_HYPRCTL_BINDS /
#   QSD_FIXTURE_LAYERS_JSON / QSD_FIXTURE_SHORTCUTS_MANIFEST /
#   QSD_FIXTURE_KEYBINDS_LUA / QSD_FIXTURE_PANEL_QML_DIR) are inert on the
#   live path: unset, every seam reads live state, and a plain invocation
#   performs zero fixture reads. Only --self-test ever sets one, and it
#   sets exactly one per replay.
#
#   D-16-23 (Phase 16 Plan 04): seven more checks land — overview namespace
#   conformance, Super+O single registration, reserved-array manifest
#   coverage (all three reuse the D-15-25 seams above, no new variable
#   needed), plus four genuinely new seams:
#   QSD_FIXTURE_HYPRCTL_GETOPTION (ecosystem:enforce_permissions runtime
#   readback), QSD_FIXTURE_PERMISSIONS_LUA (the allow-list file),
#   QSD_FIXTURE_OVERVIEW_STATUS (the `overview` IPC status verb's output),
#   and QSD_FIXTURE_OVERVIEW_QML_DIR (the single-capture-path source scan
#   root). Same two discipline rules as D-15-25's seams: a variable naming
#   a nonexistent path is a hard FATAL, and none of the four is ever
#   consulted on the live path unless explicitly set.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
SHORTCUTS_MANIFEST="$HOME/.config/quickshell/shortcuts.json"
KEYBINDS_LUA="$HOME/.config/hypr/config/keybinds.lua"
PERMISSIONS_LUA="$HOME/.config/hypr/config/permissions.lua"
QUICKSHELL_CONFIG_DIR="$HOME/.config/quickshell"
LAUNCHER_LOG="$HOME/.cache/quickshell.log"
STATE_DIR="$HOME/.local/state/quickshell"
BASELINE_FILE="$STATE_DIR/doctor-baseline.json"
KEYBIND_DOCTOR="$SCRIPT_DIR/keybind-doctor"
FIXTURES_DIR="$SCRIPT_DIR/tests/quickshell-fixtures"
# 18-17 (QBAR-12/GATE-03): the bar's sole owner (D-18-27) and its own
# source file. bar-reserved-zone-stability calls exactly two of the
# owner's verbs — bar-visibility.sh status and bar-visibility.sh keybind
# toggle — and never a raw signal or a direct `qs ipc call bar` (the
# desync class this repo has already deleted twice, per that script's own
# header).
BAR_VISIBILITY_SH="$HOME/.config/hypr/scripts/bar-visibility.sh"
BAR_QML_PATH="$QUICKSHELL_CONFIG_DIR/modules/Bar.qml"
US=$'\x1f'

NO_SUMMON=0
NO_HEADLESS_OUTPUT=0
NO_PANEL_CHECKS=0
SELF_TEST=0
# 18-17: this file's first OPT-IN flag (every flag above downgrades a
# check that is safe by default; this one enables a compositor mutation
# that is not) — deliberately inverted polarity, default off, see the
# usage block above for the full cost.
WITH_COMPOSITOR_RELOAD=0
for arg in "$@"; do
    case "$arg" in
        --no-summon) NO_SUMMON=1 ;;
        --no-headless-output) NO_HEADLESS_OUTPUT=1 ;;
        --no-panel-checks) NO_PANEL_CHECKS=1 ;;
        --with-compositor-reload) WITH_COMPOSITOR_RELOAD=1 ;;
        --self-test) SELF_TEST=1 ;;
    esac
done

# D-15-25 hard-error guard, run at TRUE top level (not inside a `$(...)`
# subshell, where `exit` would only terminate the subshell and silently
# let the live path continue) — a QSD_FIXTURE_* variable left set in a
# shell profile, CI environment, or copied invocation that names a
# nonexistent path is a hard error before this script does anything
# else, never a silent fall-through to live (T-15-08).
for _qsd_fv in QSD_FIXTURE_BUSCTL_LIST QSD_FIXTURE_HYPRCTL_BINDS QSD_FIXTURE_LAYERS_JSON QSD_FIXTURE_SHORTCUTS_MANIFEST QSD_FIXTURE_KEYBINDS_LUA QSD_FIXTURE_HYPRCTL_GETOPTION QSD_FIXTURE_PERMISSIONS_LUA QSD_FIXTURE_OVERVIEW_STATUS QSD_FIXTURE_MONITORS_JSON QSD_FIXTURE_DESIGN_QML QSD_FIXTURE_WINDOWRULES_LUA; do
    _qsd_fv_val="${!_qsd_fv:-}"
    if [[ -n "$_qsd_fv_val" && ! -f "$_qsd_fv_val" ]]; then
        echo "FATAL: $_qsd_fv names a nonexistent file: $_qsd_fv_val" >&2
        exit 1
    fi
done
if [[ -n "${QSD_FIXTURE_PANEL_QML_DIR:-}" && ! -d "$QSD_FIXTURE_PANEL_QML_DIR" ]]; then
    echo "FATAL: QSD_FIXTURE_PANEL_QML_DIR names a nonexistent directory: $QSD_FIXTURE_PANEL_QML_DIR" >&2
    exit 1
fi
if [[ -n "${QSD_FIXTURE_OVERVIEW_QML_DIR:-}" && ! -d "$QSD_FIXTURE_OVERVIEW_QML_DIR" ]]; then
    echo "FATAL: QSD_FIXTURE_OVERVIEW_QML_DIR names a nonexistent directory: $QSD_FIXTURE_OVERVIEW_QML_DIR" >&2
    exit 1
fi
# 18-17: QSD_FIXTURE_SHELL_QML_ROOT (directory seam, bar-surface registry
# source-tree scan root — Task 3) joins the two directory guards above,
# same hard-FATAL-before-anything-else discipline.
if [[ -n "${QSD_FIXTURE_SHELL_QML_ROOT:-}" && ! -d "$QSD_FIXTURE_SHELL_QML_ROOT" ]]; then
    echo "FATAL: QSD_FIXTURE_SHELL_QML_ROOT names a nonexistent directory: $QSD_FIXTURE_SHELL_QML_ROOT" >&2
    exit 1
fi
# 21-04 (QMEDIA-03): QSD_FIXTURE_QUICKSHELL_CONFIG_DIR (directory seam, the
# standing MPRIS-reader-count check's scan root) joins the directory
# guards above, same hard-FATAL-before-anything-else discipline.
if [[ -n "${QSD_FIXTURE_QUICKSHELL_CONFIG_DIR:-}" && ! -d "$QSD_FIXTURE_QUICKSHELL_CONFIG_DIR" ]]; then
    echo "FATAL: QSD_FIXTURE_QUICKSHELL_CONFIG_DIR names a nonexistent directory: $QSD_FIXTURE_QUICKSHELL_CONFIG_DIR" >&2
    exit 1
fi
unset _qsd_fv _qsd_fv_val

# D-13 (12-CONTEXT.md, one-way): per-screen Quickshell surface fan-out was
# accepted as a permanent limitation after Phase 12's bounded re-attempt —
# a checked-in modules/qmldir (closing the FM1 scanner race) plus two
# structurally distinct Variants+per-screen-LazyLoader arrangements, one of
# them the escape-hatch spike — reproduced an FM2-class multi-screen
# surface-creation failure on quickshell 0.3.0-2 in both arrangements,
# re-proven across a real session restart. Full record: 12-QS03-EVIDENCE.md.
# This is deliberately a one-line guard, not a --qs03-accepted CLI switch:
# the acceptance is a property of this repo on this quickshell version, not
# a per-invocation choice a future run could silently flip. Flip it to 0 to
# get the real per-screen check back the moment a quickshell build exists
# on which the fan-out might work. Leaving the check permanently red
# instead was rejected (D-14): a gate everyone knows is red is a gate
# nobody reads, and its non-zero exit stops being a usable signal for the
# other 13 checks.
QS03_ACCEPTED_PERMANENT=1

# ── D-15-25 identity-model promotion (Phase 15 Plan 09's own
#    <assumption_delta_decision>, record-why in QS03_ACCEPTED_PERMANENT's
#    established voice) — record-why, not a per-invocation choice.
#
#    Before Phase 15 this file knew exactly one D-Bus identity noun,
#    OWNER, and asserted cardinality 1 on it (the single
#    org.freedesktop.Notifications check below, and the per-key handler
#    count check). Phase 15 introduced three participants that are
#    emphatically NOT owners: the audio/wifi/bluetooth panels are
#    unbounded CLIENTS of PipeWire, NetworkManager and BlueZ — D-15-24's
#    own reasoning already draws this line ("the panels are additional
#    consumers, not ownership claimants") but no instrument encoded it
#    before this plan.
#
#    So the primary noun is promoted to SERVICE PARTICIPANT, with two
#    demoted variants:
#      - name-owner:      cardinality exactly 1, ASSERTED, poison-provable.
#                          QSD_NAME_OWNERS below is this registry.
#      - client-consumer: cardinality N, NEVER asserted exclusive — the
#                          assertion is that no exclusivity assertion
#                          exists at all. QSD_CLIENT_CONSUMERS below is
#                          this registry.
#
#    A future editor MUST NOT assert cardinality 1 on anything in
#    QSD_CLIENT_CONSUMERS — PipeWire/NetworkManager/BlueZ are many-client
#    services by design, and a future check that "helpfully" asserts
#    exclusivity over one of them will fail the moment two legitimate
#    clients talk to it at once, which is that service's normal operating
#    mode. _qsd_assert_client_consumer_not_owned below is the structural
#    guard that makes this mistake fail the gate instead of shipping.
# RETIRE-03 / D-19-42 atomic swap (Plan 19-08 Task 4). The declared owner
# of org.freedesktop.Notifications below and the notification-daemon launch
# entry in hypr/config/autostart.lua are the same fact recorded in two
# places, so the plan required them to move in ONE commit: any boot from a
# state where the old daemon is still launched but the shell is declared
# owner runs two processes racing for a bus name only one can hold, and the
# loser fails silently rather than loudly.
#
# HONEST DEVIATION, recorded here rather than only in a commit message.
# The flip on the row below did NOT land with the launch-entry removal. It
# landed early, in Task 1's commit bf55b1e ("pre-deletion baseline, fixture
# re-point, live single-owner proof"), which the plan had explicitly asked
# to leave this row alone. The launch-entry removal followed in Task 4.
# So the exposure window this pairing exists to prevent did briefly exist
# in repo history — bf55b1e..Task 4 — with the registry naming the shell
# while autostart.lua still launched the old daemon.
#
# It never bit on this host: the session was already running the shell as
# sole owner throughout that window (verified live at both ends), the old
# daemon was not running, and no cold boot occurred between the two
# commits. A cold boot inside that window WOULD have started both. The
# window is closed as of Task 4; this note stays so that a future reader
# auditing "was the swap really atomic" gets the true answer from the file
# rather than inferring a cleaner history than actually happened.
declare -A QSD_NAME_OWNERS=(
    ["org.freedesktop.Notifications"]="quickshell"
)
declare -A QSD_CLIENT_CONSUMERS=(
    ["PipeWire"]="Phase 15's audio panel joins pw-play/pw-cli/wpctl as an additional PipeWire client — never the sole one, so cardinality is never asserted"
    ["NetworkManager"]="Phase 15's wifi panel joins nm-applet/nmcli/nmtui as an additional NetworkManager client — never the sole one"
    ["BlueZ"]="Phase 15's bluetooth panel joins bluetoothctl/blueman-manager as an additional BlueZ client — never the sole one"
)
QSD_PANEL_NAMES=(audio wifi bluetooth)
QSD_PANEL_NAMESPACE_PREFIX="quickshell-"
QSD_PANEL_NAMESPACE_SUFFIX="-panel"

# ── 18-17 Task 3 (GATE-03) — the bar-surface registry. One ordered row
#    per bar-family layer-shell frame this phase added, each:
#    file (relative to the shell's QML module root) | namespace value or
#    prefix | match type (exact|pattern — pattern requires at least one
#    character after the stored prefix, never a bare startswith) | layer
#    level (hyprctl layers -j levels key: 0=background 1=bottom 2=top
#    3=overlay) | reservation permission (reserve|noreserve) | lifetime
#    (permanent|transient).
#
#    A FUTURE EDITOR MUST: add one row, add nothing else. The closure
#    this registry drives — in _qsd_assert_bar_surface_registry_source and
#    _qsd_assert_bar_surface_registry_live below — is what makes forgetting
#    a row impossible rather than merely discouraged: a row whose file is
#    missing fails, and a file anywhere under the scan root that declares
#    a layer namespace and is not a registry row or in
#    QSD_KNOWN_NONBAR_FRAMES also fails.
#
#    `bar/BarDrawer.qml` (18-11's recommended Option B for D-18-11's
#    vertical drawers) was an OPEN DECISION when this array was first
#    written, not yet taken. The decision was taken by quick task
#    260812-59l (closing GATE-02 row B.4-DRAWER): the file ships, and its
#    row is below. Its namespace prefix is `quickshell-bardrawer-`, NOT
#    `quickshell-bar-drawer-` — a future editor must not "fix" this to
#    look more like a hyphenated compound word. The reason:
#    _qsd_assert_bar_surface_registry_live (below) requires every live
#    bar-family namespace to match EXACTLY ONE registry row, and the
#    SectionPopout row above stores the pattern prefix `quickshell-bar-`,
#    which matches ANY string beginning with that prefix plus at least
#    one character. A namespace of the shape `quickshell-bar-…` would
#    therefore match both the SectionPopout row and this file's own row,
#    be counted `unmatched`, and fail the live half the moment a drawer
#    is actually open. `quickshell-bardrawer-…` still starts with
#    `quickshell-bar` (so the broad candidate net still captures it) and
#    with `quickshell-` (so the family-wide blur/ignore_alpha layer rules
#    still apply), while resolving to exactly one row.
#
#    Ordered and INDEXED, never associative — bash associative-array
#    iteration order is unspecified, and a report string that changes
#    order between runs would make a committed fixture's verdict
#    order-dependent, the same class of defect the ten hardware keys in
#    this file already avoid this way.
#    `bar/BarTooltip.qml` (quick task 260812-69w, F2 — GATE-02 iteration-1
#    defect) was added the same way BarDrawer.qml was: its namespace
#    prefix is `quickshell-bartip-`, NOT `quickshell-bar-tip-` — the same
#    reason BarDrawer.qml's own row is `quickshell-bardrawer-` and not
#    `quickshell-bar-drawer-`. The SectionPopout row's pattern prefix
#    `quickshell-bar-` matches ANY string beginning with that prefix plus
#    at least one character, so `quickshell-bar-tip-…` would match both
#    rows, be counted `unmatched`, and fail the live half the moment a
#    tooltip is shown. `quickshell-bartip-…` still starts with
#    `quickshell-bar` (broad candidate net) and `quickshell-` (family
#    blur/ignore_alpha rules), while resolving to exactly one row.
QSD_BAR_SURFACE_ROWS=(
    "Bar.qml|quickshell-bar|exact|2|reserve|permanent"
    "bar/SectionPopout.qml|quickshell-bar-|pattern|3|noreserve|transient"
    "bar/HotZone.qml|quickshell-bar-hotzone|exact|3|noreserve|transient"
    "bar/BarDrawer.qml|quickshell-bardrawer-|pattern|3|noreserve|transient"
    "bar/BarTooltip.qml|quickshell-bartip-|pattern|3|noreserve|transient"
    # ── Phase 19 notification family (RETIRE-03 / QNOTIF, added 2026-08-14)
    #    Registered here rather than waved through QSD_KNOWN_NONBAR_FRAMES
    #    below: that set is explicitly for frames "this phase did not add"
    #    and which PREDATE the registry, and these are neither — they are
    #    exactly the case the registry exists to cover, just from a later
    #    phase than the one that wrote it. Plan 19-06 deferred these rows to
    #    19-08 and 19-08 closed without adding them, which is the whole of
    #    the `unregistered=3` debt this closes.
    #
    #    All three verified against the files and the live compositor before
    #    being written: each declares `WlrLayershell.layer: WlrLayer.Overlay`
    #    (level 3) and `exclusiveZone: 0`, and `hyprctl layers -j` reports
    #    quickshell-notif-popups at level 3 live. `noreserve` is therefore
    #    accurate, not assumed — the bar remains the single reserving
    #    surface this file's own header insists on.
    #
    #    Lifetime is `permanent` for the popup stack and the centre because
    #    D-19-14 mounts both unconditionally at shell root (history and DND
    #    must not depend on the centre's existence); the toast is `transient`
    #    — it is summoned per feedback event and destroyed on expiry.
    "notifications/NotifPopupStack.qml|quickshell-notif-popups|exact|3|noreserve|permanent"
    "centre/NotifCentre.qml|quickshell-notif-centre|exact|3|noreserve|permanent"
    "toast/Toast.qml|quickshell-notif-toast|exact|3|noreserve|transient"
    # ── Phase 20 Plan 04 (QOSD-01/QOSD-03, D-20-33) — the OSD's own
    #    namespace. D-20-04 is explicit that no NEW top-level frame is
    #    created for the OSD (it is a `Toast.qml` INSTANCE), so this is a
    #    namespace registration only, not a new frame class.
    #
    #    Resolution direction, recorded per this array's own header
    #    instruction: the LIVE half (_qsd_assert_bar_surface_registry_live)
    #    resolves namespace->row and would tolerate a second row on
    #    toast/Toast.qml fine — cardinality is judged on the live
    #    namespace string, not the file. The SOURCE half
    #    (_qsd_assert_bar_surface_registry_forward) is what actually
    #    resolves file->row: for EACH row it re-derives both the
    #    "this file declares its own namespace exactly once" marker and the
    #    row's namespace LITERAL from that SAME row's own file. A second
    #    row pointed at toast/Toast.qml with namespace "quickshell-osd"
    #    fails that check — the literal string "quickshell-osd" never
    #    appears in Toast.qml's own source; it lives only in
    #    modules/osd/Osd.qml, which sets Toast's `layerNamespace` property
    #    to that value. So this row is registered against `osd/Osd.qml`
    #    instead, per the array header's own file->row fallback rule.
    #
    #    That file, in turn, contains no literal `WlrLayershell.namespace`
    #    string at all (Toast.qml owns that binding once, forwarding
    #    `toastWindow.layerNamespace`) — a case the forward check's marker
    #    predates. `_qsd_assert_bar_surface_registry_forward` below accepts
    #    a `layerNamespace:` property-override line as an equally valid,
    #    count-once declaration marker, but ONLY as a fallback when the
    #    direct `WlrLayershell.namespace` marker count is zero — every
    #    pre-Phase-20 row above still matches the direct marker exactly
    #    once and never reaches that fallback, so this extension changes no
    #    existing row's verdict. The same fallback covers the
    #    `exclusiveZone: 0` noreserve check: Osd.qml inherits it from
    #    Toast.qml rather than redeclaring it, so that check falls back to
    #    toast/Toast.qml's own literal when the instance file doesn't carry
    #    one itself.
    "osd/Osd.qml|quickshell-osd|exact|3|noreserve|transient"
    # ── Phase 20 Plan 06 Task 2 (QPOWER-01, D-20-33) — the power menu's own
    #    namespace. Resolution direction, recorded per this array's own
    #    header instruction: unlike the OSD row above, this one needs no
    #    file->row fallback — `session/PowerMenu.qml` declares
    #    `WlrLayershell.namespace: "quickshell-session"` as a direct
    #    literal in its own source (it is not a Toast.qml instance forwarding
    #    someone else's namespace binding), so
    #    `_qsd_assert_bar_surface_registry_forward`'s direct
    #    `WlrLayershell.namespace` marker matches this row's file exactly
    #    once with no fallback needed. Level 3 because it declares
    #    `WlrLayer.Overlay`; `noreserve` because `exclusiveZone: 0` (the bar
    #    remains the single reserving surface this file's header insists
    #    on); `transient` because it is summoned per invocation (a
    #    LazyLoader toggle) and destroyed on dismiss, mirroring the notif
    #    toast row's own transient lifetime above rather than the
    #    permanent notif-popups/notif-centre rows.
    "session/PowerMenu.qml|quickshell-session|exact|3|noreserve|transient"
)

# Pre-existing summonable layer-shell frames this phase did not add and
# does not register — declaring a real WlrLayershell.namespace is
# expected and correct for these, matched by basename. PanelDialog.qml is
# the shared frame D-18-15 built the registry below to compensate for
# (its own header forbids a bespoke PanelWindow beyond it); Dashboard.qml,
# Overview.qml, Probe.qml and ScreencopyProbe.qml all predate this phase.
QSD_KNOWN_NONBAR_FRAMES=(PanelDialog.qml Dashboard.qml Overview.qml Probe.qml ScreencopyProbe.qml)

PASS=0
FAIL=0

check() {
    local desc="$1"
    local ok="$2"
    if [[ "$ok" == "0" ]]; then
        printf '  [PASS] %s\n' "$desc"
        PASS=$((PASS + 1))
    else
        printf '  [FAIL] %s\n' "$desc"
        FAIL=$((FAIL + 1))
    fi
}

# V5 input-validation control (matches keybind-doctor's own discipline,
# its comment at lines 69-71): every value parsed from the manifest is
# handled as display/comparison-only text. Before any manifest-derived
# appid/name reaches a `hyprctl dispatch` argv element, it is checked
# against this strict allowlist — never shell-command-interpreted, never
# passed through a constructed shell string (T-11-10).
_qsd_valid_token() {
    [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]]
}

# _qsd_dispatch_global — summon/dismiss a Quickshell GlobalShortcut.
#
# Phase 13.1 migrated the compositor to the Lua config manager, which
# parses a `hyprctl dispatch` argument as Lua source. The pre-migration
# bare form (`hyprctl dispatch global quickshell:probe`) is no longer a
# no-op-with-a-warning — it is a hard parse error:
#
#     hl.dispatch(global quickshell:probe)  ->  ')' expected near 'quickshell'
#
# Every call site here redirects to /dev/null, so the failure was silent:
# the headless-remove check could never pass (nothing was ever summoned,
# so the probe always read as absent), and the reserved-space check passed
# VACUOUSLY for the same reason. Same bug class as 13.1-09's `hyprctl
# keyword` finding, which that sweep fixed in gaming-mode-toggle.sh only.
#
# Callers MUST have already put the identifier through _qsd_valid_token,
# whose allowlist ([A-Za-z0-9_-]+ per segment) is what makes embedding it
# in a Lua double-quoted string safe — no quote or backslash can survive
# it, so there is no Lua-string escape to construct (T-11-10 still holds).
_qsd_dispatch_global() {
    hyprctl dispatch "hl.dsp.global(\"$1\")" >/dev/null 2>&1
}

# ── D-15-25 seam layer (T-15-08) — one function per observation source.
#    Each returns LIVE output when its QSD_FIXTURE_* variable is unset,
#    and the named fixture's content (or path) when it is set. Two
#    discipline rules, both load-bearing:
#      1. A seam variable naming a file/dir that does not exist is a HARD
#         ERROR, never a silent fall-through to live — a typo'd self-test
#         path must not quietly become a live run.
#      2. No seam is ever consulted on the live path: with no QSD_FIXTURE_*
#         variable set, every seam below performs zero fixture reads, and
#         --self-test (below) is the ONLY caller that ever sets one — and
#         it sets exactly one per replay, never two at once.
_qsd_busctl_list() {
    if [[ -n "${QSD_FIXTURE_BUSCTL_LIST:-}" ]]; then
        [[ -f "$QSD_FIXTURE_BUSCTL_LIST" ]] || { echo "FATAL: QSD_FIXTURE_BUSCTL_LIST names a nonexistent file: $QSD_FIXTURE_BUSCTL_LIST" >&2; exit 1; }
        cat -- "$QSD_FIXTURE_BUSCTL_LIST"
        return
    fi
    busctl --user list 2>/dev/null
}

_qsd_hyprctl_binds() {
    if [[ -n "${QSD_FIXTURE_HYPRCTL_BINDS:-}" ]]; then
        [[ -f "$QSD_FIXTURE_HYPRCTL_BINDS" ]] || { echo "FATAL: QSD_FIXTURE_HYPRCTL_BINDS names a nonexistent file: $QSD_FIXTURE_HYPRCTL_BINDS" >&2; exit 1; }
        cat -- "$QSD_FIXTURE_HYPRCTL_BINDS"
        return
    fi
    hyprctl binds 2>/dev/null
}

_qsd_layers_json() {
    if [[ -n "${QSD_FIXTURE_LAYERS_JSON:-}" ]]; then
        [[ -f "$QSD_FIXTURE_LAYERS_JSON" ]] || { echo "FATAL: QSD_FIXTURE_LAYERS_JSON names a nonexistent file: $QSD_FIXTURE_LAYERS_JSON" >&2; exit 1; }
        cat -- "$QSD_FIXTURE_LAYERS_JSON"
        return
    fi
    hyprctl layers -j 2>/dev/null
}


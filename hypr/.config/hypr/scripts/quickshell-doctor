#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║            QUICKSHELL-DOCTOR (D-05)                   ║
# ║  Rerunnable coexistence gate: proves the Quickshell    ║
# ║  shell root stays alive, claims no reserved screen     ║
# ║  space, sits on its own quickshell-* overlay namespace, ║
# ║  and shares every event source (D-Bus ownership,       ║
# ║  hardware keys, volume/brightness step, MPRIS) with     ║
# ║  waybar, swaync, SwayOSD, wleave, AGS and walker        ║
# ║  without a second handler ever appearing. Report-only  ║
# ║  apart from one documented transient exception (the     ║
# ║  volume/brightness step probes below), which restore    ║
# ║  what they change via a trap installed before either    ║
# ║  probe's first mutation runs (T-11-11).                 ║
# ╚══════════════════════════════════════════════════════╝
#
# Record-why (D-14-style correction, for this file's own design): on
# Hyprland 0.56.0, `hyprctl layers -j` carries NO reserved-space field at
# all — verified directly (11-RESEARCH.md Pitfall 1). Its "levels" keys
# 0-3 are shell-layer levels (background/bottom/top/overlay), not screen
# edges, and no such per-client field appears anywhere in its output. A
# check written to grep that query for such a field would report PASS
# whether Quickshell actually reserves space or not — a check that
# cannot fail is not a check. The real reserved-space accounting is
# visible on `hyprctl monitors -j`'s `reserved` array
# ([left,top,right,bottom] pixel counts). Do NOT "simplify" this file
# back into a `layers -j` grep for that field — it isn't there.
#
# Usage: quickshell-doctor [--no-summon] [--no-headless-output] [--no-panel-checks] [--self-test]
#   --no-summon           Downgrade the transient summon-and-diff
#                         reserved-space check to a named [SKIP] line, for
#                         a headless/CI context where dispatching a
#                         GlobalShortcut has no compositor to land on.
#   --no-headless-output  Downgrade the QS-03 headless-output hotplug
#                         group (add / per-screen surface creation /
#                         reserved-unchanged / remove) to named [SKIP]
#                         lines, for a context where mutating the live
#                         monitor topology is undesirable.
#   --no-panel-checks     Downgrade the four D-15-25 panel checks
#                         (panel-namespace-conformance,
#                         panel-shortcut-single-registration,
#                         panel-notifications-single-owner,
#                         panel-swayosd-key-ownership) to named [SKIP]
#                         lines, for a headless/CI context with no
#                         compositor to summon a panel into — the same
#                         shape --no-summon already has for the
#                         reserved-space check.
#   --self-test            Replay every committed fixture under
#                         tests/quickshell-fixtures/ through the seam its
#                         target check reads, in isolation, and assert the
#                         recorded verdict. Runs NO live check and performs
#                         NO mutation of any kind (no summon, no volume
#                         write, no radio mutation, no headless output) —
#                         this path returns before any mutating group is
#                         ever reached. Own tally, own exit code.
#
#   Note: within the headless-output group, the per-screen surface
#   creation check is a documented SKIP under D-13/D-14 (12-CONTEXT.md,
#   one-way) — accepted as a permanent limitation on quickshell 0.3.0-2
#   after a bounded Phase 12 re-attempt, see 12-QS03-EVIDENCE.md. The
#   other three checks in the group (add / reserved-unchanged / remove)
#   still run live. Flip QS03_ACCEPTED_PERMANENT near the top of this file
#   to 0 to re-enable the live per-screen check the moment a quickshell
#   build exists on which the fan-out might work again.
#
#   D-15-25 (Phase 15 Plan 09): four new checks land on the SAME
#   before/during/after summon-and-diff mechanism the reserved-space check
#   above already established — no second verification mechanism is
#   invented here. Their fixture-substitution seams
#   (QSD_FIXTURE_BUSCTL_LIST / QSD_FIXTURE_HYPRCTL_BINDS /
#   QSD_FIXTURE_LAYERS_JSON / QSD_FIXTURE_SHORTCUTS_MANIFEST /
#   QSD_FIXTURE_KEYBINDS_LUA / QSD_FIXTURE_PANEL_QML_DIR) are inert on the
#   live path: unset, every seam reads live state, and a plain invocation
#   performs zero fixture reads. Only --self-test ever sets one, and it
#   sets exactly one per replay.
#
#   D-16-23 (Phase 16 Plan 04): seven more checks land — overview namespace
#   conformance, Super+O single registration, reserved-array manifest
#   coverage (all three reuse the D-15-25 seams above, no new variable
#   needed), plus four genuinely new seams:
#   QSD_FIXTURE_HYPRCTL_GETOPTION (ecosystem:enforce_permissions runtime
#   readback), QSD_FIXTURE_PERMISSIONS_LUA (the allow-list file),
#   QSD_FIXTURE_OVERVIEW_STATUS (the `overview` IPC status verb's output),
#   and QSD_FIXTURE_OVERVIEW_QML_DIR (the single-capture-path source scan
#   root). Same two discipline rules as D-15-25's seams: a variable naming
#   a nonexistent path is a hard FATAL, and none of the four is ever
#   consulted on the live path unless explicitly set.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
SHORTCUTS_MANIFEST="$HOME/.config/quickshell/shortcuts.json"
KEYBINDS_LUA="$HOME/.config/hypr/config/keybinds.lua"
PERMISSIONS_LUA="$HOME/.config/hypr/config/permissions.lua"
QUICKSHELL_CONFIG_DIR="$HOME/.config/quickshell"
LAUNCHER_LOG="$HOME/.cache/quickshell.log"
STATE_DIR="$HOME/.local/state/quickshell"
BASELINE_FILE="$STATE_DIR/doctor-baseline.json"
KEYBIND_DOCTOR="$SCRIPT_DIR/keybind-doctor"
FIXTURES_DIR="$SCRIPT_DIR/tests/quickshell-fixtures"
US=$'\x1f'

NO_SUMMON=0
NO_HEADLESS_OUTPUT=0
NO_PANEL_CHECKS=0
SELF_TEST=0
for arg in "$@"; do
    case "$arg" in
        --no-summon) NO_SUMMON=1 ;;
        --no-headless-output) NO_HEADLESS_OUTPUT=1 ;;
        --no-panel-checks) NO_PANEL_CHECKS=1 ;;
        --self-test) SELF_TEST=1 ;;
    esac
done

# D-15-25 hard-error guard, run at TRUE top level (not inside a `$(...)`
# subshell, where `exit` would only terminate the subshell and silently
# let the live path continue) — a QSD_FIXTURE_* variable left set in a
# shell profile, CI environment, or copied invocation that names a
# nonexistent path is a hard error before this script does anything
# else, never a silent fall-through to live (T-15-08).
for _qsd_fv in QSD_FIXTURE_BUSCTL_LIST QSD_FIXTURE_HYPRCTL_BINDS QSD_FIXTURE_LAYERS_JSON QSD_FIXTURE_SHORTCUTS_MANIFEST QSD_FIXTURE_KEYBINDS_LUA QSD_FIXTURE_HYPRCTL_GETOPTION QSD_FIXTURE_PERMISSIONS_LUA QSD_FIXTURE_OVERVIEW_STATUS; do
    _qsd_fv_val="${!_qsd_fv:-}"
    if [[ -n "$_qsd_fv_val" && ! -f "$_qsd_fv_val" ]]; then
        echo "FATAL: $_qsd_fv names a nonexistent file: $_qsd_fv_val" >&2
        exit 1
    fi
done
if [[ -n "${QSD_FIXTURE_PANEL_QML_DIR:-}" && ! -d "$QSD_FIXTURE_PANEL_QML_DIR" ]]; then
    echo "FATAL: QSD_FIXTURE_PANEL_QML_DIR names a nonexistent directory: $QSD_FIXTURE_PANEL_QML_DIR" >&2
    exit 1
fi
if [[ -n "${QSD_FIXTURE_OVERVIEW_QML_DIR:-}" && ! -d "$QSD_FIXTURE_OVERVIEW_QML_DIR" ]]; then
    echo "FATAL: QSD_FIXTURE_OVERVIEW_QML_DIR names a nonexistent directory: $QSD_FIXTURE_OVERVIEW_QML_DIR" >&2
    exit 1
fi
unset _qsd_fv _qsd_fv_val

# D-13 (12-CONTEXT.md, one-way): per-screen Quickshell surface fan-out was
# accepted as a permanent limitation after Phase 12's bounded re-attempt —
# a checked-in modules/qmldir (closing the FM1 scanner race) plus two
# structurally distinct Variants+per-screen-LazyLoader arrangements, one of
# them the escape-hatch spike — reproduced an FM2-class multi-screen
# surface-creation failure on quickshell 0.3.0-2 in both arrangements,
# re-proven across a real session restart. Full record: 12-QS03-EVIDENCE.md.
# This is deliberately a one-line guard, not a --qs03-accepted CLI switch:
# the acceptance is a property of this repo on this quickshell version, not
# a per-invocation choice a future run could silently flip. Flip it to 0 to
# get the real per-screen check back the moment a quickshell build exists
# on which the fan-out might work. Leaving the check permanently red
# instead was rejected (D-14): a gate everyone knows is red is a gate
# nobody reads, and its non-zero exit stops being a usable signal for the
# other 13 checks.
QS03_ACCEPTED_PERMANENT=1

# ── D-15-25 identity-model promotion (Phase 15 Plan 09's own
#    <assumption_delta_decision>, record-why in QS03_ACCEPTED_PERMANENT's
#    established voice) — record-why, not a per-invocation choice.
#
#    Before Phase 15 this file knew exactly one D-Bus identity noun,
#    OWNER, and asserted cardinality 1 on it (the single
#    org.freedesktop.Notifications check below, and the per-key handler
#    count check). Phase 15 introduced three participants that are
#    emphatically NOT owners: the audio/wifi/bluetooth panels are
#    unbounded CLIENTS of PipeWire, NetworkManager and BlueZ — D-15-24's
#    own reasoning already draws this line ("the panels are additional
#    consumers, not ownership claimants") but no instrument encoded it
#    before this plan.
#
#    So the primary noun is promoted to SERVICE PARTICIPANT, with two
#    demoted variants:
#      - name-owner:      cardinality exactly 1, ASSERTED, poison-provable.
#                          QSD_NAME_OWNERS below is this registry.
#      - client-consumer: cardinality N, NEVER asserted exclusive — the
#                          assertion is that no exclusivity assertion
#                          exists at all. QSD_CLIENT_CONSUMERS below is
#                          this registry.
#
#    A future editor MUST NOT assert cardinality 1 on anything in
#    QSD_CLIENT_CONSUMERS — PipeWire/NetworkManager/BlueZ are many-client
#    services by design, and a future check that "helpfully" asserts
#    exclusivity over one of them will fail the moment two legitimate
#    clients talk to it at once, which is that service's normal operating
#    mode. _qsd_assert_client_consumer_not_owned below is the structural
#    guard that makes this mistake fail the gate instead of shipping.
declare -A QSD_NAME_OWNERS=(
    ["org.freedesktop.Notifications"]="swaync"
)
declare -A QSD_CLIENT_CONSUMERS=(
    ["PipeWire"]="Phase 15's audio panel joins pw-play/pw-cli/wpctl and waybar's own pulseaudio module as an additional PipeWire client — never the sole one, so cardinality is never asserted"
    ["NetworkManager"]="Phase 15's wifi panel joins nm-applet/nmcli/nmtui as an additional NetworkManager client — never the sole one"
    ["BlueZ"]="Phase 15's bluetooth panel joins bluetoothctl/blueman-manager as an additional BlueZ client — never the sole one"
)
QSD_PANEL_NAMES=(audio wifi bluetooth)
QSD_PANEL_NAMESPACE_PREFIX="quickshell-"
QSD_PANEL_NAMESPACE_SUFFIX="-panel"

PASS=0
FAIL=0

check() {
    local desc="$1"
    local ok="$2"
    if [[ "$ok" == "0" ]]; then
        printf '  [PASS] %s\n' "$desc"
        PASS=$((PASS + 1))
    else
        printf '  [FAIL] %s\n' "$desc"
        FAIL=$((FAIL + 1))
    fi
}

# V5 input-validation control (matches keybind-doctor's own discipline,
# its comment at lines 69-71): every value parsed from the manifest is
# handled as display/comparison-only text. Before any manifest-derived
# appid/name reaches a `hyprctl dispatch` argv element, it is checked
# against this strict allowlist — never shell-command-interpreted, never
# passed through a constructed shell string (T-11-10).
_qsd_valid_token() {
    [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]]
}

# _qsd_dispatch_global — summon/dismiss a Quickshell GlobalShortcut.
#
# Phase 13.1 migrated the compositor to the Lua config manager, which
# parses a `hyprctl dispatch` argument as Lua source. The pre-migration
# bare form (`hyprctl dispatch global quickshell:probe`) is no longer a
# no-op-with-a-warning — it is a hard parse error:
#
#     hl.dispatch(global quickshell:probe)  ->  ')' expected near 'quickshell'
#
# Every call site here redirects to /dev/null, so the failure was silent:
# the headless-remove check could never pass (nothing was ever summoned,
# so the probe always read as absent), and the reserved-space check passed
# VACUOUSLY for the same reason. Same bug class as 13.1-09's `hyprctl
# keyword` finding, which that sweep fixed in gaming-mode-toggle.sh only.
#
# Callers MUST have already put the identifier through _qsd_valid_token,
# whose allowlist ([A-Za-z0-9_-]+ per segment) is what makes embedding it
# in a Lua double-quoted string safe — no quote or backslash can survive
# it, so there is no Lua-string escape to construct (T-11-10 still holds).
_qsd_dispatch_global() {
    hyprctl dispatch "hl.dsp.global(\"$1\")" >/dev/null 2>&1
}

# ── D-15-25 seam layer (T-15-08) — one function per observation source.
#    Each returns LIVE output when its QSD_FIXTURE_* variable is unset,
#    and the named fixture's content (or path) when it is set. Two
#    discipline rules, both load-bearing:
#      1. A seam variable naming a file/dir that does not exist is a HARD
#         ERROR, never a silent fall-through to live — a typo'd self-test
#         path must not quietly become a live run.
#      2. No seam is ever consulted on the live path: with no QSD_FIXTURE_*
#         variable set, every seam below performs zero fixture reads, and
#         --self-test (below) is the ONLY caller that ever sets one — and
#         it sets exactly one per replay, never two at once.
_qsd_busctl_list() {
    if [[ -n "${QSD_FIXTURE_BUSCTL_LIST:-}" ]]; then
        [[ -f "$QSD_FIXTURE_BUSCTL_LIST" ]] || { echo "FATAL: QSD_FIXTURE_BUSCTL_LIST names a nonexistent file: $QSD_FIXTURE_BUSCTL_LIST" >&2; exit 1; }
        cat -- "$QSD_FIXTURE_BUSCTL_LIST"
        return
    fi
    busctl --user list 2>/dev/null
}

_qsd_hyprctl_binds() {
    if [[ -n "${QSD_FIXTURE_HYPRCTL_BINDS:-}" ]]; then
        [[ -f "$QSD_FIXTURE_HYPRCTL_BINDS" ]] || { echo "FATAL: QSD_FIXTURE_HYPRCTL_BINDS names a nonexistent file: $QSD_FIXTURE_HYPRCTL_BINDS" >&2; exit 1; }
        cat -- "$QSD_FIXTURE_HYPRCTL_BINDS"
        return
    fi
    hyprctl binds 2>/dev/null
}

_qsd_layers_json() {
    if [[ -n "${QSD_FIXTURE_LAYERS_JSON:-}" ]]; then
        [[ -f "$QSD_FIXTURE_LAYERS_JSON" ]] || { echo "FATAL: QSD_FIXTURE_LAYERS_JSON names a nonexistent file: $QSD_FIXTURE_LAYERS_JSON" >&2; exit 1; }
        cat -- "$QSD_FIXTURE_LAYERS_JSON"
        return
    fi
    hyprctl layers -j 2>/dev/null
}

# Directory seam — the source-half scan target for panel-namespace-
# conformance. Live: the real dashboard modules directory. Fixture: a
# directory containing exactly the one panel-body fixture under test
# (--self-test isolates each fixture into its own temp dir, motion-lint's
# own per-fixture isolation pattern).
_qsd_panel_qml_dir() {
    if [[ -n "${QSD_FIXTURE_PANEL_QML_DIR:-}" ]]; then
        [[ -d "$QSD_FIXTURE_PANEL_QML_DIR" ]] || { echo "FATAL: QSD_FIXTURE_PANEL_QML_DIR names a nonexistent directory: $QSD_FIXTURE_PANEL_QML_DIR" >&2; exit 1; }
        printf '%s' "$QSD_FIXTURE_PANEL_QML_DIR"
        return
    fi
    printf '%s' "$QUICKSHELL_CONFIG_DIR/modules/dashboard"
}

# Path seams (not content — keybind-doctor and jq both want a file path,
# matching keybind-doctor's own documented two-argument hook).
_qsd_shortcuts_manifest_path() {
    if [[ -n "${QSD_FIXTURE_SHORTCUTS_MANIFEST:-}" ]]; then
        [[ -f "$QSD_FIXTURE_SHORTCUTS_MANIFEST" ]] || { echo "FATAL: QSD_FIXTURE_SHORTCUTS_MANIFEST names a nonexistent file: $QSD_FIXTURE_SHORTCUTS_MANIFEST" >&2; exit 1; }
        printf '%s' "$QSD_FIXTURE_SHORTCUTS_MANIFEST"
        return
    fi
    printf '%s' "$SHORTCUTS_MANIFEST"
}

_qsd_keybinds_lua_path() {
    if [[ -n "${QSD_FIXTURE_KEYBINDS_LUA:-}" ]]; then
        [[ -f "$QSD_FIXTURE_KEYBINDS_LUA" ]] || { echo "FATAL: QSD_FIXTURE_KEYBINDS_LUA names a nonexistent file: $QSD_FIXTURE_KEYBINDS_LUA" >&2; exit 1; }
        printf '%s' "$QSD_FIXTURE_KEYBINDS_LUA"
        return
    fi
    printf '%s' "$KEYBINDS_LUA"
}

# ── D-16-23 seam layer (T-15-08 discipline, extended) — four genuinely new
#    seams. The other three D-16-23 checks (overview namespace, Super+O
#    registration, reserved-array manifest coverage) reuse the D-15-25
#    seams already above — no new variable for those three.
_qsd_hyprctl_getoption_enforce() {
    if [[ -n "${QSD_FIXTURE_HYPRCTL_GETOPTION:-}" ]]; then
        [[ -f "$QSD_FIXTURE_HYPRCTL_GETOPTION" ]] || { echo "FATAL: QSD_FIXTURE_HYPRCTL_GETOPTION names a nonexistent file: $QSD_FIXTURE_HYPRCTL_GETOPTION" >&2; exit 1; }
        cat -- "$QSD_FIXTURE_HYPRCTL_GETOPTION"
        return
    fi
    hyprctl getoption ecosystem:enforce_permissions 2>/dev/null
}

_qsd_permissions_lua_path() {
    if [[ -n "${QSD_FIXTURE_PERMISSIONS_LUA:-}" ]]; then
        [[ -f "$QSD_FIXTURE_PERMISSIONS_LUA" ]] || { echo "FATAL: QSD_FIXTURE_PERMISSIONS_LUA names a nonexistent file: $QSD_FIXTURE_PERMISSIONS_LUA" >&2; exit 1; }
        printf '%s' "$QSD_FIXTURE_PERMISSIONS_LUA"
        return
    fi
    printf '%s' "$PERMISSIONS_LUA"
}

_qsd_overview_status() {
    if [[ -n "${QSD_FIXTURE_OVERVIEW_STATUS:-}" ]]; then
        [[ -f "$QSD_FIXTURE_OVERVIEW_STATUS" ]] || { echo "FATAL: QSD_FIXTURE_OVERVIEW_STATUS names a nonexistent file: $QSD_FIXTURE_OVERVIEW_STATUS" >&2; exit 1; }
        cat -- "$QSD_FIXTURE_OVERVIEW_STATUS"
        return
    fi
    qs ipc call overview status 2>/dev/null
}

_qsd_overview_qml_dir() {
    if [[ -n "${QSD_FIXTURE_OVERVIEW_QML_DIR:-}" ]]; then
        [[ -d "$QSD_FIXTURE_OVERVIEW_QML_DIR" ]] || { echo "FATAL: QSD_FIXTURE_OVERVIEW_QML_DIR names a nonexistent directory: $QSD_FIXTURE_OVERVIEW_QML_DIR" >&2; exit 1; }
        printf '%s' "$QSD_FIXTURE_OVERVIEW_QML_DIR"
        return
    fi
    printf '%s' "$QUICKSHELL_CONFIG_DIR/modules/overview"
}

# ── D-15-25 identity-model functions ────────────────────────────────────
# _qsd_name_owner_rows — the single reader for the name-owner variant.
# Filters _qsd_busctl_list's output to the named bus, emits matching rows.
_qsd_name_owner_rows() {
    local busname="$1"
    _qsd_busctl_list | grep -F -- "$busname" || true
}

# count+owner sample, "<count> <owner-or-none>" on one line — the shared
# helper panel-notifications-single-owner (Task 1 Part E) samples three
# times against, and the pre-existing single-owner check below refactors
# onto as well (verdict unchanged, model underneath it promoted).
_qsd_notif_sample() {
    local rows count owner
    rows=$(_qsd_name_owner_rows "org.freedesktop.Notifications")
    count=$(printf '%s\n' "$rows" | grep -c '.')
    owner=$(printf '%s\n' "$rows" | awk '{print $3}' | head -1)
    printf '%s %s' "$count" "${owner:-<none>}"
}

# _qsd_assert_client_consumer_not_owned — the structural guard that makes
# the promotion load-bearing rather than decorative: the two registries
# must stay disjoint. Reports through check() as an ordinary gate line.
_qsd_assert_client_consumer_not_owned() {
    local bad=0 key
    for key in "${!QSD_CLIENT_CONSUMERS[@]}"; do
        if [[ -n "${QSD_NAME_OWNERS[$key]+x}" ]]; then
            bad=$((bad + 1))
        fi
    done
    check "service-participant model (D-15-25 promotion): no client-consumer registry key is also a name-owner registry key — asserting exclusivity over a many-client service is exactly the mistake this guard exists to catch (collisions: ${bad})" "$([[ "$bad" -eq 0 ]] && echo 0 || echo 1)"
}

# ── D-15-25 shared data — the ten XF86 keys, hoisted so both the
#    pre-existing check 8 (unchanged, own invocation, own verdict) and the
#    new _qsd_xf86_ownership_table below read the same literal list rather
#    than each maintaining its own copy.
XF86_KEYS=(XF86AudioRaiseVolume XF86AudioLowerVolume XF86AudioMute XF86AudioMicMute XF86MonBrightnessUp XF86MonBrightnessDown XF86AudioNext XF86AudioPause XF86AudioPlay XF86AudioPrev)

# _qsd_xf86_ownership_table — one deterministic, newline-free string of
# key=count pairs in XF86_KEYS' fixed order, reading binds through
# _qsd_hyprctl_binds and the manifest through its seam. Factored out of
# check 8's own per-key computation (which keeps its own direct
# invocation and its own verdict below — this function is a second
# reader of the same logic, not a replacement).
_qsd_xf86_ownership_table() {
    local binds_raw manifest out="" xk hypr_count manifest_count total
    binds_raw=$(_qsd_hyprctl_binds)
    manifest=$(_qsd_shortcuts_manifest_path)
    for xk in "${XF86_KEYS[@]}"; do
        hypr_count=$(printf '%s\n' "$binds_raw" | grep -c "	key: ${xk}\$")
        manifest_count=0
        if [[ -f "$manifest" ]] && command -v jq >/dev/null 2>&1; then
            manifest_count=$(jq -r --arg k "$xk" '[.[] | select(.chord.key == $k)] | length' "$manifest" 2>/dev/null)
            [[ -z "$manifest_count" ]] && manifest_count=0
        fi
        total=$((hypr_count + manifest_count))
        out="${out}${xk}=${total}${US}"
    done
    printf '%s' "$out"
}

# _qsd_swayosd_server_reachable — succeeds only when the OSD server is
# actually answering on the session bus (name-owned, not merely that
# swayosd-client is on PATH — the exact guard gap measured at planning
# time: a dead server produced "measured delta=0 ... drift: 3277", a
# failure blamed on tolerance rather than on the absent instrument).
# Read-only: lists the bus, never round-trips a method call, so this
# guard itself performs no mutation.
_qsd_swayosd_server_reachable() {
    command -v busctl >/dev/null 2>&1 || return 1
    _qsd_busctl_list | grep -q 'org\.erikreider\.swayosd-server'
}

# _qsd_osd_activation_count — counts OSD-pill activations (namespace
# "swayosd", confirmed live 2026-08-02 by polling `hyprctl layers -j`
# every 50ms across a real swayosd-client raise with the server running:
# a 258x96 layer at level 3 owned by the swayosd-server PID, namespace
# literally "swayosd") across the window the given action command runs
# in. Counts rising edges (absent -> present transitions), which is a
# truer "activation count" than a bare presence flag when the pill can
# blink more than once.
_qsd_osd_activation_count() {
    local action="$1" i hit prev=0 transitions=0
    ( eval "$action" ) &
    local action_pid=$!
    for i in $(seq 1 24); do
        hit=0
        if _qsd_layers_json 2>/dev/null | jq -e '[.[]?.levels?["3"]?[]? | select(.namespace=="swayosd")] | length > 0' >/dev/null 2>&1; then
            hit=1
        fi
        [[ "$hit" -eq 1 && "$prev" -eq 0 ]] && transitions=$((transitions + 1))
        prev=$hit
        sleep 0.05
    done
    wait "$action_pid" 2>/dev/null
    printf '%s' "$transitions"
}

# ── D-15-25 summon/dismiss — drives 15-03's IPC contract
#    (`qs ipc call panel open|toggle <name>`, confirmed live this session:
#    `qs list` shows exactly one Instance, `qs ipc call panel open wifi`
#    mounts `quickshell-wifi-panel` at level 3 within one second, owned by
#    the shell's own PID) with the same V5 validation _qsd_dispatch_global
#    already applies. PANEL_SUMMONED_NAME is set immediately before the
#    summon and cleared immediately after the dismiss; the cleanup trap
#    (T-11-11 discipline, extended below) dismisses a still-summoned panel
#    on interrupt so a mid-cycle Ctrl-C can never strand a panel mounted
#    on the user's screen.
_qsd_summon_panel() {
    local name="$1"
    _qsd_valid_token "$name" || return 1
    command -v qs >/dev/null 2>&1 || return 1
    PANEL_SUMMONED_NAME="$name"
    qs ipc call panel open "$name" >/dev/null 2>&1
}

_qsd_dismiss_panel() {
    local name="$1"
    _qsd_valid_token "$name" || return 1
    command -v qs >/dev/null 2>&1 || return 1
    qs ipc call panel toggle "$name" >/dev/null 2>&1
    PANEL_SUMMONED_NAME=""
}

# ── D-15-25 panel-namespace-conformance helpers ─────────────────────────
# Emits level<TAB>namespace<TAB>pid for every layer whose namespace is
# panel-shaped (quickshell-<word>-panel), at ANY level — deliberately
# broad so an off-level or unknown-namespace poison is still captured,
# not filtered out before the assertion below ever sees it.
_qsd_panel_layer_rows() {
    printf '%s' "$1" | jq -r '
        .[]? | .levels? // {} | to_entries[] | .key as $lvl | .value[]?
        | select(.namespace | test("^quickshell-[a-z]+-panel$"))
        | [$lvl, .namespace, .pid] | @tsv
    ' 2>/dev/null
}

# Asserts a layers_json snapshot carries exactly expected_count
# panel-shaped namespaces, all at level 3, all owned by a shell PID, all
# named within QSD_PANEL_NAMES's derived set, and (when expected_ns is
# given and expected_count is 1) that the one surviving namespace is
# expected_ns. Prints a one-line "count=.. off-level=.. wrong-pid=..
# unknown-ns=.." report and returns 0/1.
#
# T-16-SELFTEST (Rule 3, found and fixed live while executing Phase 16
# Plan 04's own D-16-23 checks — a genuine pre-existing bug, not caused by
# this plan's changes, but one that blocked this plan's own --self-test
# exit-0 acceptance criterion, so it is fixed here rather than only
# logged): the 4th parameter is an OPTIONAL explicit shell-pid override.
# Live call sites (below) never pass it, so behaviour there is unchanged —
# real live pgrep output. --self-test's own replay (further down) now
# passes the fixed pid baked into all four compliant/poisoned
# *-panel-layers.json fixtures (2982672) instead of comparing against
# whatever quickshell process happens to be running when --self-test
# executes, which is what made the compliant fixture spuriously report
# wrong-pid=1 and FAIL self-test on every host except the one it was
# captured on.
_qsd_assert_panel_layers() {
    local json="$1" expected_count="$2" expected_ns="${3:-}" shell_pids_override="${4:-}"
    local lvl ns pid total=0 off_level=0 wrong_pid=0 unknown_ns=0 last_ns=""
    local shell_pids
    if [[ -n "$shell_pids_override" ]]; then
        shell_pids=" $shell_pids_override "
    else
        shell_pids=" $(pgrep -f 'quickshell -p' | tr '\n' ' ') "
    fi
    while IFS=$'\t' read -r lvl ns pid; do
        [[ -z "$lvl" ]] && continue
        total=$((total + 1))
        last_ns="$ns"
        [[ "$lvl" != "3" ]] && off_level=$((off_level + 1))
        case "$shell_pids" in
            *" $pid "*) ;;
            *) wrong_pid=$((wrong_pid + 1)) ;;
        esac
        local known=0 pn
        for pn in "${QSD_PANEL_NAMES[@]}"; do
            [[ "$ns" == "${QSD_PANEL_NAMESPACE_PREFIX}${pn}${QSD_PANEL_NAMESPACE_SUFFIX}" ]] && known=1
        done
        [[ "$known" -eq 0 ]] && unknown_ns=$((unknown_ns + 1))
    done < <(_qsd_panel_layer_rows "$json")
    local ns_ok=1
    [[ -n "$expected_ns" && "$total" -eq 1 && "$last_ns" != "$expected_ns" ]] && ns_ok=0
    printf 'count=%s off-level=%s wrong-pid=%s unknown-ns=%s' "$total" "$off_level" "$wrong_pid" "$unknown_ns"
    [[ "$total" -eq "$expected_count" && "$off_level" -eq 0 && "$wrong_pid" -eq 0 && "$unknown_ns" -eq 0 && "$ns_ok" -eq 1 ]]
}

# Source half — no file under the panel QML directory (excluding
# PanelDialog.qml itself, which legitimately owns WlrLayershell.namespace
# as the shared frame) may set the layer namespace directly. Comments
# stripped first (qml `//`) so a header note restating the fence is safe.
_qsd_assert_panel_source() {
    local dir="$1" f bad=0
    while IFS= read -r f; do
        [[ "$(basename -- "$f")" == "PanelDialog.qml" ]] && continue
        if grep -vE '^\s*//' -- "$f" 2>/dev/null | grep -q 'WlrLayershell\.namespace'; then
            bad=$((bad + 1))
        fi
    done < <(find -L "$dir" -maxdepth 1 -type f -name '*.qml' 2>/dev/null)
    printf 'bad=%s' "$bad"
    [[ "$bad" -eq 0 ]]
}

# ── 17-03 Task 4 (standing constraint #4) — mpvpaper layer-coexistence
#    helpers. AMB-01's live wallpaper is not a Quickshell surface, but it
#    shares the same layer-shell surface it must never collide with —
#    this file's coexistence remit already covers exactly this kind of
#    cross-process claim (see the D-15-25 panel helpers above). Emits
#    level<TAB>namespace<TAB>pid for every layer whose namespace is
#    EXACTLY the literal "mpvpaper" (RESEARCH.md §7: the namespace is a
#    fixed literal set unconditionally in mpvpaper's create_output(),
#    src/main.c:932-933 — never per-monitor, never derived from a flag),
#    at ANY level — deliberately broad so an off-level poison is captured
#    by the assertion below rather than filtered out before it is judged.
_qsd_mpvpaper_layer_rows() {
    printf '%s' "$1" | jq -r '
        .[]? | .levels? // {} | to_entries[] | .key as $lvl | .value[]?
        | select(.namespace == "mpvpaper")
        | [$lvl, .namespace, .pid] | @tsv
    ' 2>/dev/null
}

# Asserts a layers_json snapshot carries every mpvpaper-namespaced surface
# at level 0 (background) and owned by a PID in the supplied mpvpaper PID
# set. Prints a one-line "count=.. off-level=.. wrong-pid=.." report and
# returns 0/1. The PID set is an EXPLICIT parameter, never a live `pgrep`
# inside this function — same T-16-SELFTEST discipline
# _qsd_assert_panel_layers already established: a committed fixture must
# replay identically on any host, not only the one it was captured on.
_qsd_assert_mpvpaper_layers() {
    local json="$1" mpvpaper_pids="$2"
    local lvl ns pid total=0 off_level=0 wrong_pid=0
    local pid_set=" $mpvpaper_pids "
    while IFS=$'\t' read -r lvl ns pid; do
        [[ -z "$lvl" ]] && continue
        total=$((total + 1))
        [[ "$lvl" != "0" ]] && off_level=$((off_level + 1))
        case "$pid_set" in
            *" $pid "*) ;;
            *) wrong_pid=$((wrong_pid + 1)) ;;
        esac
    done < <(_qsd_mpvpaper_layer_rows "$json")
    printf 'count=%s off-level=%s wrong-pid=%s' "$total" "$off_level" "$wrong_pid"
    [[ "$off_level" -eq 0 && "$wrong_pid" -eq 0 ]]
}

# ── D-15-25 check bodies — called once each, after check 9, before the
#    volume probe (see run-order comment at that call site). Defined here
#    (before the trap/checks 1-12 flow) so --self-test, which dispatches
#    before the trap is even installed, can call them directly.
_qsd_check_panel_namespace_conformance() {
    if [[ "$NO_PANEL_CHECKS" -eq 1 ]]; then
        echo "  [SKIP] panel-namespace-conformance (D-15-25): disabled by --no-panel-checks"
        return
    fi
    if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1 || ! command -v qs >/dev/null 2>&1; then
        echo "  [SKIP] panel-namespace-conformance (D-15-25): hyprctl, jq or qs not found"
        return
    fi
    local overall_bad=0 report="" res rc name expected

    res=$(_qsd_assert_panel_layers "$(_qsd_layers_json)" 0); rc=$?
    [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
    report+="pre[${res}] "

    for name in "${QSD_PANEL_NAMES[@]}"; do
        expected="${QSD_PANEL_NAMESPACE_PREFIX}${name}${QSD_PANEL_NAMESPACE_SUFFIX}"
        _qsd_summon_panel "$name"
        sleep 0.4
        res=$(_qsd_assert_panel_layers "$(_qsd_layers_json)" 1 "$expected"); rc=$?
        [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
        report+="${name}-during[${res}] "
        _qsd_dismiss_panel "$name"
        sleep 0.3
        res=$(_qsd_assert_panel_layers "$(_qsd_layers_json)" 0); rc=$?
        [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
        report+="${name}-after[${res}] "
    done

    # Cross-panel case — the mechanical closure of 15-03's at-most-one-
    # panel edge truth: summon the first name, summon the second WITHOUT
    # dismissing the first (openPanel()'s own closeAllPanels() call is
    # what should tear the first one down — this proves that, it does not
    # simulate it).
    local first="${QSD_PANEL_NAMES[0]}" second="${QSD_PANEL_NAMES[1]}"
    local expected2="${QSD_PANEL_NAMESPACE_PREFIX}${second}${QSD_PANEL_NAMESPACE_SUFFIX}"
    _qsd_summon_panel "$first"
    sleep 0.3
    _qsd_summon_panel "$second"
    sleep 0.4
    res=$(_qsd_assert_panel_layers "$(_qsd_layers_json)" 1 "$expected2"); rc=$?
    [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
    report+="cross[${res}] "
    _qsd_dismiss_panel "$second"
    sleep 0.3
    res=$(_qsd_assert_panel_layers "$(_qsd_layers_json)" 0); rc=$?
    [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
    report+="cross-after[${res}] "

    res=$(_qsd_assert_panel_source "$(_qsd_panel_qml_dir)"); rc=$?
    [[ "$rc" -ne 0 ]] && overall_bad=$((overall_bad + 1))
    report+="source[${res}]"

    check "panel-namespace-conformance (D-15-25/D-21/PANEL-06, mechanically closes 15-03's at-most-one-panel / zero-when-none / last-writer-wins edge truths): ${report}" "$([[ "$overall_bad" -eq 0 ]] && echo 0 || echo 1)"
}

_qsd_check_panel_shortcut_single_registration() {
    if [[ "$NO_PANEL_CHECKS" -eq 1 ]]; then
        echo "  [SKIP] panel-shortcut-single-registration (D-15-25): disabled by --no-panel-checks"
        return
    fi
    if ! command -v jq >/dev/null 2>&1 || ! command -v hyprctl >/dev/null 2>&1; then
        echo "  [SKIP] panel-shortcut-single-registration (D-15-25): jq or hyprctl not found"
        return
    fi
    local manifest keybinds kbd_out kbd_rc manifest_count=0 global_count=0 bind_count=0
    manifest=$(_qsd_shortcuts_manifest_path)
    keybinds=$(_qsd_keybinds_lua_path)
    if [[ -x "$KEYBIND_DOCTOR" ]]; then
        kbd_out=$("$KEYBIND_DOCTOR" "$keybinds" "$manifest" 2>&1)
        kbd_rc=$?
    else
        kbd_out="keybind-doctor not found or not executable at $KEYBIND_DOCTOR"
        kbd_rc=1
    fi
    if [[ -f "$manifest" ]]; then
        manifest_count=$(jq -r '[.[] | select(.name=="audio-panel")] | length' "$manifest" 2>/dev/null)
        [[ -z "$manifest_count" ]] && manifest_count=0
    fi
    global_count=$(hyprctl globalshortcuts 2>/dev/null | grep -c '^quickshell:audio-panel ->')
    if [[ -f "$keybinds" ]]; then
        bind_count=$(grep -vE '^\s*--' -- "$keybinds" | grep -c 'hl\.dsp\.global("quickshell:audio-panel")')
    fi
    local ok=0
    [[ "$manifest_count" -eq 1 && "$global_count" -eq 1 && "$bind_count" -eq 1 && "$kbd_rc" -eq 0 ]] || ok=1
    check "panel-shortcut-single-registration (D-15-04/MAINT-01, delegates to keybind-doctor): audio-panel registered manifest=${manifest_count} globalshortcuts=${global_count} hyprland-binds=${bind_count} times (all must be 1), keybind-doctor exit=${kbd_rc}" "$ok"
    if [[ "$kbd_rc" -ne 0 ]]; then
        printf '%s\n' "$kbd_out" | tail -8 | sed 's/^/    /' >&2
    fi
}

_qsd_check_panel_notifications_single_owner() {
    if [[ "$NO_PANEL_CHECKS" -eq 1 ]]; then
        echo "  [SKIP] panel-notifications-single-owner (D-15-25): disabled by --no-panel-checks"
        return
    fi
    if ! command -v busctl >/dev/null 2>&1 || ! command -v qs >/dev/null 2>&1; then
        echo "  [SKIP] panel-notifications-single-owner (D-15-25): busctl or qs not found"
        return
    fi
    local bad=0 report="" count owner expected="${QSD_NAME_OWNERS[org.freedesktop.Notifications]}" name

    read -r count owner <<<"$(_qsd_notif_sample)"
    report+="pre(count=${count},owner=${owner}) "
    [[ "$count" -eq 1 && "$owner" == "$expected" ]] || bad=$((bad + 1))

    for name in "${QSD_PANEL_NAMES[@]}"; do
        _qsd_summon_panel "$name"
        sleep 0.3
        read -r count owner <<<"$(_qsd_notif_sample)"
        report+="${name}(count=${count},owner=${owner}) "
        [[ "$count" -eq 1 && "$owner" == "$expected" ]] || bad=$((bad + 1))
        _qsd_dismiss_panel "$name"
        sleep 0.2
    done

    read -r count owner <<<"$(_qsd_notif_sample)"
    report+="post(count=${count},owner=${owner})"
    [[ "$count" -eq 1 && "$owner" == "$expected" ]] || bad=$((bad + 1))

    check "panel-notifications-single-owner (T-15-03, existing check invoked in the summoned context — no new mechanism): ${report}" "$([[ "$bad" -eq 0 ]] && echo 0 || echo 1)"
}

_qsd_check_panel_swayosd_key_ownership() {
    if [[ "$NO_PANEL_CHECKS" -eq 1 ]]; then
        echo "  [SKIP] panel-swayosd-key-ownership (D-15-25): disabled by --no-panel-checks"
        return
    fi
    if ! command -v hyprctl >/dev/null 2>&1 || ! command -v qs >/dev/null 2>&1; then
        echo "  [SKIP] panel-swayosd-key-ownership (D-15-25): hyprctl or qs not found"
        return
    fi
    if ! _qsd_swayosd_server_reachable; then
        echo "  [SKIP] panel-swayosd-key-ownership (D-15-24): SwayOSD server unreachable (org.erikreider.swayosd-server not on the session bus) — never a [FAIL] blaming the ownership table for a dead instrument"
        return
    fi

    local bad=0 report="" pre during after name

    pre=$(_qsd_xf86_ownership_table)
    if printf '%s' "$pre" | grep -qE '=[02-9][0-9]*'"${US}"'|=0'"${US}"; then :; fi
    for name in "${QSD_PANEL_NAMES[@]}"; do
        _qsd_summon_panel "$name"
        sleep 0.3
        during=$(_qsd_xf86_ownership_table)
        [[ "$during" != "$pre" ]] && bad=$((bad + 1))
        _qsd_dismiss_panel "$name"
        sleep 0.2
    done
    after=$(_qsd_xf86_ownership_table)
    [[ "$after" != "$pre" ]] && bad=$((bad + 1))

    local not_one=0 pair k v
    IFS="$US" read -ra pairs <<<"$pre"
    for pair in "${pairs[@]}"; do
        [[ -z "$pair" ]] && continue
        v="${pair##*=}"
        [[ "$v" != "1" ]] && not_one=$((not_one + 1))
    done
    [[ "$not_one" -ne 0 ]] && bad=$((bad + 1))
    report+="table-byte-identical=$([[ "$bad" -eq 0 ]] && echo yes || echo no) not-exactly-one-count=${not_one} "

    # Differential OSD proof — arm the volume restore trap BEFORE either
    # write, extending the existing T-11-11 trap rather than adding a
    # second one (VOL_RESTORE_NEEDED/VOL_ORIG_RAW are declared below,
    # ahead of this check's own call site).
    local zero_count=0 one_count=0
    if command -v pactl >/dev/null 2>&1 && pactl get-sink-volume @DEFAULT_SINK@ >/dev/null 2>&1; then
        local orig_line
        orig_line=$(pactl get-sink-volume @DEFAULT_SINK@)
        mapfile -t VOL_ORIG_RAW < <(printf '%s' "$orig_line" | grep -oP '(?<=: )\d+(?=\s*/)')
        if [[ "${#VOL_ORIG_RAW[@]}" -gt 0 ]]; then
            VOL_RESTORE_NEEDED=1
            # (i) direct PipeWire-node write — the same class of write the
            # audio panel's backend performs, no OSD client in the path.
            zero_count=$(_qsd_osd_activation_count "pactl set-sink-volume @DEFAULT_SINK@ +1%")
            # (ii) the hardware-key path, exactly as the compositor bind
            # invokes it (keybinds.lua: swayosd-client --output-volume raise).
            one_count=$(_qsd_osd_activation_count "swayosd-client --output-volume raise")
            pactl set-sink-volume @DEFAULT_SINK@ "${VOL_ORIG_RAW[@]}" >/dev/null 2>&1
        fi
    fi
    [[ "$zero_count" -ne 0 || "$one_count" -ne 1 ]] && bad=$((bad + 1))
    report+="osd-differential(pipewire-write=${zero_count},hw-key=${one_count},instrument=layer-namespace:swayosd) "

    local src_bad=0
    src_bad=$(grep -rlE 'swayosd-client' -- "$(_qsd_panel_qml_dir)" 2>/dev/null | grep -c '.')
    [[ "$src_bad" -ne 0 ]] && bad=$((bad + 1))
    report+="source-holds-by-construction(swayosd-client-refs=${src_bad})"

    check "panel-swayosd-key-ownership (D-15-24, proven differentially): ${report}" "$([[ "$bad" -eq 0 ]] && echo 0 || echo 1)"
}

# ── D-16-23 (Phase 16 Plan 04) check bodies — seven checks closing the two
#    risks this phase's ROADMAP entry owns: the permission silent-revert
#    (checks 4/5) and the blank-tile failure (check 6), plus three more
#    (checks 1/2/3 reuse-and-extend existing coexistence checks) and one
#    deliberate addition beyond D-16-23's own six (check 7, the
#    assumption-delta promotion recorded in 16-04-PLAN.md). Defined here —
#    after the D-15-25 panel checks, before --self-test — so --self-test
#    can call the pure assertion helpers directly without ever touching
#    the trap/mutating groups below.

# ── check 1: overview-namespace-conformance ─────────────────────────────
# Distinct from check 4 (namespace discipline, family-wide): that check
# asserts the ^quickshell-.* family rule; this one names quickshell-overview
# specifically and its own second-claimant condition. shell_pids is an
# explicit parameter (never live pgrep inside the assertion itself) so a
# --self-test replay's verdict never depends on which quickshell process
# happens to be running when the fixture was authored vs. when it is
# replayed — the live call site below passes real pgrep output; --self-test
# passes a fixed sentinel that matches (or deliberately does not match)
# each fixture's own baked-in pid.
_qsd_overview_namespace_rows() {
    printf '%s' "$1" | jq -r '
        .[]? | .levels? // {} | to_entries[] | .key as $lvl | .value[]?
        | select(.namespace == "quickshell-overview")
        | [$lvl, .namespace, .pid] | @tsv
    ' 2>/dev/null
}

_qsd_assert_overview_namespace() {
    local json="$1" shell_pids="$2"
    local lvl ns pid count=0 off_level=0 wrong_pid=0
    while IFS=$'\t' read -r lvl ns pid; do
        [[ -z "$lvl" ]] && continue
        count=$((count + 1))
        [[ "$lvl" != "3" ]] && off_level=$((off_level + 1))
        case " $shell_pids " in
            *" $pid "*) ;;
            *) wrong_pid=$((wrong_pid + 1)) ;;
        esac
    done < <(_qsd_overview_namespace_rows "$json")
    printf 'count=%s off-level=%s wrong-pid=%s' "$count" "$off_level" "$wrong_pid"
    [[ "$count" -le 1 && "$off_level" -eq 0 && "$wrong_pid" -eq 0 ]]
}

_qsd_check_overview_namespace_conformance() {
    if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
        echo "  [SKIP] overview-namespace-conformance (D-16-23 check 1): hyprctl or jq not found"
        return
    fi
    local shell_pids res rc
    shell_pids="$(pgrep -f 'quickshell -p' | tr '\n' ' ')"
    res=$(_qsd_assert_overview_namespace "$(_qsd_layers_json)" "$shell_pids"); rc=$?
    check "overview-namespace-conformance (D-16-23 check 1, names quickshell-overview specifically — distinct from the family-wide namespace discipline check above): ${res}" "$rc"
}

# ── 17-03 Task 4 (standing constraint #4) — the mpvpaper live-wallpaper
#    layer-coexistence gate. Report-only by construction: reads layers
#    through the _qsd_layers_json seam and `pgrep`, summons nothing,
#    mutates nothing, starts/stops no process.
_qsd_check_mpvpaper_layer_coexistence() {
    if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
        echo "  [SKIP] mpvpaper-layer-coexistence (17-03 Task 4): hyprctl or jq not found"
        return
    fi
    local json mpvpaper_pids surface_count res rc
    json="$(_qsd_layers_json)"
    mpvpaper_pids="$(pgrep -x mpvpaper 2>/dev/null | tr '\n' ' ')"
    surface_count=$(_qsd_mpvpaper_layer_rows "$json" | grep -c . || true)
    surface_count=${surface_count:-0}

    # Common healthy case: a still-only desktop. Must never be a [FAIL] —
    # this file's own header (lines 40-46) records what a gate that fires
    # on a healthy desktop already cost this project once.
    if [[ -z "$mpvpaper_pids" && "$surface_count" -eq 0 ]]; then
        echo "  [SKIP] mpvpaper-layer-coexistence (17-03 Task 4): no live wallpaper is currently selected"
        return
    fi

    res=$(_qsd_assert_mpvpaper_layers "$json" "$mpvpaper_pids"); rc=$?
    # A player alive with NO layer surface at all is a real failure (a
    # broken launch) — the assert above alone cannot detect this, since
    # zero rows trivially satisfies "no off-level, no wrong-pid". The
    # inverse (a stale surface with no live process) IS already caught by
    # the assert's wrong-pid count, since an empty pid set matches no row.
    if [[ -n "$mpvpaper_pids" && "$surface_count" -eq 0 ]]; then
        rc=1
    fi

    # Coexistence, not just presence: no quickshell- namespaced layer may
    # sit at level 0 (the background level this check asserts mpvpaper
    # owns), and mpvpaper's own namespace must never appear at level 3
    # (the shell's overlay level) — folded into the same report line so
    # one line names everything examined.
    local qs_at_bg mpv_at_overlay
    qs_at_bg=$(printf '%s' "$json" | jq -r '
        [.[]? | .levels? // {} | (.["0"] // [])[] | select(.namespace | startswith("quickshell-"))] | length
    ' 2>/dev/null)
    qs_at_bg=${qs_at_bg:-0}
    mpv_at_overlay=$(printf '%s' "$json" | jq -r '
        [.[]? | .levels? // {} | (.["3"] // [])[] | select(.namespace == "mpvpaper")] | length
    ' 2>/dev/null)
    mpv_at_overlay=${mpv_at_overlay:-0}
    [[ "$qs_at_bg" != "0" || "$mpv_at_overlay" != "0" ]] && rc=1

    check "mpvpaper-layer-coexistence (17-03 Task 4, standing constraint #4): the live-wallpaper layer surface sits on the background level under an mpvpaper-owned PID and never collides with a quickshell- surface at that level nor appears itself at the shell's overlay level 3 (${res}, quickshell-at-bg=${qs_at_bg}, mpvpaper-at-overlay=${mpv_at_overlay})" "$rc"
}

# ── check 2: overview-shortcut-single-registration ──────────────────────
# Delegates to keybind-doctor (MAINT-01's own bind-collision proof) and
# additionally asserts hyprctl globalshortcuts carries quickshell:overview
# exactly once — a second registration is the exact collision class
# MAINT-01's detector exists for, and Phases 14 and 16 each added a chord.
_qsd_check_overview_shortcut_single_registration() {
    if ! command -v jq >/dev/null 2>&1 || ! command -v hyprctl >/dev/null 2>&1; then
        echo "  [SKIP] overview-shortcut-single-registration (D-16-23 check 2): jq or hyprctl not found"
        return
    fi
    local manifest keybinds kbd_out kbd_rc manifest_count=0 global_count=0
    manifest=$(_qsd_shortcuts_manifest_path)
    keybinds=$(_qsd_keybinds_lua_path)
    if [[ -x "$KEYBIND_DOCTOR" ]]; then
        kbd_out=$("$KEYBIND_DOCTOR" "$keybinds" "$manifest" 2>&1)
        kbd_rc=$?
    else
        kbd_out="keybind-doctor not found or not executable at $KEYBIND_DOCTOR"
        kbd_rc=1
    fi
    if [[ -f "$manifest" ]]; then
        manifest_count=$(jq -r '[.[] | select(.name=="overview")] | length' "$manifest" 2>/dev/null)
        [[ -z "$manifest_count" ]] && manifest_count=0
    fi
    global_count=$(hyprctl globalshortcuts 2>/dev/null | grep -c '^quickshell:overview ->')
    local ok=0
    [[ "$manifest_count" -eq 1 && "$global_count" -eq 1 && "$kbd_rc" -eq 0 ]] || ok=1
    check "overview-shortcut-single-registration (D-16-23 check 2, MAINT-01/keybind-doctor delegate): overview registered manifest=${manifest_count} globalshortcuts=${global_count} times (both must be 1), keybind-doctor exit=${kbd_rc}" "$ok"
    if [[ "$kbd_rc" -ne 0 ]]; then
        printf '%s\n' "$kbd_out" | tail -8 | sed 's/^/    /' >&2
    fi
}

# ── check 3: reserved-array-manifest-coverage ───────────────────────────
# The existing reserved-space summon-and-diff (check 5, above) already
# iterates every shortcuts.json entry, so the overview's fifth manifest
# entry is already in scope. This is the explicit structural guard that a
# future manifest entry cannot silently fall out of that iteration: every
# entry must pass the same _qsd_valid_token allowlist the live summon-and-
# diff loop itself gates on before dispatching. Non-invasive (parses the
# manifest only, no summon), so it runs unconditionally, not gated behind
# --no-summon.
_qsd_assert_manifest_coverage() {
    local manifest="$1"
    local total valid=0 m_appid m_name
    total=$(jq -r 'length' "$manifest" 2>/dev/null)
    [[ -z "$total" || "$total" == "null" ]] && total=0
    while IFS="$US" read -r m_appid m_name; do
        [[ -z "$m_appid" && -z "$m_name" ]] && continue
        if _qsd_valid_token "$m_appid" && _qsd_valid_token "$m_name"; then
            valid=$((valid + 1))
        fi
    done < <(jq -r --arg us "$US" '.[] | [(.appid // ""), (.name // "")] | join($us)' "$manifest" 2>/dev/null)
    printf 'manifest-entries=%s validated=%s' "$total" "$valid"
    [[ "$total" -gt 0 && "$valid" -eq "$total" ]]
}

_qsd_check_reserved_array_manifest_coverage() {
    if ! command -v jq >/dev/null 2>&1; then
        echo "  [SKIP] reserved-array-manifest-coverage (D-16-23 check 3): jq not found"
        return
    fi
    local manifest res rc
    manifest=$(_qsd_shortcuts_manifest_path)
    if [[ ! -f "$manifest" ]]; then
        echo "  [SKIP] reserved-array-manifest-coverage (D-16-23 check 3): manifest not found ($manifest)"
        return
    fi
    res=$(_qsd_assert_manifest_coverage "$manifest"); rc=$?
    check "reserved-array-manifest-coverage (D-16-23 check 3, extends check 5's summon-and-diff): every manifest entry passes the same _qsd_valid_token allowlist check 5's dispatch loop gates on, so none can silently fall out of the diff — ${res}" "$rc"
}

# ── check 4: permissions-enforce-readback ───────────────────────────────
# Guards D-16-09 against silent revert. ecosystem:enforce_permissions is
# read ONCE at compositor startup and its failure mode is silence — reading
# permissions.lua's own text is not evidence of anything at runtime, only
# this readback is.
_qsd_assert_enforce_permissions() {
    printf '%s' "$1" | grep -qE '^bool:[[:space:]]*true[[:space:]]*$'
}

_qsd_check_permissions_enforce_readback() {
    if ! command -v hyprctl >/dev/null 2>&1; then
        echo "  [SKIP] permissions-enforce-readback (D-16-23 check 4): hyprctl not found"
        return
    fi
    local raw rc
    raw=$(_qsd_hyprctl_getoption_enforce)
    _qsd_assert_enforce_permissions "$raw"
    rc=$?
    check "permissions-enforce-readback (D-16-23 check 4, guards D-16-09 against silent revert): hyprctl getoption ecosystem:enforce_permissions reports true at runtime (raw: $(printf '%s' "$raw" | tr '\n' ' '))" "$rc"
}

# ── check 5: permissions-allowlist-paths-resolve ────────────────────────
# A package update moving grim or the portal binary breaks screenshots
# under enforcement with no warning until a key is pressed. Also
# mechanically asserts the T-11-20 discipline (no glob/alternation
# metacharacter in any grant) rather than trusting it to review.
_qsd_assert_permissions_allowlist() {
    local file="$1" p total=0 missing=0 nonexec=0 pattern=0
    while IFS= read -r p; do
        [[ -z "$p" ]] && continue
        total=$((total + 1))
        case "$p" in
            *['*?[|']*) pattern=$((pattern + 1)) ;;
        esac
        if [[ ! -e "$p" ]]; then
            missing=$((missing + 1))
        elif [[ ! -x "$p" ]]; then
            nonexec=$((nonexec + 1))
        fi
    done < <(grep -oP 'binary\s*=\s*"\K[^"]+' -- "$file" 2>/dev/null)
    printf 'grants=%s missing=%s non-executable=%s pattern=%s' "$total" "$missing" "$nonexec" "$pattern"
    [[ "$total" -gt 0 && "$missing" -eq 0 && "$nonexec" -eq 0 && "$pattern" -eq 0 ]]
}

_qsd_check_permissions_allowlist_paths_resolve() {
    local file res rc
    file=$(_qsd_permissions_lua_path)
    if [[ ! -f "$file" ]]; then
        echo "  [SKIP] permissions-allowlist-paths-resolve (D-16-23 check 5): $file not found"
        return
    fi
    res=$(_qsd_assert_permissions_allowlist "$file"); rc=$?
    check "permissions-allowlist-paths-resolve (D-16-23 check 5, T-16-15/T-16-16 mitigation): every granted binary path resolves on disk, is executable, and uses no glob/alternation metacharacter (T-11-20) — ${res}" "$rc"
}

# ── check 6: overview-content-check ──────────────────────────────────────
# D-16-10's whole-grid catch made machine-detectable: summons the overview,
# reads the `overview` IPC status verb, requires withContent > 0 whenever
# windows > 0 (never a tile-count assertion — D-16-01's count is fixed
# elsewhere and this check must keep working as plan 16-03 lands eleven
# tiles), then dismisses.
#
# Honest caveat (D-16-23, carried verbatim from 16-CONTEXT.md): the natural
# poison — removing quickshell from the allow list — needs a compositor
# restart, so it cannot be reproduced by a fixture. The practical
# falsification committed here is a poisoned overview-status fixture
# reporting windows>0 with withContent=0 (the exact false-pass shape
# 16-02-SUMMARY.md's own history warns this check must catch — a bare
# non-zero windows count is NOT sufficient). Separately, and consistent
# with the same honest caveat: running this exact assertion against a
# genuinely NOT-summoned overview (windows=0) is vacuously true by design
# — the assertion is a conditional ("whenever windows>0"), not an
# unconditional "must always have content" — so that path is not itself a
# failure demonstration; the poisoned-blank-tiles fixture is.
_qsd_assert_overview_content() {
    local raw="$1" windows withcontent
    windows=$(printf '%s' "$raw" | grep -oP 'windows=\K[0-9]+' | head -1)
    withcontent=$(printf '%s' "$raw" | grep -oP 'withContent=\K[0-9]+' | head -1)
    if [[ -z "$windows" || -z "$withcontent" ]]; then
        printf 'windows=<unparsed> withContent=<unparsed>'
        return 1
    fi
    printf 'windows=%s withContent=%s' "$windows" "$withcontent"
    if [[ "$windows" -gt 0 ]]; then
        [[ "$withcontent" -gt 0 ]]
    else
        return 0
    fi
}

_qsd_check_overview_content() {
    if ! command -v qs >/dev/null 2>&1; then
        echo "  [SKIP] overview-content-check (D-16-23 check 6): qs not found"
        return
    fi
    local raw report rc
    qs ipc call overview toggle >/dev/null 2>&1
    OVERVIEW_SUMMONED=1
    sleep 0.4
    raw=$(_qsd_overview_status)
    report=$(_qsd_assert_overview_content "$raw"); rc=$?
    qs ipc call overview toggle >/dev/null 2>&1
    OVERVIEW_SUMMONED=0
    sleep 0.2
    check "overview-content-check (D-16-23 check 6, D-16-10's whole-grid catch): ${report} (raw='$(printf '%s' "$raw" | tr '\n' ' ')'). Honest caveat: the natural poison (removing quickshell from the allow list) needs a compositor restart; the practical falsification is the committed poisoned-blank-tiles-overview-status.txt fixture (windows>0, withContent=0), replayed by --self-test." "$rc"
}

# ── check 7: single-capture-path ─────────────────────────────────────────
# Beyond D-16-23's own six, made deliberately and recorded as such (see
# 16-04-SUMMARY.md): asserts the screencopy view type is instantiated in
# exactly one file under modules/overview/, encoding the 16-03 assumption-
# delta promotion (WindowThumbnail.qml is the ONLY ScreencopyView site) as
# a standing gate rather than a convention a later plan can silently break
# by forking the renderer.
_qsd_assert_single_capture_path() {
    local dir="$1" f matches=0 names=""
    while IFS= read -r f; do
        if grep -vE '^\s*//' -- "$f" 2>/dev/null | grep -qE 'ScreencopyView[[:space:]]*\{'; then
            matches=$((matches + 1))
            names="${names}$(basename -- "$f") "
        fi
    done < <(find -L "$dir" -maxdepth 1 -type f -name '*.qml' 2>/dev/null)
    printf 'files-instantiating-ScreencopyView=%s (%s)' "$matches" "${names:-none}"
    [[ "$matches" -eq 1 ]]
}

_qsd_check_single_capture_path() {
    local dir res rc
    dir=$(_qsd_overview_qml_dir)
    if [[ ! -d "$dir" ]]; then
        echo "  [SKIP] single-capture-path (D-16-23 check 7): $dir not found"
        return
    fi
    res=$(_qsd_assert_single_capture_path "$dir"); rc=$?
    check "single-capture-path (D-16-23 check 7, assumption-delta promotion beyond D-16-23's own six): exactly one ScreencopyView instantiation site under modules/overview/ — ${res}" "$rc"
}

# ── D-15-25 --self-test — motion-lint's own fixture-replay shape
#    (tests/motion-fixtures, lines 1009-1090), adapted for a LIVE
#    observation gate rather than a static-scan one: each entry drives the
#    seam directly (never a scan root), sets exactly one QSD_FIXTURE_*
#    variable per replay, and asserts a narrow parse-and-assert verdict —
#    it does NOT prove the live capture path is wired to the right
#    command (that compensating proof is that all four checks also ran
#    live in the normal invocation, and the two-panel/zero-panel cases
#    were additionally observed live). Performs NO summon, NO volume
#    write, NO radio mutation, NO headless output — structurally true,
#    because this whole function returns before the trap/mutating groups
#    below are ever reached.
_qsd_self_test_assert_layers() {
    local fixture="$1" expect_nonzero="$2" want_count="$3" want_ns="${4:-}"
    local json rc
    json=$(cat -- "$FIXTURES_DIR/$fixture")
    # T-16-SELFTEST: pass the fixed pid (2982672) baked into all four
    # compliant/poisoned *-panel-layers.json fixtures, rather than letting
    # _qsd_assert_panel_layers fall back to live pgrep — see that
    # function's own header comment for the full record-why.
    _qsd_assert_panel_layers "$json" "$want_count" "$want_ns" "2982672" >/dev/null 2>&1
    rc=$?
    if [[ "$expect_nonzero" == "0" && "$rc" -eq 0 ]]; then return 0; fi
    if [[ "$expect_nonzero" == "1" && "$rc" -ne 0 ]]; then return 0; fi
    return 1
}

run_self_test() {
    echo "quickshell-doctor --self-test — replaying the committed quickshell-fixtures"
    echo ""
    local st_pass=0 st_fail=0
    _qsd_st() {
        local desc="$1" rc="$2"
        if [[ "$rc" -eq 0 ]]; then
            printf '  [PASS] self-test: %s\n' "$desc"
            st_pass=$((st_pass + 1))
        else
            printf '  [FAIL] self-test: %s\n' "$desc"
            st_fail=$((st_fail + 1))
        fi
    }

    if [[ ! -d "$FIXTURES_DIR" ]]; then
        _qsd_st "fixtures directory missing: $FIXTURES_DIR" 1
        printf 'Self-test summary: %d passed, %d failed\n' "$st_pass" "$st_fail"
        return 1
    fi

    # panel-namespace-conformance — layers half (4 fixtures). The
    # compliant fixture is the DURING-summon shape (one panel, correct
    # namespace, level 3, shell-owned pid) — a real 2026-08-02 capture
    # taken while `qs ipc call panel open wifi` had the wifi panel
    # summoned.
    _qsd_self_test_assert_layers "compliant-panel-layers.json" 0 1 "quickshell-wifi-panel"
    _qsd_st "compliant-panel-layers.json -> panel-namespace-conformance PASSES (one compliant panel namespace, live during-summon snapshot)" $?
    _qsd_self_test_assert_layers "poisoned-offlevel-panel-layers.json" 1 0
    _qsd_st "poisoned-offlevel-panel-layers.json -> panel-namespace-conformance FAILS (namespace off the overlay level)" $?
    _qsd_self_test_assert_layers "poisoned-two-panel-layers.json" 1 0
    _qsd_st "poisoned-two-panel-layers.json -> panel-namespace-conformance FAILS (two panel namespaces mounted at once)" $?
    _qsd_self_test_assert_layers "poisoned-unknown-namespace-layers.json" 1 0
    _qsd_st "poisoned-unknown-namespace-layers.json -> panel-namespace-conformance FAILS (panel-shaped namespace outside the expected set)" $?

    # panel-namespace-conformance — source half (2 fixtures, isolated per-fixture tmpdir)
    local tmpdir rc
    tmpdir=$(mktemp -d)
    cp -- "$FIXTURES_DIR/compliant-panel.qml" "$tmpdir/"
    QSD_FIXTURE_PANEL_QML_DIR="$tmpdir" _qsd_assert_panel_source "$tmpdir" >/dev/null 2>&1
    rc=$?
    _qsd_st "compliant-panel.qml -> panel-namespace-conformance source-half PASSES (no self-owned namespace)" "$([[ "$rc" -eq 0 ]] && echo 0 || echo 1)"
    rm -rf -- "$tmpdir"
    tmpdir=$(mktemp -d)
    cp -- "$FIXTURES_DIR/poisoned-own-namespace-panel.qml" "$tmpdir/"
    _qsd_assert_panel_source "$tmpdir" >/dev/null 2>&1
    rc=$?
    _qsd_st "poisoned-own-namespace-panel.qml -> panel-namespace-conformance source-half FAILS (panel body sets its own WlrLayershell.namespace)" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"
    rm -rf -- "$tmpdir"

    # panel-shortcut-single-registration (4 fixtures)
    local mc
    mc=$(jq -r '[.[] | select(.name=="audio-panel")] | length' "$FIXTURES_DIR/compliant-shortcuts.json" 2>/dev/null)
    _qsd_st "compliant-shortcuts.json -> panel-shortcut-single-registration PASSES (audio-panel appears once, manifest half)" "$([[ "$mc" == "1" ]] && echo 0 || echo 1)"
    mc=$(jq -r '[.[] | select(.name=="audio-panel")] | length' "$FIXTURES_DIR/poisoned-duplicate-shortcuts.json" 2>/dev/null)
    _qsd_st "poisoned-duplicate-shortcuts.json -> panel-shortcut-single-registration FAILS (audio-panel declared twice)" "$([[ "$mc" != "1" ]] && echo 0 || echo 1)"
    "$KEYBIND_DOCTOR" "$FIXTURES_DIR/compliant-keybinds.lua" "$SHORTCUTS_MANIFEST" >/dev/null 2>&1
    rc=$?
    _qsd_st "compliant-keybinds.lua -> keybind-doctor's static chord-collision check clean (exit ${rc})" "$([[ "$rc" -eq 0 ]] && echo 0 || echo 1)"
    "$KEYBIND_DOCTOR" "$FIXTURES_DIR/poisoned-collision-keybinds.lua" "$SHORTCUTS_MANIFEST" >/dev/null 2>&1
    rc=$?
    _qsd_st "poisoned-collision-keybinds.lua -> keybind-doctor's static chord-collision check FAILS (a second bind claims the audio-panel chord, exit ${rc})" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"

    # panel-notifications-single-owner (3 fixtures)
    local rows count owner
    rows=$(cat -- "$FIXTURES_DIR/compliant-busctl-list.txt" | grep -F 'org.freedesktop.Notifications' || true)
    count=$(printf '%s\n' "$rows" | grep -c '.')
    owner=$(printf '%s\n' "$rows" | awk '{print $3}' | head -1)
    _qsd_st "compliant-busctl-list.txt -> panel-notifications-single-owner PASSES (count=${count}, owner=${owner:-<none>})" "$([[ "$count" == "1" && "$owner" == "swaync" ]] && echo 0 || echo 1)"
    rows=$(cat -- "$FIXTURES_DIR/poisoned-two-owner-busctl-list.txt" | grep -F 'org.freedesktop.Notifications' || true)
    count=$(printf '%s\n' "$rows" | grep -c '.')
    _qsd_st "poisoned-two-owner-busctl-list.txt -> panel-notifications-single-owner FAILS (count=${count}, expected 1)" "$([[ "$count" != "1" ]] && echo 0 || echo 1)"
    rows=$(cat -- "$FIXTURES_DIR/poisoned-zero-owner-busctl-list.txt" | grep -F 'org.freedesktop.Notifications' || true)
    count=$(printf '%s\n' "$rows" | grep -c '.')
    _qsd_st "poisoned-zero-owner-busctl-list.txt -> panel-notifications-single-owner FAILS (count=${count}, a dead daemon is as much a failure as a second one)" "$([[ "$count" != "1" ]] && echo 0 || echo 1)"

    # panel-swayosd-key-ownership (3 fixtures)
    local table not_one=0 p v
    table=$(QSD_FIXTURE_HYPRCTL_BINDS="$FIXTURES_DIR/compliant-hyprctl-binds.txt" _qsd_xf86_ownership_table)
    IFS="$US" read -ra pairs <<<"$table"
    for p in "${pairs[@]}"; do [[ -z "$p" ]] && continue; v="${p##*=}"; [[ "$v" != "1" ]] && not_one=$((not_one + 1)); done
    _qsd_st "compliant-hyprctl-binds.txt -> panel-swayosd-key-ownership PASSES (not-exactly-one count=${not_one})" "$([[ "$not_one" -eq 0 ]] && echo 0 || echo 1)"
    not_one=0
    table=$(QSD_FIXTURE_HYPRCTL_BINDS="$FIXTURES_DIR/poisoned-duplicate-xf86-binds.txt" _qsd_xf86_ownership_table)
    IFS="$US" read -ra pairs <<<"$table"
    for p in "${pairs[@]}"; do [[ -z "$p" ]] && continue; v="${p##*=}"; [[ "$v" != "1" ]] && not_one=$((not_one + 1)); done
    _qsd_st "poisoned-duplicate-xf86-binds.txt -> panel-swayosd-key-ownership FAILS (volume-raise key doubled, not-exactly-one count=${not_one})" "$([[ "$not_one" -ne 0 ]] && echo 0 || echo 1)"
    not_one=0
    table=$(QSD_FIXTURE_HYPRCTL_BINDS="$FIXTURES_DIR/poisoned-missing-xf86-binds.txt" _qsd_xf86_ownership_table)
    IFS="$US" read -ra pairs <<<"$table"
    for p in "${pairs[@]}"; do [[ -z "$p" ]] && continue; v="${p##*=}"; [[ "$v" != "1" ]] && not_one=$((not_one + 1)); done
    _qsd_st "poisoned-missing-xf86-binds.txt -> panel-swayosd-key-ownership FAILS (mute key bound zero times, not-exactly-one count=${not_one})" "$([[ "$not_one" -ne 0 ]] && echo 0 || echo 1)"

    # The promotion's own structural guard, replayed rather than only
    # observed once: deliberately collide a client-consumer key into the
    # name-owner registry, in a subshell so the real arrays are untouched.
    (
        declare -A QSD_NAME_OWNERS=(["org.freedesktop.Notifications"]="swaync" ["PipeWire"]="nobody")
        declare -A QSD_CLIENT_CONSUMERS=(["PipeWire"]="collision fixture")
        bad=0
        for key in "${!QSD_CLIENT_CONSUMERS[@]}"; do
            [[ -n "${QSD_NAME_OWNERS[$key]+x}" ]] && bad=$((bad + 1))
        done
        exit "$([[ "$bad" -eq 0 ]] && echo 0 || echo 1)"
    )
    rc=$?
    _qsd_st "deliberate client-consumer/name-owner collision -> structural guard FAILS (bad=1 when PipeWire is placed in both registries)" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"

    # ── D-16-23 (Phase 16 Plan 04) — seven new checks, each fixture-proven
    #    able to fail before being trusted to pass.

    # check 1: overview-namespace-conformance (4 fixtures). shell_pids is a
    # fixed sentinel ("424242") shared by every fixture's own baked-in pid
    # — never live pgrep — so the verdict cannot depend on which quickshell
    # process happens to be running when --self-test executes.
    local json
    json=$(cat -- "$FIXTURES_DIR/compliant-overview-layers.json")
    _qsd_assert_overview_namespace "$json" "424242" >/dev/null 2>&1
    rc=$?
    _qsd_st "compliant-overview-layers.json -> overview-namespace-conformance (D-16-23 check 1: the overview namespace names quickshell-overview specifically) PASSES (one claimant, level 3, matching pid)" "$([[ "$rc" -eq 0 ]] && echo 0 || echo 1)"
    json=$(cat -- "$FIXTURES_DIR/poisoned-offlevel-overview-layers.json")
    _qsd_assert_overview_namespace "$json" "424242" >/dev/null 2>&1
    rc=$?
    _qsd_st "poisoned-offlevel-overview-layers.json -> overview-namespace-conformance FAILS (namespace off the overlay level)" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"
    json=$(cat -- "$FIXTURES_DIR/poisoned-two-claimant-overview-layers.json")
    _qsd_assert_overview_namespace "$json" "424242 555555" >/dev/null 2>&1
    rc=$?
    _qsd_st "poisoned-two-claimant-overview-layers.json -> overview-namespace-conformance FAILS (two surfaces claim the namespace at once)" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"
    json=$(cat -- "$FIXTURES_DIR/poisoned-wrongpid-overview-layers.json")
    _qsd_assert_overview_namespace "$json" "424242" >/dev/null 2>&1
    rc=$?
    _qsd_st "poisoned-wrongpid-overview-layers.json -> overview-namespace-conformance FAILS (namespace owned by a pid outside the declared shell-pid set)" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"

    # check 2: overview-shortcut-single-registration (4 fixtures: 2 manifest
    # half, 2 keybind-doctor half — same shape as panel-shortcut-single-
    # registration's own self-test above).
    local mc
    mc=$(jq -r '[.[] | select(.name=="overview")] | length' "$FIXTURES_DIR/compliant-overview-shortcuts.json" 2>/dev/null)
    _qsd_st "compliant-overview-shortcuts.json -> overview-shortcut-single-registration PASSES (overview appears once, manifest half)" "$([[ "$mc" == "1" ]] && echo 0 || echo 1)"
    mc=$(jq -r '[.[] | select(.name=="overview")] | length' "$FIXTURES_DIR/poisoned-duplicate-overview-shortcuts.json" 2>/dev/null)
    _qsd_st "poisoned-duplicate-overview-shortcuts.json -> overview-shortcut-single-registration FAILS (overview declared twice)" "$([[ "$mc" != "1" ]] && echo 0 || echo 1)"
    "$KEYBIND_DOCTOR" "$FIXTURES_DIR/compliant-overview-keybinds.lua" "$SHORTCUTS_MANIFEST" >/dev/null 2>&1
    rc=$?
    _qsd_st "compliant-overview-keybinds.lua -> keybind-doctor's static chord-collision check clean (exit ${rc})" "$([[ "$rc" -eq 0 ]] && echo 0 || echo 1)"
    "$KEYBIND_DOCTOR" "$FIXTURES_DIR/poisoned-collision-overview-keybinds.lua" "$SHORTCUTS_MANIFEST" >/dev/null 2>&1
    rc=$?
    _qsd_st "poisoned-collision-overview-keybinds.lua -> keybind-doctor's static chord-collision check FAILS (a second bind claims the Super+O chord, exit ${rc})" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"

    # check 3: reserved-array-manifest-coverage (2 fixtures — reuses the
    # existing compliant-shortcuts.json as its clean counterpart).
    local res
    res=$(_qsd_assert_manifest_coverage "$FIXTURES_DIR/compliant-shortcuts.json")
    rc=$?
    _qsd_st "compliant-shortcuts.json -> reserved-array-manifest-coverage PASSES (${res})" "$([[ "$rc" -eq 0 ]] && echo 0 || echo 1)"
    res=$(_qsd_assert_manifest_coverage "$FIXTURES_DIR/poisoned-invalid-token-shortcuts.json")
    rc=$?
    _qsd_st "poisoned-invalid-token-shortcuts.json -> reserved-array-manifest-coverage FAILS (${res}, an entry fails _qsd_valid_token and would silently fall out of the diff)" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"

    # check 4: permissions-enforce-readback (2 fixtures).
    local raw
    raw=$(cat -- "$FIXTURES_DIR/compliant-hyprctl-getoption-enforce.txt")
    _qsd_assert_enforce_permissions "$raw"
    rc=$?
    _qsd_st "compliant-hyprctl-getoption-enforce.txt -> permissions-enforce-readback (D-16-23 check 4: hyprctl getoption ecosystem:enforce_permissions runtime readback) PASSES (bool: true)" "$([[ "$rc" -eq 0 ]] && echo 0 || echo 1)"
    raw=$(cat -- "$FIXTURES_DIR/poisoned-hyprctl-getoption-enforce.txt")
    _qsd_assert_enforce_permissions "$raw"
    rc=$?
    _qsd_st "poisoned-hyprctl-getoption-enforce.txt -> permissions-enforce-readback FAILS (bool: false — the exact silent-revert D-16-09 guards against)" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"

    # check 5: permissions-allowlist-paths-resolve (3 fixtures).
    res=$(_qsd_assert_permissions_allowlist "$FIXTURES_DIR/compliant-permissions.lua")
    rc=$?
    _qsd_st "compliant-permissions.lua -> permissions-allowlist-paths-resolve (D-16-23 check 5: every allow-listed screencopy binary path resolves on disk) PASSES (${res})" "$([[ "$rc" -eq 0 ]] && echo 0 || echo 1)"
    res=$(_qsd_assert_permissions_allowlist "$FIXTURES_DIR/poisoned-missing-binary-permissions.lua")
    rc=$?
    _qsd_st "poisoned-missing-binary-permissions.lua -> permissions-allowlist-paths-resolve FAILS (${res})" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"
    res=$(_qsd_assert_permissions_allowlist "$FIXTURES_DIR/poisoned-pattern-binary-permissions.lua")
    rc=$?
    _qsd_st "poisoned-pattern-binary-permissions.lua -> permissions-allowlist-paths-resolve FAILS (${res}, T-11-20 alternation discipline)" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"

    # check 6: overview-content-check (2 fixtures — the practical
    # falsification the honest caveat names: a poisoned status report
    # showing real windows but zero painted content).
    raw=$(cat -- "$FIXTURES_DIR/compliant-overview-status.txt")
    _qsd_assert_overview_content "$raw" >/dev/null 2>&1
    rc=$?
    _qsd_st "compliant-overview-status.txt -> overview-content-check PASSES (windows=3 withContent=3)" "$([[ "$rc" -eq 0 ]] && echo 0 || echo 1)"
    raw=$(cat -- "$FIXTURES_DIR/poisoned-blank-tiles-overview-status.txt")
    _qsd_assert_overview_content "$raw" >/dev/null 2>&1
    rc=$?
    _qsd_st "poisoned-blank-tiles-overview-status.txt -> overview-content-check FAILS (windows=3 withContent=0 — the exact false-pass shape 16-02's own history warns against)" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"

    # check 7: single-capture-path (2 fixtures, isolated per-scenario
    # tmpdir — same isolation pattern as panel-namespace-conformance's
    # source half above).
    local tmpdir
    tmpdir=$(mktemp -d)
    cp -- "$FIXTURES_DIR/compliant-window-thumbnail.qml" "$tmpdir/"
    _qsd_assert_single_capture_path "$tmpdir" >/dev/null 2>&1
    rc=$?
    _qsd_st "compliant-window-thumbnail.qml alone -> single capture path check (D-16-23 check 7) PASSES (exactly one ScreencopyView instantiation site)" "$([[ "$rc" -eq 0 ]] && echo 0 || echo 1)"
    rm -rf -- "$tmpdir"
    tmpdir=$(mktemp -d)
    cp -- "$FIXTURES_DIR/compliant-window-thumbnail.qml" "$tmpdir/"
    cp -- "$FIXTURES_DIR/poisoned-second-screencopyview.qml" "$tmpdir/"
    _qsd_assert_single_capture_path "$tmpdir" >/dev/null 2>&1
    rc=$?
    _qsd_st "poisoned-second-screencopyview.qml added alongside -> single-capture-path FAILS (a second ScreencopyView instantiation site appeared)" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"
    rm -rf -- "$tmpdir"

    # 17-03 Task 4 (standing constraint #4) — mpvpaper-layer-coexistence
    # (2 fixtures). Fixed pid 2982672 baked into both, same T-16-SELFTEST
    # discipline as the panel/overview fixtures above — never a live
    # pgrep inside the replay.
    res=$(_qsd_assert_mpvpaper_layers "$(cat -- "$FIXTURES_DIR/compliant-mpvpaper-layers.json")" "2982672"); rc=$?
    _qsd_st "compliant-mpvpaper-layers.json -> mpvpaper-layer-coexistence PASSES (${res}, live during-playback snapshot)" "$([[ "$rc" -eq 0 ]] && echo 0 || echo 1)"
    res=$(_qsd_assert_mpvpaper_layers "$(cat -- "$FIXTURES_DIR/poisoned-offlevel-mpvpaper-layers.json")" "2982672"); rc=$?
    _qsd_st "poisoned-offlevel-mpvpaper-layers.json -> mpvpaper-layer-coexistence FAILS (${res}, namespace moved to the overlay level)" "$([[ "$rc" -ne 0 ]] && echo 0 || echo 1)"

    echo ""
    printf 'Self-test summary: %d passed, %d failed\n' "$st_pass" "$st_fail"
    [[ "$st_fail" -eq 0 ]]
}

if [[ "$SELF_TEST" -eq 1 ]]; then
    run_self_test
    exit $?
fi

echo "quickshell-doctor — Quickshell coexistence gate (QS-05/QS-06)"
echo ""

# ── T-11-11: install the restore trap BEFORE either mutating probe
#    below runs. Restoration is the trap's job alone — never call the
#    cleanup function directly inline — so an interrupt between
#    mutate-and-restore can never strand the user's volume/brightness at
#    a raised level. ─────────────────────────────────────────────────
VOL_RESTORE_NEEDED=0
VOL_ORIG_RAW=()
BRI_RESTORE_NEEDED=0
BRI_ORIG_RAW=""
# T-11-15 (QS-03 headless-output group, Task 1): armed BEFORE `hyprctl
# output create headless` runs below, same discipline as the
# volume/brightness probes above — never remove a headless output this
# run did not itself create, and never call this cleanup directly
# in-line; the trap alone restores state so an interrupt mid-cycle can
# never strand a stray virtual monitor registered on the session.
HEADLESS_CREATED_NAME=""
PROBE_SUMMONED_FOR_HEADLESS_TEST=0
# T-11-REVIEWFIX (CR-03): armed with the currently-summoned manifest
# surface immediately before dispatch, cleared immediately after dismiss
# — same discipline as PROBE_SUMMONED_FOR_HEADLESS_TEST above, so an
# interrupt mid-cycle of the reserved-space check can never strand a
# manifest surface mounted on the user's screen.
RESERVED_CHECK_SUMMONED=""
# D-15-25 (Phase 15 Plan 09): PANEL_SUMMONED_NAME follows
# RESERVED_CHECK_SUMMONED's exact discipline for the four new panel
# checks' own summon/dismiss cycle — armed by _qsd_summon_panel
# immediately before dispatch, cleared by _qsd_dismiss_panel immediately
# after. RFKILL_RESTORE_NEEDED/RFKILL_ORIG_WIFI_SOFT/RFKILL_ORIG_BT_SOFT
# are declared here for the same reason (T-11-11 discipline available to
# any future rerun of the rfkill fault-injection procedure Task 2
# performs) even though this run of quickshell-doctor itself never
# mutates rfkill state — that injection is driven live, outside this
# script, and is recorded in 15-09-SUMMARY.md.
PANEL_SUMMONED_NAME=""
RFKILL_RESTORE_NEEDED=0
RFKILL_ORIG_WIFI_SOFT=""
RFKILL_ORIG_BT_SOFT=""
# D-16-23 (Phase 16 Plan 04) check 6 — same T-11-11 discipline as
# PANEL_SUMMONED_NAME above: set immediately before `qs ipc call overview
# toggle` summons the surface, cleared immediately after the matching
# dismiss toggle, so an interrupt mid-check can never strand the overview
# mounted on the user's screen.
OVERVIEW_SUMMONED=0
CLEANED_UP=0
# shellcheck disable=SC2329 # invoked indirectly via `trap` below, not a direct call
_qsd_cleanup() {
    [[ "$CLEANED_UP" -eq 1 ]] && return
    CLEANED_UP=1
    if [[ "$VOL_RESTORE_NEEDED" -eq 1 && "${#VOL_ORIG_RAW[@]}" -gt 0 ]]; then
        pactl set-sink-volume @DEFAULT_SINK@ "${VOL_ORIG_RAW[@]}" >/dev/null 2>&1
    fi
    if [[ "$BRI_RESTORE_NEEDED" -eq 1 && -n "$BRI_ORIG_RAW" ]]; then
        brightnessctl set "$BRI_ORIG_RAW" >/dev/null 2>&1
    fi
    if [[ "$PROBE_SUMMONED_FOR_HEADLESS_TEST" -eq 1 ]]; then
        _qsd_dispatch_global "quickshell:probe"
        PROBE_SUMMONED_FOR_HEADLESS_TEST=0
    fi
    if [[ -n "$HEADLESS_CREATED_NAME" ]]; then
        hyprctl output remove "$HEADLESS_CREATED_NAME" >/dev/null 2>&1
        HEADLESS_CREATED_NAME=""
    fi
    if [[ -n "$RESERVED_CHECK_SUMMONED" ]]; then
        _qsd_dispatch_global "$RESERVED_CHECK_SUMMONED"
        RESERVED_CHECK_SUMMONED=""
    fi
    if [[ -n "$PANEL_SUMMONED_NAME" ]]; then
        qs ipc call panel toggle "$PANEL_SUMMONED_NAME" >/dev/null 2>&1
        PANEL_SUMMONED_NAME=""
    fi
    if [[ "$OVERVIEW_SUMMONED" -eq 1 ]]; then
        qs ipc call overview toggle >/dev/null 2>&1
        OVERVIEW_SUMMONED=0
    fi
    if [[ "$RFKILL_RESTORE_NEEDED" -eq 1 ]]; then
        [[ -n "$RFKILL_ORIG_WIFI_SOFT" ]] && rfkill "$RFKILL_ORIG_WIFI_SOFT" wifi >/dev/null 2>&1
        [[ -n "$RFKILL_ORIG_BT_SOFT" ]] && rfkill "$RFKILL_ORIG_BT_SOFT" bluetooth >/dev/null 2>&1
        RFKILL_RESTORE_NEEDED=0
    fi
}
# EXIT alone covers normal completion; INT/TERM additionally terminate
# the script immediately after restoring (a signal handler that
# silently keeps running defeats the point of interrupting it) — the
# guard above keeps a subsequent EXIT-trap firing from double-restoring.
trap _qsd_cleanup EXIT
trap '_qsd_cleanup; exit 130' INT
trap '_qsd_cleanup; exit 143' TERM

# ── 1. Binary present ────────────────────────────────────────────────
command -v quickshell >/dev/null 2>&1
check "quickshell binary present on PATH" "$?"

# ── 2. Shell process alive (D-06) — a headless root that renders
#    nothing is also invisible when it fails to start or dies, so this
#    is the load-bearing liveness proof. ─────────────────────────────
pgrep -f 'quickshell -p' >/dev/null 2>&1
check "quickshell shell process alive (matches the launcher's exec'd invocation)" "$?"

# ── 3. Launcher log healthy ──────────────────────────────────────────
if [[ ! -f "$LAUNCHER_LOG" ]]; then
    check "launcher log exists with a healthy last startup ($LAUNCHER_LOG)" "1"
else
    LAST_START_LINE_NO=$(grep -n 'quickshell-launch\.sh: starting' "$LAUNCHER_LOG" | tail -1 | cut -d: -f1)
    if [[ -z "$LAST_START_LINE_NO" ]]; then
        check "launcher log exists with a healthy last startup ($LAUNCHER_LOG)" "1"
        echo "    no 'quickshell-launch.sh: starting' line found in $LAUNCHER_LOG" >&2
    else
        TAIL_SINCE_START=$(tail -n +"$LAST_START_LINE_NO" "$LAUNCHER_LOG")
        CRASH_HITS=$(printf '%s\n' "$TAIL_SINCE_START" | grep -ciE 'fatal|panic|segmentation fault|core dumped|\babort(ed)?\b')
        check "launcher log's last startup line ($LAUNCHER_LOG:$LAST_START_LINE_NO) has no crash/abort marker after it" "$([[ "$CRASH_HITS" -eq 0 ]] && echo 0 || echo 1)"
        if [[ "$CRASH_HITS" -gt 0 ]]; then
            echo "    last lines since startup:" >&2
            printf '%s\n' "$TAIL_SINCE_START" | tail -10 | sed 's/^/    /' >&2
        fi
    fi
fi

# ── 4. Namespace discipline (D-21) — every quickshell-* layer namespace
#    must sit at level 3 (overlay) and belong to the shell's own PID.
#    This is what stops the class of stale-namespace residue that left
#    two inert eww-media-popup layerrules behind. ────────────────────
if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    echo "  [SKIP] namespace discipline (D-21): hyprctl or jq not found"
else
    SHELL_PIDS=" $(pgrep -f 'quickshell -p' | tr '\n' ' ') "
    LAYERS_JSON=$(hyprctl layers -j 2>/dev/null)
    OFF_LEVEL_COUNT=$(printf '%s' "$LAYERS_JSON" | jq -r '
        [.[].levels | to_entries[] | select(.key != "3") | .value[] | select(.namespace | startswith("quickshell-"))] | length
    ')
    WRONG_PID_COUNT=0
    while IFS= read -r pid; do
        [[ -z "$pid" ]] && continue
        case "$SHELL_PIDS" in
            *" $pid "*) ;;
            *) WRONG_PID_COUNT=$((WRONG_PID_COUNT + 1)) ;;
        esac
    done < <(printf '%s' "$LAYERS_JSON" | jq -r '.[].levels["3"][]? | select(.namespace | startswith("quickshell-")) | .pid')
    check "namespace discipline (D-21): every quickshell-* layer namespace sits at level 3 (overlay) and belongs to the shell's own PID (off-level: ${OFF_LEVEL_COUNT}, wrong-pid: ${WRONG_PID_COUNT})" "$([[ "$OFF_LEVEL_COUNT" -eq 0 && "$WRONG_PID_COUNT" -eq 0 ]] && echo 0 || echo 1)"
fi

# ── 5. Reserved-space stays unclaimed (D-21), by diff not by literal —
#    summon every manifest surface, re-read monitors -j's reserved
#    array, assert byte-identical, then dismiss again. Never assert
#    equality against a hardcoded value: waybar's height, this host's
#    monitor name and the monitor count must all be free to change
#    without editing this file. ───────────────────────────────────────
if [[ "$NO_SUMMON" -eq 1 ]]; then
    echo "  [SKIP] reserved-space stays unclaimed (D-21): summon-and-diff disabled by --no-summon"
elif ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    echo "  [SKIP] reserved-space stays unclaimed (D-21): hyprctl or jq not found"
elif [[ ! -f "$SHORTCUTS_MANIFEST" ]]; then
    echo "  [SKIP] reserved-space stays unclaimed (D-21): manifest not found ($SHORTCUTS_MANIFEST)"
else
    ZONE_DIFF_BAD=0
    while IFS="$US" read -r m_appid m_name; do
        [[ -z "$m_appid" ]] && continue
        if ! _qsd_valid_token "$m_appid" || ! _qsd_valid_token "$m_name"; then
            ZONE_DIFF_BAD=$((ZONE_DIFF_BAD + 1))
            printf '    manifest entry failed the strict appid/name allowlist — refusing to dispatch: appid=%q name=%q\n' "$m_appid" "$m_name" >&2
            continue
        fi
        PRE=$(hyprctl monitors -j | jq -c '[.[].reserved]')
        RESERVED_CHECK_SUMMONED="${m_appid}:${m_name}"
        _qsd_dispatch_global "${m_appid}:${m_name}"
        sleep 0.3
        POST=$(hyprctl monitors -j | jq -c '[.[].reserved]')
        _qsd_dispatch_global "${m_appid}:${m_name}"
        RESERVED_CHECK_SUMMONED=""
        sleep 0.3
        if [[ "$PRE" != "$POST" ]]; then
            ZONE_DIFF_BAD=$((ZONE_DIFF_BAD + 1))
            printf '    reserved array changed summoning %s:%s — before=%s after=%s\n' "$m_appid" "$m_name" "$PRE" "$POST" >&2
        fi
    done < <(jq -r --arg us "$US" '.[] | [.appid, .name] | join($us)' "$SHORTCUTS_MANIFEST")
    check "reserved-space stays unclaimed (D-21): summoning every manifest surface leaves monitors -j's reserved array byte-identical (changed: ${ZONE_DIFF_BAD})" "$([[ "$ZONE_DIFF_BAD" -eq 0 ]] && echo 0 || echo 1)"
fi

# ── 6. keybind-doctor clean — the MAINT-01 half of QS-05's
#    bind-collision proof, wired in so it cannot rot separately. ─────
if [[ -x "$KEYBIND_DOCTOR" ]]; then
    KBD_OUTPUT=$("$KEYBIND_DOCTOR" 2>&1)
    KBD_EXIT=$?
    check "keybind-doctor clean (MAINT-01 bind-collision proof, exit ${KBD_EXIT})" "$([[ "$KBD_EXIT" -eq 0 ]] && echo 0 || echo 1)"
    if [[ "$KBD_EXIT" -ne 0 ]]; then
        printf '%s\n' "$KBD_OUTPUT" | tail -5 | sed 's/^/    /' >&2
    fi
else
    check "keybind-doctor clean (MAINT-01 bind-collision proof)" "1"
    echo "    keybind-doctor not found or not executable at $KEYBIND_DOCTOR" >&2
fi

# ── 7. Single org.freedesktop.Notifications owner (QS-06) — assert
#    EXACTLY one: zero is as much a failure as two (zero means the
#    notification daemon died). ──────────────────────────────────────
if ! command -v busctl >/dev/null 2>&1; then
    echo "  [SKIP] single org.freedesktop.Notifications owner (busctl not found)"
else
    # D-15-25: refactored onto the name-owner variant's shared reader
    # (_qsd_notif_sample / QSD_NAME_OWNERS). Check text, PASS/FAIL
    # semantics and position all stay unchanged — this is a promotion of
    # the model underneath the check, not a change to what it asserts.
    read -r NOTIF_COUNT NOTIF_OWNER <<<"$(_qsd_notif_sample)"
    check "single org.freedesktop.Notifications owner, and it is swaync (count: ${NOTIF_COUNT}, owner: ${NOTIF_OWNER})" "$([[ "$NOTIF_COUNT" -eq 1 && "$NOTIF_OWNER" == "${QSD_NAME_OWNERS[org.freedesktop.Notifications]}" ]] && echo 0 || echo 1)"
fi
_qsd_assert_client_consumer_not_owned

# ── 8. Single handler per hardware key (QS-06) — count registered
#    handlers across BOTH registration mechanisms: Hyprland's own binds
#    plus any manifest entry whose chord.key names the same key. ─────
if ! command -v hyprctl >/dev/null 2>&1; then
    echo "  [SKIP] single handler per hardware key (hyprctl not found)"
else
    # D-15-25: XF86_KEYS is now the top-level shared constant (declared
    # before checks 1-12 run) so this check and _qsd_xf86_ownership_table
    # read the same literal list rather than each keeping its own copy.
    BINDS_RAW=$(hyprctl binds 2>/dev/null)
    KEY_BAD=0
    KEY_REPORT=""
    for xk in "${XF86_KEYS[@]}"; do
        HYPR_COUNT=$(printf '%s\n' "$BINDS_RAW" | grep -c "	key: ${xk}\$")
        MANIFEST_COUNT=0
        if [[ -f "$SHORTCUTS_MANIFEST" ]] && command -v jq >/dev/null 2>&1; then
            MANIFEST_COUNT=$(jq -r --arg k "$xk" '[.[] | select(.chord.key == $k)] | length' "$SHORTCUTS_MANIFEST" 2>/dev/null)
            [[ -z "$MANIFEST_COUNT" ]] && MANIFEST_COUNT=0
        fi
        TOTAL=$((HYPR_COUNT + MANIFEST_COUNT))
        KEY_REPORT="${KEY_REPORT}${xk}=${TOTAL} "
        [[ "$TOTAL" -ne 1 ]] && KEY_BAD=$((KEY_BAD + 1))
    done
    check "single handler per hardware key: all 10 XF86Audio*/XF86MonBrightness* keys have exactly one registered handler (bad: ${KEY_BAD})" "$([[ "$KEY_BAD" -eq 0 ]] && echo 0 || echo 1)"
    echo "    per-key counts: ${KEY_REPORT}"
fi

# ── 9. No Quickshell MPRIS writer (QS-06 / standing constraint 4) —
#    Phase 11 ships no media widget so this asserts a zero that must
#    stay zero; a third *reader* of MPRIS is safe, a third uncoordinated
#    *writer* is not. ─────────────────────────────────────────────────
if [[ -d "$QUICKSHELL_CONFIG_DIR" ]]; then
    MPRIS_HITS=0
    # T-11-REVIEWFIX (WR-02): match an actual MPRIS API surface — the
    # service import line or a QML `Mpris*` type instantiation — not a
    # bare case-insensitive substring of the word, which would also flip
    # on prose (e.g. a doc comment merely mentioning "MPRIS").
    while IFS= read -r f; do
        grep -qE 'import[[:space:]]+Quickshell\.Services\.Mpris|\bMpris[A-Za-z]*[[:space:]]*\{' "$f" 2>/dev/null && MPRIS_HITS=$((MPRIS_HITS + 1))
    done < <(find -L "$QUICKSHELL_CONFIG_DIR" -type f 2>/dev/null)
    check "zero Quickshell MPRIS writers (found in ${MPRIS_HITS} file(s) under $QUICKSHELL_CONFIG_DIR)" "$([[ "$MPRIS_HITS" -eq 0 ]] && echo 0 || echo 1)"
else
    echo "  [SKIP] no Quickshell MPRIS writer check ($QUICKSHELL_CONFIG_DIR not found)"
fi

# ── D-15-25 (Phase 15 Plan 09) — four new panel checks, placed here (after
#    9, before the volume probe) so the file's existing reading order —
#    liveness, namespaces, D-Bus, keys, invasive hotplug — is preserved
#    and these sit with the D-Bus/key material they extend. All four are
#    driven by the SAME before/during/after summon-and-diff mechanism the
#    reserved-space check (5, above) already established. ───────────────
_qsd_check_panel_namespace_conformance
_qsd_check_panel_shortcut_single_registration
_qsd_check_panel_notifications_single_owner
_qsd_check_panel_swayosd_key_ownership

# ── 10. One step per press — volume (QS-06), measured, transient,
#    self-restoring. The one deliberate mutation in this gate. Never
#    let a missing instrument produce a silent [PASS]: skip cleanly
#    when swayosd-client is absent, pactl reports no default sink, or
#    (D-15-25 Part 2) the SwayOSD server itself is unreachable — the
#    guard gap measured at planning time, where a dead server produced
#    "measured delta=0 ... drift: 3277", a failure blamed on tolerance
#    rather than on the absent instrument. ──────────────────────────────
if ! command -v swayosd-client >/dev/null 2>&1; then
    echo "  [SKIP] one-step-per-press volume probe (swayosd-client not found)"
elif ! command -v pactl >/dev/null 2>&1 || ! pactl get-sink-volume @DEFAULT_SINK@ >/dev/null 2>&1; then
    echo "  [SKIP] one-step-per-press volume probe (pactl reports no default sink)"
elif ! _qsd_swayosd_server_reachable; then
    echo "  [SKIP] one-step-per-press volume probe (D-15-25 guard: SwayOSD server unreachable — org.erikreider.swayosd-server not on the session bus, never a [FAIL] blaming tolerance drift for a dead instrument)"
else
    ORIG_LINE=$(pactl get-sink-volume @DEFAULT_SINK@)
    mapfile -t VOL_ORIG_RAW < <(printf '%s' "$ORIG_LINE" | grep -oP '(?<=: )\d+(?=\s*/)')
    if [[ "${#VOL_ORIG_RAW[@]}" -eq 0 ]]; then
        # T-11-REVIEWFIX (WR-01): pactl's output didn't match the expected
        # numeric shape — bail out before the mutation below runs at all,
        # since there is no validated baseline to restore to.
        check "one-step-per-press volume probe: pactl get-sink-volume output did not match the expected numeric shape — skipping mutation" "1"
    else
        # Arm the trap BEFORE the mutation below (T-11-11) — restoration is
        # the trap's job alone from this point on; this script never calls
        # _qsd_cleanup directly.
        VOL_RESTORE_NEEDED=1

        swayosd-client --output-volume raise >/dev/null 2>&1
        sleep 0.3
        NEW_LINE=$(pactl get-sink-volume @DEFAULT_SINK@)
        mapfile -t VOL_NEW_RAW < <(printf '%s' "$NEW_LINE" | grep -oP '(?<=: )\d+(?=\s*/)')
        if [[ "${#VOL_NEW_RAW[@]}" -eq 0 ]]; then
            # T-11-REVIEWFIX (WR-01): post-mutation read didn't match either
            # — the trap above still restores VOL_ORIG_RAW, we just can't
            # compute a delta against it.
            check "one-step-per-press volume probe: pactl get-sink-volume output did not match the expected numeric shape after the raise (baseline still restorable via the trap)" "1"
        else
            VOL_DELTA=$((VOL_NEW_RAW[0] - VOL_ORIG_RAW[0]))

            mkdir -p "$STATE_DIR"
            if [[ -f "$BASELINE_FILE" ]] && jq -e '.volume_step_delta_raw != null' "$BASELINE_FILE" >/dev/null 2>&1; then
                VOL_BASELINE=$(jq -r '.volume_step_delta_raw' "$BASELINE_FILE")
                # Compare within a tolerance band, not by exact equality. This
                # check exists to catch a *doubling* (two handlers firing per
                # press, which reads ~2x baseline); raw PulseAudio units round
                # differently depending on the sink's current level, so an
                # exact match spuriously fails by a unit or two. A 10% band
                # clears rounding while a doubling still misses by ~10x.
                VOL_TOLERANCE=$(( VOL_BASELINE / 10 ))
                (( VOL_TOLERANCE < 1 )) && VOL_TOLERANCE=1
                VOL_DRIFT=$(( VOL_DELTA - VOL_BASELINE ))
                (( VOL_DRIFT < 0 )) && VOL_DRIFT=$(( -VOL_DRIFT ))
                check "one-step-per-press volume probe: measured delta=${VOL_DELTA} raw units is within tolerance of recorded baseline=${VOL_BASELINE} (drift: ${VOL_DRIFT}, tolerance: +/-${VOL_TOLERANCE}; a doubling would show as drift ~${VOL_BASELINE} here)" "$([[ "$VOL_DRIFT" -le "$VOL_TOLERANCE" ]] && echo 0 || echo 1)"
            else
                BASELINE_JSON="{}"
                [[ -f "$BASELINE_FILE" ]] && BASELINE_JSON=$(cat "$BASELINE_FILE")
                printf '%s' "$BASELINE_JSON" | jq --argjson d "$VOL_DELTA" '.volume_step_delta_raw = $d' >"$BASELINE_FILE"
                check "one-step-per-press volume probe: seeded baseline delta=${VOL_DELTA} raw units (first run — no prior baseline)" "0"
            fi
        fi
    fi
fi

# ── 11. One step per press — brightness (QS-06). Same shape, guarded on
#    a real backlight-class device existing. Detect the CLASS, not mere
#    command presence, or this would try to raise the capslock LED. ───
BRI_HAS_BACKLIGHT=0
if command -v brightnessctl >/dev/null 2>&1 && brightnessctl -l 2>/dev/null | grep -q "class 'backlight'"; then
    BRI_HAS_BACKLIGHT=1
fi

if ! command -v swayosd-client >/dev/null 2>&1; then
    echo "  [SKIP] one-step-per-press brightness probe (swayosd-client not found)"
elif [[ "$BRI_HAS_BACKLIGHT" -eq 0 ]]; then
    echo "  [SKIP] one-step-per-press brightness probe (no backlight-class device — brightnessctl -l lists only leds-class devices on this host)"
else
    BRI_ORIG_RAW=$(brightnessctl get)
    # Arm the trap BEFORE the mutation below (T-11-11), same discipline
    # as the volume probe above.
    BRI_RESTORE_NEEDED=1

    swayosd-client --brightness raise >/dev/null 2>&1
    sleep 0.3
    BRI_NEW=$(brightnessctl get)
    BRI_DELTA=$((BRI_NEW - BRI_ORIG_RAW))

    mkdir -p "$STATE_DIR"
    if [[ -f "$BASELINE_FILE" ]] && jq -e '.brightness_step_delta_raw != null' "$BASELINE_FILE" >/dev/null 2>&1; then
        BRI_BASELINE=$(jq -r '.brightness_step_delta_raw' "$BASELINE_FILE")
        check "one-step-per-press brightness probe: measured delta=${BRI_DELTA} matches recorded baseline=${BRI_BASELINE}" "$([[ "$BRI_DELTA" == "$BRI_BASELINE" ]] && echo 0 || echo 1)"
    else
        BASELINE_JSON="{}"
        [[ -f "$BASELINE_FILE" ]] && BASELINE_JSON=$(cat "$BASELINE_FILE")
        printf '%s' "$BASELINE_JSON" | jq --argjson d "$BRI_DELTA" '.brightness_step_delta_raw = $d' >"$BASELINE_FILE"
        check "one-step-per-press brightness probe: seeded baseline delta=${BRI_DELTA} (first run — no prior baseline)" "0"
    fi
fi

# ── 12. Headless-output hotplug (QS-03, 11-04 Task 1) — the one
#    invasive-but-self-restoring group in this file. The removal trap
#    (T-11-15, above) is armed BEFORE the create call below runs, never
#    removes an output this run did not itself create, and never fires
#    inline — only via the EXIT/INT/TERM trap. Guarded by name: if a
#    monitor whose name already starts with HEADLESS exists before this
#    group runs, it is left completely untouched (someone may be using a
#    virtual output for their own reasons) and the whole group [SKIP]s.
if [[ "$NO_HEADLESS_OUTPUT" -eq 1 ]]; then
    echo "  [SKIP] headless output add (QS-03): disabled by --no-headless-output"
    echo "  [SKIP] per-screen surface creation (QS-03): disabled by --no-headless-output"
    echo "  [SKIP] reserved-space unchanged across hotplug (QS-03): disabled by --no-headless-output"
    echo "  [SKIP] headless output remove (QS-03): disabled by --no-headless-output"
elif ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    echo "  [SKIP] headless output add (QS-03): hyprctl or jq not found"
    echo "  [SKIP] per-screen surface creation (QS-03): hyprctl or jq not found"
    echo "  [SKIP] reserved-space unchanged across hotplug (QS-03): hyprctl or jq not found"
    echo "  [SKIP] headless output remove (QS-03): hyprctl or jq not found"
elif printf '%s\n' "$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name')" | grep -q '^HEADLESS'; then
    echo "  [SKIP] headless output add (QS-03): a monitor named HEADLESS* already exists — not touching it"
    echo "  [SKIP] per-screen surface creation (QS-03): a monitor named HEADLESS* already exists — not touching it"
    echo "  [SKIP] reserved-space unchanged across hotplug (QS-03): a monitor named HEADLESS* already exists — not touching it"
    echo "  [SKIP] headless output remove (QS-03): a monitor named HEADLESS* already exists — not touching it"
else
    # Baseline — bookkeeping only, not itself a check() call.
    QSD_BASELINE_NAMES=$(hyprctl monitors -j | jq -r '.[].name')
    QSD_BASELINE_COUNT=$(printf '%s\n' "$QSD_BASELINE_NAMES" | grep -c .)
    QSD_BASELINE_RESERVED=$(hyprctl monitors -j | jq -c '[.[] | {name, reserved}] | sort_by(.name)')

    # ── Add ── never assume a specific fixed name for the new output
    #    (Hyprland increments the numeric suffix across the session's
    #    lifetime, so it is not always the first one): read the actual
    #    name back from the monitor list, diffed against baseline.
    hyprctl output create headless >/dev/null 2>&1
    sleep 0.3
    QSD_AFTER_ADD_NAMES=$(hyprctl monitors -j | jq -r '.[].name')
    QSD_AFTER_ADD_COUNT=$(printf '%s\n' "$QSD_AFTER_ADD_NAMES" | grep -c .)
    QSD_NEW_MONITOR=$(comm -13 <(printf '%s\n' "$QSD_BASELINE_NAMES" | sort) <(printf '%s\n' "$QSD_AFTER_ADD_NAMES" | sort) | head -1)
    [[ -n "$QSD_NEW_MONITOR" ]] && HEADLESS_CREATED_NAME="$QSD_NEW_MONITOR"
    check "headless output add: monitor count increased by exactly one (before: ${QSD_BASELINE_COUNT}, after: ${QSD_AFTER_ADD_COUNT}), new output name read from the monitor list (not assumed): ${QSD_NEW_MONITOR:-<none>}" \
        "$([[ "$QSD_AFTER_ADD_COUNT" -eq $((QSD_BASELINE_COUNT + 1)) && -n "$QSD_NEW_MONITOR" ]] && echo 0 || echo 1)"

    # ── Per-screen surface creation ── summon the probe and assert
    #    hyprctl layers -j carries exactly one quickshell-probe entry
    #    under DP-1's key AND exactly one under the new monitor's key,
    #    with distinct addresses — not zero on the new screen (hotplug
    #    missed), not two on either (duplicate), not one shared address
    #    under both keys (the same surface listed twice).
    #
    #    D-13/D-14 (12-CONTEXT.md, one-way): checked BEFORE the summon —
    #    an accepted limitation should not keep paying for a probe cycle.
    #    See QS03_ACCEPTED_PERMANENT's record-why comment near the top of
    #    this file. PROBE_SUMMONED_FOR_HEADLESS_TEST is deliberately left
    #    untouched on this branch: no dispatch happens, so there is
    #    nothing for the cleanup trap to restore.
    if [[ "$QS03_ACCEPTED_PERMANENT" -eq 1 ]]; then
        echo "  [SKIP] per-screen surface fan-out accepted as a permanent limitation (single-monitor host, quickshell 0.3.0). See 11-VERIFICATION.md overrides[0] and 12-CONTEXT.md D-13."
    elif [[ -z "$QSD_NEW_MONITOR" ]]; then
        check "per-screen surface creation (QS-03): skipped — no new monitor name was captured by the add step" "1"
    else
        _qsd_dispatch_global "quickshell:probe"
        PROBE_SUMMONED_FOR_HEADLESS_TEST=1
        sleep 0.4
        QSD_LAYERS_AFTER=$(hyprctl layers -j 2>/dev/null)
        QSD_DP1_ADDRS=$(printf '%s' "$QSD_LAYERS_AFTER" | jq -r '(."DP-1".levels["3"] // [])[] | select(.namespace=="quickshell-probe") | .address' 2>/dev/null)
        QSD_NEW_ADDRS=$(printf '%s' "$QSD_LAYERS_AFTER" | jq -r --arg m "$QSD_NEW_MONITOR" '(.[$m].levels["3"] // [])[] | select(.namespace=="quickshell-probe") | .address' 2>/dev/null)
        QSD_DP1_COUNT=$(printf '%s\n' "$QSD_DP1_ADDRS" | grep -c . 2>/dev/null || true); QSD_DP1_COUNT=${QSD_DP1_COUNT:-0}
        QSD_NEW_COUNT=$(printf '%s\n' "$QSD_NEW_ADDRS" | grep -c . 2>/dev/null || true); QSD_NEW_COUNT=${QSD_NEW_COUNT:-0}
        QSD_SHARED_ADDR=0
        if [[ -n "$QSD_DP1_ADDRS" && -n "$QSD_NEW_ADDRS" ]] \
            && comm -12 <(printf '%s\n' "$QSD_DP1_ADDRS" | sort) <(printf '%s\n' "$QSD_NEW_ADDRS" | sort) | grep -q .; then
            QSD_SHARED_ADDR=1
        fi
        check "per-screen surface creation (QS-03): exactly one quickshell-probe surface under DP-1 (found: ${QSD_DP1_COUNT}) and exactly one under ${QSD_NEW_MONITOR} (found: ${QSD_NEW_COUNT}), addresses distinct, not shared (shared: ${QSD_SHARED_ADDR})" \
            "$([[ "$QSD_DP1_COUNT" -eq 1 && "$QSD_NEW_COUNT" -eq 1 && "$QSD_SHARED_ADDR" -eq 0 ]] && echo 0 || echo 1)"

        _qsd_dispatch_global "quickshell:probe"
        PROBE_SUMMONED_FOR_HEADLESS_TEST=0
        sleep 0.2
    fi

    # ── Reserved unchanged ── diff, never a hardcoded literal — every
    #    monitor present at baseline must show a byte-identical reserved
    #    array now that a new screen exists.
    QSD_AFTER_RESERVED_BASELINE_SUBSET=$(hyprctl monitors -j | jq -c --argjson base "$QSD_BASELINE_RESERVED" \
        '[.[] | select(.name as $n | ($base | map(.name) | index($n)) != null) | {name, reserved}] | sort_by(.name)')
    QSD_RESERVED_DIFF=0
    [[ "$QSD_BASELINE_RESERVED" != "$QSD_AFTER_RESERVED_BASELINE_SUBSET" ]] && QSD_RESERVED_DIFF=1
    check "reserved-space unchanged across the hotplug cycle (QS-03): every baseline monitor's reserved array is byte-identical after the new screen appeared (changed: ${QSD_RESERVED_DIFF})" \
        "$([[ "$QSD_RESERVED_DIFF" -eq 0 ]] && echo 0 || echo 1)"

    # ── Remove ── dismiss, remove the headless output, assert the
    #    monitor count returns to baseline, DP-1's probe is still
    #    creatable, the shell process kept the same PID, and no
    #    crash/abort marker landed in the launcher log during the cycle.
    QSD_PRE_REMOVE_PID=$(pgrep -x quickshell | head -1)
    hyprctl output remove "$QSD_NEW_MONITOR" >/dev/null 2>&1
    HEADLESS_CREATED_NAME=""
    sleep 0.3
    QSD_AFTER_REMOVE_COUNT=$(hyprctl monitors -j | jq length)
    QSD_POST_REMOVE_PID=$(pgrep -x quickshell | head -1)

    _qsd_dispatch_global "quickshell:probe"
    PROBE_SUMMONED_FOR_HEADLESS_TEST=1
    sleep 0.3
    QSD_DP1_STILL_WORKS=$(hyprctl layers -j 2>/dev/null | jq -r '(."DP-1".levels["3"] // [])[] | select(.namespace=="quickshell-probe") | .address' | grep -c . 2>/dev/null || true)
    QSD_DP1_STILL_WORKS=${QSD_DP1_STILL_WORKS:-0}
    _qsd_dispatch_global "quickshell:probe"
    PROBE_SUMMONED_FOR_HEADLESS_TEST=0
    sleep 0.2

    QSD_CRASH_HITS=$(tail -n 30 "$LAUNCHER_LOG" 2>/dev/null | grep -ciE 'fatal|panic|segmentation fault|core dumped|\babort(ed)?\b')
    check "headless output remove (QS-03): monitor count back to baseline (${QSD_AFTER_REMOVE_COUNT} == ${QSD_BASELINE_COUNT}), DP-1 probe still creatable (found: ${QSD_DP1_STILL_WORKS}), shell PID unchanged (${QSD_PRE_REMOVE_PID:-<none>} == ${QSD_POST_REMOVE_PID:-<none>}), no crash marker in launcher log (hits: ${QSD_CRASH_HITS})" \
        "$([[ "$QSD_AFTER_REMOVE_COUNT" -eq "$QSD_BASELINE_COUNT" && "$QSD_DP1_STILL_WORKS" -eq 1 && -n "$QSD_PRE_REMOVE_PID" && "$QSD_PRE_REMOVE_PID" == "$QSD_POST_REMOVE_PID" && "$QSD_CRASH_HITS" -eq 0 ]] && echo 0 || echo 1)"
fi

# ── D-16-23 (Phase 16 Plan 04) — seven checks closing the two risks this
#    phase's ROADMAP entry owns (permission silent-revert, blank-tile
#    failure), placed here after the pre-existing coexistence groups so
#    this file's established reading order is preserved. Check 6 is the
#    one deliberate mutation in this group (summon/dismiss the overview,
#    self-restoring via the trap above, same discipline as the D-15-25
#    panel checks and the reserved-space check further up).
_qsd_check_overview_namespace_conformance
# 17-03 Task 4 (standing constraint #4) — not part of the D-16-23 group
# (that group is overview-specific); placed here per the plan's own
# placement instruction, immediately after the namespace-conformance
# check this new check shares the most structural shape with.
_qsd_check_mpvpaper_layer_coexistence
_qsd_check_overview_shortcut_single_registration
_qsd_check_reserved_array_manifest_coverage
_qsd_check_permissions_enforce_readback
_qsd_check_permissions_allowlist_paths_resolve
_qsd_check_overview_content
_qsd_check_single_capture_path

echo ""
echo "Summary: ${PASS} passed, ${FAIL} failed"
[[ "$FAIL" -eq 0 ]]
exit $?

#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║              HYPR-LUA-HARNESS (Phase 13.1)            ║
# ║  Nested-compositor harness for safely test-driving a    ║
# ║  Hyprland Lua config entry point (live or draft) WITHOUT ║
# ║  touching the real live session (pid-owning compositor    ║
# ║  the operator is actually using) or the repository        ║
# ║  working tree.                                             ║
# ╚══════════════════════════════════════════════════════╝
#
# REPAIRED (13.1 gap-closure session, WR-01/13.1-REVIEW.md): originally
# built during the hyprlang-to-Lua migration (plans 13.1-03 through
# 13.1-08) around a `hyprland.lua.disabled` staging convention: the tool
# refused to run whenever `~/.config/hypr/hyprland.lua` already existed
# (meaning "the live session is already on Lua, this nested run isn't
# what you think it is") and required a `.disabled`-suffixed copy of the
# real entry point to boot from instead. The 13.1-10 cutover made both of
# those assumptions permanently false: `hyprland.lua` is now ALWAYS the
# live file (never `.disabled`), so the old guard could never again pass.
#
# Repaired rather than retired: this tool's actual job — boot a real,
# isolated nested Hyprland instance from a chosen Lua entry point without
# fighting the live session over layer namespaces/D-Bus names — has
# ongoing value for testing FUTURE hyprland.lua/config/*.lua changes
# before they ever touch the live compositor, independent of the
# migration that originally motivated building it. The entry point is now
# an explicit `--entry <path>` argument (default: the live
# `~/.config/hypr/hyprland.lua` itself, since that IS the current
# source of truth) instead of a hardcoded `.disabled`-suffix convention.
#
# Usage:
#   hypr-lua-harness start [--with-autostart] [--entry <path>]
#       Default --entry: ~/.config/hypr/hyprland.lua (the live entry
#       point — the harness boots a nested, fully-isolated copy of it,
#       it never reads FROM or writes TO the live compositor's own
#       process). Pass an explicit --entry to test-drive a draft/modified
#       copy before it is ever installed live. mktemp -d a throwaway
#       root, symlink every entry of ~/.config/hypr/ into <root>/hypr/
#       EXCEPT hyprland.conf and hyprland.lua itself (the entry point is
#       always written explicitly below, never symlinked, so the
#       autostart-filter step can edit it without risk of writing through
#       a symlink into the real live file), write <root>/hypr/hyprland.lua
#       from --entry with the require("config.autostart") line filtered
#       out (unless --with-autostart was passed) — asserting exactly one
#       line was removed — launch Hyprland nested under
#       XDG_CONFIG_HOME=<root>, wait for it to appear in
#       `hyprctl instances -j`, and print its instance signature.
#       Autostart is excluded by default: a nested instance running this
#       repo's exec-once lines would spawn a second
#       waybar/swaync/walker/quickshell/wallpaper-daemon and fight the
#       live session over layer namespaces and the
#       org.freedesktop.Notifications bus name.
#
#   hypr-lua-harness hyprctl <args...>
#       Forward to `hyprctl -i <signature> <args...>` against the running
#       nested instance.
#
#   hypr-lua-harness status
#       Print the signature, or exit non-zero when nothing is running.
#
#   hypr-lua-harness stop
#       Terminate the nested instance and remove the throwaway root.
#
# This tool never writes to ~/.config/hypr/ and never writes into the
# repository working tree — its only writes are the mktemp -d throwaway
# root (removed by `stop`) and a small state file under $XDG_RUNTIME_DIR
# recording which nested instance/root the running harness owns. It also
# never sends any dispatch/reload to the live compositor — the nested
# instance is a fully separate Hyprland process with its own
# HYPRLAND_INSTANCE_SIGNATURE, reached only via `hyprctl -i <signature>`.

set -uo pipefail

HYPR_CONF_DIR="$HOME/.config/hypr"
STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/hypr-lua-harness.state"

usage() {
    echo "Usage: hypr-lua-harness start [--with-autostart] [--entry <path>] | hyprctl <args...> | status | stop" >&2
}

CMD="${1:-}"
[[ $# -gt 0 ]] && shift

case "$CMD" in
    start)
        WITH_AUTOSTART=0
        ENTRY_POINT="$HYPR_CONF_DIR/hyprland.lua"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --with-autostart)
                    WITH_AUTOSTART=1
                    shift
                    ;;
                --entry)
                    [[ $# -ge 2 ]] || { echo "hypr-lua-harness: --entry requires a path argument" >&2; exit 1; }
                    ENTRY_POINT="$2"
                    shift 2
                    ;;
                *)
                    echo "hypr-lua-harness: unrecognised argument: $1" >&2
                    usage
                    exit 1
                    ;;
            esac
        done

        if [[ -f "$STATE_FILE" ]]; then
            echo "hypr-lua-harness: a harness instance already appears to be running (state file $STATE_FILE exists) — run 'stop' first, or remove the file if stale" >&2
            exit 1
        fi

        if [[ ! -f "$ENTRY_POINT" ]]; then
            echo "hypr-lua-harness: entry point $ENTRY_POINT not found" >&2
            exit 1
        fi

        for tool in hyprctl jq mktemp; do
            command -v "$tool" >/dev/null 2>&1 || { echo "hypr-lua-harness: $tool not found in PATH" >&2; exit 1; }
        done

        ROOT="$(mktemp -d)"
        mkdir -p "$ROOT/hypr"

        # Symlink every entry of the real config root into the throwaway
        # root EXCEPT hyprland.conf and hyprland.lua itself — never write
        # into or read a stale copy of the repo working tree, and never
        # symlink the entry-point NAME (hyprland.lua) regardless of
        # whether --entry points at the live file or a draft elsewhere:
        # the autostart-filter write below always targets
        # $ROOT/hypr/hyprland.lua directly, and if that path were still a
        # symlink to the REAL live ~/.config/hypr/hyprland.lua, the `>`
        # redirection would write straight through the symlink and
        # corrupt the live file. Every other entry (config/, scripts/,
        # lib/, hyprlock.conf, ...) is reached live through these
        # symlinks.
        for entry in "$HYPR_CONF_DIR"/*; do
            base="$(basename "$entry")"
            [[ "$base" == "hyprland.conf" ]] && continue
            [[ "$base" == "hyprland.lua" ]] && continue
            ln -s "$entry" "$ROOT/hypr/$base"
        done

        # Assert the harness entry point is provably in sync with the real
        # one: filtering the autostart require line must remove EXACTLY
        # one line, or the harness refuses rather than silently booting a
        # drifted copy. Anchored to line-start/end (^...$) so it matches
        # only the real CODE line, never an explanatory comment mentioning
        # the same string.
        AUTOSTART_MATCHES="$(grep -cx 'require("config.autostart")' "$ENTRY_POINT" || true)"
        if [[ "$AUTOSTART_MATCHES" != "1" ]]; then
            echo "hypr-lua-harness: expected exactly ONE require(\"config.autostart\") line in $ENTRY_POINT, found $AUTOSTART_MATCHES — refusing to start (the entry point has drifted from what this harness expects)" >&2
            rm -rf "$ROOT"
            exit 1
        fi

        if [[ "$WITH_AUTOSTART" == "1" ]]; then
            cp "$ENTRY_POINT" "$ROOT/hypr/hyprland.lua"
        else
            grep -vx 'require("config.autostart")' "$ENTRY_POINT" > "$ROOT/hypr/hyprland.lua"
        fi

        LOG_FILE="$ROOT/nested-hyprland.log"
        XDG_CONFIG_HOME="$ROOT" Hyprland > "$LOG_FILE" 2>&1 &
        HYPR_PID=$!
        disown "$HYPR_PID" 2>/dev/null || true

        SIGNATURE=""
        for _ in $(seq 1 50); do
            if ! kill -0 "$HYPR_PID" 2>/dev/null; then
                break
            fi
            SIGNATURE="$(hyprctl instances -j 2>/dev/null \
                | jq -r --arg pid "$HYPR_PID" 'map(select((.pid|tostring) == $pid)) | .[0].instance // empty' 2>/dev/null)"
            [[ -n "$SIGNATURE" ]] && break
            sleep 0.2
        done

        if [[ -z "$SIGNATURE" ]]; then
            echo "hypr-lua-harness: nested Hyprland instance did not appear in 'hyprctl instances -j' within 10s (see $LOG_FILE)" >&2
            kill "$HYPR_PID" 2>/dev/null || true
            rm -rf "$ROOT"
            exit 1
        fi

        printf '%s\t%s\t%s\n' "$SIGNATURE" "$ROOT" "$HYPR_PID" > "$STATE_FILE"
        echo "$SIGNATURE"
        ;;

    hyprctl)
        if [[ ! -f "$STATE_FILE" ]]; then
            echo "hypr-lua-harness: no running harness instance (run 'start' first)" >&2
            exit 1
        fi
        SIGNATURE="$(cut -f1 "$STATE_FILE")"
        hyprctl -i "$SIGNATURE" "$@"
        ;;

    status)
        if [[ ! -f "$STATE_FILE" ]]; then
            echo "hypr-lua-harness: no running harness instance" >&2
            exit 1
        fi
        SIGNATURE="$(cut -f1 "$STATE_FILE")"
        if hyprctl instances -j 2>/dev/null | jq -e --arg sig "$SIGNATURE" '[.[].instance] | index($sig) != null' >/dev/null 2>&1; then
            echo "$SIGNATURE"
            exit 0
        else
            echo "hypr-lua-harness: recorded instance $SIGNATURE is no longer running" >&2
            exit 1
        fi
        ;;

    stop)
        if [[ ! -f "$STATE_FILE" ]]; then
            echo "hypr-lua-harness: no running harness instance" >&2
            exit 1
        fi
        IFS=$'\t' read -r SIGNATURE ROOT PID < "$STATE_FILE"

        hyprctl -i "$SIGNATURE" dispatch exit >/dev/null 2>&1 || true
        for _ in $(seq 1 20); do
            kill -0 "$PID" 2>/dev/null || break
            sleep 0.2
        done
        kill -0 "$PID" 2>/dev/null && kill "$PID" 2>/dev/null
        sleep 0.2

        [[ -n "$ROOT" && -d "$ROOT" ]] && rm -rf "$ROOT"
        rm -f "$STATE_FILE"
        ;;

    *)
        usage
        exit 1
        ;;
esac

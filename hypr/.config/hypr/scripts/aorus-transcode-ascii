#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════╗
# ║           AORUS-TRANSCODE-ASCII (quick-260827-b52)        ║
# ║  Turn an image into the block/braille art the screensaver ║
# ║  renders. Ruling D6: branding is swappable.               ║
# ╚══════════════════════════════════════════════════════════╝
#
# Ported from Omarchy's `omarchy-transcode-ascii` (vendored at
# .planning/notes/aorus-screensaver/, master f4378f0d). The awk half —
# the PBM-to-half-block and PBM-to-braille pairing — is theirs and is
# reproduced faithfully; the option parsing is rewritten smaller, the
# defaults are retuned for this shell's own wordmark geometry, and the
# output path defaults to this repo's branding location rather than
# Omarchy's.
#
# The shipped wordmark (quickshell/.config/quickshell/assets/wordmark.txt,
# 10 rows x 78 cols) was generated by exactly this pipeline from the text
# "AORUS" — see --demo below, which reproduces it.
#
# WHY BLOCK IS THE DEFAULT AND BRAILLE IS NOT
# Braille packs 2x4 pixels per cell against block's 1x2, so it carries
# four times the detail per column — which is why Omarchy defaults to it
# for arbitrary logos. This shell defaults to block because the
# screensaver's fallback font chain (SaverArt.qml's `fontFamilies`) is
# only PROVEN to cover Block Elements U+2580-U+259F on a fresh install;
# Noto Sans Mono's braille coverage is not part of that proof. Pass
# --braille if your font has it and you want the detail.
#
# HARD REQUIREMENT: ImageMagick. Already in install.sh's package list
# (`imagemagick`), so this needs no new dependency.
set -o pipefail

BRANDING_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/aorus/branding"
DEFAULT_OUT="$BRANDING_DIR/screensaver.txt"

usage() {
    cat <<'EOF'
Usage:
  aorus-transcode-ascii <image.svg|png|jpg> [output-path] [options]
  aorus-transcode-ascii --text <STRING> [output-path] [options]
  aorus-transcode-ascii --demo

Writes block/braille art for the Quickshell screensaver to
  ~/.config/aorus/branding/screensaver.txt   (the default output path)
which SaverArt.qml prefers over the built-in wordmark whenever it exists.

Options:
  -w, --width <columns>      Output width in character columns (default: 78)
  -H, --height <rows>        Output height in character rows    (default: 10)
  -m, --mode <block|braille> Output style                       (default: block)
  -t, --threshold <percent>  Pixel cutoff, 0-100                (default: 50)
      --invert               Treat light pixels as the mark, not dark ones
      --font <name>          Font for --text (default: a bold mono from fc-match)
      --stdout               Print to stdout instead of writing a file
      --demo                 Regenerate the shipped "AORUS" wordmark and print it
      --help                 This

Notes:
  * 78x10 is the shipped wordmark's own geometry and a good target: the
    screensaver sizes glyphs from the output width and the column count,
    so a much wider mark renders in a much smaller font.
  * Rows are padded to the widest row on write. SaverArt.qml re-pads on
    read, but the constellation style maps cells by column index, so
    ragged input would shift glyphs left.
  * Delete the output file to go back to the built-in wordmark.
EOF
}

die() { echo "aorus-transcode-ascii: $*" >&2; exit 1; }

width=78
height=10
mode=block
threshold=50
invert=false
to_stdout=false
text=""
font=""
image=""
output=""
demo=false

while (($# > 0)); do
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --demo) demo=true; shift ;;
        --stdout) to_stdout=true; shift ;;
        --invert) invert=true; shift ;;
        --braille) mode=braille; shift ;;
        --block) mode=block; shift ;;
        -w|--width) width="${2:?--width needs a value}"; shift 2 ;;
        -H|--height) height="${2:?--height needs a value}"; shift 2 ;;
        -m|--mode) mode="${2:?--mode needs a value}"; shift 2 ;;
        -t|--threshold) threshold="${2:?--threshold needs a value}"; shift 2 ;;
        --text) text="${2:?--text needs a value}"; shift 2 ;;
        --font) font="${2:?--font needs a value}"; shift 2 ;;
        -*) die "unknown option '$1' (try --help)" ;;
        *)
            if [[ -z $image && -z $text ]]; then image="$1"
            elif [[ -z $output ]]; then output="$1"
            else die "unexpected argument '$1'"
            fi
            shift
            ;;
    esac
done

if [[ $demo == true ]]; then
    text="AORUS"
    to_stdout=true
fi

[[ -n $image || -n $text ]] || { usage >&2; exit 1; }
[[ $mode == block || $mode == braille ]] || die "--mode must be block or braille"
[[ $width =~ ^[0-9]+$ ]] && ((width >= 1)) || die "--width must be a positive integer"
[[ $height =~ ^[0-9]+$ ]] && ((height >= 1)) || die "--height must be a positive integer"
[[ $threshold =~ ^[0-9]+$ ]] && ((threshold <= 100)) || die "--threshold must be 0-100"
command -v magick >/dev/null 2>&1 || die "ImageMagick (magick) is required"
[[ -z $image || -f $image ]] || die "no such image: $image"

output="${output:-$DEFAULT_OUT}"

# Pixel budget per cell: braille packs 2x4, block packs 1x2.
if [[ $mode == braille ]]; then
    px_w=$((width * 2)); px_h=$((height * 4))
else
    px_w=$width; px_h=$((height * 2))
fi

# ── Source: either a real image, or text rendered into one ──────────────
# For --text, `fc-match` resolves a FILE rather than a family name because
# ImageMagick's own font lookup does not see fontconfig aliases here
# (measured: `-font "FiraCode Nerd Font Mono SemiBold"` fails with
# "unable to read font", the resolved .ttf path works).
tmp_src=""
if [[ -n $text ]]; then
    if [[ -z $font ]]; then
        font=$(fc-match -f '%{file}' "FiraCode Nerd Font Mono:weight=bold" 2>/dev/null)
        [[ -n $font && -f $font ]] || font=$(fc-match -f '%{file}' "monospace:weight=bold" 2>/dev/null)
    elif [[ ! -f $font ]]; then
        font=$(fc-match -f '%{file}' "$font" 2>/dev/null)
    fi
    [[ -n $font && -f $font ]] || die "could not resolve a font file for --text"
    tmp_src=$(mktemp --suffix=.png) || die "mktemp failed"
    # pointsize 400 + kerning 20 are the shipped wordmark's own values:
    # large enough that the threshold below lands on clean strokes rather
    # than on antialiasing, and loose enough that adjacent letters do not
    # merge into one blob at 78 columns.
    magick -background none -fill white -font "$font" -pointsize 400 -kerning 20 \
        label:"$text" "$tmp_src" || die "text render failed"
    image="$tmp_src"
fi

cleanup() { [[ -n $tmp_src ]] && rm -f "$tmp_src"; }
trap cleanup EXIT

# ── Alpha vs luminance ──────────────────────────────────────────────────
# A transparent PNG/SVG logo carries its shape in the ALPHA channel; a
# flat JPEG carries it in luminance. Omarchy's own probe: if the alpha
# channel has any variation at all, use it; otherwise fall back to grey.
alpha_min=$(magick -background none "$image" -alpha extract -format '%[fx:minima]' info: 2>/dev/null) \
    || die "unable to read image: $image"
alpha_max=$(magick -background none "$image" -alpha extract -format '%[fx:maxima]' info: 2>/dev/null)

args=(-background none "$image" -auto-orient)
if awk -v a="$alpha_min" -v b="$alpha_max" 'BEGIN { exit !(a < 0.999 && b > a) }'; then
    args+=(-alpha extract -alpha off)
    [[ $invert == true ]] && args+=(-negate)
else
    args+=(-alpha remove -alpha off -colorspace Gray)
    [[ $invert == false ]] && args+=(-negate)
fi
args+=(-bordercolor black -border 1 -trim +repage
       -resize "${px_w}x${px_h}!" -threshold "${threshold}%" -negate -compress none pbm:-)

# ── PBM -> characters ───────────────────────────────────────────────────
# Both awk programs are Omarchy's, unchanged in substance: read the P1
# tokens, pair pixels into cells, trim blank rows off both ends.
read -r -d '' BLOCK_AWK <<'AWKEOF'
BEGIN { blk["11"]="█"; blk["10"]="▀"; blk["01"]="▄"; blk["00"]=" " }
{ sub(/#.*/,""); for (i=1;i<=NF;i++) tok[++n]=$i }
END {
  if (tok[1] != "P1") exit 1
  w=tok[2]; h=tok[3]; off=4
  for (y=0; y<h; y+=2) {
    line=""
    for (x=0; x<w; x++) {
      t=tok[off+(y*w)+x]
      b=(y+1<h) ? tok[off+((y+1)*w)+x] : 0
      line=line blk[t b]
    }
    sub(/[ ]+$/,"",line); L[++c]=line
  }
  f=1; while (f<=c && L[f]~/^[ ]*$/) f++
  l=c; while (l>=f && L[l]~/^[ ]*$/) l--
  for (i=f;i<=l;i++) print L[i]
}
AWKEOF

read -r -d '' BRAILLE_AWK <<'AWKEOF'
BEGIN {
  base=10240
  d[0,0]=1;  d[0,1]=2;  d[0,2]=4;  d[1,0]=8
  d[1,1]=16; d[1,2]=32; d[0,3]=64; d[1,3]=128
}
{ sub(/#.*/,""); for (i=1;i<=NF;i++) tok[++n]=$i }
END {
  if (tok[1] != "P1") exit 1
  w=tok[2]; h=tok[3]; off=4
  for (y=0; y<h; y+=4) {
    line=""
    for (x=0; x<w; x+=2) {
      code=0
      for (dy=0; dy<4; dy++) for (dx=0; dx<2; dx++)
        if (y+dy<h && x+dx<w && tok[off+((y+dy)*w)+x+dx]==1) code+=d[dx,dy]
      line = line (code==0 ? " " : sprintf("%c", base+code))
    }
    sub(/[ ]+$/,"",line); L[++c]=line
  }
  f=1; while (f<=c && L[f]~/^[ ]*$/) f++
  l=c; while (l>=f && L[l]~/^[ ]*$/) l--
  for (i=f;i<=l;i++) print L[i]
}
AWKEOF

tmp_out=$(mktemp) || die "mktemp failed"
cleanup() { [[ -n $tmp_src ]] && rm -f "$tmp_src"; rm -f "$tmp_out"; }

if [[ $mode == braille ]]; then
    magick "${args[@]}" | awk "$BRAILLE_AWK" > "$tmp_out" || die "conversion failed"
else
    magick "${args[@]}" | awk "$BLOCK_AWK" > "$tmp_out" || die "conversion failed"
fi

[[ -s $tmp_out ]] || die "no pixels survived the threshold — try --threshold or --invert"

# Pad every row to the widest one. SaverArt.qml re-pads on read, but the
# constellation style divides column index by (cols - 1) to place points,
# so a ragged file would place glyphs of short rows too far left.
awk '{ L[NR]=$0; if (length($0)>m) m=length($0) }
     END { for (i=1;i<=NR;i++) { s=L[i]; while (length(s)<m) s=s " "; print s } }' \
    "$tmp_out" > "$tmp_out.pad" && mv "$tmp_out.pad" "$tmp_out"

if [[ $to_stdout == true ]]; then
    cat "$tmp_out"
    [[ $demo == true ]] && echo >&2 "" && \
        echo >&2 "$(wc -l < "$tmp_out") rows x $(awk '{print length($0)}' "$tmp_out" | sort -rn | head -1) cols"
    exit 0
fi

mkdir -p "$(dirname "$output")" || die "cannot create $(dirname "$output")"
cp "$tmp_out" "$output" || die "cannot write $output"
echo "Wrote $(wc -l < "$output") rows to $output"
echo "The screensaver picks it up on its next appearance — no restart needed."

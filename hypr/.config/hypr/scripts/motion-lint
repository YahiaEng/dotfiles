#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║                  MOTION-LINT (12-05)                  ║
# ║  Deny-by-default motion-token gate. Report-only —      ║
# ║  never mutates any file. Exits nonzero if ANY check    ║
# ║  FAILs.                                                ║
# ╚══════════════════════════════════════════════════════╝
#
# TOKEN-04 requires that a surface hand-rolling its own duration/easing value
# fails a gate, and D-24 requires the gate to ALSO catch a token reference
# that does not resolve — a raw-value check alone just teaches an author to
# replace a literal with a reference, and a typo'd reference then satisfies
# the lint while silently breaking the animation (two of the three render
# targets fail *silently* on a dangling reference — see Pitfall 6/D-24).
#
#   CHECK A — reference resolution: every motion-token reference in every
#             non-exempt scanned surface (a CSS `var(--motion-*)` usage, a
#             QML `Motion.<property>` usage, or the curve name in a
#             Hyprland `animation =` line) must resolve against the name
#             set the pipeline actually emitted under
#             ~/.local/state/theme/{gtk-4.0-motion.css,motion.json,
#             hyprland-motion.conf}. This is the WLOG-01-style killer for
#             motion, exactly `waybar-design-lint`'s CHECK A precedent.
#   CHECK B — no raw values: no non-exempt surface may hand-roll a bare
#             duration/easing literal instead of consuming a token. For
#             CSS/QML this is a literal `Nms`/`Ns`/`cubic-bezier(...)`/CSS
#             easing keyword outside a `var(...)`/`Motion.*` reference; for
#             Hyprland it is a `bezier =` line defining a NEW curve under a
#             non-`motion-`-prefixed name instead of consuming an emitted
#             one (Hyprland has no `var()`-equivalent reference mechanism —
#             a hand-authored curve IS the raw-value shape there).
#   CHECK C — scanned-count floor: the run must scan more than zero
#             surfaces; a fixed expected count would go stale the moment a
#             later phase adds surfaces, so the assertion is `> 0`, with
#             the actual count printed on every run so a partial-glob miss
#             is visible to a human.
#
# Deny-by-default (D-23): every repo-authored GTK4 stylesheet, Hyprland
# `.conf` fragment under the hypr config tree, and `.qml` file under the
# quickshell config tree is scanned; there is no per-file opt-in registry,
# so a brand-new Phase 14-17 surface is covered the moment its file exists.
# A small, explicit EXEMPTIONS list (below) carries the debt this phase
# deliberately does not close yet — every entry requires a non-empty
# reason and prints an `[EXEMPT]` line on EVERY run, so that debt stays
# visible rather than becoming an invisible, permanently-green gate over
# non-compliant surfaces (this plan's prohibition).
#
# Usage:
#   motion-lint [target-dir]
#       No argument: scans the real deployed surface set (hypr config
#       tree, quickshell config tree, and the known GTK app config dirs).
#       With an argument: treats target-dir as ONE flat directory and
#       recursively globs the same three extensions (.css/.scss, .conf,
#       .qml) inside it — the same code path serves a throwaway/poisoned
#       fixture directory as serves the real tree (keybind-doctor's D-18
#       path-argument precedent: "a gate that cannot fail is not a gate").
#
#   motion-lint --self-test
#       Runs this script against each of the eleven committed fixtures
#       under tests/motion-fixtures/ (one at a time, in isolation) and asserts
#       the expected verdict: compliant fixtures exit 0, poisoned fixtures
#       exit non-zero. Makes criterion 3's "proven to fail" property a
#       permanent, rerunnable command rather than a one-time demonstration
#       (D-28).
#
#   motion-lint --no-pending
#       Opt-in, never default (D-33): asserts zero entries across both
#       EXEMPTIONS and LINE_EXEMPTIONS carry a structured `pending: True`
#       field. A wholly separate assertion pass — same shape as
#       --self-test above — that runs no surface scan at all; it only
#       inspects the exemption declarations themselves. Exits 0 when every
#       entry is permanent (`pending: False`); exits 1 and names each
#       offending entry otherwise. A plain `motion-lint` run with no flags
#       never performs this assertion, so adding a genuinely temporary
#       exemption (`pending: True`) does not fail the everyday gate.
#
#   MOTION_LINT_STATE_DIR (env, optional)
#       Overrides the definition-source directory (default
#       ~/.local/state/theme). Exists so the "refuse to proceed on an
#       empty definition set" guard can be exercised against a throwaway
#       empty directory without touching live state.
#
# Never runs theme-apply, never edits anything — pure read-only analysis.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
FIXTURES_DIR="$SCRIPT_DIR/tests/motion-fixtures"
STATE_DIR="${MOTION_LINT_STATE_DIR:-$HOME/.local/state/theme}"

PASS=0
FAIL=0

check() {
    local desc="$1"
    local ok="$2"
    if [[ "$ok" == "0" ]]; then
        printf '  [PASS] %s\n' "$desc"
        PASS=$((PASS + 1))
    else
        printf '  [FAIL] %s\n' "$desc"
        FAIL=$((FAIL + 1))
    fi
}

# ── Single python pass: definitions, exemptions, scanned-count and both
#    checks, TAB-separated TAG/STATUS/detail lines on stdout. One process
#    so the comment strippers and reference/raw-value regexes are defined
#    exactly once (waybar-design-lint's precedent). ───────────────────────
_motion_lint_checks() {
    python3 - "$STATE_DIR" "$FIXTURES_DIR" "${ROOTS[@]}" <<'PYEOF'
import json
import os
import re
import sys

state_dir = sys.argv[1]
fixtures_dir = os.path.realpath(sys.argv[2])
roots = sys.argv[3:]

results = []  # (tag, status, detail) — tag in {A, B, C, DEFS, EXEMPT, ABORT}


def emit(tag, status, detail):
    results.append((tag, status, detail))


def dump():
    for tag, status, detail in results:
        print(f'{tag}\t{status}\t{detail}')


# ── Comment strippers (newline-preserving, so line numbers stay accurate
#    for the file:line citations UI-SPEC's Copywriting Contract mandates)
def strip_block_comments(text):
    out = []
    i = 0
    n = len(text)
    while i < n:
        if text[i] == '/' and i + 1 < n and text[i + 1] == '*':
            j = text.find('*/', i + 2)
            end = n if j == -1 else j + 2
            for ch in text[i:end]:
                out.append('\n' if ch == '\n' else ' ')
            i = end
        else:
            out.append(text[i])
            i += 1
    return ''.join(out)


def strip_css_comments(text):
    return strip_block_comments(text)


def strip_qml_comments(text):
    text = strip_block_comments(text)
    lines = text.split('\n')
    out = []
    # WR-03: `line.find('//')` had no awareness of string literals — a line
    # placing a real `Motion.*` reference or a raw duration/bezier literal
    # AFTER a `//`-containing string (e.g. `"https://example.com"`) on the
    # same line would have that content silently deleted before either
    # CHECK ever saw it. Track quote state char-by-char (with backslash-
    # escape awareness) so a `//` inside an open `"..."`/'...' span is never
    # mistaken for a comment start.
    for line in lines:
        in_string = None
        cut = -1
        i = 0
        n = len(line)
        while i < n:
            ch = line[i]
            if in_string:
                if ch == '\\' and i + 1 < n:
                    i += 2
                    continue
                if ch == in_string:
                    in_string = None
            elif ch in ('"', "'"):
                in_string = ch
            elif ch == '/' and i + 1 < n and line[i + 1] == '/':
                cut = i
                break
            i += 1
        out.append(line[:cut] if cut != -1 else line)
    return '\n'.join(out)


def strip_hash_comments(text):
    lines = text.split('\n')
    out = []
    for line in lines:
        idx = line.find('#')
        out.append(line[:idx] if idx != -1 else line)
    return '\n'.join(out)


# ── Definition sets — built from the emitted render targets, never a
#    hardcoded list (D-24/Pitfall 3-adjacent: reading the real output is
#    what keeps the lint from drifting away from what the pipeline
#    actually emits). ────────────────────────────────────────────────────
def load_gtk_defs():
    path = os.path.join(state_dir, 'gtk-4.0-motion.css')
    defs = set()
    if os.path.isfile(path):
        try:
            body = open(path, encoding='utf-8').read()
        except OSError:
            return defs
        for m in re.finditer(r'^\s*--(motion-[A-Za-z0-9_-]+)\s*:', body, re.M):
            defs.add(m.group(1))
    return defs


def load_hypr_defs():
    path = os.path.join(state_dir, 'hyprland-motion.conf')
    bezier_names = set()
    var_names = set()
    if os.path.isfile(path):
        try:
            body = open(path, encoding='utf-8').read()
        except OSError:
            return bezier_names, var_names
        for m in re.finditer(r'^\s*bezier\s*=\s*([A-Za-z0-9_-]+)\s*,', body, re.M):
            bezier_names.add(m.group(1))
        for m in re.finditer(r'^\$([A-Za-z_][A-Za-z0-9_]*)\s*=', body, re.M):
            var_names.add(m.group(1))
    return bezier_names, var_names


def load_qml_defs():
    path = os.path.join(state_dir, 'motion.json')
    defs = set()
    if os.path.isfile(path):
        try:
            data = json.loads(open(path, encoding='utf-8').read())
        except Exception:
            return defs
        for key in (data.get('semantic') or {}).keys():
            camel = re.sub(r'-([a-z0-9])', lambda m: m.group(1).upper(), key)
            defs.add(camel + 'Duration')
            defs.add(camel + 'Easing')
        # motion.json's top-level `motion_enabled` boolean is the real
        # global gate Pitfall 4 (12-RESEARCH.md) requires QML surfaces to
        # bind Behavior.enabled to directly — a genuine Motion.* reference,
        # not just the per-pair duration/easing properties above.
        if 'motion_enabled' in data:
            defs.add('motionEnabled')
    return defs


gtk_defs = load_gtk_defs()
hypr_bezier_defs, hypr_var_defs = load_hypr_defs()
qml_defs = load_qml_defs()

# ── Exemption list (D-23/D-32) — path-glob -> required non-empty reason.
#    Printed on EVERY run regardless of whether a matching file currently
#    exists, so outstanding debt never goes invisible. D-32's end state
#    (13-06): all three remaining whole-file entries below share ONE
#    reason now — each surface has ZERO repo-authored motion literals,
#    full stop, so retrofitting it onto motion tokens would add a
#    fresh-install failure path with no coverage behind it. This is a
#    recorded DECISION, not unfinished work — none of the three carries
#    the old temporary-retrofit phrasing anymore, and each has an
#    explicit structured `pending: False` field (see below) rather than
#    that fact living only in prose. A future Phase 14+ surface that genuinely
#    needs a TEMPORARY exemption sets `pending: True` on its own entry;
#    `--no-pending` (below) is the opt-in assertion that catches one left
#    behind.
#    wleave's own whole-file entry was REMOVED by plan 12-07 (TOKEN-03/
#    D-19/D-23) once it retrofitted wleave's stylesheet onto emitted
#    tokens — wleave/style.css is now covered by CHECK A and CHECK B like
#    any other non-exempt surface (see LINE_EXEMPTIONS below for the one
#    narrow carve-out D-19 still requires).
#    hypr/config/animations.conf's whole-file entry was REMOVED by plan
#    13-01 (MOTION-01/D-32) once it retrofitted every `animation =` line
#    onto $motion_speed_*/$motion_curve_*/motion-* tokens emitted by
#    hyprland-motion.conf — the file is now covered by CHECK A/B like any
#    other non-exempt Hyprland surface (see check_hypr_surface below).
#    swaync/style.css's whole-file entry was REMOVED by plan 13-02
#    (MOTION-02/D-01/D-34) once it converted the file to style.scss and
#    tokenized all six transitions onto the sass-compiled _motion.scss
#    partial — the renamed .scss source is picked up by this script's
#    existing .css/.scss glob with no code change, and is now covered by
#    CHECK A/B like any other non-exempt CSS/SCSS surface (see
#    check_css_surface below). swayosd/style.css stays exempt (D-02: zero
#    motion literals, motion is entirely compositor-delivered) — it was
#    never a candidate for this conversion.
#    waybar/*.css's whole-file entry was REMOVED by plan 13-05
#    (MOTION-02/D-01) once it converted all six waybar stylesheets to
#    sass (theme.scss, style-{full,athena,floating,vertical}.scss,
#    waybar-modules.scss) and tokenized every transition/animation-
#    duration/animation-timing-function declaration onto the same
#    sass-compiled _motion.scss partial swaync consumes — the renamed
#    .scss sources are picked up by this script's existing .css/.scss
#    glob with no code change, and are now covered by CHECK A/B like any
#    other non-exempt CSS/SCSS surface (see check_css_surface below).
EXEMPTIONS = [
    {'glob': 'swayosd/style.css', 'regex': re.compile(r'(^|/)swayosd/style\.css$'),
     'reason': 'no motion literals — motion is compositor-delivered through '
               'the layer animation (D-02)',
     'pending': False},
    {'glob': 'walker/**/style.css', 'regex': re.compile(r'(^|/)walker/.*/style\.css$'),
     'reason': 'no motion literals — motion is compositor-delivered through '
               'the layer animation',
     'pending': False},
    {'glob': 'ags/*.scss', 'regex': re.compile(r'(^|/)ags/[^/]+\.scss$'),
     'reason': 'no motion literals — motion is compositor-delivered through '
               'the layer animation',
     'pending': False},
]

for ex in EXEMPTIONS:
    if not ex['reason'].strip():
        emit('EXEMPT', 'FAIL', f"{ex['glob']}: exemption entry has an empty reason (deny-by-default violation)")
    else:
        emit('EXEMPT', 'INFO', f"{ex['glob']} — {ex['reason']}")


def path_is_exempt(path):
    return any(ex['regex'].search(path) for ex in EXEMPTIONS)


# ── Line-scoped exemptions (D-23 sibling mechanism, added 12-07) — a
#    narrower carve-out than a whole-file EXEMPTIONS entry: covers exactly
#    one CSS rule inside a file that is otherwise fully non-exempt.
#    Printed once per declared entry regardless of whether it currently
#    matches anything, same visibility discipline as EXEMPTIONS. Exists
#    because wleave's `button:hover, button:focus` rule intentionally
#    keeps its overshoot timing function AND its three still-literal
#    `150ms ease` transitions (12-07 Task 1's D-19-fenced retrofit tokenizes
#    only the `transform` item's duration) while the REST of the same
#    file (the motion import, `capsule-entrance`, the label-reveal exit
#    transition) is fully token-driven — a whole-file EXEMPTIONS entry
#    here would silently re-exempt those retrofitted rules too, exactly
#    the silencing D-23/this plan's sibling prohibition forbids.
LINE_EXEMPTIONS = [
    {'label': 'wleave/style.css button:hover,button:focus rule',
     'regex': re.compile(r'(^|/)wleave/style\.css$'),
     # WR-04: content anchors, not hardcoded line numbers. The prior
     # `'start': 230, 'end': 253` had no tie to the actual rule it was
     # meant to cover — any edit ABOVE that range (a new comment, an
     # inserted rule, even one blank line) silently shifts every
     # subsequent line number, so the exemption would then cover the
     # wrong span. Resolved per-run below (after the real matching file,
     # if any, is known) by locating the `button:hover,` / `button:focus
     # {` open pair and the next bare `}` close — a moved/renamed rule
     # then fails loud (EXEMPT FAIL) instead of silently mis-scoping.
     'anchor_start': re.compile(r'^\s*button:hover\s*,\s*$'),
     'anchor_focus': re.compile(r'^\s*button:focus\s*\{'),
     'anchor_end': re.compile(r'^\s*\}\s*$'),
     'start': None, 'end': None,
     'reason': "D-19/D-31 fence, PERMANENT: hover/focus keeps its "
               "hand-authored overshoot timing function and its three "
               "still-literal 150ms/ease transitions — human-approved "
               "feel at a prior render gate (\"button glows and grows "
               "larger\"), deliberately preserved. A knowing, scoped "
               "exception to MD3 purity on exactly this one rule, not "
               "unfinished work; only the transform item's duration was "
               "ever tokenized",
     'pending': False},
]

for lx in LINE_EXEMPTIONS:
    if not lx['reason'].strip():
        emit('EXEMPT', 'FAIL', f"{lx['label']}: line-exemption entry has an empty reason (deny-by-default violation)")
    # The resolved-range INFO/FAIL line is emitted later, once the actual
    # matching file (if any) in this run's surface set is known — see
    # "Resolve LINE_EXEMPTIONS content anchors" below.

# ── D-33: `--no-pending` assertion (opt-in, never default behaviour) ────
# A structured boolean field, not a reason-string substring match — the
# brittle regex-over-prose class this repo has repeatedly been burned by
# (WLOG-01, keybind-doctor's -j parse break). Checked here, immediately
# after both lists are built and BEFORE the empty-definition-set guard
# below, so this assertion needs nothing from the render pipeline: it is
# purely about the exemption declarations themselves. Early-exits the
# whole python process — no surface scan runs in this mode, matching
# --self-test's shape of a wholly separate assertion pass rather than an
# add-on to the normal scan.
if os.environ.get('MOTION_LINT_MODE') == 'no-pending':
    pending_entries = [
        (ex['glob'], ex['reason']) for ex in EXEMPTIONS if ex.get('pending')
    ] + [
        (lx['label'], lx['reason']) for lx in LINE_EXEMPTIONS if lx.get('pending')
    ]
    if pending_entries:
        for label, reason in pending_entries:
            emit('PENDING', 'FAIL', f'{label} is marked pending: True — {reason}')
    else:
        emit('PENDING', 'PASS',
             'zero exemption entries (EXEMPTIONS + LINE_EXEMPTIONS) carry pending: True')
    dump()
    sys.exit(0)


def line_is_exempt(path, line_no):
    return any(
        lx['regex'].search(path)
        and lx.get('start') is not None and lx.get('end') is not None
        and lx['start'] <= line_no <= lx['end']
        for lx in LINE_EXEMPTIONS
    )


# ── Refuse to proceed on an empty definition set (mirrors theme-parity's
#    empty-reference-name-set guard): with nothing to resolve against,
#    every subsequent reference would look dangling, which is a vacuous
#    failure mode, not a real one. ──────────────────────────────────────
if not gtk_defs and not hypr_bezier_defs and not hypr_var_defs and not qml_defs:
    emit('DEFS', 'FAIL',
         f'zero motion definitions loaded from {state_dir} '
         '(gtk-4.0-motion.css / hyprland-motion.conf / motion.json) — '
         'refusing to run: an empty definition set would make every '
         'reference look dangling')
    dump()
    sys.exit(0)

# The fixtures directory lives at tests/motion-fixtures/, nested INSIDE
# the real hypr config tree root (hypr/scripts/tests/...) — a default
# run's recursive walk would otherwise pick up the deliberately-poisoned
# fixtures as if they were real surfaces. Excluded only when no root the
# caller passed is itself inside fixtures_dir, so a self-test/manual run
# that deliberately points AT the fixtures (or a throwaway copy under it)
# is unaffected — same code path, context-aware exclusion.
exclude_fixtures = not any(
    os.path.realpath(r) == fixtures_dir or os.path.realpath(r).startswith(fixtures_dir + os.sep)
    for r in roots
)


def under_fixtures_dir(path):
    real = os.path.realpath(path)
    return real == fixtures_dir or real.startswith(fixtures_dir + os.sep)


# ── Surface collection — recursive glob by extension under each root.
#    Same function serves the real multi-root run and the single
#    throwaway/fixture-dir run (D-28: "same code path"). ─────────────────
surfaces = {'css': [], 'conf': [], 'qml': []}
for root in roots:
    if not os.path.isdir(root):
        continue
    # followlinks=True: this repo is deployed via GNU stow, which symlinks
    # whole subdirectories (e.g. ~/.config/hypr/config,
    # ~/.config/quickshell/modules) as often as individual files. The
    # default os.walk(followlinks=False) treats a symlinked directory as a
    # leaf and never descends into it — silently dropping every file
    # inside from the surface set, which is exactly the "partial-glob
    # miss" CHECK C exists to make visible. Following symlinks here is
    # safe: this whole tree is a single trusted repo checkout, not
    # untrusted input, so there is no traversal-attack surface to guard
    # against.
    for dirpath, _dirnames, filenames in os.walk(root, followlinks=True):
        for fn in filenames:
            full = os.path.join(dirpath, fn)
            if exclude_fixtures and under_fixtures_dir(full):
                continue
            if fn.endswith('.css') or fn.endswith('.scss'):
                surfaces['css'].append(full)
            elif fn.endswith('.conf'):
                surfaces['conf'].append(full)
            elif fn.endswith('.qml'):
                surfaces['qml'].append(full)

# ── Resolve LINE_EXEMPTIONS content anchors (WR-04) — must happen after
#    surfaces are collected, since resolving a content anchor requires
#    reading the actual matching file's text. Reason-emptiness was already
#    checked above (structural, file-independent); this pass emits the
#    per-run EXEMPT INFO/FAIL line carrying the actual (or FAILED-to-
#    resolve) span. ──────────────────────────────────────────────────────
all_scanned_paths = surfaces['css'] + surfaces['conf'] + surfaces['qml']
for lx in LINE_EXEMPTIONS:
    if not lx['reason'].strip():
        continue  # already emitted FAIL above; don't also print a range
    match_path = next((p for p in all_scanned_paths if lx['regex'].search(p)), None)
    if match_path is None:
        emit('EXEMPT', 'INFO',
             f"{lx['label']} — {lx['reason']} (no matching file in this "
             "run's surface set; anchor not verified this run)")
        continue
    try:
        raw = open(match_path, encoding='utf-8').read()
    except OSError as exc:
        emit('EXEMPT', 'FAIL', f"{lx['label']}: {match_path} unreadable ({exc})")
        continue
    lx_lines = strip_css_comments(raw).split('\n')
    start_idx = next((idx for idx, ln in enumerate(lx_lines) if lx['anchor_start'].search(ln)), None)
    focus_idx = None
    if start_idx is not None:
        focus_idx = next(
            (idx for idx in range(start_idx, min(start_idx + 3, len(lx_lines)))
             if lx['anchor_focus'].search(lx_lines[idx])),
            None)
    end_idx = None
    if focus_idx is not None:
        end_idx = next(
            (idx for idx in range(focus_idx, len(lx_lines)) if lx['anchor_end'].search(lx_lines[idx])),
            None)
    if start_idx is None or focus_idx is None or end_idx is None:
        emit('EXEMPT', 'FAIL',
             f"{lx['label']}: content anchor not found in {match_path} — "
             "the exemption's intended rule may have moved, been renamed, "
             "or been removed; update the anchor or delete this exemption "
             "entry rather than leaving it mis-scoped")
        continue
    lx['start'] = start_idx + 1  # 1-indexed, inclusive
    lx['end'] = end_idx + 1
    emit('EXEMPT', 'INFO', f"{lx['label']} (lines {lx['start']}-{lx['end']}) — {lx['reason']}")

total_scanned = len(surfaces['css']) + len(surfaces['conf']) + len(surfaces['qml'])

if total_scanned == 0:
    emit('C', 'FAIL', 'motion-lint scanned 0 surfaces; check the surface glob.')
else:
    emit('C', 'PASS',
         f'motion-lint scanned {total_scanned} surface(s) '
         f'(css/scss={len(surfaces["css"])}, conf={len(surfaces["conf"])}, '
         f'qml={len(surfaces["qml"])})')


# ── CHECK A/B per surface type ──────────────────────────────────────────
DURATION_RE = re.compile(r'\b\d+(?:\.\d+)?(?:ms|s)\b')
CUBIC_BEZIER_RE = re.compile(r'\bcubic-bezier\([^)]*\)')
EASING_KEYWORD_RE = re.compile(r'\b(ease-in-out|ease-in|ease-out|ease)\b')
LINEAR_RE = re.compile(r'\blinear\b(?!-gradient)')
# Matches BOTH the bare form `var(--motion-foo)` and the CSS-fallback form
# `var(--motion-foo, ...)` — the trailing `)` or `,` alternation is what
# CR-01 fixes: the prior version anchored on `)` only, so a fallback's `,`
# made the whole reference invisible to CHECK A (never validated for
# resolution at all).
VAR_MOTION_RE = re.compile(r'var\(\s*--(motion-[A-Za-z0-9_-]+)\s*(?:\)|,)')
# A `var(--motion-*, ...)` WITH a fallback argument is itself a CHECK B
# raw-value violation (D-19/zero-duplicate-value: a fallback duplicates or
# contradicts the token) — flagged in check_css_surface before masking.
VAR_MOTION_FALLBACK_RE = re.compile(r'var\(\s*--(motion-[A-Za-z0-9_-]+)\s*,')
# One-level-of-nesting-aware mask: `[^)]*` used to stop at the FIRST `)`,
# which for a fallback like `var(--x, cubic-bezier(0.1,0.2,0.3,0.4))`
# matched only up through the bezier's own closing paren — leaving the
# real outer `)` (and everything after the fallback's mask start) unmasked
# and, worse, erasing the raw literal from CHECK B before DURATION_RE ever
# saw it (CR-01). This version matches either a non-paren run or one fully
# balanced `(...)` span, repeated, so it correctly finds the true outer
# closing paren for both the bare and one-level-nested fallback forms.
VAR_MASK_RE = re.compile(r'var\((?:[^()]|\([^()]*\))*\)')
# `animation-delay`/`transition-delay` are STAGGER/CHOREOGRAPHY values, not
# the duration/easing values this pipeline emits tokens for at all — there
# is no `--motion-delay-*` custom property anywhere in motion.json's data
# model, so CHECK B's "replace with a var(--motion-*) reference" message
# would be actively wrong pointed at one (added 12-07, found live against
# wleave's six per-capsule `animation-delay` lines: D-23's deny-by-default
# scan cannot tell "this raw ms value has a token that should replace it"
# from "this raw ms value has no token because none was ever meant to
# exist" without this carve-out — a lint-design gap, not a wleave defect).
# search, not match+anchor: wleave writes these as one-line rules
# (`button#lock { animation-delay: 0ms; }`), so the property name never
# sits at column 0.
DELAY_PROPERTY_RE = re.compile(r'(?:animation|transition)-delay\s*:', re.I)
# WR-01: the declaration's own VALUE span (property name through the next
# `;`, or end-of-line if unterminated) — used to blank out only that
# declaration before CHECK B's raw-value scan, so a delay carve-out cannot
# also hide an unrelated raw literal that happens to share the same line
# (the old code's `continue` skipped the WHOLE line's CHECK B on a mere
# DELAY_PROPERTY_RE.search hit, not just that declaration's value).
DELAY_DECL_RE = re.compile(r'(?:animation|transition)-delay\s*:[^;]*;?', re.I)

RAW_VALUE_MSG = (
    "hand-rolls a raw duration/easing value instead of a motion token "
    "('{val}'). Replace with a var(--motion-*) reference, a named bezier, "
    "or a semantic property, then re-run."
)
DANGLING_MSG = (
    "references undefined motion token '{name}' — no matching entry in "
    "motion.json's semantic layer."
)


def check_css_surface(path):
    try:
        raw = open(path, encoding='utf-8').read()
    except OSError as exc:
        emit('ABORT', 'FAIL',
             f'{path}: unreadable ({exc}) — aborting scan, remaining '
             'surfaces not checked this run')
        return False

    body = strip_css_comments(raw)
    lines = body.split('\n')
    a_hits = []
    b_hits = []
    for i, line in enumerate(lines, start=1):
        for m in VAR_MOTION_RE.finditer(line):
            name = m.group(1)
            if name not in gtk_defs:
                a_hits.append((i, name))
        if line_is_exempt(path, i):
            continue
        # WR-01: blank out ONLY the delay declaration's own value span
        # (not the whole line) before scanning for raw literals — a line
        # combining a legitimate animation-delay:/transition-delay: value
        # with an unrelated raw literal must still fail CHECK B for that
        # other literal.
        scan_line = DELAY_DECL_RE.sub(lambda mm: ' ' * len(mm.group(0)), line) \
            if DELAY_PROPERTY_RE.search(line) else line
        for m in VAR_MOTION_FALLBACK_RE.finditer(scan_line):
            b_hits.append((i, f'var(--{m.group(1)}, ...) — fallback value on '
                               'a motion token reference is itself a raw-value violation'))
        masked = VAR_MASK_RE.sub(lambda mm: 'V' * len(mm.group(0)), scan_line)
        for m in DURATION_RE.finditer(masked):
            b_hits.append((i, m.group(0)))
        for m in CUBIC_BEZIER_RE.finditer(masked):
            b_hits.append((i, m.group(0)))
        for m in EASING_KEYWORD_RE.finditer(masked):
            b_hits.append((i, m.group(0)))
        for m in LINEAR_RE.finditer(masked):
            b_hits.append((i, m.group(0)))

    if a_hits:
        for i, name in a_hits:
            emit('A', 'FAIL', f'{path}:{i} ' + DANGLING_MSG.format(name=f'--{name}'))
    else:
        emit('A', 'PASS', f'{path}: all motion token references resolve')

    if b_hits:
        for i, val in b_hits:
            emit('B', 'FAIL', f'{path}:{i} ' + RAW_VALUE_MSG.format(val=val))
    else:
        emit('B', 'PASS', f'{path}: no raw duration/easing literals')

    return True


ANIMATION_LINE_RE = re.compile(
    r'^\s*animation\s*=\s*([^,]+),\s*([^,]+),\s*([^,]+),\s*([^,]+)'
)
BEZIER_LINE_RE = re.compile(r'^\s*bezier\s*=\s*([A-Za-z0-9_-]+)\s*,')
# 13-01 Task 4: an `animation =` line's SPEED (group 3) and CURVE (group 4)
# fields may now reference an engine-emitted `$motion_speed_*`/
# `$motion_curve_*` hyprlang variable instead of a literal number/bezier
# name — this is the "new reference shape" load_hypr_defs's pre-existing
# var_names collection (Phase 12, unwired until now) exists to resolve.
HYPR_VAR_REF_RE = re.compile(r'^\$([A-Za-z_][A-Za-z0-9_]*)$')


def check_hypr_surface(path):
    try:
        raw = open(path, encoding='utf-8').read()
    except OSError as exc:
        emit('ABORT', 'FAIL',
             f'{path}: unreadable ({exc}) — aborting scan, remaining '
             'surfaces not checked this run')
        return False

    body = strip_hash_comments(raw)
    lines = body.split('\n')
    a_hits = []
    b_hits = []
    for i, line in enumerate(lines, start=1):
        m = ANIMATION_LINE_RE.match(line)
        if m:
            speed = m.group(3).strip()
            curve = m.group(4).strip()

            var_match = HYPR_VAR_REF_RE.match(speed)
            if var_match:
                if var_match.group(1) not in hypr_var_defs:
                    a_hits.append((i, speed))
            elif speed:
                # CHECK B: a raw numeric speed literal instead of a
                # $motion_speed_* token — the Hyprland-side equivalent of
                # CSS's bare `Nms`/`Ns` raw-value violation (no `var()`
                # mechanism exists here, so a hand-authored number IS the
                # raw-value shape, same posture as the bezier-declaration
                # check below).
                b_hits.append((i, f'animation speed {speed!r} (not a $motion_speed_* token)'))

            var_match = HYPR_VAR_REF_RE.match(curve)
            if var_match:
                if var_match.group(1) not in hypr_var_defs:
                    a_hits.append((i, curve))
            elif curve and curve not in hypr_bezier_defs:
                a_hits.append((i, curve))
        m2 = BEZIER_LINE_RE.match(line)
        if m2:
            name = m2.group(1)
            if not name.startswith('motion-'):
                b_hits.append((i, f'bezier = {name}, ...'))

    if a_hits:
        for i, curve in a_hits:
            emit('A', 'FAIL', f'{path}:{i} ' + DANGLING_MSG.format(name=curve))
    else:
        emit('A', 'PASS', f'{path}: all animation speed/curve references resolve')

    if b_hits:
        for i, val in b_hits:
            emit('B', 'FAIL', f'{path}:{i} ' + RAW_VALUE_MSG.format(val=val))
    else:
        emit('B', 'PASS', f'{path}: no hand-authored (non motion-*) bezier curves or raw speed literals')

    return True


MOTION_PROP_RE = re.compile(r'Motion\.([A-Za-z][A-Za-z0-9]*)')
QML_DURATION_RE = re.compile(r'\bduration\s*:\s*(\d+)\b')
QML_LITERAL_BEZIER_RE = re.compile(r'easing\.bezierCurve\s*:\s*\[')


def check_qml_surface(path):
    try:
        raw = open(path, encoding='utf-8').read()
    except OSError as exc:
        emit('ABORT', 'FAIL',
             f'{path}: unreadable ({exc}) — aborting scan, remaining '
             'surfaces not checked this run')
        return False

    body = strip_qml_comments(raw)
    lines = body.split('\n')
    a_hits = []
    b_hits = []
    for i, line in enumerate(lines, start=1):
        for m in MOTION_PROP_RE.finditer(line):
            name = m.group(1)
            if name not in qml_defs:
                a_hits.append((i, name))
        # WR-01: mask only the matched `Motion.xxx` token span(s), not the
        # whole line — gating the raw-literal scan on mere substring
        # presence of "Motion." anywhere on the line let a legitimate
        # Motion.* reference sharing a line with an unrelated raw literal
        # (e.g. a future `duration: 200 /* fallback while Motion.foo loads
        # */`-shaped line) escape CHECK B entirely.
        scan_line = MOTION_PROP_RE.sub(lambda mm: 'M' * len(mm.group(0)), line)
        m2 = QML_DURATION_RE.search(scan_line)
        if m2:
            b_hits.append((i, f'duration: {m2.group(1)}'))
        if QML_LITERAL_BEZIER_RE.search(scan_line):
            b_hits.append((i, 'easing.bezierCurve: [literal array]'))

    if a_hits:
        for i, name in a_hits:
            emit('A', 'FAIL', f'{path}:{i} ' + DANGLING_MSG.format(name=f'Motion.{name}'))
    else:
        emit('A', 'PASS', f'{path}: all Motion.* references resolve')

    if b_hits:
        for i, val in b_hits:
            emit('B', 'FAIL', f'{path}:{i} ' + RAW_VALUE_MSG.format(val=val))
    else:
        emit('B', 'PASS', f'{path}: no raw duration/easing literals')

    return True


all_surfaces = []
for p in sorted(surfaces['css']):
    all_surfaces.append(('css', p))
for p in sorted(surfaces['conf']):
    all_surfaces.append(('conf', p))
for p in sorted(surfaces['qml']):
    all_surfaces.append(('qml', p))

for kind, path in all_surfaces:
    if path_is_exempt(path):
        continue
    if kind == 'css':
        ok = check_css_surface(path)
    elif kind == 'conf':
        ok = check_hypr_surface(path)
    else:
        ok = check_qml_surface(path)
    if not ok:
        break  # abort: do not report on the subset already read

dump()
PYEOF
}

run_self_test() {
    local -a fixtures=(
        "compliant-gtk4.css:0"
        "poisoned-raw-gtk4.css:1"
        "poisoned-dangling-gtk4.css:1"
        "poisoned-fallback-gtk4.css:1"
        "compliant-hypr.conf:0"
        "poisoned-raw-hypr.conf:1"
        "poisoned-raw-speed-hypr.conf:1"
        "poisoned-dangling-hypr.conf:1"
        "compliant-qml.qml:0"
        "poisoned-raw-qml.qml:1"
        "poisoned-dangling-qml.qml:1"
    )
    local st_pass=0 st_fail=0
    local entry fname expect_nonzero src tmp out rc want_desc

    echo "motion-lint --self-test — replaying the eleven committed fixtures"
    echo ""

    for entry in "${fixtures[@]}"; do
        fname="${entry%%:*}"
        expect_nonzero="${entry##*:}"
        src="$FIXTURES_DIR/$fname"

        if [[ ! -f "$src" ]]; then
            printf '  [FAIL] self-test: fixture missing: %s\n' "$src"
            st_fail=$((st_fail + 1))
            continue
        fi

        tmp="$(mktemp -d)"
        cp -- "$src" "$tmp/$fname"
        out="$("$0" "$tmp" 2>&1)"
        rc=$?
        rm -rf -- "$tmp"

        if [[ "$expect_nonzero" == "0" ]]; then
            want_desc="exit 0 (compliant)"
        else
            want_desc="a non-zero exit (poisoned)"
        fi

        if [[ "$expect_nonzero" == "0" && "$rc" -eq 0 ]] || [[ "$expect_nonzero" == "1" && "$rc" -ne 0 ]]; then
            printf '  [PASS] self-test: %s -> %s as expected\n' "$fname" "$want_desc"
            st_pass=$((st_pass + 1))
        else
            printf '  [FAIL] self-test: %s -> exited %d, expected %s\n' "$fname" "$rc" "$want_desc"
            printf '         output:\n%s\n' "$(printf '%s\n' "$out" | sed 's/^/           /')"
            st_fail=$((st_fail + 1))
        fi
    done

    echo ""
    printf 'Self-test summary: %d passed, %d failed\n' "$st_pass" "$st_fail"
    [[ "$st_fail" -eq 0 ]]
}

if [[ "${1:-}" == "--self-test" ]]; then
    run_self_test
    exit $?
fi

# D-33: same shape as --self-test above — check the first argument, branch
# into a wholly separate assertion pass, exit with its status. Opt-in only:
# omitting this flag (the normal `motion-lint` invocation) never runs this
# assertion, so a temporary Phase 14+ exemption does not fail the everyday
# gate the moment it is added — only `--no-pending` enforces zero pending.
if [[ "${1:-}" == "--no-pending" ]]; then
    echo "motion-lint --no-pending — asserting zero exemption entries are pending"
    echo ""
    ROOTS=()
    while IFS=$'\t' read -r tag status detail; do
        [[ -z "$tag" ]] && continue
        case "$tag" in
            EXEMPT)
                case "$status" in
                    FAIL) check "exemption entry: $detail" "1" ;;
                    *)    printf '  [EXEMPT] %s\n' "$detail" ;;
                esac
                ;;
            *)
                case "$status" in
                    PASS) check "CHECK $tag: $detail" "0" ;;
                    FAIL) check "CHECK $tag: $detail" "1" ;;
                esac
                ;;
        esac
    done < <(MOTION_LINT_MODE=no-pending _motion_lint_checks)
    echo ""
    if [[ "$FAIL" -eq 1 ]]; then
        FAIL_WORD="check failed"
    else
        FAIL_WORD="checks failed"
    fi
    printf 'Summary: %d passed, %d %s\n' "$PASS" "$FAIL" "$FAIL_WORD"
    [[ "$FAIL" -eq 0 ]]
    exit $?
fi

TARGET_DIR="${1:-}"

if [[ -n "$TARGET_DIR" ]]; then
    ROOTS=("$TARGET_DIR")
else
    # The known repo-authored surface families that could consume a motion
    # token, one directory per family (D-23: deny-by-default, no per-file
    # registry — any new file dropped into one of these directories is
    # covered automatically). Same collection code below serves this list
    # AND the single throwaway/fixture directory above.
    ROOTS=(
        "$HOME/.config/hypr"
        "$HOME/.config/quickshell"
        "$HOME/.config/waybar"
        "$HOME/.config/swaync"
        "$HOME/.config/swayosd"
        "$HOME/.config/walker"
        "$HOME/.config/wleave"
        "$HOME/.config/gtk-4.0"
        "$HOME/.config/ags"
    )
fi

echo "motion-lint — motion-token deny-by-default gate"
if [[ -n "$TARGET_DIR" ]]; then
    echo "  target: $TARGET_DIR"
else
    echo "  target: real deployed surface set (${#ROOTS[@]} root dir(s))"
fi
echo "  definitions: $STATE_DIR"
echo ""


while IFS=$'\t' read -r tag status detail; do
    [[ -z "$tag" ]] && continue
    case "$tag" in
        EXEMPT)
            case "$status" in
                FAIL) check "exemption entry: $detail" "1" ;;
                *)    printf '  [EXEMPT] %s\n' "$detail" ;;
            esac
            ;;
        ABORT)
            check "$detail" "1"
            ;;
        DEFS)
            check "$detail" "1"
            ;;
        *)
            case "$status" in
                PASS) check "CHECK $tag: $detail" "0" ;;
                FAIL) check "CHECK $tag: $detail" "1" ;;
            esac
            ;;
    esac
done < <(_motion_lint_checks)

if [[ "$FAIL" -eq 1 ]]; then
    FAIL_WORD="check failed"
else
    FAIL_WORD="checks failed"
fi

echo ""
printf 'Summary: %d passed, %d %s\n' "$PASS" "$FAIL" "$FAIL_WORD"
[[ "$FAIL" -eq 0 ]]
exit $?

#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════╗
# ║              KEYBIND-DOCTOR (D-04)                    ║
# ║  Rerunnable regression gate: cross-checks              ║
# ║  keybinds.lua against the compositor's ACTUAL          ║
# ║  registered state (hyprctl binds), never the file      ║
# ║  alone. Report-only — never mutates state (no          ║
# ║  hyprctl reload/keyword, no writes to keybinds.lua).   ║
# ╚══════════════════════════════════════════════════════╝
#
# Usage: keybind-doctor [path-to-keybinds.lua]
#   Defaults to ~/.config/hypr/config/keybinds.lua. An explicit path is
#   accepted so this gate can be pointed at a throwaway copy for a
#   regression self-test (a gate that cannot fail is not a gate).
#
# Phase 13.1/13.1-09: retargeted from keybinds.conf (hyprlang) to
# keybinds.lua. This file NEVER falls back to reading keybinds.conf when
# the Lua module is missing — a silent fallback would let the eventual
# retirement of the hyprlang tree (13.1-10) break this gate without
# anyone noticing (T-13.1-27). It never dynamically executes the parsed
# Lua as code (no `lua`/`dofile` on it) — text-only parsing, same
# discipline the pre-migration version held for keybinds.conf.

set -uo pipefail

KEYBINDS_SRC="${1:-$HOME/.config/hypr/config/keybinds.lua}"
SRC_LABEL="$(basename -- "$KEYBINDS_SRC")"

PASS=0
FAIL=0

check() {
    local desc="$1"
    local ok="$2"
    if [[ "$ok" == "0" ]]; then
        printf '  [PASS] %s\n' "$desc"
        PASS=$((PASS + 1))
    else
        printf '  [FAIL] %s\n' "$desc"
        FAIL=$((FAIL + 1))
    fi
}

echo "keybind-doctor — Hyprland keybind regression gate"
echo ""

if [[ ! -f "$KEYBINDS_SRC" ]]; then
    printf '  [FAIL] %s not found\n' "$KEYBINDS_SRC"
    FAIL=$((FAIL + 1))
    echo ""
    echo "Summary: ${PASS} passed, ${FAIL} failed"
    exit 1
fi

# ── modmask resolution (never hardcode SUPER — read the `local mainMod`
#    declaration from the file's own source, same discipline as
#    theme-doctor's contract sourcing) ───────────────────────────────
_kbd_mod_bit() {
    case "$1" in
        SUPER) printf '%s' 64 ;;
        SHIFT) printf '%s' 1 ;;
        CAPS) printf '%s' 2 ;;
        CTRL | CONTROL) printf '%s' 4 ;;
        ALT) printf '%s' 8 ;;
        MOD2) printf '%s' 16 ;;
        MOD3) printf '%s' 32 ;;
        MOD5) printf '%s' 128 ;;
        *) printf '%s' 0 ;;
    esac
}

# shellcheck disable=SC2016 # intentional: literal quote in the grep -P pattern, not shell expansion
MAINMOD_VALUE=$(grep -oP '^\s*local\s+mainMod\s*=\s*"\K[^"]+' "$KEYBINDS_SRC" | head -1)
check "mainMod resolved from ${SRC_LABEL} (got: ${MAINMOD_VALUE:-<unset>})" "$([[ -n "$MAINMOD_VALUE" ]] && echo 0 || echo 1)"
MAINMOD_VALUE="${MAINMOD_VALUE:-SUPER}"

_kbd_modmask() {
    # $1 = space-separated modifier tokens (already resolved, no
    # "mainMod" literal left in it) — every parsed field here is handled
    # as display/arithmetic-only text, never fed to a shell-command-
    # interpretation builtin (V5 input-validation control).
    local field="$1" total=0 tok
    for tok in $field; do
        total=$((total + $(_kbd_mod_bit "$tok")))
    done
    printf '%s' "$total"
}

# ── Parse every hl.bind(...) call into a comparable tuple:
#    modmask|key|keycode|release ────────────────────────────────────
#
# Lua bind lines aren't a regex-friendly `key = value, value, value`
# shape like hyprlang's — they're a real (if simple) function call whose
# key-string and options-table arguments can themselves contain quoted
# text with embedded "--" (e.g. `hl.dsp.exec_cmd("uwsm app -- walker -m
# menus:main")`, `"cliphist list | walker --dmenu | ..."`), which a
# naive "find the first --" comment search would misidentify as the
# trailing description. Parsing this correctly needs a real (quote- and
# bracket-depth-aware) small tokenizer, not a regex — the same reasoning
# that already pushed hypr-equivalence-check's config-tree/options
# parsers into python3 rather than bash regex. This function is that
# tokenizer: single pass, tracks whether it is inside a "..." string
# (toggled on unescaped quotes) and the combined ( / { bracket depth, so
# top-level commas (depth==1, the arguments directly inside the outer
# hl.bind(...) call) are found correctly and nested commas (inside a
# dispatcher's own argument table, e.g. resize({ x = ..., y = ... }))
# are not mistaken for argument separators. The true trailing comment is
# whatever follows the call's own closing paren (where depth returns to
# 0) — never found by scanning for "--" itself, so a "--" embedded in a
# quoted argument can never be mistaken for the description marker.
#
# A line that doesn't fit the expected shape (unbalanced brackets, an
# unrecognised key-expression form, or neither 2 nor 3 top-level
# arguments) is a NAMED shape error, never a silently wrong tuple — same
# discipline as the plain-text bind-block parser below.
_kbd_parse_lua_binds() {
    local path="$1" mainmod="$2"
    python3 - "$path" "$mainmod" <<'PYEOF'
import re
import sys

US = "\x1f"
path, mainmod = sys.argv[1], sys.argv[2]

try:
    with open(path, "r", encoding="utf-8") as fh:
        lines = fh.readlines()
except OSError as exc:
    print(f"AWKERR{US}cannot read {path}: {exc}")
    sys.exit(0)


def scan_call(text):
    """text starts with 'hl.bind('. Returns (args, trailer) where args is
    the list of top-level (bracket-depth==1) comma-separated argument
    substrings inside the outer call, and trailer is everything after
    the call's own closing paren. Returns None on an unbalanced call."""
    assert text.startswith("hl.bind(")
    i = len("hl.bind(")
    depth = 1  # already consumed the opening '('
    in_string = False
    arg_start = i
    args = []
    n = len(text)
    while i < n:
        c = text[i]
        if in_string:
            if c == "\\":
                i += 2
                continue
            if c == '"':
                in_string = False
            i += 1
            continue
        if c == '"':
            in_string = True
            i += 1
            continue
        if c in "({":
            depth += 1
            i += 1
            continue
        if c in ")}":
            depth -= 1
            if depth == 0:
                args.append(text[arg_start:i])
                return args, text[i + 1:]
            i += 1
            continue
        if c == "," and depth == 1:
            args.append(text[arg_start:i])
            arg_start = i + 1
            i += 1
            continue
        i += 1
    return None  # never closed at depth 0 -- unbalanced


for lineno, raw in enumerate(lines, 1):
    stripped = raw.rstrip("\n")
    lead = stripped.strip()
    if not lead.startswith("hl.bind("):
        continue

    result = scan_call(lead)
    if result is None:
        print(f"AWKERR{US}line {lineno}: unbalanced hl.bind(...) call — cannot parse")
        continue
    args, trailer = result
    if len(args) not in (2, 3):
        print(f"AWKERR{US}line {lineno}: hl.bind(...) has {len(args)} top-level argument(s), expected 2 or 3")
        continue

    key_arg = args[0].strip()
    dispatcher_arg = args[1].strip()
    opts_arg = args[2].strip() if len(args) == 3 else ""

    m = re.match(r'^mainMod\s*\.\.\s*"((?:[^"\\]|\\.)*)"$', key_arg)
    if m:
        full_key = mainmod + m.group(1)
    else:
        m2 = re.match(r'^"((?:[^"\\]|\\.)*)"$', key_arg)
        if not m2:
            print(f"AWKERR{US}line {lineno}: unrecognised key expression shape: {key_arg!r}")
            continue
        full_key = m2.group(1)

    tokens = full_key.split(" + ")
    key_token = tokens[-1]
    mod_tokens = tokens[:-1]

    release = "true" if re.search(r'\brelease\s*=\s*true\b', opts_arg) else "false"

    global_m = re.match(r'^hl\.dsp\.global\(\s*"((?:[^"\\]|\\.)*)"\s*\)$', dispatcher_arg)
    global_arg = global_m.group(1) if global_m else ""

    trailer_stripped = trailer.strip()
    has_desc = "1" if trailer_stripped.startswith("--") else "0"

    fields = [
        "AWKBIND", str(lineno), " ".join(mod_tokens), key_token,
        has_desc, global_arg, release, dispatcher_arg, lead, full_key,
    ]
    print(US.join(fields))
PYEOF
}

DECLARED_TUPLES=()
DECLARED_RAWLINES=()
DECLARED_GLOBAL_ARG=()
DECLARED_DISPATCHER_EXPR=()
DESC_TOTAL=0
DESC_MISSING=0
LUA_SHAPE_BAD=0

US=$'\x1f'
while IFS="$US" read -r awk_tag f1 f2 f3 f4 f5 f6 f7 f8 f9; do
    case "$awk_tag" in
        AWKERR)
            LUA_SHAPE_BAD=$((LUA_SHAPE_BAD + 1))
            printf '    parse shape error: %s\n' "$f1" >&2
            ;;
        AWKBIND)
            lineno="$f1" modsfield="$f2" keyfield="$f3" hasdesc="$f4" globalarg="$f5" release="$f6" dispexpr="$f7" rawline="$f8" fullkey="$f9"

            DESC_TOTAL=$((DESC_TOTAL + 1))
            if [[ "$hasdesc" != "1" ]]; then
                DESC_MISSING=$((DESC_MISSING + 1))
                printf '    missing description: %s:%d\n' "$SRC_LABEL" "$lineno" >&2
            fi

            modmask=$(_kbd_modmask "$modsfield")

            # Lua's own key-field serialization is confirmed live, not
            # assumed, and it is narrower/odder than a simple "keycode
            # always reads back 0" gap: a Lua-registered code:NNN bind's
            # PLAIN-TEXT `hyprctl binds` key field is the FULL
            # modifier-prefixed string (e.g. "SHIFT + code:107"), not
            # the bare "code:107" — while every ordinary symbolic-key
            # bind's key field IS stripped down to the bare key (e.g.
            # "SUPER + SHIFT + Q" registers as modmask=65, key="Q", the
            # modifier text never appearing in the key field at all).
            # Both facts confirmed directly on this build during
            # 13.1-09 (see this task's SUMMARY for the full evidence).
            # keycode itself always reads 0 for a Lua-registered bind
            # regardless of key shape (the already-documented
            # 13.1-03/13.1-04 gap). None of this is loosened here — the
            # tuple this doctor builds is simply made to match what the
            # compositor ACTUALLY reports for each shape, which is the
            # correct parse of this format, not a carve-out.
            keycode=0
            if [[ "$keyfield" =~ ^code:[0-9]+$ ]]; then
                live_key="$fullkey"
            else
                live_key="$keyfield"
            fi

            DECLARED_TUPLES+=("${modmask}|${live_key}|${keycode}|${release}")
            DECLARED_RAWLINES+=("${SRC_LABEL}:${lineno}: ${rawline}")
            DECLARED_GLOBAL_ARG+=("$globalarg")
            DECLARED_DISPATCHER_EXPR+=("$dispexpr")
            ;;
    esac
done < <(_kbd_parse_lua_binds "$KEYBINDS_SRC" "$MAINMOD_VALUE")

# ── Declared-bind parse shape guard — a line matching hl.bind( that this
#    tokenizer could not parse must fail BY NAME, never silently vanish
#    from DECLARED_TUPLES (same discipline as the plain-text bind-block
#    shape guard below). ──────────────────────────────────────────────
check "declared-bind parse shape guard: ${DESC_TOTAL} hl.bind(...) line(s) parsed with a recognised shape from ${SRC_LABEL} (parse errors: ${LUA_SHAPE_BAD})" "$([[ "$LUA_SHAPE_BAD" -eq 0 ]] && echo 0 || echo 1)"

# ── Description parity (D-30) — pure static parse, no hyprctl needed ───
check "description parity (D-30): all ${DESC_TOTAL} declared binds carry a trailing '--' description (missing: ${DESC_MISSING})" "$([[ $DESC_MISSING -eq 0 ]] && echo 0 || echo 1)"

# ── Static guard for the D-05 `walker -s` bug class (Task 1b). This is a
#    STATIC GREP ONLY — it proves the known-broken flag string is absent
#    from the file, NOT that the exec'd command won't crash at runtime.
#    `walker -s <set>` *registers* fine in hyprctl binds -j; only the
#    exec'd process panics (src/data.rs:566). A report-only doctor that
#    never invokes exec targets cannot catch that class by design. ──────
if grep -q 'walker -s' "$KEYBINDS_SRC"; then
    check "static grep: no 'walker -s <set>' invocation in ${SRC_LABEL} (known-broken flag on walker 2.16.2 — static grep only, not a runtime proof)" "1"
else
    check "static grep: no 'walker -s <set>' invocation in ${SRC_LABEL} (known-broken flag on walker 2.16.2 — static grep only, not a runtime proof)" "0"
fi

# ── Cross-check against the compositor's ACTUAL registered state ───────
#
# D-14 record-why: this file used to feed the compositor's structured
# bind query through a JSON filter here. That is now gone from every
# executable line below, and must NOT be restored. The root cause is not
# that the JSON failed to parse — it parses fine — the root cause is
# that Hyprland 0.56.0's structured serializer for this query is
# field-misaligned: verified directly on this build, it emits a boolean
# where the integer modmask belongs, puts the modmask's real value into
# the submap string instead, and emits an unquoted bareword where the
# keycode belongs. A syntax-only repair (retrying the query, adding more
# error handling around its filter) would have kept consuming this and
# produced confidently WRONG duplicate-chord answers while looking like
# it worked — strictly worse than the loud crash this file had before
# this repair. A self-healing probe that tries the structured query
# first and falls back to plain text only on a parse error was
# considered and rejected: a future build where that query parses
# cleanly but still misaligns fields would sail straight through such a
# probe undetected.
#
# What this section parses instead: plain-text `hyprctl binds`, verified
# field-correct across every declared bind block on this build. Blocks
# are blank-line delimited; the FIRST line of each block is a variable
# block-type token whose letters encode the bind's flags (a `bindel`
# declaration surfaces here as `bindle` — letters reordered — so this
# token is never treated as a fixed "bind" prefix). The remaining 8 lines
# carry stable, correctly-ordered field labels: modmask, submap, key,
# keycode, catchall, description, dispatcher, arg. The shape-guard check
# below fails BY NAME if that shape ever moves, instead of silently
# returning wrong tuples. This section is UNCHANGED by the 13.1-09
# retarget — it has never depended on the declared source's format, only
# on the compositor's own live reply.

if ! command -v hyprctl >/dev/null 2>&1; then
    echo "  [SKIP] keybind cross-check against hyprctl binds (hyprctl not found)"
else
    LIVE_BINDS_RAW=$(hyprctl binds 2>/dev/null)

    if [[ -z "$LIVE_BINDS_RAW" ]]; then
        check "hyprctl binds returned data" "1"
    else
        check "hyprctl binds returned data" "0"

        # Parse blank-line-delimited blocks. Emits one record per output
        # line, fields joined by ASCII Unit Separator (0x1f) — not a tab
        # and not '|': `arg` values can and do contain a literal '|'
        # (e.g. the cliphist pipe bind), and bash's `read` silently
        # COLLAPSES adjacent tabs (tab is IFS-whitespace, so an empty
        # `key` field vanishes and shifts every later field left by
        # one). 0x1f is neither, so empty fields survive intact:
        #   AWKERR<0x1f>message                          (named shape problem)
        #   AWKTUPLE<0x1f>modmask<0x1f>key<0x1f>keycode<0x1f>release<0x1f>dispatcher<0x1f>arg
        # then a trailing AWKBLOCKS<0x1f>count line.
        PARSED=$(printf '%s' "$LIVE_BINDS_RAW" | awk -v RS="" -v FS="\n" -v US="$US" '
            {
                nblocks++
                if (NF < 9) {
                    print "AWKERR" US "block " nblocks " has " NF " lines (expected 9)"
                    next
                }
                header = $1
                if ($2 !~ /^\tmodmask: /)     { print "AWKERR" US "block " nblocks ": field 2 is not \"modmask: \" (got " $2 ")"; next }
                if ($3 !~ /^\tsubmap: /)      { print "AWKERR" US "block " nblocks ": field 3 is not \"submap: \" (got " $3 ")"; next }
                if ($4 !~ /^\tkey: /)         { print "AWKERR" US "block " nblocks ": field 4 is not \"key: \" (got " $4 ")"; next }
                if ($5 !~ /^\tkeycode: /)     { print "AWKERR" US "block " nblocks ": field 5 is not \"keycode: \" (got " $5 ")"; next }
                if ($6 !~ /^\tcatchall: /)    { print "AWKERR" US "block " nblocks ": field 6 is not \"catchall: \" (got " $6 ")"; next }
                if ($7 !~ /^\tdescription: /) { print "AWKERR" US "block " nblocks ": field 7 is not \"description: \" (got " $7 ")"; next }
                if ($8 !~ /^\tdispatcher: /)  { print "AWKERR" US "block " nblocks ": field 8 is not \"dispatcher: \" (got " $8 ")"; next }
                if ($9 !~ /^\targ: /)         { print "AWKERR" US "block " nblocks ": field 9 is not \"arg: \" (got " $9 ")"; next }

                modmask = $2; sub(/^\tmodmask: /, "", modmask)
                key = $4; sub(/^\tkey: /, "", key)
                keycode = $5; sub(/^\tkeycode: /, "", keycode)
                dispatcher = $8; sub(/^\tdispatcher: /, "", dispatcher)
                arg = $9; sub(/^\targ: /, "", arg)

                release = (header ~ /r/) ? "true" : "false"

                print "AWKTUPLE" US modmask US key US keycode US release US dispatcher US arg
            }
            END { print "AWKBLOCKS" US nblocks }
        ')

        declare -A LIVE_TUPLE_SET=()
        declare -A TUPLE_TARGETS=()
        declare -A TUPLE_UNIQ_COUNT=()
        declare -A SEEN_PAIR=()
        SHAPE_BAD=0
        SHAPE_BLOCKS=0
        RELEASE_KEYS=()
        KILLBIND_LIVE_FOUND=0

        while IFS="$US" read -r awk_tag f1 f2 f3 f4 f5 f6; do
            case "$awk_tag" in
                AWKERR)
                    SHAPE_BAD=$((SHAPE_BAD + 1))
                    printf '    shape error: %s\n' "$f1" >&2
                    ;;
                AWKTUPLE)
                    modmask="$f1"; key="$f2"; keycode="$f3"; release="$f4"; dispatcher="$f5"; arg="$f6"
                    tuple="${modmask}|${key}|${keycode}|${release}"
                    target="${dispatcher}:${arg}"
                    LIVE_TUPLE_SET["$tuple"]=1
                    pairkey="${tuple}"$'\x1e'"${target}"
                    if [[ -z "${SEEN_PAIR[$pairkey]+x}" ]]; then
                        SEEN_PAIR["$pairkey"]=1
                        TUPLE_UNIQ_COUNT["$tuple"]=$(( ${TUPLE_UNIQ_COUNT[$tuple]:-0} + 1 ))
                        if [[ -z "${TUPLE_TARGETS[$tuple]+x}" ]]; then
                            TUPLE_TARGETS["$tuple"]="$target"
                        else
                            TUPLE_TARGETS["$tuple"]="${TUPLE_TARGETS[$tuple]}, ${target}"
                        fi
                    fi
                    [[ "$release" == "true" ]] && RELEASE_KEYS+=("$key")
                    if [[ "$modmask" == "64" && "$key" == "Escape" && "$keycode" == "0" && "$release" == "false" ]]; then
                        KILLBIND_LIVE_FOUND=1
                    fi
                    ;;
                AWKBLOCKS)
                    SHAPE_BLOCKS="$f1"
                    ;;
            esac
        done <<<"$PARSED"

        check "plain-text bind block shape guard: ${SHAPE_BLOCKS} block(s) parsed from hyprctl binds, each carrying the expected 8 field labels (modmask/submap/key/keycode/catchall/description/dispatcher/arg) in order (shape errors: ${SHAPE_BAD})" "$([[ "$SHAPE_BLOCKS" -ge 1 && "$SHAPE_BAD" -eq 0 ]] && echo 0 || echo 1)"

        # 1. Declared-vs-registered: every declared tuple must be live.
        MISSING_COUNT=0
        i=0
        for t in "${DECLARED_TUPLES[@]}"; do
            if [[ -z "${LIVE_TUPLE_SET[$t]+x}" ]]; then
                MISSING_COUNT=$((MISSING_COUNT + 1))
                printf '    not registered: %s\n' "${DECLARED_RAWLINES[$i]}" >&2
            fi
            i=$((i + 1))
        done
        check "declared-vs-registered: all ${#DECLARED_TUPLES[@]} declared binds appear in hyprctl binds (missing: ${MISSING_COUNT})" "$([[ $MISSING_COUNT -eq 0 ]] && echo 0 || echo 1)"

        # 2. Shadowing/duplication: two DIFFERENT dispatcher targets must
        #    never share the same (modmask,key,keycode,release) tuple.
        SHADOW_COUNT=0
        SHADOW_LINES=()
        for tuple in "${!TUPLE_UNIQ_COUNT[@]}"; do
            if [[ "${TUPLE_UNIQ_COUNT[$tuple]}" -gt 1 ]]; then
                SHADOW_COUNT=$((SHADOW_COUNT + 1))
                IFS='|' read -r s_modmask s_key s_keycode s_release <<<"$tuple"
                SHADOW_LINES+=("modmask=${s_modmask} key=${s_key} keycode=${s_keycode} release=${s_release} targets=[${TUPLE_TARGETS[$tuple]}]")
            fi
        done
        if [[ "$SHADOW_COUNT" -gt 0 ]]; then
            printf '    shadowed: %s\n' "${SHADOW_LINES[@]}" >&2
        fi
        check "no shadowing: zero (modmask,key,keycode,release) tuples shared by two different dispatcher targets (found: ${SHADOW_COUNT})" "$([[ $SHADOW_COUNT -eq 0 ]] && echo 0 || echo 1)"

        # 3. Release-bind inventory — informational, always reports how
        #    many release-triggered binds are registered and lists their
        #    keys; never a pass/fail signal on its own.
        RELEASE_COUNT=${#RELEASE_KEYS[@]}
        check "release-bind inventory recorded (${RELEASE_COUNT} release-triggered bind(s) registered)" "0"
        if [[ "$RELEASE_COUNT" -gt 0 ]]; then
            printf '%s\n' "${RELEASE_KEYS[@]}" | sed 's/^/    release-bind key: /'
        fi

        # 4. Kill-bind presence (D-03) — must fail loudly if a future
        #    phase ever deletes the escape hatch.
        #
        #    Split into a source-level half and a live half, the same
        #    proof shape hypr-equivalence-check already established for
        #    exactly this gap (COVERAGE.md "Binds equivalence: two-half
        #    proof"): a Lua-registered bind's dispatcher/arg fields are
        #    opaque at the compositor's live registry (dispatcher reads
        #    back "__lua", arg an opaque internal index — confirmed live
        #    on this build) — the pre-retarget check's exact-match
        #    `dispatcher == "exec" && arg == "pkill walker"` can now
        #    never fire for ANY Lua-registered bind, which is why it
        #    started failing post-cutover (13.1-08's "11 passed, 2
        #    failed" record). Neither half alone proves what this check
        #    needs: the live half alone cannot show WHICH command a
        #    chord runs (the opacity gap itself); the source half alone
        #    cannot show the bind actually survived config load. Both
        #    together is not a loosening — it is a different, and more
        #    directly verifiable, form of the same proof.
        KILLBIND_SOURCE_FOUND=0
        i=0
        for t in "${DECLARED_TUPLES[@]}"; do
            IFS='|' read -r d_modmask d_key d_keycode d_release <<<"$t"
            if [[ "$d_modmask" == "64" && "$d_key" == "Escape" && "$d_keycode" == "0" && "$d_release" == "false" ]]; then
                if [[ "${DECLARED_DISPATCHER_EXPR[$i]}" == 'hl.dsp.exec_cmd("pkill walker")' ]]; then
                    KILLBIND_SOURCE_FOUND=1
                fi
            fi
            i=$((i + 1))
        done
        check "D-03 kill-bind present (source: ${SRC_LABEL} declares Super+Escape -> hl.dsp.exec_cmd(\"pkill walker\"): $([[ $KILLBIND_SOURCE_FOUND -eq 1 ]] && echo yes || echo no); live: that exact chord is registered: $([[ $KILLBIND_LIVE_FOUND -eq 1 ]] && echo yes || echo no))" "$([[ "$KILLBIND_SOURCE_FOUND" -eq 1 && "$KILLBIND_LIVE_FOUND" -eq 1 ]] && echo 0 || echo 1)"
    fi
fi

# ── D-16/D-17: cross-check Quickshell-claimed global shortcuts ─────────
# Quickshell 0.3.0 exposes no GlobalShortcut runtime-introspection API
# (verified: quickshell.org/docs/v0.3.0/types/Quickshell.Hyprland/
# GlobalShortcut/ documents no read-back call) — this is the D-17 gap
# record. So the manifest at SHORTCUTS_MANIFEST is the DECLARED side
# (what Quickshell claims to own) and `hyprctl globalshortcuts` is the
# LIVE side (Hyprland's own registry of what actually got claimed). This
# section compares the two, same discipline as the bind cross-check
# above: parse what the compositor actually emits, and name a shape
# problem instead of silently matching nothing. It also checks the
# manifest for a same-appid+same-name duplicate on its own, independent
# of anything live — RESEARCH.md Pitfall 4: that pairing can crash
# Quickshell at startup with no log line pointing at the cause.
#
# The second positional argument extends this file's existing
# self-test hook (KEYBINDS_SRC above) to the manifest side, without
# changing the first argument's meaning.
SHORTCUTS_MANIFEST="${2:-$HOME/.config/quickshell/shortcuts.json}"

if [[ ! -f "$SHORTCUTS_MANIFEST" ]]; then
    echo "  [SKIP] quickshell shortcut cross-check ($SHORTCUTS_MANIFEST not found)"
elif ! command -v jq >/dev/null 2>&1; then
    echo "  [SKIP] quickshell shortcut cross-check (jq not found)"
elif ! command -v hyprctl >/dev/null 2>&1; then
    echo "  [SKIP] quickshell shortcut cross-check (hyprctl not found)"
else
    # 1. Manifest schema: valid JSON array, every entry non-empty on the
    #    fields the checks below depend on.
    MANIFEST_SCHEMA_OK=1
    if jq empty "$SHORTCUTS_MANIFEST" >/dev/null 2>&1 && [[ "$(jq -r 'type' "$SHORTCUTS_MANIFEST" 2>/dev/null)" == "array" ]]; then
        BAD_ENTRIES=$(jq -r '[.[] | select((.appid // "") == "" or (.name // "") == "" or (.chord.mods // "") == "" or (.chord.key // "") == "")] | length' "$SHORTCUTS_MANIFEST" 2>/dev/null)
        [[ "$BAD_ENTRIES" == "0" ]] && MANIFEST_SCHEMA_OK=0
    fi
    check "quickshell manifest schema: ${SHORTCUTS_MANIFEST} is a JSON array whose entries each carry non-empty appid/name/chord.mods/chord.key" "$MANIFEST_SCHEMA_OK"

    if [[ "$MANIFEST_SCHEMA_OK" -ne 0 ]]; then
        echo "  [SKIP] quickshell duplicate/registered/collision checks (manifest failed the schema check above)"
    else
        # 2. No duplicate appid+name (RESEARCH.md Pitfall 4).
        DUP_PAIRS=$(jq -r '.[] | "\(.appid):\(.name)"' "$SHORTCUTS_MANIFEST" | sort | uniq -d)
        DUP_COUNT=0
        if [[ -n "$DUP_PAIRS" ]]; then
            DUP_COUNT=$(printf '%s\n' "$DUP_PAIRS" | grep -c '.')
            printf '%s\n' "$DUP_PAIRS" | sed 's/^/    duplicate appid+name: /' >&2
        fi
        check "no duplicate appid+name in quickshell manifest (a duplicate pair can crash Quickshell rather than reject cleanly — RESEARCH.md Pitfall 4; found: ${DUP_COUNT})" "$([[ $DUP_COUNT -eq 0 ]] && echo 0 || echo 1)"

        # Live global-shortcut registry, plain text (verified clean on
        # this build: `<appid:name> -> <description>`, one per line; an
        # empty registry prints the literal word "none"). A line that
        # matches neither shape is a named shape failure, not a silent
        # non-match.
        GS_RAW=$(hyprctl globalshortcuts 2>/dev/null)
        declare -A GS_LIVE_SET=()
        GS_SHAPE_BAD=0
        GS_TRIMMED="${GS_RAW#"${GS_RAW%%[![:space:]]*}"}"
        GS_TRIMMED="${GS_TRIMMED%"${GS_TRIMMED##*[![:space:]]}"}"
        if [[ -n "$GS_TRIMMED" && "$GS_TRIMMED" != "none" ]]; then
            while IFS= read -r gline; do
                [[ -z "$gline" ]] && continue
                if [[ "$gline" =~ ^(.+)\ -\>\ (.*)$ ]]; then
                    GS_LIVE_SET["${BASH_REMATCH[1]}"]=1
                else
                    GS_SHAPE_BAD=$((GS_SHAPE_BAD + 1))
                    printf '    globalshortcuts shape error: unrecognised line: %s\n' "$gline" >&2
                fi
            done <<<"$GS_RAW"
        fi

        # 3. Registered: every manifest entry's appid:name must appear in
        #    the live registry above.
        UNREG_COUNT=0
        while IFS="$US" read -r m_appid m_name; do
            [[ -z "$m_appid" && -z "$m_name" ]] && continue
            pair="${m_appid}:${m_name}"
            if [[ -z "${GS_LIVE_SET[$pair]+x}" ]]; then
                UNREG_COUNT=$((UNREG_COUNT + 1))
                printf '    not registered in hyprctl globalshortcuts: %s\n' "$pair" >&2
            fi
        done < <(jq -r --arg us "$US" '.[] | [.appid, .name] | join($us)' "$SHORTCUTS_MANIFEST")
        check "quickshell shortcut registered: every manifest entry's appid:name appears in hyprctl globalshortcuts (unregistered: ${UNREG_COUNT}, registry shape errors: ${GS_SHAPE_BAD})" "$([[ $UNREG_COUNT -eq 0 && $GS_SHAPE_BAD -eq 0 ]] && echo 0 || echo 1)"

        # 4. Chord collision — purely static: reads only the file under
        #    test plus the manifest, no live state, so a throwaway
        #    fixture (never reloaded into the compositor) can still
        #    fail on exactly this check. The declared side's "is this
        #    bind legitimately the manifest's own `hl.dsp.global(...)`
        #    registration" question is answered directly from
        #    DECLARED_GLOBAL_ARG (captured once, at parse time, by
        #    _kbd_parse_lua_binds) rather than re-parsing the raw line
        #    text a second time here.
        COLLISION_COUNT=0
        while IFS="$US" read -r m_appid m_name m_mods m_key; do
            [[ -z "$m_appid" ]] && continue
            m_modmask=$(_kbd_modmask "$m_mods")
            i=0
            for t in "${DECLARED_TUPLES[@]}"; do
                IFS='|' read -r d_modmask d_key _ _ <<<"$t"
                if [[ "$d_modmask" == "$m_modmask" && "$d_key" == "$m_key" ]]; then
                    rawline="${DECLARED_RAWLINES[$i]}"
                    c_global_arg="${DECLARED_GLOBAL_ARG[$i]}"
                    if [[ -n "$c_global_arg" && "$c_global_arg" == "${m_appid}:${m_name}" ]]; then
                        : # the manifest entry's own legitimate registration line
                    else
                        COLLISION_COUNT=$((COLLISION_COUNT + 1))
                        printf '    chord collision: %s collides with quickshell manifest entry %s:%s\n' "$rawline" "$m_appid" "$m_name" >&2
                    fi
                fi
                i=$((i + 1))
            done
        done < <(jq -r --arg us "$US" '.[] | [.appid, .name, .chord.mods, .chord.key] | join($us)' "$SHORTCUTS_MANIFEST")
        check "quickshell chord collision: zero Hyprland-declared binds claim a chord the manifest already owns without going through the matching global dispatcher (found: ${COLLISION_COUNT})" "$([[ $COLLISION_COUNT -eq 0 ]] && echo 0 || echo 1)"
    fi
fi

echo ""
echo "Summary: ${PASS} passed, ${FAIL} failed"
[[ "$FAIL" -eq 0 ]]
exit $?

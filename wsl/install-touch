#!/usr/bin/env bash
set -euo pipefail

if [[ "$(systemd-detect-virt 2>/dev/null)" != wsl ]]; then
    printf '%s is available only inside Arch WSL2.\n' "${0##*/}" >&2
    exit 1
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/weaselway-touch"
destination="$HOME/.local/share/weaselway/touch"
drop_in="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/weaselwayd.service.d/30-native-touch.conf"
llvm_release=20261117
llvm="llvm-mingw-$llvm_release-ucrt-ubuntu-22.04-x86_64"

mkdir -p "$cache"
fetch() {
    local name="$1" url="$2" checksum="$3"
    if ! printf '%s  %s\n' "$checksum" "$cache/$name" | sha256sum -c --status 2>/dev/null; then
        curl -fLsS --retry 3 -o "$cache/$name.download" "$url"
        printf '%s  %s\n' "$checksum" "$cache/$name.download" | sha256sum -c --status
        mv -f "$cache/$name.download" "$cache/$name"
    fi
}

fetch "weaselway-v1.9.1.tar.gz" \
    "https://codeload.github.com/weaselway/weaselway/tar.gz/refs/tags/v1.9.1" \
    f67bc0d9a28c5b471ec8d0b6a98e3d8d6847dfa0ec1fcbbc0499283c2c6b352b
fetch "freerdp-v1.3.0.tar.gz" \
    "https://codeload.github.com/weaselway/freerdp/tar.gz/refs/tags/v1.3.0" \
    9e7e90ed2a1c730e61a371dd1be19030f9fdd851fd47c87d3f98cfd65a4d92ff
fetch dxgdrm_drm.h \
    "https://raw.githubusercontent.com/weaselway/dxgdrm/87ad880c095f8b481f37f9624df8b0e24c1e7535/dxgdrm_drm.h" \
    0c8beea912b0c2dc41e4d4c13126b1966d109be0548f4615860de68106dc3ecb
fetch "$llvm.tar.xz" \
    "https://github.com/mstorsjo/llvm-mingw/releases/download/$llvm_release/$llvm.tar.xz" \
    e7a15a49a2ea95e9f3d8a9d0cfabe5052a4b10fb4777cc54de5a8c27b64bb701

build="$(mktemp -d "$cache/build.XXXXXXXX")"
trap 'find "$build" -depth -delete' EXIT
for archive in weaselway-v1.9.1.tar.gz freerdp-v1.3.0.tar.gz "$llvm.tar.xz"; do
    tar -xf "$cache/$archive" -C "$build"
done
daemon="$build/weaselway-1.9.1/weaselwayd"
viewer="$build/freerdp-1.3.0"

patch -d "$daemon" -p1 < "$script_dir/weaselway-daemon-touch.patch"
patch -d "$viewer" -p1 < "$script_dir/weaselway-viewer-touch.patch"
jobs="${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc)}"
make -C "$daemon" -j"$jobs" DXGDRM_INCLUDE="$cache" weaselwayd

# Weaselway's viewer build sources this helper to select the UCRT toolchain.
cat > "$build/mingw-env" <<'EOF'
export CC="$1-gcc" CXX="$1-g++" AR="$1-ar" RANLIB="$1-ranlib" RC="$1-windres"
EOF
PATH="$build:$build/$llvm/bin:$PATH" \
MINGW_SYSROOT="$build/$llvm/x86_64-w64-mingw32" \
CMAKE_BUILD_PARALLEL_LEVEL="$jobs" bash "$viewer/build-freerdp.sh"

"$script_dir/launch-desktop" --disconnect
install -Dm755 "$daemon/weaselwayd" "$destination/weaselwayd.new"
mv -f "$destination/weaselwayd.new" "$destination/weaselwayd"
for name in SDL3.dll SDL3_ttf.dll sdl-freerdp.exe; do
    install -Dm755 "$viewer/build/$name" "$destination/viewer/$name.new"
    mv -f "$destination/viewer/$name.new" "$destination/viewer/$name"
done
install -Dm644 "$script_dir/weaselwayd-touch.conf" "$drop_in"
systemctl --user daemon-reload
systemctl --user try-restart weaselwayd.service

printf 'Native touch installed. Reopen Arch Linux to load the new viewer and daemon.\n'

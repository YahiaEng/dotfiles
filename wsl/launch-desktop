#!/usr/bin/env bash
set -euo pipefail

if [[ "$(systemd-detect-virt 2>/dev/null)" != wsl ]]; then
    printf '%s is available only inside Arch WSL2.\n' "${0##*/}" >&2
    exit 1
fi

# Weaselway's system profile exports the stock path even for our launcher.
stock_viewer=/opt/weaselway/viewer/sdl-freerdp.exe
viewer_path="${WEASELWAY_VIEWER:-$stock_viewer}"
touch_viewer="$HOME/.local/share/weaselway/touch/viewer/sdl-freerdp.exe"
if [[ "$viewer_path" == "$stock_viewer" && -x "$touch_viewer" ]]; then
    viewer_path="$touch_viewer"
fi
export WEASELWAY_VIEWER="$viewer_path"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/usr/lib/wsl/lib:$PATH"

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
powershell=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
runtime="${XDG_RUNTIME_DIR:?Missing WSL user runtime directory}"
profile_file="${XDG_CONFIG_HOME:-$HOME/.config}/weaselway/displays"
scale_file="${profile_file%/*}/display-scales.json"
windows_layout_file="$runtime/arch-hyprland-displays-windows"
display_list='DISPLAY[0-9]+(,DISPLAY[0-9]+){0,3}'
profile_pattern="^(auto(,DISPLAY[0-9]+)?|manual,$display_list)$"
saved_profile=auto
if [[ -r "$profile_file" ]]; then
    read -r saved_profile < "$profile_file" || true
    if [[ "$saved_profile" =~ ^$display_list$ ]]; then
        # Old multi-display profiles can discover new displays while keeping
        # their preferred main display. Keep explicit single-display profiles.
        if [[ "$saved_profile" == *,* ]]; then
            saved_profile="auto,${saved_profile%%,*}"
        else
            saved_profile="manual,$saved_profile"
        fi
    elif [[ ! "$saved_profile" =~ $profile_pattern ]]; then
        saved_profile=auto
    fi
fi

windows_action() {
    local helper viewer distro launcher action profile bounds handles
    helper="$(wslpath -w "$script_dir/windows-viewer.ps1")"
    viewer="$(wslpath -w "$WEASELWAY_VIEWER")"
    distro="${WSL_DISTRO_NAME:-}"
    if [[ -z "$distro" ]]; then
        distro="$(wslpath -w /)"
        distro="${distro%\\}"
        distro="${distro##*\\}"
    fi
    launcher="$script_dir/launch-desktop"
    action="$1"
    profile="${2:-auto}"
    bounds="${3:-}"
    bounds="${bounds//$'\n'/;}"
    handles="${4:-}"
    (
        cd /mnt/c
        "$powershell" -NoProfile -NonInteractive -Command \
            "& ([ScriptBlock]::Create([IO.File]::ReadAllText('${helper//\'/\'\'}'))) '$action' '${viewer//\'/\'\'}' '${distro//\'/\'\'}' '${launcher//\'/\'\'}' '${profile//\'/\'\'}' '${bounds//\'/\'\'}' '${handles//\'/\'\'}'"
    ) 8>&- 9>&- </dev/null
}

apply_layout() {
    local instance desired
    local path="$runtime/arch-hyprland-displays"
    desired="$(python3 "$script_dir/display-layout.py" --overrides "${1:-$scale_file}" <<< "$layout")" || return
    if [[ ! -r "$windows_layout_file" || "$(<"$windows_layout_file")" != "$layout" ]]; then
        printf '%s\n' "$layout" > "$windows_layout_file.tmp" &&
            mv "$windows_layout_file.tmp" "$windows_layout_file" || return
    fi
    if [[ ! -r "$path" || "$(<"$path")" != "$desired" ]]; then
        printf '%s\n' "$desired" > "$path.tmp" && mv "$path.tmp" "$path" || return
        instance="$(hyprctl instances -j | jq -r '.[0].instance // empty')" || return
        if [[ -n "$instance" ]]; then
            HYPRLAND_INSTANCE_SIGNATURE="$instance" hyprctl reload >/dev/null
        fi
    fi
}

check_quickshell_layout() {
    local pid attempt
    for attempt in {1..6}; do
        pid="$(systemctl --user show -p MainPID --value quickshell.service)" || return
        if [[ "$pid" != 0 ]] && timeout 1s qs ipc --pid "$pid" call bar status >/dev/null 2>&1 &&
            python3 "$script_dir/display-layout.py" --overrides "$scale_file" --check-bars --previous-bars "$1" <<< "$layout"; then
            return 0
        fi
        sleep .2
    done
    # The Display page owns this command. Queue the restart after the scale
    # is saved so it can finish even when the page disappears.
    systemctl --user --no-block restart quickshell.service 8>&-
}

set_display_scale() (
    local pending layout instance bar_spans preview=false
    exec 8>"$runtime/arch-hyprland-viewer-switch.lock"
    if ! flock -w 12 8; then
        printf 'The viewer is still changing layouts. Try again when it settles.\n' >&2
        return 1
    fi
    if [[ ! -s "$windows_layout_file" ]]; then
        printf 'The Windows display layout is unavailable.\n' >&2
        return 1
    fi
    layout="$(<"$windows_layout_file")"
    instance="$(hyprctl instances -j | jq -er '.[0].instance')" || return
    export HYPRLAND_INSTANCE_SIGNATURE="$instance"
    if systemctl --user is-active --quiet quickshell.service; then
        bar_spans="$(python3 "$script_dir/display-layout.py" --overrides "$scale_file" --snapshot-bars <<< "$layout")"
    fi
    mkdir -p -- "${scale_file%/*}"
    pending="$(mktemp "$scale_file.XXXXXXXX")" || return
    trap '
        if "$preview" && [[ -e "$pending" ]]; then
            apply_layout || hyprctl reload >/dev/null
        fi
        rm -f -- "$pending"
    ' EXIT
    trap 'exit 1' HUP INT TERM
    python3 "$script_dir/display-layout.py" --overrides "$scale_file" --set "$1" "$2" <<< "$layout" > "$pending" || return
    preview=true
    if ! apply_layout "$pending" ||
        ! { python3 "$script_dir/display-layout.py" --overrides "$pending" --wait-live <<< "$layout" ||
            { hyprctl reload >/dev/null &&
                python3 "$script_dir/display-layout.py" --overrides "$pending" --wait-live <<< "$layout"; }; }; then
        printf 'Hyprland did not apply the requested layout. The previous scale remains saved.\n' >&2
        return 1
    fi
    mv -f -- "$pending" "$scale_file" || return
    if [[ -n "${bar_spans:-}" ]]; then check_quickshell_layout "$bar_spans"; fi
)

start_weaselwayd() {
    local attempt socket restart=false
    local watcher_dir="$runtime/weaselway-hyprland"
    local drop_in="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/weaselwayd.service.d/20-hyprland-socket.conf"
    for attempt in {1..30}; do
        socket="$(hyprctl instances -j | jq -r '.[0].wl_socket // empty')"
        if [[ -n "$socket" && -S "$runtime/$socket" ]]; then break; fi
        sleep .2
    done
    if [[ -z "$socket" || ! -S "$runtime/$socket" ]]; then
        printf 'Could not find the Hyprland Wayland socket.\n' >&2
        return 1
    fi

    # The daemon scans its runtime directory for a compositor. Give it
    # only Hyprland's socket so WSLg cannot supply the pointer layout.
    install -d -m 700 "$watcher_dir"
    if [[ "$(readlink "$watcher_dir/wayland-hyprland")" != "$runtime/$socket" ]]; then
        restart=true
    fi
    ln -sfn "$runtime/$socket" "$watcher_dir/wayland-hyprland"
    if ! cmp -s "$script_dir/weaselwayd-hyprland.conf" "$drop_in"; then
        install -Dm 644 "$script_dir/weaselwayd-hyprland.conf" "$drop_in"
        systemctl --user daemon-reload
        restart=true
    fi
    if "$restart"; then
        systemctl --user restart weaselwayd.service
    else
        systemctl --user start weaselwayd.service
    fi
}

sync_wallpaper() {
    local count="$1"
    local attempt socket outputs missing wallpaper
    for attempt in {1..16}; do
        socket="$(hyprctl instances -j | jq -r '.[0].wl_socket // empty')" || return
        if [[ -n "$socket" ]] && outputs="$(WAYLAND_DISPLAY="$socket" awww query 2>/dev/null)"; then
            if (( $(sed -n '/^: Virtual-[0-9]*:/p' <<< "$outputs" | wc -l) >= count )); then
                break
            fi
        fi
        sleep .25
    done
    missing="$(sed -nE 's/^: (Virtual-[0-9]+): .*currently displaying: color: 000000$/\1/p' <<< "${outputs:-}" | paste -sd,)"
    wallpaper="$HOME/.local/state/theme/current.jpg"
    if [[ -n "$missing" && -r "$wallpaper" ]]; then
        WAYLAND_DISPLAY="$socket" awww img "$wallpaper" -o "$missing" --transition-type none
    fi
}

mode="${1:-auto}"
case "$mode" in
    --install-shortcuts)
        windows_action shortcuts
        exit
        ;;
    --list-monitors)
        windows_action displays
        exit
        ;;
    --display-scales)
        if (( $# == 1 )); then
            if [[ -r "$windows_layout_file" ]]; then
                python3 "$script_dir/display-layout.py" --overrides "$scale_file" --options < "$windows_layout_file"
            else
                printf '{}\n'
            fi
            exit
        fi
        if (( $# != 3 )); then
            printf 'Usage: %s --display-scales [DISPLAY_ID SCALE]\n' "$0" >&2
            exit 2
        fi
        set_display_scale "$2" "$3"
        exit
        ;;
    --disconnect|--hide)
        exec 8>"$runtime/arch-hyprland-viewer-switch.lock"
        flock 8
        action=close
        if [[ "$mode" == --hide ]]; then action=hide; fi
        status=0
        windows_action "$action" || status=$?
        if [[ "$status" == 3 ]]; then status=0; fi
        exit "$status"
        ;;
    --display-settings)
        profile="$(windows_action choose "$saved_profile" | tr -d '\r')"
        if [[ ! "$profile" =~ $profile_pattern ]]; then exit 0; fi
        ;;
    auto|--toggle) profile="$saved_profile" ;;
    both)
        profile=auto
        if [[ "$saved_profile" == *,* ]]; then
            preferred_main="${saved_profile#*,}"
            profile="auto,${preferred_main%%,*}"
        fi
        ;;
    primary|external) profile="$mode" ;;
    --monitor|--monitors)
        profile="${2:-}"
        if [[ ! "$profile" =~ ^$display_list$ ]]; then
            printf 'Use --list-monitors to find the DISPLAY names.\n' >&2
            exit 2
        fi
        ;;
    *)
        printf 'Usage: %s [--display-settings|--toggle|both|primary|external|--monitors DISPLAY[,DISPLAY]|--list-monitors|--disconnect|--install-shortcuts]\n' "$0" >&2
        exit 2
        ;;
esac

# The switch lock serializes a Windows handover. The viewer lock is held
# until its foreground process exits and the next layout can connect.
exec 8>"$runtime/arch-hyprland-viewer-switch.lock"
flock 8

action=show
if [[ "$mode" == --toggle ]]; then action=toggle; fi
if [[ "$mode" == auto || "$mode" == --toggle ]]; then
    if windows_action "$action"; then
        exit 0
    else
        status=$?
        if [[ "$status" != 3 ]]; then exit "$status"; fi
    fi
fi

layout="$(windows_action layout "$profile" | tr -d '\r')"
if [[ "$profile" == external ]]; then profile="${layout%% *}"; fi

if [[ "$mode" != auto && "$mode" != --toggle ]]; then
    status=0
    windows_action close || status=$?
    if [[ "$status" != 0 && "$status" != 3 ]]; then exit "$status"; fi
fi

exec 9>"$runtime/arch-hyprland-viewer.lock"
if ! flock -w 8 9; then
    printf 'The current Weaselway viewer is still starting or closing.\n' >&2
    exit 1
fi

if ! systemctl is-active --quiet weaselway-session.service; then
    if ! systemctl is-active --quiet weaselway-prep.service; then
        sudo systemctl start weaselway-prep.service 8>&- 9>&-
    fi
    ww-start-session custom 8>&- 9>&-
fi
start_weaselwayd

log="$runtime/arch-hyprland-viewer.log"
: > "$log"
start_viewer() {
    local width=800 height=500 count
    local -a screens
    mapfile -t screens <<< "$layout"
    count="${#screens[@]}"
    if (( count == 1 )); then
        read -r _screen _x _y width height _dpi <<< "${screens[0]}"
        # Initial RDP negotiation caps the size. Let placement grow larger views.
        if (( width > 4096 || height > 2048 )); then width=800 height=500; fi
    fi
    apply_layout
    (
        # Windows can add a resize frame when it moves a borderless window
        # during a display change. Placement still resizes the client directly.
        export SDL_BORDERLESS_RESIZABLE_STYLE=0
        export WSLENV="${WSLENV:+$WSLENV:}SDL_BORDERLESS_RESIZABLE_STYLE/w"
        if (( count > 1 )); then
            # Let held-button motion reach the next viewer at a display edge.
            export SDL_MOUSE_AUTO_CAPTURE=0 SDL_MOUSE_FOCUS_CLICKTHROUGH=1
            export WSLENV="${WSLENV:+$WSLENV:}SDL_MOUSE_AUTO_CAPTURE/w:SDL_MOUSE_FOCUS_CLICKTHROUGH/w"
        fi
        DEBUG=1 exec ww-start-viewer "/sdl-windows:$count" "/w:$width" "/h:$height" \
            -decorations +grab-keyboard '/t:Arch Linux (Hyprland)'
    ) 8>&- 9>&- >>"$log" 2>&1 &
    viewer_pid=$!
    if ! handles="$(windows_action arrange "$profile" "$layout" 2>>"$log" | tr -d '\r')"; then
        kill "$viewer_pid" 2>/dev/null || true
        windows_action close >>"$log" 2>&1 || true
        printf 'Could not arrange the Weaselway viewer. See %s\n' "$log" >&2
        return 1
    fi
    if (( count > 1 )); then
        windows_action drag-handoff 8>&- 9>&- >>"$log" 2>&1 &
    fi
    sync_wallpaper "$count" 8>&- 9>&- >>"$log" 2>&1 &
}

manage_viewer() {
    local viewer_pid handles next_layout
    start_viewer
    if [[ "$mode" == --display-settings ]]; then
        mkdir -p "$(dirname "$profile_file")"
        printf '%s\n' "$profile" > "$profile_file.tmp"
        mv "$profile_file.tmp" "$profile_file"
    fi
    flock -u 8

    while kill -0 "$viewer_pid" 2>/dev/null; do
        if ! next_layout="$(windows_action watch "$profile" "$layout" "$handles" 2>>"$log" | tr -d '\r')"; then
            sleep 1
            continue
        fi
        [[ -n "$next_layout" ]] || break
        # User-initiated close or display selection owns the switch lock first.
        until flock -n 8; do
            kill -0 "$viewer_pid" 2>/dev/null || break 2
            sleep .1
        done
        kill -0 "$viewer_pid" 2>/dev/null || break
        if [[ "$(cut -d ' ' -f 1 <<< "$layout")" == "$(cut -d ' ' -f 1 <<< "$next_layout")" ]]; then
            # A DPI-only change keeps the existing Windows client bounds.
            if [[ "$(cut -d ' ' -f 1-5 <<< "$layout")" == "$(cut -d ' ' -f 1-5 <<< "$next_layout")" ]] ||
                windows_action arrange "$profile" "$next_layout" "$handles" >>"$log" 2>&1; then
                layout="$next_layout"
                apply_layout
            fi
        elif windows_action close >>"$log" 2>&1; then
            # SDL fixes the window count at launch. Reconnect only the viewer
            # when the Windows output set or its main display changes.
            wait "$viewer_pid" || true
            layout="$next_layout"
            start_viewer
        fi
        flock -u 8
    done

    if ! wait "$viewer_pid"; then
        if ! grep -q 'ERRCONNECT_CONNECT_CANCELLED' "$log"; then
            printf 'The Weaselway viewer exited with an error. See %s\n' "$log" >&2
            exit 1
        fi
    fi
}

manage_viewer
